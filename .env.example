# Sternenschicht – Server-Konfiguration (kopieren nach .env)
PORT=3300
# DEBUG=1 erlaubt debug-Nachrichten (alternativ: npm run debug)
DEBUG=0

# Teaser-Mission: fallback (Archiv, Default) oder bridge (Claude-Bridge)
MISSION_SOURCE=fallback
CLAUDE_BRIDGE_URL=http://localhost:5505
# Token nie einchecken, nie an Clients weitergeben
CLAUDE_BRIDGE_TOKEN=
# Notbremse pro einzelnem Aufruf in USD
CLAUDE_MAX_BUDGET_USD=0.30
# Token-Deckel pro Serverlauf (Eingabe inkl. Cache + Ausgabe); danach nur noch Archiv-Missionen
CLAUDE_TOKEN_BUDGET=500000

# S2 – Spielleiter: live nur, wenn BEIDE Schalter gesetzt sind (sonst spielt nur das Archiv)
# SPIELLEITER_LLM=off|mock|live   (Standard off)
SPIELLEITER_LLM=off
# LLM_LIVE=1                      (zweiter Schalter für echte Claude-CLI-Aufrufe)
# Regie-Logbuch (Standard data/regie) und Ablage erzeugter Missionen (Standard content/spielleiter/erzeugt)
# REGIE_DIR=data/regie
# ERZEUGT_DIR=content/spielleiter/erzeugt

# SUND-03 A2 – Lage-Spielleiter der Freien Fahrt Sund (Standard AUS; braucht SPIELLEITER_LLM=mock|live, live zusätzlich LLM_LIVE=1)
# Takt und Grenzen: content/welt/lage-spielleiter-werte.json (Mindestabstand, Deckel je Sitzung, Timeout). Debug: lage status | plan | fail
# LAGE_SPIELLEITER=1
# LLM_ANBIETER_LAGE=claude             # nur claude (ollama wird ignoriert)

# SUND-03 B – Modelle je Anfrageart (nur im Live-Modus; ohne diese Zeilen bleibt es bei Claude für alles)
# Router ein (Standard: grobplan -> claude/sonnet, szene -> ollama, text -> ollama); jede LLM_ANBIETER_* schaltet ihn auch ein
# LLM_ROUTER=1
# LLM_ANBIETER_GROBPLAN=claude         # claude|ollama, ebenso LLM_ANBIETER_SZENE und LLM_ANBIETER_TEXT
# LLM_MODELL_GROBPLAN=sonnet           # Modell des gewählten Anbieters, ebenso LLM_MODELL_SZENE / LLM_MODELL_TEXT
# LLM_ESKALATION=claude                # claude|aus: ungültige Ollama-Antwort geht dieselbe Anfrage an Claude
# LLM_ESKALATION_MODELL=sonnet
# Ollama auf Sleipnir (ssh-Tunnel: ssh -N -L 11435:127.0.0.1:11434 sleipnir)
# OLLAMA_URL=http://127.0.0.1:11435
# OLLAMA_MODEL=gemma4:26b-a4b-it-q4_K_M
# OLLAMA_TEMPERATURE=                  # leer: Standard des Modells (so wurde gemessen)
