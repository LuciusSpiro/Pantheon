# Sternenschicht – Server-Konfiguration (kopieren nach .env)
PORT=3300
# DEBUG=1 erlaubt debug-Nachrichten (alternativ: npm run debug)
DEBUG=0

# Teaser-Mission: fallback (Archiv, Default) oder bridge (Claude-Bridge)
MISSION_SOURCE=fallback
CLAUDE_BRIDGE_URL=http://localhost:5505
# Token nie einchecken, nie an Clients weitergeben
CLAUDE_BRIDGE_TOKEN=
# Notbremse pro einzelnem Aufruf in USD
CLAUDE_MAX_BUDGET_USD=0.30
# Token-Deckel pro Serverlauf (Eingabe inkl. Cache + Ausgabe); danach nur noch Archiv-Missionen
CLAUDE_TOKEN_BUDGET=500000

# S2 – Spielleiter: live nur, wenn BEIDE Schalter gesetzt sind (sonst spielt nur das Archiv)
# SPIELLEITER_LLM=off|mock|live   (Standard off)
SPIELLEITER_LLM=off
# LLM_LIVE=1                      (zweiter Schalter für echte Claude-CLI-Aufrufe)
# Regie-Logbuch (Standard data/regie) und Ablage erzeugter Missionen (Standard content/spielleiter/erzeugt)
# REGIE_DIR=data/regie
# ERZEUGT_DIR=content/spielleiter/erzeugt
