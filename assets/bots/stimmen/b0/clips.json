 "texte": {
  "4154646b5e941edf.wav": "Wir sind nicht unterwegs.",
  "0ef99cc6d16204d0.wav": "Solange wir vor Anker liegen, nicht.",
  "ec3940db3895acce.wav": "Langsam. Eins nach dem anderen.",
  "04150bc04c0ef8af.wav": "Ich komme nicht mit.",
  "a758b859ad7c145c.wav": "Davon weiß ich nichts.",
  "ffafc7df15f91e0b.wav": "Das steht in keinem Logbuch.",
  "2c2eb1031cf997ff.wav": "Das ist ein anderer Posten.",
  "201de61d2855927a.wav": "Dafür ist ein anderer da.",
  "75d894fa3f83b4cc.wav": "Das passt nicht zusammen.",
  "c55a46252219056e.wav": "Die Angabe stimmt nicht, Käpt'n.",
  "3e871af62254b2ba.wav": "Da hakt etwas.",
  "63d8f3ba1c15aa40.wav": "Es klappt gerade nicht.",
  "73acd036ecdf82da.wav": "Niemand ist unten.",
  "9b9cb0775b8054a0.wav": "Das Außenteam fehlt.",
  "0add3c544d58d9fb.wav": "Nicht in dieser Lage.",
  "f8de3ac6bcbc2445.wav": "Jetzt kann ich das nicht tun.",
  "c9ca4e836fb2d4f4.wav": "So nehme ich keinen Befehl an.",
  "036c045374282400.wav": "Auf diesem Weg kommt nichts an.",
  "3657f5d1077fb463.wav": "Ein Mensch steht dort. Ich warte.",
  "58f85f43ce9d2c92.wav": "Die Station ist besetzt.",
  "024387d64327783a.wav": "Kuppel wird gesetzt.",
  "7d69a3a3024a9fc0.wav": "Die Kuppel kommt.",
  "68f72b9ab205df10.wav": "Der Posten ist leer.",
  "e624b33269c425e8.wav": "Es ist niemand dafür da.",
  "5b9285f02e6bd682.wav": "Die Anlage liegt still.",
  "b476d4964f647f22.wav": "Ohne Anlage geht das nicht.",
  "fca4bcb09c90dcec.wav": "Rückholung läuft.",
  "097564f945207bce.wav": "Ich hole sie zurück.",
  "8ab7bdf709135f2f.wav": "Messfühler wird gesetzt.",
  "5a6b872aa9afaec2.wav": "Der Messfühler kommt.",
  "53e5197496fdb2e2.wav": "Automatik übernimmt.",
  "9dfe3f99dc1d4679.wav": "Zurück in den Standardbetrieb.",
  "285c7f88ce7ec19f.wav": "Bericht folgt.",
  "d4728857ca72c8dd.wav": "Ich melde die Lage.",
  "68097bd3938d30b8.wav": "Bitte wiederholen.",
  "56441241b71bc37b.wav": "Das kam nicht an.",
  "b3d40e42afd96c93.wav": "Kein Ziel in Sicht.",
  "6ea4efdf17ab2c55.wav": "Mir fehlt ein Ziel.",
  "451d425303f98b0e.wav": "Die See erlaubt es nicht.",
  "18f68d1958fef789.wav": "Jetzt nicht.",
  "64870e6fd72d1022.wav": "Ich halte Abstand.",
  "a484d941f830a338.wav": "Ich bleibe auf Distanz.",
  "07dbd9d4ccd5de40.wav": "Ich gehe längsseits.",
  "b162b47ddf452bad.wav": "Leinen werden klargemacht.",
  "41b96b4b87ada067.wav": "Wir fallen ab.",
  "2f0390fbfabcfdf7.wav": "Ruder liegt, wir weichen.",
  "439e6900a2515067.wav": "Kurs liegt an.",
  "90316bd6aa0b8d1b.wav": "Ruder liegt, Kurs steht.",
  "33cd245aa902595d.wav": "Fahrt wird angepasst.",
  "507b040beb78e81e.wav": "Ich gebe Fahrt.",
  "a042aef85aa8552a.wav": "Sprung wird vorbereitet.",
  "f1c7d4d7197c28ff.wav": "Der Sprung wird klargemacht.",
  "58c54d442acda9fe.wav": "Maschinen stehen.",
  "19f651fa929c47f0.wav": "Wir liegen still.",
  "bdf528b122926b47.wav": "Jetzt nicht, die Lage ist falsch.",
  "8b7b7f5ef5e3e115.wav": "Das passt gerade nicht.",
  "f35f296f497e6de3.wav": "Transport läuft.",
  "71d03cec18db3c1f.wav": "Der Transporter arbeitet.",
  "8dbe440a91c55745.wav": "Feuer frei.",
  "6348b24c3cd54d9d.wav": "Ich eröffne das Feuer.",
  "3369149f4891e5a7.wav": "Die Waffen schweigen.",
  "4637417963d4e9c3.wav": "Ich stelle das Feuer ein.",
  "cabd61b5aab5c083.wav": "Ich suche festen Grund.",
  "c72c14335d79f7df.wav": "Landeplatz wird gesucht.",
  "57c17e668ffb75f3.wav": "Ich taste ab.",
  "59d64d7751875cef.wav": "Der Scan läuft.",
  "33c5125a55a7d95c.wav": "Ziel ist erfasst.",
  "62d4544c628d2b50.wav": "Ich habe es im Blick.",
  "fc9c022a5d592c33.wav": "Jetzt ist es nicht machbar.",
  "4840bdb0accd736d.wav": "In dieser Lage nicht.",
  "05b77aa06283cc3d.wav": "Energie wird umgeleitet.",
  "0c91eb9a01f809cc.wav": "Ich lenke die Kraft um.",
  "36be4676122b14ef.wav": "Reihenfolge steht.",
  "ff1b4b90c7c2d1da.wav": "Prioritäten sind gesetzt.",
  "2f51d2e914ffe5bb.wav": "Reparatur ist eingeplant.",
  "e03367615d68ea48.wav": "Kommt auf die Liste.",
  "082ff7a16fa659e0.wav": "Schilde werden umgelegt.",
  "35c1f9375ba4ffc3.wav": "Ich verlege die Schilde.",
  "4adac9a63b6392c6.wav": "Überladung läuft.",
  "470b04db8474a631.wav": "Ich treibe die Anlage an."
 }
}
