 "texte": {
  "4510eec25da0b9b6.wav": "Es läuft derzeit keine Fahrt.",
  "8be3aad24f25574e.wav": "Außerhalb einer Fahrt gibt es keine Befehle.",
  "3f265c92fdecaee4.wav": "Zu viele Befehle in zu kurzer Zeit.",
  "e6eb7013aeeac91b.wav": "Bitte einzeln. Ich schreibe mit.",
  "881d0a7913bcf36c.wav": "Dieser Befehl steht nicht im Katalog.",
  "19ceaea01db4ace9.wav": "Diesen Befehl führe ich nicht.",
  "d8ff2639178bc980.wav": "Das fällt nicht in meine Zuständigkeit.",
  "2dc5189ca6707664.wav": "Falscher Adressat.",
  "018df1c3cf816a6b.wav": "Die Angabe ist ungültig.",
  "a064031b007e1e53.wav": "Das ist so nicht zulässig.",
  "ecfad8c7aa33e6e9.wav": "Fehler bei der Ausführung.",
  "edac86d7fa188d8b.wav": "Das ist leider schiefgegangen.",
  "51c6774402340782.wav": "Es befindet sich niemand unten.",
  "dfa06c8619a51902.wav": "Ein Außenteam ist nicht vorhanden.",
  "7a73b024bd150f9d.wav": "Derzeit nicht ausführbar.",
  "ea0cbeec83c6d5a9.wav": "Die Lage steht dem entgegen.",
  "0efc13eb9de1dcd0.wav": "Dieser Eingabeweg ist nicht vorgesehen.",
  "221cadf684619d88.wav": "Über diesen Weg nehme ich nichts an.",
  "13d3e8bef9d7f53f.wav": "Die Station ist menschlich besetzt.",
  "d9f0e98621c09bef.wav": "Ein Mensch hat die Station. Ich warte.",
  "02ea78f974b731a4.wav": "Kuppel wird platziert.",
  "356fe7293af70a59.wav": "Kuppelaufbau eingeleitet.",
  "9a4d9591dfed3f55.wav": "Der Posten ist unbesetzt.",
  "95656e0d72c2f53b.wav": "Es gibt dafür keinen Zuständigen.",
  "56b789d850136e68.wav": "Die Anlage ist nicht verfügbar.",
  "9d0c723beff9f211.wav": "Ausfall der Anlage, daher nicht möglich.",
  "a9a2ff64e5d29777.wav": "Rückholung eingeleitet.",
  "56b4f63116bdfaed.wav": "Das Team wird zurückgeholt.",
  "484d87068b7d52be.wav": "Messgerät wird platziert.",
  "ffdb28c94faf2f6b.wav": "Messung wird vorbereitet.",
  "09ce8bc25f0e53b2.wav": "Automatik ist aktiv.",
  "fda58e56b29cd6d0.wav": "Standardbetrieb wiederhergestellt.",
  "85c59c250a1c3597.wav": "Statusbericht folgt.",
  "0d3a267d78073d13.wav": "Lage wird erfasst.",
  "7738974ffb5e59be.wav": "Bitte präzisieren.",
  "56f9840228b94c97.wav": "Der Befehl war unklar.",
  "09c432ae7573f376.wav": "Es ist kein Ziel gewählt.",
  "6e944492b04211f2.wav": "Ohne Ziel kann ich nicht arbeiten.",
  "9eedd8477ad7c090.wav": "Das Manöver ist derzeit nicht möglich.",
  "cdf380be7a950fd2.wav": "Die Lage lässt es nicht zu.",
  "3aed5c1d023924a6.wav": "Abstandshaltung aktiv.",
  "a370486b531e4267.wav": "Abstand wird eingehalten.",
  "b72cc70fb1251a84.wav": "Anflug auf den Anlegepunkt.",
  "16bf7d734542ac26.wav": "Anlegemanöver läuft.",
  "538e8e4f89247ec1.wav": "Ausweichkurs liegt an.",
  "e9c2be538d0d20bc.wav": "Ich weiche aus, wie befohlen.",
  "3ad2e218868a37be.wav": "Kurs bestätigt.",
  "bdeb29daf1c6c84f.wav": "Kurs liegt an, wie befohlen.",
  "abab1d9e367f0115.wav": "Schub angepasst.",
  "5a6c0a6d1c34321c.wav": "Schubwert ist gesetzt.",
  "482d64a73b352129.wav": "Sprungvorbereitung eingeleitet.",
  "32455649a4d03a3d.wav": "Sprung in Vorbereitung.",
  "0085a0ed21beb53c.wav": "Maschinen gestoppt.",
  "eef30bb84a1210a2.wav": "Stillstand hergestellt.",
  "a87b9cd3c139d4f0.wav": "Unter diesen Umständen nicht möglich.",
  "046823b5101ba9fd.wav": "Die Lage verbietet das derzeit.",
  "2ec13054d8e3d642.wav": "Transport eingeleitet.",
  "b311495b2abe4a51.wav": "Transportvorgang läuft.",
  "123f522fc9e8c3c5.wav": "Feuer freigegeben.",
  "20d3fc3aff157ab8.wav": "Feuerfreigabe verbucht.",
  "6f914b7f86a539c6.wav": "Feuer eingestellt.",
  "1f74bdbe30a4a1b8.wav": "Feuerhalt bestätigt.",
  "a9e6b0b106438ff3.wav": "Landepunktsuche läuft.",
  "23250885057477e3.wav": "Geeignete Flächen werden geprüft.",
  "f3abb27419e70068.wav": "Scan eingeleitet.",
  "ab69ebade3572e87.wav": "Abtastung läuft.",
  "87b5d6f9338300dd.wav": "Ziel erfasst.",
  "867246ee06f10be5.wav": "Ziel ist aufgenommen.",
  "3d22808722db8025.wav": "Aktuell nicht durchführbar.",
  "56c61f5f482a2a45.wav": "Die Lage gibt das nicht her.",
  "d05d0f0d1b9626c7.wav": "Energieverteilung angepasst.",
  "f7d1966e8970fdcc.wav": "Umleitung ist aktiv.",
  "9ceb91424e59fc85.wav": "Reihenfolge angepasst.",
  "486aa6b828898cd7.wav": "Priorität ist vermerkt.",
  "0b51a92ae7bc8dfe.wav": "Reparatur vermerkt.",
  "83df7c9beca76966.wav": "Auftrag ist eingetragen.",
  "1d88a12b565ec548.wav": "Schildverteilung geändert.",
  "d9cb33f3e283fdcd.wav": "Schilde sind umgelegt.",
  "c7df7edc84efcee0.wav": "Überladung eingeleitet.",
  "c5ef9ac4f5b57dac.wav": "Überladung läuft. Risiko vermerkt."
 }
