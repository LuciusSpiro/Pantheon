 },
 "texte": {
  "f842641ab3c4ad3f.wav": "Wir fahren doch gerade gar nicht!",
  "046d48b9dad58b5a.wav": "Erst wenn die Fahrt losgeht, ja?",
  "eb08abd451ee8727.wav": "Moment, nicht so schnell!",
  "a25de4ad5c1eee72.wav": "Ich komm nicht hinterher, Entschuldigung!",
  "22142f072ec4128c.wav": "Den Befehl kenne ich noch nicht!",
  "00ba855be427cdf7.wav": "Hab ich noch nie gehört, Entschuldigung!",
  "02b0875596d40bbb.wav": "Das macht jemand anderes, glaube ich!",
  "712501c32cd72ef1.wav": "Das ist nicht mein Platz!",
  "5f2bf0b3ebf7ee3d.wav": "Das verstehe ich nicht ganz!",
  "f1387fcf0f569dd3.wav": "Hier stimmt etwas nicht, oder?",
  "d5137c337589753b.wav": "Huch, das hat nicht geklappt!",
  "9ead4c288063dc64.wav": "Da klemmt irgendwas, Entschuldigung!",
  "b8f9700cc02cb0ad.wav": "Es ist doch keiner unten!",
  "55349e5c0fbb0e9f.wav": "Da unten ist niemand, wirklich!",
  "1c5df6aae946e243.wav": "Jetzt nicht, die Lage ist zu heikel!",
  "0583010cba1f62a7.wav": "Das schaffe ich gerade nicht!",
  "2d28ec226922dc7b.wav": "So darf ich das nicht annehmen!",
  "d08c785901773060.wav": "Über diesen Weg geht das nicht!",
  "cf624b60519cc2f0.wav": "Da sitzt schon jemand, ich warte!",
  "37f28f8463d9d698.wav": "Ein Mensch macht das, ich halte mich raus!",
  "2373e87c9644c199.wav": "Ich setze die Kuppel!",
  "d4129fdc7fb5165f.wav": "Kuppel kommt, gleich steht sie!",
  "c5a0b236be76fae7.wav": "Dafür ist keiner da, schade!",
  "c891e9488432d5ba.wav": "Der Posten ist gar nicht besetzt!",
  "1e71681882617fa8.wav": "Die Anlage ist kaputt, leider!",
  "4daa2757d98cbb24.wav": "Ohne die Anlage geht nichts, tut mir leid!",
  "1bfedf657230255b.wav": "Ich hole sie sofort zurück!",
  "6a58cac7e483a012.wav": "Rückholung läuft, ich beeile mich!",
  "bd2409028caed8bb.wav": "Messfühler kommt, ich beeile mich!",
  "d63906cd63f26455.wav": "Ich setze den Messfühler!",
  "7bece3948fa8d301.wav": "Automatik übernimmt, ich passe auf!",
  "011d0de2f958ee91.wav": "Ich fahre wieder normal!",
  "1d0a16fcd60eda64.wav": "Ich melde gleich die Lage!",
  "6b1e19f0a1a81224.wav": "Bericht kommt, einen Moment!",
  "a4ccefa5a8cb4ffc.wav": "Wie bitte? Noch einmal, bitte!",
  "85920df6c4444f5a.wav": "Das hab ich nicht verstanden!",
  "5b6d2ae5e797e37a.wav": "Ich sehe kein Ziel, Käpt'n!",
  "b683d476882d3657.wav": "Welches Ziel denn?",
  "04cff0a9cd41b6f0.wav": "Jetzt gerade geht das leider nicht!",
  "bf78f4f17df5bfe9.wav": "Die Lage macht das unmöglich, tut mir leid!",
  "27174a6d5f59e0ea.wav": "Ich halte Abstand, versprochen!",
  "ba1598035ae44535.wav": "Abstand bleibt, ich pass auf!",
  "61e2699cfbe93f36.wav": "Ich gehe längsseits, los geht's!",
  "ef0d106d92954829.wav": "Anlegen, das mache ich gern!",
  "03ccd8d8a33ca642.wav": "Wir weichen aus, festhalten!",
  "dcc5e28d7772b9fc.wav": "Ich drehe ab, schnell!",
  "829ceddbdc24c7cc.wav": "Kurs liegt an, mache ich sofort!",
  "98a39877ae06e27d.wav": "Neuer Kurs, ich bin dran!",
  "224c3b85325933d1.wav": "Schub wird angepasst, mache ich!",
  "ecde4adfa7849d9d.wav": "Ich ändere die Fahrt, sofort!",
  "88b539b6ead34b43.wav": "Sprung wird vorbereitet, aufregend!",
  "0353b4d1f8ff79ca.wav": "Ich bereite den Sprung vor!",
  "6f57127265300edb.wav": "Alle Maschinen gestoppt, mache ich!",
  "572ec107fdcc01e9.wav": "Wir stehen, ich hab's!",
  "3aaff82fcff376a5.wav": "Das passt jetzt gar nicht, Käpt'n!",
  "f0e6177264bca2a9.wav": "Gerade nicht, später vielleicht!",
  "d55b406c17ed848c.wav": "Transport läuft, ich bin dabei!",
  "274fcad3eb7a36b1.wav": "Der Transporter surrt schon!",
  "b947c783a75fb3b8.wav": "Feuer frei, ich schieße!",
  "affa24916e66e21c.wav": "Los geht's, Feuer eröffnet!",
  "fdd51fadd137acc8.wav": "Feuer eingestellt, alles ruhig!",
  "7207aca717dce534.wav": "Ich höre auf zu schießen!",
  "7cff9a6475fa1921.wav": "Ich suche einen Landeplatz, sofort!",
  "967934a384319cd1.wav": "Landeplatzsuche läuft, ich schau!",
  "36c52561b3a8c30c.wav": "Scan läuft, ich schau hin!",
  "e1097faf7d2bf238.wav": "Ich suche alles ab!",
  "448c60e94c394af7.wav": "Ziel erfasst, ich hab es!",
  "1862c2bf73163767.wav": "Ich habe es im Visier!",
  "43a997da5829b549.wav": "Gerade nicht, da kommt was dazwischen!",
  "2f0da6aef5d1acdf.wav": "In der Lage geht das nicht!",
  "7555d6c48b276e70.wav": "Ich leite die Energie um!",
  "78e2e83301fe0118.wav": "Energie wird umgeleitet, sofort!",
  "e199ef0b97093977.wav": "Reihenfolge steht, mache ich!",
  "9b2d4d0db6ebb28e.wav": "Neue Prioritäten, verstanden!",
  "7df8529fe26fcece.wav": "Ich repariere das, versprochen!",
  "a7bbd38405ce8483.wav": "Ich kümmere mich drum!",
  "f1d0635fe566f4d4.wav": "Ich lege die Schilde um!",
  "3a867891f16284b9.wav": "Schilde werden verlegt, mache ich!",
  "558c54b86945bf4a.wav": "Überladung läuft, ganz schön heiß!",
  "87ba6df24e89cc3a.wav": "Ich überlade, hoffentlich hält's!"
 }
}
