{
  "format": "molekuel/1",
  "id": "raetsel_loesen",
  "name": "Rätsel lösen",
  "familie": "erkunden_und_forschen",
  "kern": "Mechanismus, Glyphen, Licht",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "C5"
  ],
  "umsetzungen": [
    {
      "id": "zwei_schluessel",
      "name": "Tor nur zu zweit zu öffnen",
      "schauplatz": "aussen",
      "beschreibung": "Zwei Schlüssel weit auseinander müssen gleichzeitig gehalten werden, dann öffnet sich das Tor. Ruhiger Moment nach einem Gefecht: Absprache und Anzählen. Heute nur auf Kesh.",
      "braucht": [
        "transfer",
        "aussen_objekte"
      ],
      "dauer_min": [
        1,
        3
      ],
      "ereignisse": [
        "vaultOpened"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true,
          "werte": [
            "kesh"
          ]
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "werte": [
            "kesh"
          ]
        },
        "funk_npc": {
          "typ": "npc",
          "default": "tesk"
        },
        "funk_tipp": {
          "typ": "text",
          "default": "Die Kustoden bauten für Paare. Einer allein kommt da nicht rein."
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ],
          "objekte": {
            "{{map}}": [
              "vault",
              "key"
            ]
          }
        },
        "besetzung": {
          "npc": [
            "{{funk_npc}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "enter": [
              {
                "oda": "@{{id}}.ruhe"
              }
            ],
            "timers": [
              {
                "at": 5,
                "radio": {
                  "from": "{{funk_npc}}",
                  "text": "@{{id}}.tipp"
                }
              },
              {
                "at": 60,
                "if": {
                  "not": {
                    "check": {
                      "name": "object_state",
                      "map": "{{map}}",
                      "object": "vault",
                      "state": "open"
                    }
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "objectives": [
              {
                "id": "schluessel",
                "text": "@{{id}}.ziel",
                "done": {
                  "check": {
                    "name": "object_state",
                    "map": "{{map}}",
                    "object": "vault",
                    "state": "open"
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "check": {
                    "name": "object_state",
                    "map": "{{map}}",
                    "object": "vault",
                    "state": "open"
                  }
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "set_object_state",
                "map": "{{map}}",
                "object": "vault",
                "state": "open"
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ruhe": "Ruhe. Zwei Schlüssel, weit auseinander: beide gleichzeitig E halten, dann öffnet das Tor.",
          "{{id}}.tipp": "{{funk_tipp}}",
          "{{id}}.hinweis": "Ein Schlüssel oben an der Hallenwand, einer unten rechts am Gewölbe. Anzählen, dann beide E!",
          "{{id}}.ziel": "Beide Schlüssel gleichzeitig halten (E)"
        }
      },
      "test": {
        "params": {
          "loc": "kesh",
          "map": "kesh"
        }
      }
    },
    {
      "id": "sonden_code",
      "name": "Sonden-Code: Captain sieht die Tabelle",
      "schauplatz": "aussen",
      "beschreibung": "Eine Sonde steuert Wachdrohnen. Unten sieht das Außenteam Symbole, oben hat der Captain die Codetabelle: Nur zusammen schaltet man die Sonde ab. Wissen aufteilen in Reinform. Heute nur auf B-7 (Plattform).",
      "braucht": [
        "transfer",
        "aussen_objekte",
        "wissen_aufteilen"
      ],
      "dauer_min": [
        2,
        4
      ],
      "ereignisse": [
        "sondeDisabled"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true,
          "werte": [
            "b7"
          ]
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "werte": [
            "platform"
          ]
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ],
          "objekte": {
            "{{map}}": [
              "sonde"
            ]
          }
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "timers": [
              {
                "at": 0.5,
                "oda": "@{{id}}.start"
              },
              {
                "at": 40,
                "if": {
                  "not": {
                    "check": {
                      "name": "object_state",
                      "map": "{{map}}",
                      "object": "sonde",
                      "state": "off"
                    }
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "check": {
                    "name": "away_active",
                    "map": "{{map}}"
                  }
                }
              },
              {
                "id": "sonde",
                "text": "@{{id}}.ziel_sonde",
                "show": {
                  "check": {
                    "name": "away_active",
                    "map": "{{map}}"
                  }
                },
                "done": {
                  "check": {
                    "name": "object_state",
                    "map": "{{map}}",
                    "object": "sonde",
                    "state": "off"
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "check": {
                    "name": "object_state",
                    "map": "{{map}}",
                    "object": "sonde",
                    "state": "off"
                  }
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "debug_skip_away",
                "map": "{{map}}"
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.start": "Außenteam auf die Pads. Die Sonde unten steuert die Drohnen – den Code hat der Captain oben.",
          "{{id}}.hinweis": "Captain: Reiter „Außenteam“ zeigt die Codetabelle. Unten: Symbole ansagen, oben: Farben durchgeben.",
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_sonde": "Sonde abschalten (Code vom Captain)"
        }
      },
      "test": {
        "params": {
          "loc": "b7",
          "map": "platform"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}