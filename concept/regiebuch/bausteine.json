    "ship_fire":          { "einordnung": "generisch", "beschreibung": "Feuer an Bord in einer Region", "params": { "region": { "typ": "region" }, "text": { "typ": "text" } }, "effekt": "schaden" },
    "ship_breach":        { "einordnung": "generisch", "beschreibung": "Hüllenbruch in einer Region", "params": { "region": { "typ": "region" }, "text": { "typ": "text" } }, "effekt": "schaden" },
