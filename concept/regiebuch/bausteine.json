    "reveal_location":    { "einordnung": "generisch", "beschreibung": "Ort auf der Sternkarte aufdecken, optional gesperrte Verbindung öffnen", "params": { "loc": { "typ": "loc", "pflicht": true }, "openLink": { "typ": "string" }, "text": { "typ": "text" } } },
