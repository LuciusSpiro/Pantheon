{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pantheon/weltstand/1",
  "title": "Weltstand (Pantheon, Version 1)",
  "description": "Speicherstand einer Spielrunde: Welt + Schiff + NSC + Chronik. Liegt auf dem Server (data/weltstaende/<id>.json), atomar geschrieben. Gespeichert wird bei jedem Andocken. Höchstens 5 Weltstände.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "erstellt", "gespeichert", "ort", "schiff", "welt", "missionen", "npc", "chronik"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "description": "Formatversion für spätere Migrationen" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{4,40}$" },
    "name": { "type": "string", "maxLength": 40, "description": "Anzeigename in der Lobby, z. B. Schiffsname + Datum" },
    "erstellt": { "type": "string", "format": "date-time" },
    "gespeichert": { "type": "string", "format": "date-time" },
    "spielzeit_s": { "type": "number", "minimum": 0 },
    "tutorial": { "enum": ["gespielt", "uebersprungen", "laeuft"] },

    "ort": {
      "type": "object", "additionalProperties": false, "required": ["angedockt"],
      "description": "Gespeichert wird nur angedockt. Laden setzt das Schiff hierhin.",
      "properties": { "angedockt": { "type": "string" } }
    },

    "schiff": {
      "type": "object", "additionalProperties": false, "required": ["name", "marken", "lager"],
      "properties": {
        "name": { "type": "string" },
        "marken": { "type": "integer", "minimum": 0 },
        "lager": { "type": "object", "description": "Gegenstand -> Anzahl (ersatzteil, flickblech, medipack, bolzen …)", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "ausbauten": { "type": "array", "items": { "type": "string" }, "description": "gekaufte Upgrades (bolzen, seitenturm …)" },
        "deko": { "type": "array", "items": { "type": "string" }, "description": "Deko im Besitz" },
        "quartiere": { "type": "object", "description": "Quartier -> Einrichtung (Boden, Wand, Licht, Deko-Plätze)" },
        "systeme": { "type": "object", "description": "System -> ok|damaged|broken (Schäden bleiben über das Speichern hinweg)", "additionalProperties": { "enum": ["ok", "damaged", "broken"] } },
        "huelle": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },

    "welt": {
      "type": "object", "additionalProperties": false, "required": ["orte"],
      "properties": {
        "orte": {
          "type": "object", "additionalProperties": false, "required": ["bekannt", "besucht"],
          "properties": {
            "bekannt": { "type": "array", "items": { "type": "string" } },
            "besucht": { "type": "array", "items": { "type": "string" } },
            "aufgedeckt": { "type": "array", "items": { "type": "string" }, "description": "per Weitscan aufgedeckte Funde" },
            "gefunden": { "type": "array", "items": { "type": "string" }, "description": "eingesammelte/gescannte Funde" }
          }
        },
        "verbindungen_offen": { "type": "array", "items": { "type": "string" }, "description": "Schlüssel aus LOCKED_LINKS, die offen sind" },
        "flags": { "type": "object", "description": "Weltweite Flags (bribed, decision, technikerRescued …)" },
        "fakten": { "type": "object", "description": "Kanon aus Folgen, z. B. tafel_von_kesh: konkordat_archiv", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },

    "missionen": {
      "type": "object",
      "description": "Missions-ID -> Status. Laden startet eine aktive Mission beim gespeicherten Schritt neu.",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["status"],
        "properties": {
          "status": { "enum": ["angeboten", "aktiv", "erledigt"] },
          "schritt": { "type": "string" },
          "v": { "type": "object", "description": "Schrittvariablen (m.v)" },
          "ereignisse": { "type": "array", "items": { "type": "string" }, "description": "für den Neustart nötige Ereignisse (accepted …)" },
          "entscheidungen": { "type": "array", "items": { "type": "string" } },
          "erledigte_ziele": { "type": "array", "items": { "type": "object" } },
          "ausgang": { "type": "string" },
          "start_s": { "type": "number" }, "ende_s": { "type": "number" }
        }
      }
    },

    "npc": {
      "type": "object",
      "description": "NSC als Datensätze (Nemesis-Prinzip). Kennung -> Datensatz.",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["name", "fraktion", "status", "haltung", "gedaechtnis"],
        "properties": {
          "name": { "type": "string" },
          "titel": { "type": "string", "description": "Anzeige im Funk, z. B. 'Hafenmeisterin'" },
          "fraktion": { "type": "string" },
          "rolle": { "type": "string" },
          "status": { "enum": ["lebt", "verwundet", "gefangen", "tot", "verschwunden", "befoerdert", "uebergelaufen"] },
          "haltung": { "type": "integer", "minimum": -3, "maximum": 3, "description": "-3 Feind … 0 neutral … 3 Verbündeter" },
          "ort": { "type": "string" },
          "gedaechtnis": {
            "type": "array", "maxItems": 12,
            "description": "Kurze Liste gemeinsamer Ereignisse, älteste zuerst. Bei mehr als 12 werden die ältesten zusammengefasst.",
            "items": { "type": "object", "additionalProperties": false, "required": ["text"],
              "properties": { "text": { "type": "string", "maxLength": 200 }, "mission": { "type": "string" }, "spielzeit_s": { "type": "number" } } }
          }
        }
      }
    },

    "chronik": {
      "type": "array",
      "description": "Gespielte Missionen und Entscheidungen. Grundlage für 'Was bisher geschah'.",
      "items": { "type": "object", "additionalProperties": false, "required": ["text"],
        "properties": { "text": { "type": "string", "maxLength": 300 }, "mission": { "type": "string" }, "ausgang": { "type": "string" }, "spielzeit_s": { "type": "number" } } }
    }
  }
}
