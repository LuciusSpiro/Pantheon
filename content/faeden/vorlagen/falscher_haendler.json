{
  "format": "faden-vorlage/1",
  "id": "falscher_haendler",
  "titel": "Falscher Händler",
  "ausloeser": [{ "art": "notruf", "ausgang": "gelungen", "ereignis": ["notruf_havarie_konvoi"] }],
  "volk_erlaubt": ["rom", "kon"],
  "nsc": { "status": "aktiv", "haltung": 0, "klassen": ["frachter", "kurier"] },
  "wahrheit": { "id": "ist_germane", "fraktion": "ger" },
  "hinweise": {
    "h_gerucht": { "kanal": "geruecht", "text": "Gerücht: Von {name} hat noch kein Kontor je eine Lieferung gesehen." },
    "h_papiere": { "kanal": "papiere", "text": "Das Siegel auf den Papieren von {name} führt kein Kontor." },
    "h_schmuggel": { "kanal": "geruecht", "text": "Gerücht: Piraten wollen bei {name} Schmuggelware an Bord gewittert haben." }
  },
  "beats": [
    {
      "id": "b_bitte", "typ": "bitte",
      "hinweise": ["h_gerucht"],
      "parameter": { "text_key": "bitte_transport", "text_key_kein_ziel": "bitte_transport_kein_ziel" },
      "optionen": [
        { "id": "annehmen", "text": "Wir bringen eure Ware.", "ausgang": "gelungen", "folge": [{ "typ": "haltung_aenderung", "grund": "geholfen" }] },
        { "id": "ablehnen", "text": "Sucht euch jemand anderen.", "ausgang": "gescheitert", "folge": [{ "typ": "haltung_aenderung", "grund": "bitte_abgelehnt" }] },
        { "id": "spaeter", "text": "Meldet euch später.", "folge": [{ "typ": "haltung_aenderung", "grund": "hingehalten" }] }
      ],
      "aus": {
        "gelungen": { "status": "verbuendet", "weiter": "b_fracht" },
        "gescheitert": { "status": "aktiv", "weiter": "b_abschluss" }
      }
    },
    {
      "id": "b_fracht", "typ": "fracht",
      "hinweise": ["h_papiere", "h_schmuggel"],
      "parameter": { "nach": "$ort", "ware": "fracht_kiste", "ende": "geladen" },
      "aus": {
        "gelungen": { "status": "verbuendet", "weiter": "b_forderung" },
        "gescheitert": { "status": "aktiv", "weiter": "b_abschluss" }
      }
    },
    {
      "id": "b_forderung", "typ": "forderung",
      "parameter": { "staerke": "mittel" },
      "optionen": [
        { "id": "ausliefern", "text": "Nehmt die Ware.", "ausgang": "gescheitert", "folge": [{ "typ": "haltung_aenderung", "grund": "im_stich_gelassen" }] },
        { "id": "nicht_ausliefern", "text": "Die Ware bleibt bei uns.", "ausgang": "gelungen", "folge": [] }
      ],
      "aus": {
        "gelungen": { "status": "verbuendet", "weiter": "b_schmier" },
        "gescheitert": { "status": "aktiv", "weiter": "b_abschluss" }
      }
    },
    {
      "id": "b_schmier", "typ": "schmiergeld",
      "parameter": { "staerke": "mittel" },
      "optionen": [
        { "id": "bestechen", "text": "Wir zahlen.", "ausgang": "gelungen", "folge": [] },
        { "id": "verweigern", "text": "Wir zahlen nichts.", "ausgang": "gescheitert", "folge": [] }
      ],
      "aus": {
        "gelungen": { "status": "verbuendet", "weiter": "b_abgabe" },
        "gescheitert": { "status": "aktiv", "weiter": "b_kampf" }
      }
    },
    {
      "id": "b_kampf", "typ": "raumschlacht",
      "aus": {
        "gelungen": { "status": "aktiv", "weiter": "b_abgabe" },
        "gescheitert": { "status": "aktiv", "weiter": "b_abschluss" }
      }
    },
    {
      "id": "b_abgabe", "typ": "fracht",
      "parameter": { "nach": "$ort", "ware": "fracht_kiste", "ende": "abgeliefert" },
      "aus": {
        "gelungen": { "status": "verbuendet", "weiter": "b_enthuell" },
        "gescheitert": { "status": "aktiv", "weiter": "b_abschluss" }
      }
    },
    {
      "id": "b_enthuell", "typ": "enthuellung",
      "aus": {
        "gelungen": { "status": "feindlich", "weiter": "b_jagd", "folge": [{ "typ": "sim_befehl" }] },
        "gescheitert": { "status": "geflohen", "weiter": "b_jagd" }
      }
    },
    {
      "id": "b_jagd", "typ": "verfolgung",
      "parameter": { "fluchtziel": "naechster_sprungpunkt" },
      "aus": {
        "gelungen": { "status": "feindlich", "weiter": "b_schlacht" },
        "gescheitert": { "status": "geflohen", "weiter": "b_schlacht" }
      }
    },
    {
      "id": "b_schlacht", "typ": "raumschlacht",
      "aus": {
        "gelungen": { "status": "tot", "weiter": "b_abschluss", "folge": [{ "typ": "ruf_aenderung", "grund": "funk_rom_gruss" }] },
        "gescheitert": { "status": "geflohen", "weiter": "b_abschluss" }
      }
    },
    {
      "id": "b_abschluss", "typ": "abschluss", "erfolg": { "ereignis": ["raumschlacht_gelungen"] },
      "aus": {
        "gelungen": { "folge": [{ "typ": "haltung_aenderung", "grund": "gedankt" }] },
        "gescheitert": { "folge": [] }
      }
    }
  ]
}
