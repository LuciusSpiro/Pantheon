{
  "format": "molekuel/1",
  "id": "artefakt_freilegen",
  "name": "Artefakt freilegen",
  "familie": "bergen_und_sichern",
  "kern": "Fund ausgraben, stabilisieren, sicher transportieren",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "C1",
    "C5",
    "C9"
  ],
  "umsetzungen": [
    {
      "id": "fund_aus_gewoelbe",
      "name": "Fund aus dem Gewölbe bergen",
      "schauplatz": "aussen",
      "beschreibung": "Hinter dem Tor liegt der Fund (Ruine: die Legionskasse). Ist das Tor noch zu, muss es erst auf (Rätselpaar, Sprengen oder E am einfachen Tor). E halten am Sockel, dann ist der Fund geborgen. Kurz und ruhig, meist folgt eine Wendung (Wächter erwacht, Verstärkung).",
      "braucht": [
        "transfer",
        "aussen_objekte"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "ruine",
          "kesh"
        ],
        "anker": [
          "tor",
          "fund"
        ]
      },
      "dauer_min": [
        1,
        2
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          1,
          3
        ],
        "2": [
          1,
          2
        ],
        "3": [
          1,
          2
        ]
      },
      "liefert_flags": [
        "{{id}}_geborgen"
      ],
      "ereignisse": [
        "fundGeborgen",
        "tabletTaken"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "fund_name": {
          "typ": "text",
          "default": "{{lex.fund:der}}",
          "beschreibung": "Name des Funds im Nominativ mit Artikel (z. B. „die Legionskasse“); Standard aus dem Lexikon"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": {
                  "not": {
                    "check": {
                      "name": "anker_state",
                      "map": "{{map}}",
                      "anker": "tor",
                      "state": "offen"
                    }
                  }
                },
                "oda": "@{{id}}.zu"
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 45,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "fund",
                        "state": "genommen"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_geborgen": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft",
                    "fund": "{{fund_name}}"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "tor",
                "zustand": "offen"
              },
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "fund",
                "zustand": "genommen"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_geborgen": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "{{fund_name}} liegt hinter {{lex.tor:dem}}. Hingehen, E halten – dann ist der Fund geborgen.",
          "{{id}}.zu": "{{lex.tor:der}} ist noch zu. Erst öffnen, dann an den Sockel.",
          "{{id}}.hinweis": "Captain: Sockel auf der Außenteam-Karte markiert, dort liegt {{fund_name}}. Durch {{lex.tor:den}}, dann E halten.",
          "{{id}}.geschafft": "{{fund_name}} ist geborgen!",
          "{{id}}.ziel": "Fund bergen (E halten): {{fund_name}}"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "kesh",
          "map": "kesh.kastell"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
