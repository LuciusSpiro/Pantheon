{
  "format": "molekuel/1",
  "id": "ausbruch",
  "name": "Ausbruch",
  "familie": "kampf",
  "kern": "Aus der Gefangenschaft freikommen und die Ausrüstung zurückholen",
  "ansaetze": [
    "gewalt",
    "heimlich"
  ],
  "szenentypen": [
    "C8"
  ],
  "umsetzungen": [
    {
      "id": "zelle_und_kammer",
      "name": "Aus der Zelle, Ausrüstung holen, raus",
      "schauplatz": "aussen",
      "beschreibung": "Die Szene beginnt in der Zelle: Die Crew kommt ohne Waffen zu sich (team_gefangen beim Szenenstart). Zellentür von innen öffnen (E halten, laut, alarmiert die Wachen), Ausrüstung an der Truhe holen (E halten), dann zum Abholpunkt. Nicht am Heimathafen. Als eigene Szene oder als Folge einer Gefangennahme.",
      "braucht": [
        "transfer",
        "gefangenschaft",
        "aussen_kampf"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten",
          "station",
          "schiff"
        ],
        "anker": [
          "zelle",
          "beute",
          "abholpunkt"
        ]
      },
      "dauer_min": [
        4,
        6
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          5,
          7
        ],
        "2": [
          4,
          6
        ],
        "3": [
          4,
          6
        ]
      },
      "liefert_flags": [
        "{{id}}_frei"
      ],
      "ereignisse": [
        "teamGefangen",
        "gefangen",
        "alarm"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "fraktion": {
          "typ": "text",
          "default": "rostmeute",
          "werte": [
            "rostmeute",
            "kontor",
            "raubzug",
            "herrenlos",
            "kustoden"
          ],
          "beschreibung": "Wärter (Fraktion = Besitz-ID); sie sind ruhig, bis die Zellentür knallt"
        },
        "staerke": {
          "typ": "text",
          "default": "klein",
          "werte": [
            "klein",
            "mittel",
            "gross"
          ]
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": {
                  "not": {
                    "v": "{{id}}_besetzt"
                  }
                },
                "do": "besetzen",
                "map": "{{map}}",
                "fraktion": "{{fraktion}}",
                "staerke": "{{staerke}}",
                "haltung": "ruhig",
                "tag": "{{id}}_wache"
              },
              {
                "set": {
                  "{{id}}_besetzt": true
                }
              },
              {
                "do": "team_gefangen",
                "landepunkt": "{{map}}"
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 45,
                "if": {
                  "not": {
                    "flag": "{{id}}_frei"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "beute",
                        "state": "leer"
                      }
                    },
                    {
                      "not": {
                        "flag": "{{id}}_frei"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "setFlag": {
                      "{{id}}_frei": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "zelle",
                "text": "@{{id}}.ziel_zelle",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "zelle",
                        "state": "offen"
                      }
                    },
                    {
                      "flag": "{{id}}_frei"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "flag": "{{id}}_frei"
                }
              },
              {
                "id": "hoch",
                "text": "@{{id}}.ziel_hoch",
                "show": {
                  "flag": "{{id}}_frei"
                },
                "done": {
                  "not": {
                    "check": {
                      "name": "team_down",
                      "map": "{{map}}"
                    }
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    {
                      "flag": "{{id}}_frei"
                    },
                    {
                      "not": {
                        "check": {
                          "name": "team_down",
                          "map": "{{map}}"
                        }
                      }
                    }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "zelle",
                "zustand": "offen"
              },
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "beute",
                "zustand": "leer"
              },
              {
                "setFlag": {
                  "{{id}}_frei": true
                }
              },
              {
                "do": "debug_recall_all",
                "map": "{{map}}"
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_hoch": "Zurück an Bord beamen (Abholpunkt)",
          "{{id}}.start": "Ihr kommt {{lex.zelle:im}} zu euch. Die Waffen sind weg – sie liegen irgendwo in {{lex.beute:einem}}.",
          "{{id}}.hinweis": "Die Tür gibt nach, wenn ihr dranbleibt. Eure Ausrüstung liegt in {{lex.beute:dem}} – auf der Karte markiert.",
          "{{id}}.geschafft": "Ausrüstung zurück! Jetzt zum Abholpunkt.",
          "{{id}}.ziel_zelle": "{{lex.zelle:den}} von innen öffnen (E halten, laut)",
          "{{id}}.ziel": "Ausrüstung holen (E halten)"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "splitter",
          "map": "splitter.schuerflager",
          "fraktion": "rostmeute"
        }
      }
    }
  ],
  "quelle": "CONTRACT-B2 §4/§7, INHALT §9.2, CONTRACT-W1 §5.4 Nr. 5"
}
