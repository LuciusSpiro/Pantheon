{
  "format": "molekuel/1",
  "id": "ausbruch",
  "name": "Ausbruch",
  "familie": "kampf",
  "kern": "Aus der Gefangenschaft freikommen und die Ausrüstung zurückholen",
  "ansaetze": [
    "gewalt",
    "heimlich"
  ],
  "szenentypen": [
    "C8"
  ],
  "umsetzungen": [
    {
      "id": "zelle_und_kammer",
      "name": "Aus der Zelle, Ausrüstung holen, raus",
      "schauplatz": "aussen",
      "beschreibung": "Das Team kommt in der Zelle zu sich, ohne Waffen. Zelle von innen öffnen (laut, alarmiert), Ausrüstung an der Truhe holen (E halten), dann zum Abholpunkt. Nur als Folge von teamGefangen oder als Szene mit Startbedingung.",
      "braucht": [
        "transfer",
        "gefangenschaft",
        "aussen_kampf"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten",
          "station",
          "schiff"
        ],
        "anker": [
          "zelle",
          "beute",
          "abholpunkt"
        ]
      },
      "dauer_min": [
        4,
        6
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          5,
          7
        ],
        "2": [
          4,
          6
        ],
        "3": [
          4,
          6
        ]
      },
      "liefert_flags": [
        "{{id}}_frei"
      ],
      "ereignisse": [
        "teamGefangen",
        "gefangen",
        "alarm"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 45,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "beute",
                        "state": "leer"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_frei": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              },
              {
                "id": "zelle",
                "text": "@{{id}}.ziel_zelle",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "zelle",
                        "state": "offen"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "hoch",
                "text": "@{{id}}.ziel_hoch",
                "show": {
                  "v": "{{id}}_ende"
                },
                "done": {
                  "not": {
                    "check": {
                      "name": "team_down",
                      "map": "{{map}}"
                    }
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    {
                      "v": "{{id}}_ende"
                    },
                    {
                      "not": {
                        "check": {
                          "name": "team_down",
                          "map": "{{map}}"
                        }
                      }
                    }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "zelle",
                "zustand": "offen"
              },
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "beute",
                "zustand": "leer"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_frei": true
                }
              },
              {
                "do": "debug_recall_all",
                "map": "{{map}}"
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Ihr kommt {{lex.zelle:im}} zu euch. Die Waffen sind weg – sie liegen irgendwo in {{lex.beute:einem}}.",
          "{{id}}.hinweis": "Captain: {{lex.beute:der}} mit eurer Ausrüstung ist auf der Außenteam-Karte markiert.",
          "{{id}}.geschafft": "Ausrüstung zurück! Jetzt zum Abholpunkt.",
          "{{id}}.ziel_zelle": "{{lex.zelle:den}} von innen öffnen (E halten, laut)",
          "{{id}}.ziel": "Ausrüstung holen (E halten)"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "hafen",
          "map": "hafen.kontor"
        }
      }
    }
  ],
  "quelle": "CONTRACT-B2 §4/§7, INHALT §9.2"
}
