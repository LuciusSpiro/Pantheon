{
  "format": "molekuel/1",
  "id": "ausschlachten",
  "name": "Ausschlachten",
  "familie": "bergen_und_sichern",
  "kern": "Ersatzteile oder Rohstoffe aus einem Wrack holen",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "A11",
    "C1",
    "C9"
  ],
  "umsetzungen": [
    {
      "id": "wrack_container",
      "name": "Container im Wrack bergen",
      "schauplatz": "aussen",
      "beschreibung": "Ein Wrack bzw. verfallenes Schiff oder eine aufgegebene Station: Das Außenteam sucht im Halbdunkel die Bergungskisten, öffnet sie (E halten) und kommt zu den Pads zurück. Der Captain sieht von oben, wo noch etwas liegt. Ruhig, mit Stimmung; nach einer Weile lässt man den Rest liegen. Am besten auf verfallenen Landepunkten.",
      "braucht": [
        "transfer",
        "aussen_objekte"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "wreck",
          "schiff",
          "station"
        ],
        "anker": [
          "beute"
        ],
        "min": {
          "beute": 3
        }
      },
      "dauer_min": [
        3,
        5
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          5,
          7
        ],
        "2": [
          4,
          5
        ],
        "3": [
          3,
          4
        ]
      },
      "liefert_flags": [
        "{{id}}_alles",
        "{{id}}_genug"
      ],
      "ereignisse": [
        "wreckSalvage",
        "beuteGeborgen",
        "beamedUp"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "zuruecksetzen": {
          "typ": "bool",
          "default": true,
          "beschreibung": "Karte vorher zurücksetzen (map_reset) – nur false, wenn eine frühere Szene der Mission sie schon zurückgesetzt hat oder die Karte neu ist"
        },
        "grund": {
          "typ": "text",
          "default": "Ortung: Seit eurem letzten Besuch ist neues Treibgut ins Wrack gedriftet – frische Container.",
          "beschreibung": "Erzählte Begründung für das Zurücksetzen (ODA, ≤ 120 Zeichen)"
        },
        "aufgeben_nach": {
          "typ": "zahl",
          "default": 300,
          "min": 120,
          "max": 480
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": "{{zuruecksetzen}}",
                "do": "map_reset",
                "map": "{{map}}",
                "grund": "@{{id}}.grund"
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 70,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "beute",
                        "state": "leer",
                        "all": true
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_alles": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              },
              {
                "if": {
                  "all": [
                    {
                      "elapsed": "{{aufgeben_nach}}"
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_genug": true
                    }
                  },
                  {
                    "oda": "@{{id}}.genug"
                  }
                ],
                "garantie": "zeitlimit"
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              },
              {
                "id": "hoch",
                "text": "@{{id}}.ziel_hoch",
                "show": {
                  "v": "{{id}}_ende"
                },
                "done": {
                  "not": {
                    "check": {
                      "name": "team_down",
                      "map": "{{map}}"
                    }
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    {
                      "v": "{{id}}_ende"
                    },
                    {
                      "not": {
                        "check": {
                          "name": "team_down",
                          "map": "{{map}}"
                        }
                      }
                    }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_alles": true
                }
              },
              {
                "do": "debug_recall_all",
                "map": "{{map}}"
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.grund": "{{grund}}",
          "{{id}}.start": "Außenteam auf die Pads. Drinnen ist es dunkel – Captain: Reiter „Außenteam“ zeigt die Kisten.",
          "{{id}}.hinweis": "Captain: die Kisten auf der Außenteam-Karte ansagen. Unten: hingehen, E halten, dann zurück zu den Pads.",
          "{{id}}.geschafft": "Alles geborgen! Zurück zu den Pads, dann holen wir euch hoch.",
          "{{id}}.genug": "Genug gewühlt – den Rest lassen wir liegen. Zurück zu den Pads.",
          "{{id}}.ziel": "Bergungsgut bergen (E halten)"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "vaelen",
          "map": "vaelen.handelsschiff",
          "zuruecksetzen": false
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md; Umsetzung S2 (CONTRACT-S2 §6), Container aus dem Nebenauftrag Zaunkönig"
}
