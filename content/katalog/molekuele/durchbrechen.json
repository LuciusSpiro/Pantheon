{
  "format": "molekuel/1",
  "id": "durchbrechen",
  "name": "Durchbrechen",
  "familie": "kampf",
  "kern": "Durch eine Sperre kommen, ohne alles zu bekämpfen",
  "ansaetze": [
    "gewalt",
    "heimlich",
    "reden"
  ],
  "szenentypen": [
    "A6",
    "A7",
    "C7",
    "C2"
  ],
  "umsetzungen": [
    {
      "id": "bis_zum_ziel",
      "name": "Vom Eingang bis ins Ziel",
      "schauplatz": "aussen",
      "beschreibung": "Wache Besetzung, kein Schleichen: Vom Eingang aus kämpft sich das Team in den Zielbereich durch. Nicht alles bekämpfen – Deckung, Flanke, durch.",
      "braucht": [
        "transfer",
        "aussen_kampf"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten",
          "station",
          "ruine",
          "schiff"
        ],
        "anker": [
          "eingang",
          "wache"
        ],
        "gefecht": true
      },
      "dauer_min": [
        3,
        5
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          5,
          7
        ],
        "2": [
          4,
          6
        ],
        "3": [
          3,
          5
        ]
      },
      "liefert_flags": [
        "{{id}}_durch"
      ],
      "ereignisse": [
        "alarm",
        "droneKilled"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "fraktion": {
          "typ": "text",
          "default": "rostmeute",
          "werte": [
            "rostmeute",
            "kontor",
            "raubzug",
            "herrenlos",
            "kustoden"
          ],
          "beschreibung": "Besitzer bzw. Gegner (Fraktion = Besitz-ID); Rollen kommen aus den Trupp-Rezepten der Fraktion"
        },
        "staerke": {
          "typ": "text",
          "default": "mittel",
          "werte": [
            "klein",
            "mittel",
            "gross"
          ]
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": {
                  "not": {
                    "v": "{{id}}_besetzt"
                  }
                },
                "do": "besetzen",
                "map": "{{map}}",
                "fraktion": "{{fraktion}}",
                "staerke": "{{staerke}}",
                "haltung": "wach",
                "tag": "{{id}}_sperre"
              },
              {
                "set": {
                  "{{id}}_besetzt": true
                }
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 50,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "team_im_bereich",
                        "map": "{{map}}",
                        "bereich": "ziel"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_durch": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_durch": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Sie wissen, dass ihr kommt. {{lex.eingang_laut:vom}} aus durch bis ins Ziel.",
          "{{id}}.hinweis": "Captain: Zielbereich ist auf der Außenteam-Karte markiert. Nicht stehen bleiben – Deckung zu Deckung.",
          "{{id}}.geschafft": "Ihr seid durch!",
          "{{id}}.ziel": "In den Zielbereich durchbrechen"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "kesh",
          "map": "kesh.kastell"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
