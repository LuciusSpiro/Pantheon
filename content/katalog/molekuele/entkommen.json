{
  "format": "molekuel/1",
  "id": "entkommen",
  "name": "Entkommen",
  "familie": "kampf",
  "kern": "Weg, bis der Sprung geladen ist oder der Abholpunkt erreicht",
  "ansaetze": [
    "gewalt",
    "heimlich"
  ],
  "szenentypen": [
    "A6",
    "C7"
  ],
  "umsetzungen": [
    {
      "id": "zu_den_pads",
      "name": "Mit der Beute zu den Pads",
      "schauplatz": "aussen",
      "beschreibung": "Ein Trupp der Fraktion stellt sich in den Weg, das Team schlägt sich mit der Beute zum nächsten Abholpunkt durch und beamt hoch. Kein Game Over: Wer fällt, wird zurückgeholt.",
      "braucht": [
        "transfer",
        "aussen_kampf"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten",
          "station",
          "ruine",
          "schiff",
          "kesh"
        ],
        "anker": [
          "abholpunkt"
        ]
      },
      "dauer_min": [
        2,
        4
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          3,
          5
        ],
        "2": [
          2,
          4
        ],
        "3": [
          2,
          3
        ]
      },
      "liefert_flags": [
        "{{id}}_entkommen"
      ],
      "ereignisse": [
        "beamedUp",
        "alarm"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "gegenstand": {
          "typ": "text",
          "default": "{fund}",
          "beschreibung": "Was das Team trägt, im Nominativ mit Artikel (z. B. „die Legionskasse“). Standard {fund}: Fund der Mission (Aktion fund der Fund-Umsetzungen), sonst „die Beute“"
        },
        "fraktion": {
          "typ": "text",
          "default": "rostmeute",
          "werte": [
            "rostmeute",
            "kontor",
            "raubzug",
            "herrenlos",
            "kustoden"
          ],
          "beschreibung": "Besitzer bzw. Gegner (Fraktion = Besitz-ID); Rollen kommen aus den Trupp-Rezepten der Fraktion"
        },
        "staerke": {
          "typ": "text",
          "default": "klein",
          "werte": [
            "klein",
            "mittel",
            "gross"
          ]
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "wendung": "{{id}}_nachhut",
                "ankuendigung": {
                  "oda": "@{{id}}.nachhut",
                  "art": "gleichzeitig"
                },
                "wirkung": [
                  {
                    "do": "besetzen",
                    "map": "{{map}}",
                    "fraktion": "{{fraktion}}",
                    "staerke": "{{staerke}}",
                    "haltung": "wach",
                    "tag": "{{id}}_nachhut"
                  }
                ]
              }
            ],
            "timers": [
              {
                "at": 45,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "all": [
                        {
                          "check": {
                            "name": "away_active",
                            "map": "{{map}}"
                          }
                        },
                        {
                          "not": {
                            "check": {
                              "name": "team_down",
                              "map": "{{map}}"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_entkommen": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "debug_recall_all",
                "map": "{{map}}"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_entkommen": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.nachhut": "Gegner im Weg! Durchschlagen, dann {{lex.abholpunkt:zum}} und hochbeamen.",
          "{{id}}.hinweis": "Captain: Der nächste Abholpunkt ist auf der Außenteam-Karte markiert. Draufstellen, E halten – wir holen euch.",
          "{{id}}.geschafft": "Alle an Bord. In Sicherheit: {{gegenstand}}!",
          "{{id}}.ziel": "Zurück an Bord (Abholpunkt, hochbeamen), dabei: {{gegenstand}}"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "kesh",
          "map": "kesh.kastell"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
