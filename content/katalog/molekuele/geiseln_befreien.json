{
  "format": "molekuel/1",
  "id": "geiseln_befreien",
  "name": "Geiseln befreien",
  "familie": "helfen",
  "kern": "Gefangene lebend herausholen",
  "ansaetze": [
    "gewalt",
    "heimlich",
    "reden"
  ],
  "szenentypen": [
    "C2",
    "C4",
    "C9"
  ],
  "umsetzungen": [
    {
      "id": "zellen_oeffnen",
      "name": "Zelle öffnen, Geisel zum Pad",
      "schauplatz": "aussen",
      "beschreibung": "Bewacht von der Fraktion sitzt eine Geisel in einer Zelle. Zelle öffnen (E halten), die Person folgt zum Abholpunkt und wird mit hochgebeamt. Leise mit dem Betäuber oder laut, je nach Haltung der Wachen.",
      "braucht": [
        "transfer",
        "aussen_kampf",
        "aussen_objekte"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten",
          "station",
          "schiff"
        ],
        "anker": [
          "zelle",
          "wache",
          "abholpunkt"
        ]
      },
      "dauer_min": [
        4,
        6
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          6,
          8
        ],
        "2": [
          5,
          7
        ],
        "3": [
          4,
          6
        ]
      },
      "liefert_flags": [
        "{{id}}_befreit"
      ],
      "ereignisse": [
        "npcRescued",
        "ankerZustand",
        "alarm"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "fraktion": {
          "typ": "text",
          "default": "rostmeute",
          "werte": [
            "rostmeute",
            "kontor",
            "raubzug",
            "herrenlos",
            "kustoden"
          ],
          "beschreibung": "Besitzer bzw. Gegner (Fraktion = Besitz-ID); Rollen kommen aus den Trupp-Rezepten der Fraktion"
        },
        "staerke": {
          "typ": "text",
          "default": "klein",
          "werte": [
            "klein",
            "mittel",
            "gross"
          ]
        },
        "haltung": {
          "typ": "text",
          "default": "ruhig",
          "werte": [
            "ruhig",
            "wach"
          ]
        },
        "name": {
          "typ": "text",
          "default": "die Geisel",
          "beschreibung": "Name der Person (höchstens 24 Zeichen)"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": {
                  "not": {
                    "v": "{{id}}_besetzt"
                  }
                },
                "do": "besetzen",
                "map": "{{map}}",
                "fraktion": "{{fraktion}}",
                "staerke": "{{staerke}}",
                "haltung": "{{haltung}}",
                "tag": "{{id}}_wache"
              },
              {
                "if": {
                  "not": {
                    "v": "{{id}}_besetzt"
                  }
                },
                "do": "spawn_person",
                "map": "{{map}}",
                "person": "{{id}}_geisel",
                "name": "{{name}}",
                "verletzt": false,
                "anker": "zelle"
              },
              {
                "set": {
                  "{{id}}_besetzt": true
                }
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 70,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "person_rescued",
                        "map": "{{map}}",
                        "person": "{{id}}_geisel"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_befreit": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              },
              {
                "id": "zelle",
                "text": "@{{id}}.ziel_zelle",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "zelle",
                        "state": "offen"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "hoch",
                "text": "@{{id}}.ziel_hoch",
                "show": {
                  "v": "{{id}}_ende"
                },
                "done": {
                  "not": {
                    "check": {
                      "name": "team_down",
                      "map": "{{map}}"
                    }
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    {
                      "v": "{{id}}_ende"
                    },
                    {
                      "not": {
                        "check": {
                          "name": "team_down",
                          "map": "{{map}}"
                        }
                      }
                    }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "zelle",
                "zustand": "offen"
              },
              {
                "do": "debug_rescue_person",
                "map": "{{map}}",
                "person": "{{id}}_geisel"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_befreit": true
                }
              },
              {
                "do": "debug_recall_all",
                "map": "{{map}}"
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Unten sitzt {{name}} {{lex.zelle:im}}. Wachen sind da – leise geht, laut auch.",
          "{{id}}.hinweis": "Captain: {{lex.zelle:der}} ist auf der Außenteam-Karte markiert. Öffnen (E halten), dann gemeinsam zum Abholpunkt.",
          "{{id}}.geschafft": "{{name}} ist an Bord!",
          "{{id}}.ziel_zelle": "{{lex.zelle:den}} öffnen (E halten)",
          "{{id}}.ziel": "{{name}} zum Abholpunkt bringen"
        },
        "besetzung": {
          "stimmen": {
            "{{id}}_geisel": {
              "name": "{{name}}"
            }
          }
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "hafen",
          "map": "hafen.kontor"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
