{
  "format": "molekuel/1",
  "id": "krise_eindaemmen",
  "name": "Krise eindämmen",
  "familie": "helfen",
  "kern": "Brand, Leck, Reaktor, Seuche auf fremder Station oder an Bord",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "B1",
    "C1"
  ],
  "umsetzungen": [
    {
      "id": "ventile",
      "name": "Ventile schließen",
      "schauplatz": "aussen",
      "beschreibung": "Der Reaktor geht durch: Steuerpunkte (Ventile) verteilt im Reaktorbereich, jeweils E halten. Aufteilen – nach 90 s ist es vorbei, ob alle zu sind oder nicht (Flag _gehalten bzw. _teilweise).",
      "braucht": [
        "transfer",
        "aussen_objekte"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "station",
          "schiff"
        ],
        "anker": [
          "ziel"
        ],
        "min": {
          "ziel": 3
        }
      },
      "dauer_min": [
        3,
        4
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          4,
          5
        ],
        "2": [
          3,
          4
        ],
        "3": [
          3,
          4
        ]
      },
      "liefert_flags": [
        "{{id}}_gehalten",
        "{{id}}_teilweise"
      ],
      "ereignisse": [
        "ankerZustand"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "frist": {
          "typ": "zahl",
          "default": 90,
          "min": 60,
          "max": 180,
          "beschreibung": "Sekunden ab Szenenbeginn"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 30,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "ziel",
                        "state": "aktiviert",
                        "all": true
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_gehalten": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              },
              {
                "if": {
                  "all": [
                    {
                      "elapsed": "{{frist}}"
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_teilweise": true
                    }
                  },
                  {
                    "oda": "@{{id}}.knapp"
                  }
                ],
                "garantie": "zeitlimit"
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "ziel",
                "zustand": "aktiviert"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_gehalten": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Druck steigt! Die Ventile sind verteilt – aufteilen und jeweils E halten. Ihr habt {{frist}} Sekunden.",
          "{{id}}.hinweis": "Captain: Die Ventile sind auf der Außenteam-Karte markiert. Jeder nimmt eins!",
          "{{id}}.geschafft": "Alle Ventile zu. Der Druck fällt.",
          "{{id}}.knapp": "Zeit um – das Schlimmste ist vorbei, aber nicht alles hat gehalten.",
          "{{id}}.ziel": "Ventile schließen (E halten)"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "vaelen",
          "map": "vaelen.handelsschiff"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
