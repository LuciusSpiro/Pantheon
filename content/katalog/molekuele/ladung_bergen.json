                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "fund",
                        "state": "genommen",
                        "min": "{{anzahl}}"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_geborgen": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft",
                    "fund": "{{fund_name}}"
                  }
                ]
              },
              {
                "if": {
                  "all": [
                    {
                      "elapsed": "{{aufgeben_nach}}"
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_genug": true
                    }
                  },
                  {
                    "oda": "@{{id}}.genug"
                  }
                ],
                "garantie": "zeitlimit"
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              },
              {
                "id": "hoch",
                "text": "@{{id}}.ziel_hoch",
                "show": {
                  "v": "{{id}}_ende"
                },
                "done": {
                  "not": {
                    "check": {
                      "name": "team_down",
                      "map": "{{map}}"
                    }
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    {
                      "v": "{{id}}_ende"
                    },
                    {
                      "not": {
                        "check": {
                          "name": "team_down",
                          "map": "{{map}}"
                        }
                      }
                    }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "fund",
                "zustand": "genommen"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_geborgen": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Absturzstelle unter euch: {{anzahl}} Fundorte mit Wrackteilen und Vorräten (Außenteam-Karte). Hin, E halten.",
          "{{id}}.hinweis": "Captain: Fundorte auf der Karte markiert, dort liegt {{fund_name}} aus dem Wrack. Hin, E halten, dann zu den Pads.",
          "{{id}}.geschafft": "Das Wichtigste aus dem Wrack ist geborgen! Zurück zu den Pads.",
          "{{id}}.genug": "Genug im Wrack gewühlt – der Rest bleibt liegen. Zurück zu den Pads.",
          "{{id}}.ziel": "Aus dem Wrack bergen (E halten, {{anzahl}} Fundorte): {{fund_name}}"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
