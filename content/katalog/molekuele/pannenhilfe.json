{
  "format": "molekuel/1",
  "id": "pannenhilfe",
  "name": "Pannenhilfe",
  "familie": "helfen",
  "kern": "Fremdes Schiff reparieren (fremde Technik eines anderen Volks)",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "A3",
    "A9"
  ],
  "umsetzungen": [
    {
      "id": "andocken_und_flicken",
      "name": "Längsseits gehen und flicken",
      "schauplatz": "weltraum",
      "beschreibung": "Ein Havarist treibt mit totem Antrieb. Die Steuer bringt die Lerche nah heran und fast zum Stehen, dann flicken die Schrauber den Antrieb von außen (Fortschritt läuft nur nah, langsam und ohne Beschuss). Optional stören Jäger als angekündigte Wendung. Ruhige, präzise Flugarbeit; der Captain hält die Lage im Blick.",
      "braucht": [
        "raumkampf",
        "schuetzling"
      ],
      "dauer_min": [
        2,
        4
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": { "1": [3, 5], "2": [2, 4], "3": [2, 3] },
      "liefert_flags": [
        "{{id}}_heil",
        "{{id}}_beschaedigt",
        "{{id}}_verloren"
      ],
      "ereignisse": [
        "escortSaved",
        "escortDisabled"
      ],
      "params": {
        "loc": { "typ": "loc", "pflicht": true, "beschreibung": "Ort der Szene" },
        "funk_npc": { "typ": "npc", "pflicht": true, "beschreibung": "Wer vom Havaristen funkt" },
        "kind": { "typ": "kind", "default": "bergungsboot", "werte": ["frachter", "karawane", "bergungsboot"] },
        "name": { "typ": "text", "default": "Bergungsboot" },
        "huelle": { "typ": "zahl", "default": 90, "min": 20, "max": 100 },
        "reparatur_s": { "typ": "zahl", "default": 30, "min": 10, "max": 120, "beschreibung": "Sekunden nah und langsam, bis der Antrieb läuft (lang genug, dass der Angriff vorher ankommt)" },
        "mit_angriff": { "typ": "bool", "default": true, "beschreibung": "Angreifer stören die Reparatur (Wendung)" },
        "angriff_nach": { "typ": "zahl", "default": 20, "min": 10, "max": 120 },
        "angriff2_nach": { "typ": "zahl", "default": 40, "min": 20, "max": 180, "beschreibung": "s bis zum Ersatz-Angreifer (nur solange die Reparatur läuft und die erste Welle erledigt ist)" },
        "jaeger": { "typ": "zahl", "default": 1, "min": 1, "max": 2 },
        "angreifer": { "typ": "kind", "default": "gunboat", "werte": ["gunboat", "raider"], "beschreibung": "Schwerer Angreifer auf den Havaristen (lädt angekündigt)" },
        "funk_start": { "typ": "text", "default": "Lerche? Unser Antrieb ist tot, wir treiben. Kommt längsseits – wir brauchen eure Schrauber." },
        "funk_dank": { "typ": "text", "default": "Er läuft! Hört ihr das? Wir schulden euch was, Lerche." }
      },
      "vorlage": {
        "buehne": { "orte": ["{{loc}}"] },
        "besetzung": { "npc": ["{{funk_npc}}"], "schiffe": { "{{id}}": { "kind": "{{kind}}", "name": "{{name}}", "npc": "{{funk_npc}}" } } },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "enter": [
              { "do": "spawn_escort", "tag": "{{id}}", "kind": "{{kind}}", "name": "{{name}}", "npc": "{{funk_npc}}", "verhalten": "treibt", "von": "vorn", "huelle": "{{huelle}}", "reparatur_s": "{{reparatur_s}}" },
              { "after": { "sec": 2, "do": [ { "radio": { "from": "{{funk_npc}}", "text": "@{{id}}.funk_start" } } ] } }
            ],
            "timers": [
              { "at": 0.5, "oda": "@{{id}}.lage" },
              { "at": 50, "if": { "not": { "v": "{{id}}_ende" } }, "oda": "@{{id}}.tipp", "garantie": "hinweis" }
            ],
            "rules": [
              {
                "if": { "all": [ "{{mit_angriff}}", { "elapsed": "{{angriff_nach}}" }, { "not": { "v": "{{id}}_ende" } } ] },
                "do": [
                  {
                    "wendung": "{{id}}_stoerer",
                    "ankuendigung": { "oda": "@{{id}}.ankuendigung", "art": "vorher", "vorlauf_s": 5 },
                    "wirkung": [
                      { "if": { "not": { "v": "{{id}}_ende" } }, "spawn": { "kind": "{{angreifer}}", "tag": "{{id}}_w1", "ziel": "schuetzling", "angles": [2.4] } },
                      { "if": { "not": { "v": "{{id}}_ende" } }, "spawn": { "kind": "raider", "tag": "{{id}}_w1", "n": "{{jaeger}}", "ziel": "auto", "angles": [1.2, -1.4] } }
                    ]
                  }
                ]
              },
              {
                "_kommentar": "Ersatz-Angreifer auf den Havaristen, falls die Reparatur noch läuft und die erste Welle schon erledigt ist (nie zwei Kanonenboote gleichzeitig)",
                "if": { "all": [ "{{mit_angriff}}", { "elapsed": "{{angriff2_nach}}" }, { "enemiesLeft": { "max": 0 } }, { "not": { "v": "{{id}}_ende" } } ] },
                "do": [
                  {
                    "wendung": "{{id}}_stoerer2",
                    "ankuendigung": { "oda": "@{{id}}.ankuendigung", "art": "vorher", "vorlauf_s": 5 },
                    "wirkung": [
                      { "if": { "not": { "v": "{{id}}_ende" } }, "spawn": { "kind": "{{angreifer}}", "tag": "{{id}}_w2", "ziel": "schuetzling", "angles": [-2.2] } }
                    ]
                  }
                ]
              },
              {
                "if": { "all": [ { "event": "escortSaved" }, { "not": { "v": "{{id}}_ende" } } ] },
                "do": [ { "set": { "{{id}}_ende": true } }, { "radio": { "from": "{{funk_npc}}", "text": "@{{id}}.funk_dank" } } ]
              },
              {
                "if": { "all": [ { "check": { "name": "escort_state", "tag": "{{id}}", "state": "kampfunfaehig" } }, { "not": { "v": "{{id}}_ende" } } ] },
                "do": [ { "set": { "{{id}}_ende": true } },{ "do": "enemies_retreat", "unter_pct": 100 }, { "oda": "@{{id}}.verloren" } ]
              },
              {
                "if": { "all": [ { "elapsed": 240 }, { "not": { "v": "{{id}}_ende" } } ] },
                "do": [ { "set": { "{{id}}_ende": true } },{ "do": "enemies_retreat", "unter_pct": 100 }, { "oda": "@{{id}}.aufgegeben" } ],
                "garantie": "zeitlimit"
              },
              {
                "_kommentar": "QA-Abnahme S2b: Havarist geflickt, später doch kampfunfähig – dann setzte keine Regel mehr den Rückzug und ein Kanonenboot konnte die Szene festhalten",
                "if": { "all": [ { "v": "{{id}}_ende" }, { "elapsed": 300 } ] },
                "do": [ { "do": "enemies_retreat", "unter_pct": 100 } ],
                "garantie": "autoloesung"
              }
            ],
            "objectives": [
              { "id": "flicken", "text": "@{{id}}.ziel", "done": { "v": "{{id}}_ende" } }
            ],
            "next": [
              { "if": { "all": [ { "v": "{{id}}_ende" }, { "enemiesLeft": { "max": 0 } } ] }, "goto": "{{weiter}}" }
            ],
            "skip": [
              { "do": "debug_clear_enemies" },
              { "set": { "{{id}}_ende": true } }
            ]
          }
        ],
        "texte": {
          "{{id}}.funk_start": "{{funk_start}}",
          "{{id}}.funk_dank": "{{funk_dank}}",
          "{{id}}.lage": "{{name}} treibt. Steuer: nah ran und fast stehen bleiben – dann flicken die Schrauber.",
          "{{id}}.tipp": "Reparatur läuft nur nah, langsam und ohne Beschuss. Steuer: Tempo auf null, Bug zum Havaristen.",
          "{{id}}.ankuendigung": "Ortung: Angreifer halten auf den Havaristen zu! Reparatur pausiert unter Beschuss – dazwischen.",
          "{{id}}.verloren": "{{name}} ist kampfunfähig. Die Besatzung steigt in die Kapseln – wir melden es dem Hafen.",
          "{{id}}.aufgegeben": "Fremde Technik, keine Chance. Wir funken einen Schlepper vom Hafen herbei.",
          "{{id}}.ziel": "{{name}} flicken: längsseits gehen und stillhalten"
        }
      },
      "rueckfall": {
        "params": {
          "kind": "bergungsboot",
          "name": "Bergungsboot",
          "funk_start": "Lerche? Unser Antrieb ist tot, wir treiben. Kommt längsseits – wir brauchen eure Schrauber.",
          "funk_dank": "Er läuft! Hört ihr das? Wir schulden euch was, Lerche."
        }
      },
      "test": {
        "params": {
          "loc": "splitter",
          "funk_npc": "sela",
          "mit_angriff": true
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md; Umsetzung S2 (CONTRACT-S2 §6)"
}
