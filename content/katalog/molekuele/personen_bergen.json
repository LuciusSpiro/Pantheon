{
  "format": "molekuel/1",
  "id": "personen_bergen",
  "name": "Personen bergen",
  "familie": "bergen_und_sichern",
  "kern": "Schiffbrüchige, Verletzte, Verschüttete retten und stabilisieren",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "A11",
    "C9"
  ],
  "umsetzungen": [
    {
      "id": "techniker_retten",
      "name": "Verletzte Person von einer Außenkarte holen",
      "schauplatz": "aussen",
      "beschreibung": "Auf der Außenkarte sitzt eine verletzte Person fest (wie damals Ivo). Das Außenteam nimmt ein Medipack mit, versorgt sie (E halten), sie folgt zu den Pads und wird mit hochgebeamt. Gebaute Karten: am nsc-Platz (Station, Schiff); Handkarten wie bisher. Eine Person je Karte.",
      "braucht": [
        "transfer",
        "aussen_objekte"
      ],
      "dauer_min": [
        2,
        4
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          3,
          5
        ],
        "2": [
          2,
          4
        ],
        "3": [
          2,
          3
        ]
      },
      "liefert_flags": [
        "{{id}}_gerettet",
        "{{id}}_selbst"
      ],
      "ereignisse": [
        "npcRescued",
        "beamedUp"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "name": {
          "typ": "text",
          "default": "Technikerin Arn",
          "beschreibung": "Name der Person (höchstens 24 Zeichen)"
        },
        "verletzt": {
          "typ": "bool",
          "default": true
        },
        "zuruecksetzen": {
          "typ": "bool",
          "default": true,
          "beschreibung": "Karte vorher zurücksetzen (map_reset) – false, wenn eine frühere Szene das schon getan hat"
        },
        "grund": {
          "typ": "text",
          "default": "Das Konkordat hat B-7 neu besetzt – Wartung, Drohnen, alles wieder auf Anfang.",
          "beschreibung": "Erzählte Begründung für das Zurücksetzen (ODA, ≤ 120 Zeichen)"
        },
        "funk_person": {
          "typ": "text",
          "default": "Hallo? Ist da oben wer? Mein Bein … ich komme hier nicht allein weg."
        },
        "aufgeben_nach": {
          "typ": "zahl",
          "default": 300,
          "min": 120,
          "max": 480
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "besetzung": {
          "stimmen": {
            "{{id}}_person": {
              "name": "{{name}}"
            }
          }
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": "{{zuruecksetzen}}",
                "do": "map_reset",
                "map": "{{map}}",
                "grund": "@{{id}}.grund"
              },
              {
                "do": "spawn_person",
                "map": "{{map}}",
                "person": "{{id}}_person",
                "name": "{{name}}",
                "verletzt": "{{verletzt}}"
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 6,
                "do": [
                  {
                    "radio": {
                      "from": "{{id}}_person",
                      "text": "@{{id}}.funk_person"
                    }
                  }
                ]
              },
              {
                "at": 70,
                "if": {
                  "not": {
                    "check": {
                      "name": "person_rescued",
                      "map": "{{map}}",
                      "person": "{{id}}_person"
                    }
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "person_rescued",
                        "map": "{{map}}",
                        "person": "{{id}}_person"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_gerettet": true
                    }
                  },
                  {
                    "oda": "@{{id}}.an_bord"
                  }
                ]
              },
              {
                "if": {
                  "all": [
                    {
                      "elapsed": "{{aufgeben_nach}}"
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_selbst": true
                    }
                  },
                  {
                    "oda": "@{{id}}.selbst"
                  }
                ],
                "garantie": "zeitlimit"
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "person",
                "text": "@{{id}}.ziel_person",
                "done": {
                  "v": "{{id}}_ende"
                }
              },
              {
                "id": "hoch",
                "text": "@{{id}}.ziel_hoch",
                "show": {
                  "v": "{{id}}_ende"
                },
                "done": {
                  "not": {
                    "check": {
                      "name": "team_down",
                      "map": "{{map}}"
                    }
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    {
                      "v": "{{id}}_ende"
                    },
                    {
                      "not": {
                        "check": {
                          "name": "team_down",
                          "map": "{{map}}"
                        }
                      }
                    }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "debug_rescue_person",
                "map": "{{map}}",
                "person": "{{id}}_person"
              },
              {
                "do": "debug_skip_away",
                "map": "{{map}}"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_gerettet": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.grund": "{{grund}}",
          "{{id}}.funk_person": "{{funk_person}}",
          "{{id}}.start": "Außenteam: Medipack aus dem Lager mitnehmen, dann auf die Pads. Unten wartet {{name}}.",
          "{{id}}.hinweis": "Captain: {{name}} ist auf der Außenteam-Karte markiert. Medipack, E halten, dann gemeinsam zu den Pads.",
          "{{id}}.an_bord": "{{name}} ist an Bord. Bordarzt haben wir keinen, aber Tee.",
          "{{id}}.selbst": "{{name}} hat sich allein zu den Pads geschleppt. Wir holen alle hoch.",
          "{{id}}.ziel_runter": "Außenteam runterbeamen (Medipack!)",
          "{{id}}.ziel_person": "{{name}} versorgen und an Bord bringen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "b7",
          "map": "platform"
        }
      },
      "buehne_braucht": {
        "kartenarten": [
          "platform",
          "wreck",
          "kesh",
          "station",
          "schiff"
        ],
        "anker": [
          "abholpunkt"
        ]
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md; Umsetzung S2 (CONTRACT-S2 §6), Verallgemeinerung von Ivo (m1)"
}
