{
  "format": "molekuel/1",
  "id": "probe_nehmen",
  "name": "Probe nehmen",
  "familie": "bergen_und_sichern",
  "kern": "Probe unter Gefahr sammeln und auswerten",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "C1"
  ],
  "umsetzungen": [
    {
      "id": "am_fund",
      "name": "Probe aus dem Gewölbe",
      "schauplatz": "aussen",
      "beschreibung": "Im Kastell lagert etwas, das jemand untersuchen will (Vorratsamphore, Kassenstaub, Mauerprobe). Hingehen, E halten, Probe genommen. Kurz; passt vor oder nach einem Gefecht.",
      "braucht": [
        "transfer",
        "aussen_objekte"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "ruine"
        ],
        "anker": [
          "beute"
        ]
      },
      "dauer_min": [
        2,
        3
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          2,
          4
        ],
        "2": [
          2,
          3
        ],
        "3": [
          2,
          3
        ]
      },
      "liefert_flags": [
        "{{id}}_probe"
      ],
      "ereignisse": [
        "beuteGeborgen"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "probe_name": {
          "typ": "text",
          "default": "eine Probe",
          "beschreibung": "Was genommen wird"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 45,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "beute",
                        "state": "leer"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_probe": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft",
                    "fund": "{{probe_name}}"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "beute",
                "zustand": "leer"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_probe": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Gesucht: {{probe_name}} aus {{lex.beute:einem}}. Hingehen, E halten.",
          "{{id}}.hinweis": "Captain: Die {{lex.beute:pl}} sind auf der Außenteam-Karte markiert.",
          "{{id}}.geschafft": "{{probe_name}} ist eingepackt.",
          "{{id}}.ziel": "{{probe_name}} nehmen (E halten)"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "kesh",
          "map": "kesh.kastell"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
