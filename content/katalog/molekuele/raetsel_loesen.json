{
  "format": "molekuel/1",
  "id": "raetsel_loesen",
  "name": "Rätsel lösen",
  "familie": "erkunden_und_forschen",
  "kern": "Mechanismus, Glyphen, Licht",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "C5"
  ],
  "umsetzungen": [
    {
      "id": "zwei_schluessel",
      "name": "Tor nur zu zweit zu öffnen",
      "schauplatz": "aussen",
      "beschreibung": "Ein Rätselpaar (zwei Schlösser weit auseinander) muss gleichzeitig gehalten werden, dann öffnet sich das Tor. Ruhiger Moment nach einem Gefecht: Absprache und Anzählen. In der Ruine ist es das Zwei-Offiziers-Schloss der Legionskasse, auf Kesh die Kustoden-Schlüssel.",
      "braucht": [
        "transfer",
        "aussen_objekte"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "ruine",
          "kesh"
        ],
        "anker": [
          {
            "rolle": "raetsel",
            "paar": 1
          },
          "tor"
        ]
      },
      "dauer_min": [
        1,
        3
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          2,
          4
        ],
        "2": [
          1,
          3
        ],
        "3": [
          1,
          2
        ]
      },
      "liefert_flags": [
        "{{id}}_offen"
      ],
      "ereignisse": [
        "raetselGeloest",
        "vaultOpened",
        "ankerZustand"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "funk_npc": {
          "typ": "npc",
          "default": "tesk"
        },
        "funk_tipp": {
          "typ": "text",
          "default": "{{lex.raetsel_tipp}}",
          "beschreibung": "Funkhinweis; Standard aus dem Lexikon der Bauweise"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 5,
                "radio": {
                  "from": "{{funk_npc}}",
                  "text": "@{{id}}.tipp"
                }
              },
              {
                "at": 60,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "tor",
                        "state": "offen"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_offen": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "tor",
                "zustand": "offen"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_offen": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Ruhe. {{lex.schluessel}}: zwei Schlösser, weit getrennt. Beide zugleich E halten – dann öffnet sich {{lex.tor:der}}.",
          "{{id}}.tipp": "{{funk_tipp}}",
          "{{id}}.hinweis": "Captain: Die beiden Schlösser sind auf der Außenteam-Karte markiert. Aufteilen, anzählen, dann beide E!",
          "{{id}}.geschafft": "Beide gleichzeitig – {{lex.tor:der}} ist offen!",
          "{{id}}.ziel": "Beide Schlösser gleichzeitig halten (E)"
        },
        "besetzung": {
          "npc": [
            "{{funk_npc}}"
          ]
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "kesh",
          "map": "kesh.kastell"
        }
      }
    },
    {
      "id": "sonden_code",
      "name": "Sonden-Code: Captain sieht die Tabelle",
      "schauplatz": "aussen",
      "beschreibung": "Eine Sonde steuert Wachdrohnen. Unten sieht das Außenteam Symbole, oben hat der Captain die Codetabelle: Nur zusammen schaltet man die Sonde ab. Wissen aufteilen in Reinform. Heute nur auf B-7 (Plattform).",
      "braucht": [
        "transfer",
        "aussen_objekte",
        "wissen_aufteilen"
      ],
      "dauer_min": [
        2,
        4
      ],
      "ereignisse": [
        "sondeDisabled"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true,
          "werte": [
            "b7"
          ]
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "werte": [
            "platform"
          ]
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ],
          "objekte": {
            "{{map}}": [
              "sonde"
            ]
          }
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "timers": [
              {
                "at": 0.5,
                "oda": "@{{id}}.start"
              },
              {
                "at": 40,
                "if": {
                  "not": {
                    "check": {
                      "name": "object_state",
                      "map": "{{map}}",
                      "object": "sonde",
                      "state": "off"
                    }
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "check": {
                    "name": "away_active",
                    "map": "{{map}}"
                  }
                }
              },
              {
                "id": "sonde",
                "text": "@{{id}}.ziel_sonde",
                "show": {
                  "check": {
                    "name": "away_active",
                    "map": "{{map}}"
                  }
                },
                "done": {
                  "check": {
                    "name": "object_state",
                    "map": "{{map}}",
                    "object": "sonde",
                    "state": "off"
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "check": {
                    "name": "object_state",
                    "map": "{{map}}",
                    "object": "sonde",
                    "state": "off"
                  }
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "debug_skip_away",
                "map": "{{map}}"
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.start": "Außenteam auf die Pads. Die Sonde unten steuert die Drohnen – den Code hat der Captain oben.",
          "{{id}}.hinweis": "Captain: Reiter „Außenteam“ zeigt die Codetabelle. Unten: Symbole ansagen, oben: Farben durchgeben.",
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_sonde": "Sonde abschalten (Code vom Captain)"
        }
      },
      "test": {
        "params": {
          "loc": "b7",
          "map": "platform"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
