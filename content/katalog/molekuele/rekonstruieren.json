{
  "format": "molekuel/1",
  "id": "rekonstruieren",
  "name": "Rekonstruieren",
  "familie": "erkunden_und_forschen",
  "kern": "„Was ist hier passiert?“ aus Logs und Spuren",
  "ansaetze": [
    "technik"
  ],
  "szenentypen": [
    "C1"
  ],
  "umsetzungen": [
    {
      "id": "wrack_logbuch",
      "name": "Logbuch lesen",
      "schauplatz": "aussen",
      "beschreibung": "Ein Logbuch-Terminal (Ruine: Wachbuch) erzählt, was hier passiert ist. E halten, bis es ausgelesen ist. Optional ein Versteck hinter einer dünnen Wand, das nur ein Weitscan aus dem Orbit verrät – nur, wenn die Karte eins hat (mit_versteck). Ruhige Erkundung, Stimmung statt Kampf.",
      "braucht": [
        "transfer",
        "aussen_objekte",
        "weitscan"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "wreck",
          "schiff",
          "station",
          "ruine"
        ],
        "anker": [
          "terminal"
        ]
      },
      "dauer_min": [
        2,
        4
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          3,
          5
        ],
        "2": [
          2,
          4
        ],
        "3": [
          2,
          3
        ]
      },
      "liefert_flags": [
        "{{id}}_gelesen"
      ],
      "ereignisse": [
        "wreckLore",
        "ankerGelesen",
        "ankerZustand"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "mit_versteck": {
          "typ": "bool",
          "default": false,
          "beschreibung": "Optionales Ziel Versteck (nur, wenn die Karte einen versteck-Anker hat: Wrack, Station, Kriegsschiff)"
        },
        "was": {
          "typ": "text",
          "default": "Das Logbuch erzählt von einem Überfall – die Besatzung hat es nicht mehr hinausgeschafft.",
          "beschreibung": "Was das Logbuch erzählt (ODA, ≤ 120 Zeichen)"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 60,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "anker_state",
                        "map": "{{map}}",
                        "anker": "terminal",
                        "state": "geladen"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_gelesen": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              },
              {
                "id": "versteck",
                "text": "@{{id}}.ziel_versteck",
                "optional": true,
                "show": "{{mit_versteck}}",
                "done": {
                  "check": {
                    "name": "anker_state",
                    "map": "{{map}}",
                    "anker": "versteck",
                    "state": "offen"
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "terminal",
                "zustand": "geladen"
              },
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_gelesen": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Unten ist es still. {{lex.terminal:ein}} wartet – und ein Weitscan zeigt vielleicht mehr.",
          "{{id}}.hinweis": "Captain: {{lex.terminal:der}} ist auf der Außenteam-Karte markiert. Hingehen, E halten, bis alles ausgelesen ist.",
          "{{id}}.geschafft": "{{was}}",
          "{{id}}.ziel": "{{lex.terminal:den}} auslesen (E halten)",
          "{{id}}.ziel_versteck": "Versteck finden (Weitscan) und öffnen"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "hafen",
          "map": "hafen.kontor"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
