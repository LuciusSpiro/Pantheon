{
  "format": "molekuel/1",
  "id": "stellung_nehmen",
  "name": "Stellung nehmen",
  "familie": "kampf",
  "kern": "Ort erobern und sichern",
  "ansaetze": [
    "gewalt"
  ],
  "szenentypen": [
    "A5",
    "C2"
  ],
  "umsetzungen": [
    {
      "id": "trupp_raeumen",
      "name": "Trupp ausschalten oder durchbrechen",
      "schauplatz": "aussen",
      "beschreibung": "Die Fraktion besetzt den Gefechtsbereich (Trupps aus ihren Rezepten an den Wachposten). Deckung suchen, Schilde laden lassen, zusammen vorrücken; der Captain gibt von oben Befehle und sieht Gegner. Erledigt, wenn jemand in den Zielbereich durchbricht.",
      "braucht": [
        "transfer",
        "aussen_kampf"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten",
          "station",
          "ruine",
          "schiff"
        ],
        "anker": [
          "wache"
        ],
        "min": {
          "wache": 2
        },
        "gefecht": true
      },
      "dauer_min": [
        3,
        5
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          5,
          7
        ],
        "2": [
          4,
          6
        ],
        "3": [
          3,
          5
        ]
      },
      "liefert_flags": [
        "{{id}}_geraeumt"
      ],
      "ereignisse": [
        "droneKilled",
        "playerWounded",
        "alarm"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "fraktion": {
          "typ": "text",
          "default": "rostmeute",
          "werte": [
            "rostmeute",
            "kontor",
            "raubzug",
            "herrenlos",
            "kustoden"
          ],
          "beschreibung": "Besitzer bzw. Gegner (Fraktion = Besitz-ID); Rollen kommen aus den Trupp-Rezepten der Fraktion"
        },
        "staerke": {
          "typ": "text",
          "default": "mittel",
          "werte": [
            "klein",
            "mittel",
            "gross"
          ]
        },
        "haltung": {
          "typ": "text",
          "default": "wach",
          "werte": [
            "ruhig",
            "wach"
          ]
        },
        "durchbruch": {
          "typ": "text",
          "default": "ziel",
          "werte": [
            "ziel",
            "rueckzug",
            "hinein"
          ],
          "beschreibung": "Bereich (Rolle), dessen Erreichen als Durchbruch zählt"
        },
        "lage": {
          "typ": "text",
          "default": "Gegner vor euch. Deckung suchen, Schilde laden lassen, zusammen vorrücken."
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": {
                  "not": {
                    "v": "{{id}}_besetzt"
                  }
                },
                "do": "besetzen",
                "map": "{{map}}",
                "fraktion": "{{fraktion}}",
                "staerke": "{{staerke}}",
                "haltung": "{{haltung}}",
                "tag": "{{id}}_trupp"
              },
              {
                "set": {
                  "{{id}}_besetzt": true
                }
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 4,
                "oda": "@{{id}}.lage"
              },
              {
                "at": 40,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "any": [
                        {
                          "check": {
                            "name": "trupp_geraeumt",
                            "map": "{{map}}",
                            "tag": "{{id}}_trupp"
                          }
                        },
                        {
                          "check": {
                            "name": "team_im_bereich",
                            "map": "{{map}}",
                            "bereich": "{{durchbruch}}"
                          }
                        }
                      ]
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_geraeumt": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_geraeumt": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Außenteam unten. Captain: Reiter „Außenteam“ – Befehle setzen, Sensor und Kuppel.",
          "{{id}}.lage": "{{lage}}",
          "{{id}}.hinweis": "Captain: Ihr seid die Augen von oben. Flanke ansagen, dann gemeinsam durchbrechen.",
          "{{id}}.geschafft": "Durchgebrochen! Der Weg ist frei.",
          "{{id}}.ziel": "Gegner ausschalten oder in den Zielbereich durchbrechen"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "splitter",
          "map": "splitter.schuerflager"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md"
}
