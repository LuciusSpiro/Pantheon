{
  "format": "molekuel/1",
  "id": "stellung_nehmen",
  "name": "Stellung nehmen",
  "familie": "kampf",
  "kern": "Ort erobern und sichern",
  "ansaetze": [
    "gewalt"
  ],
  "szenentypen": [
    "A5",
    "C2"
  ],
  "umsetzungen": [
    {
      "id": "trupp_raeumen",
      "name": "Trupp ausschalten oder durchbrechen",
      "schauplatz": "aussen",
      "beschreibung": "Die Fraktion besetzt den Gefechtsbereich (Trupps aus ihren Rezepten an den Wachposten). Deckung suchen, Schilde laden lassen, zusammen vorrücken; der Captain gibt von oben Befehle und sieht Gegner. Erledigt, wenn jemand in den Zielbereich durchbricht.",
      "braucht": [
        "transfer",
        "aussen_kampf"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten",
          "station",
          "ruine",
          "schiff"
        ],
        "anker": [
          "wache"
        ],
        "min": {
          "wache": 2
        },
        "gefecht": true
      },
      "dauer_min": [
        3,
        5
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          5,
          7
        ],
        "2": [
          4,
          6
        ],
        "3": [
          3,
          5
        ]
      },
      "liefert_flags": [
        "{{id}}_geraeumt"
      ],
      "ereignisse": [
        "droneKilled",
        "playerWounded",
        "alarm"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "fraktion": {
          "typ": "text",
          "default": "rostmeute",
          "werte": [
            "rostmeute",
            "kontor",
            "raubzug",
            "herrenlos",
            "kustoden",
            "rom",
            "ger"
          ],
          "beschreibung": "Besitzer bzw. Gegner (Fraktion = Besitz-ID); Rollen kommen aus den Trupp-Rezepten der Fraktion"
        },
        "staerke": {
          "typ": "text",
          "default": "mittel",
          "werte": [
            "klein",
            "mittel",
            "gross"
          ]
        },
        "haltung": {
          "typ": "text",
          "default": "wach",
          "werte": [
            "ruhig",
            "wach"
          ]
        },
        "durchbruch": {
          "typ": "text",
          "default": "ziel",
          "werte": [
            "ziel",
            "rueckzug",
            "hinein"
          ],
          "beschreibung": "Bereich (Rolle), dessen Erreichen als Durchbruch zählt"
        },
        "lage": {
          "typ": "text",
          "default": "Gegner vor euch. Deckung suchen, Schilde laden lassen, zusammen vorrücken."
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": {
                  "not": {
                    "v": "{{id}}_besetzt"
                  }
                },
                "do": "besetzen",
                "map": "{{map}}",
                "fraktion": "{{fraktion}}",
                "staerke": "{{staerke}}",
                "haltung": "{{haltung}}",
                "tag": "{{id}}_trupp"
              },
              {
                "set": {
                  "{{id}}_besetzt": true
                }
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 4,
                "oda": "@{{id}}.lage"
              },
              {
                "at": 40,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "any": [
                        {
                          "check": {
                            "name": "trupp_geraeumt",
                            "map": "{{map}}",
                            "tag": "{{id}}_trupp"
                          }
                        },
                        {
                          "check": {
                            "name": "team_im_bereich",
                            "map": "{{map}}",
                            "bereich": "{{durchbruch}}"
                          }
                        }
                      ]
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_geraeumt": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_geraeumt": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Außenteam unten. Captain: Reiter „Außenteam“ – Befehle setzen, Sensor und Kuppel.",
          "{{id}}.lage": "{{lage}}",
          "{{id}}.hinweis": "Captain: Ihr seid die Augen von oben. Flanke ansagen, dann gemeinsam durchbrechen.",
          "{{id}}.geschafft": "Durchgebrochen! Der Weg ist frei.",
          "{{id}}.ziel": "Gegner ausschalten oder in den Zielbereich durchbrechen"
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "splitter",
          "map": "splitter.schuerflager"
        }
      }
    },
    {
      "id": "flagge_hissen",
      "name": "Flagge hissen und Siedlung halten",
      "schauplatz": "aussen",
      "beschreibung": "Das Feldzeichen steht in der Mitte des Dorfplatzes. Zwei Personen hissen es gemeinsam (E halten, der Fortschritt bleibt; lebt nur einer, geht es nicht). Dann greifen 10 Gegner und ein Anführer von allen Seiten an, danach erscheint niemand mehr. Fällt der Anführer, beamen die übrigen raus: Sieg. Fällt die Crew, bringt die Notrückholung sie an Bord, die Siedlung beginnt von vorn (Zerstörtes, Alarm, Feldzeichen unten) und die Szene geht zurück zum Hissen.",
      "braucht": [
        "transfer",
        "aussen_kampf",
        "aussen_objekte"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "aussenposten"
        ],
        "anker": [
          "flagge",
          "abholpunkt"
        ]
      },
      "dauer_min": [
        8,
        15
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "2": [
          9,
          15
        ],
        "3": [
          8,
          13
        ]
      },
      "liefert_flags": [
        "{{id}}_gesiegt",
        "{{id}}_gefallen"
      ],
      "ereignisse": [
        "flaggeGehisst",
        "endkampfAngriff",
        "gegnerAbgezogen",
        "squadRecall"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM): Siedlung mit Feldzeichen in der Platzmitte (Generator-Variante eisenwald)"
        },
        "fraktion": {
          "typ": "text",
          "default": "raubzug",
          "werte": [
            "rostmeute",
            "kontor",
            "raubzug",
            "herrenlos",
            "kustoden",
            "rom",
            "ger"
          ],
          "beschreibung": "Besitzer bzw. Gegner (Fraktion = Besitz-ID)"
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 90,
                "if": {
                  "not": {
                    "check": {
                      "name": "anker_state",
                      "map": "{{map}}",
                      "anker": "flagge",
                      "state": "gehisst",
                      "min": 1
                    }
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "sticky": false,
                "done": {
                  "check": {
                    "name": "away_active",
                    "map": "{{map}}"
                  }
                }
              },
              {
                "id": "hissen",
                "text": "@{{id}}.ziel_hissen",
                "sticky": false,
                "done": {
                  "check": {
                    "name": "anker_state",
                    "map": "{{map}}",
                    "anker": "flagge",
                    "state": "gehisst",
                    "min": 1
                  }
                }
              }
            ],
            "next": [
              {
                "if": {
                  "check": {
                    "name": "anker_state",
                    "map": "{{map}}",
                    "anker": "flagge",
                    "state": "gehisst",
                    "min": 1
                  }
                },
                "goto": "{{id}}_kampf"
              }
            ],
            "skip": [
              {
                "do": "anker_zustand",
                "map": "{{map}}",
                "anker": "flagge",
                "zustand": "gehisst"
              }
            ]
          },
          {
            "id": "{{id}}_kampf",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              {
                "if": {
                  "not": {
                    "v": "{{id}}_a"
                  }
                },
                "do": "angriff_starten",
                "map": "{{map}}",
                "fraktion": "{{fraktion}}",
                "tag": "{{id}}_a"
              },
              {
                "set": {
                  "{{id}}_a": true
                }
              },
              {
                "oda": "@{{id}}.angriff"
              }
            ],
            "timers": [
              {
                "at": 120,
                "if": {
                  "not": {
                    "v": "{{id}}_sieg"
                  }
                },
                "oda": "@{{id}}.hinweis_kampf",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "boss_besiegt",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_sieg"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_sieg": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_gesiegt": true
                    }
                  },
                  {
                    "do": "gegner_abziehen",
                    "map": "{{map}}"
                  },
                  {
                    "oda": "@{{id}}.sieg"
                  }
                ]
              },
              {
                "if": {
                  "all": [
                    {
                      "check": {
                        "name": "crew_gefallen",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "not": {
                        "v": "{{id}}_sieg"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_zurueck": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_gefallen": true
                    }
                  },
                  {
                    "oda": "@{{id}}.gefallen"
                  },
                  {
                    "do": "map_reset",
                    "map": "{{map}}"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "sticky": false,
                "done": {
                  "check": {
                    "name": "away_active",
                    "map": "{{map}}"
                  }
                }
              },
              {
                "id": "boss",
                "text": "@{{id}}.ziel_boss",
                "sticky": false,
                "done": {
                  "v": "{{id}}_sieg"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_sieg"
                },
                "goto": "{{weiter}}"
              },
              {
                "if": {
                  "v": "{{id}}_zurueck"
                },
                "goto": "{{id}}"
              }
            ],
            "skip": [
              {
                "do": "gegner_abziehen",
                "map": "{{map}}"
              },
              {
                "set": {
                  "{{id}}_sieg": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_gesiegt": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.start": "Das Feldzeichen steht in der Mitte des Dorfplatzes. Zwei von euch hissen, die anderen decken.",
          "{{id}}.hinweis": "Captain: Zwei Mann zum Feldzeichen, gemeinsam E halten. Danach kommen sie von allen Seiten.",
          "{{id}}.angriff": "Sie haben es gesehen! Gegner von allen Seiten. Der große dort ist ihr Anführer – fällt er, fällt der Rest.",
          "{{id}}.sieg": "Sie flüchten! Das Feldzeichen weht – die Siedlung gehört euch.",
          "{{id}}.gefallen": "Notrückholung eingeleitet. Wir kommen wieder – die Siedlung beginnt von vorn.",
          "{{id}}.ziel_hissen": "Feldzeichen zu zweit hissen",
          "{{id}}.ziel_boss": "Den Anführer besiegen",
          "{{id}}.hinweis_kampf": "Captain: Den Großen ausschalten, dann ist Schluss. Deckung nutzen, zusammen vorrücken."
        }
      },
      "rueckfall": {
        "params": {}
      },
      "test": {
        "params": {
          "loc": "splitter",
          "map": "splitter.eisenwald",
          "fraktion": "raubzug"
        }
      }
    },
    {
      "id": "kreaturen_in_hoehle",
      "name": "Kreaturen in der Höhle erledigen",
      "schauplatz": "aussen",
      "beschreibung": "Höhle mit Kreaturen statt Drohnen, Typ als Parameter. rudeltier: drei starke Tiere mit Panzerung vorn, einzeln bekämpfbar. schwarm: viele kleine Wesen um eine Königin am Nest; Abbaulärm lockt sie, die Königin beseitigen löst den Schwarm auf. Erledigt, wenn alle Tiere bzw. die Königin endgültig erledigt sind. Beide Typen gleichwertig anbieten und abwechseln.",
      "braucht": [
        "transfer",
        "aussen_kampf"
      ],
      "buehne_braucht": {
        "kartenarten": [
          "hoehle"
        ],
        "anker": [
          "abholpunkt",
          "nest"
        ]
      },
      "dauer_min": [
        4,
        8
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": {
        "1": [
          5,
          9
        ],
        "2": [
          4,
          8
        ],
        "3": [
          4,
          7
        ]
      },
      "liefert_flags": [
        "{{id}}_geraeumt"
      ],
      "ereignisse": [
        "kreaturAusgefallen",
        "kreaturAufgeloest",
        "abbauLaerm"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true
        },
        "map": {
          "typ": "map",
          "pflicht": true,
          "beschreibung": "Landepunkt (setzt der Szenenbau nach buehne_braucht, nie das LLM)"
        },
        "typ": {
          "typ": "text",
          "pflicht": true,
          "werte": [
            "rudeltier",
            "schwarm"
          ],
          "beschreibung": "Art der Begegnung: rudeltier (3 starke Tiere) oder schwarm (Königin am Nest mit vielen kleinen Wesen; Abbaulärm lockt sie)"
        }
      },
      "abgeleitet": {
        "typ": {
          "rudeltier": {
            "besetzen": {
              "if": {
                "not": {
                  "v": "{{id}}_besetzt"
                }
              },
              "do": "kreatur_besetzen",
              "map": "{{map}}",
              "typ": "rudeltier",
              "anzahl": 3,
              "gruppe": "{{id}}_k"
            },
            "erledigt": {
              "name": "kreaturen_erledigt",
              "map": "{{map}}",
              "gruppe": "{{id}}_k"
            },
            "lage": "Tiere in der Höhle. Die Panzerung sitzt vorn, also flankieren und zusammen vorgehen.",
            "hinweis": "Captain: Die Tiere stehen verteilt, einzeln bekämpfen. Von hinten treffen.",
            "ziel": "Alle Tiere der Höhle erledigen",
            "geschafft": "Die Höhle ist frei von Tieren."
          },
          "schwarm": {
            "besetzen": {
              "if": {
                "not": {
                  "v": "{{id}}_besetzt"
                }
              },
              "do": "nest_besetzen",
              "map": "{{map}}",
              "typ": "koenigin",
              "gruppe": "{{id}}_k"
            },
            "erledigt": {
              "name": "kreaturen_erledigt",
              "map": "{{map}}",
              "typ": "koenigin"
            },
            "lage": "Ein Schwarm in der Höhle. Lärm lockt ihn an, die Königin sitzt {{lex.nest:am}}.",
            "hinweis": "Captain: Die Spur der Schwarmlinge führt {{lex.nest:zum}}. Königin beseitigen, dann zerfällt der Schwarm.",
            "ziel": "Die Königin {{lex.nest:am}} beseitigen",
            "geschafft": "Die Königin ist erledigt, der Schwarm zerfällt."
          }
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ],
          "aussenkarten": [
            "{{map}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "allowBeam": [
              "{{map}}"
            ],
            "enter": [
              "{{besetzen}}",
              {
                "set": {
                  "{{id}}_besetzt": true
                }
              }
            ],
            "timers": [
              {
                "at": 2,
                "oda": "@{{id}}.start"
              },
              {
                "at": 4,
                "oda": "@{{id}}.lage"
              },
              {
                "at": 45,
                "if": {
                  "not": {
                    "v": "{{id}}_ende"
                  }
                },
                "oda": "@{{id}}.hinweis",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "check": "{{erledigt}}"
                    },
                    {
                      "not": {
                        "v": "{{id}}_ende"
                      }
                    }
                  ]
                },
                "do": [
                  {
                    "set": {
                      "{{id}}_ende": true
                    }
                  },
                  {
                    "setFlag": {
                      "{{id}}_geraeumt": true
                    }
                  },
                  {
                    "oda": "@{{id}}.geschafft"
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "runter",
                "text": "@{{id}}.ziel_runter",
                "done": {
                  "any": [
                    {
                      "check": {
                        "name": "away_active",
                        "map": "{{map}}"
                      }
                    },
                    {
                      "v": "{{id}}_ende"
                    }
                  ]
                }
              },
              {
                "id": "ziel",
                "text": "@{{id}}.ziel",
                "done": {
                  "v": "{{id}}_ende"
                }
              }
            ],
            "next": [
              {
                "if": {
                  "v": "{{id}}_ende"
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "set": {
                  "{{id}}_ende": true
                }
              },
              {
                "setFlag": {
                  "{{id}}_geraeumt": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.ziel_runter": "Außenteam runterbeamen",
          "{{id}}.ziel_hoch": "Zurück an Bord beamen",
          "{{id}}.start": "Außenteam unten. Captain: Reiter „Außenteam“ – Befehle setzen, Sensor und Kuppel.",
          "{{id}}.lage": "{{lage}}",
          "{{id}}.hinweis": "{{hinweis}}",
          "{{id}}.geschafft": "{{geschafft}}",
          "{{id}}.ziel": "{{ziel}}"
        }
      },
      "rueckfall": {
        "params": {
          "typ": "rudeltier"
        }
      },
      "test": {
        "params": {
