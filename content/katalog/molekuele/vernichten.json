{
  "format": "molekuel/1",
  "id": "vernichten",
  "name": "Vernichten",
  "familie": "kampf",
  "kern": "Gegner zerstören bzw. ausschalten",
  "ansaetze": [
    "gewalt"
  ],
  "szenentypen": [
    "A4",
    "A5",
    "A10",
    "C2"
  ],
  "umsetzungen": [
    {
      "id": "angriffswelle",
      "name": "Angriffswelle mit Verstärkung",
      "schauplatz": "weltraum",
      "beschreibung": "Erst greifen Jäger an. Sind sie erledigt oder dauert es zu lange, kündigt ein NSC per Funk Verstärkung an (Kanonenboot oder weitere Jäger). Breitseiten, Ausweichen, Schilde, Reparaturen. Passt für Piraten, Patrouillen, Hinterhalte. Mit ziel = schuetzling/auto gehen die Gegner auf einen Schützling derselben Szene.",
      "braucht": [
        "raumkampf",
        "bordschaeden"
      ],
      "dauer_min": [
        3,
        5
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": { "1": [4, 6], "2": [3, 5], "3": [3, 4] },
      "ereignisse": [
        "enemyKilled",
        "systemDamaged"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true,
          "beschreibung": "Ort der Szene"
        },
        "npc": {
          "typ": "npc",
          "pflicht": true,
          "beschreibung": "Wer funkt (Gegner)"
        },
        "jaeger": {
          "typ": "zahl",
          "default": 1,
          "min": 1,
          "max": 3
        },
        "verstaerkung": {
          "typ": "kind",
          "default": "gunboat",
          "werte": [
            "gunboat",
            "raider"
          ]
        },
        "verstaerkung_nach": {
          "typ": "zahl",
          "default": 50,
          "min": 20,
          "max": 120
        },
        "ziel": {
          "typ": "text",
          "default": "lerche",
          "werte": [
            "lerche",
            "schuetzling",
            "auto"
          ],
          "beschreibung": "Wen die Gegner angreifen (S2): lerche, schuetzling (Schützling derselben Szene) oder auto"
        },
        "funk_start": {
          "typ": "text",
          "default": "Da seid ihr ja. Mal sehen, wie lange eure Schilde halten."
        },
        "funk_verstaerkung": {
          "typ": "text",
          "default": "Genug gespielt. Jetzt wird es ernst."
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ]
        },
        "besetzung": {
          "npc": [
            "{{npc}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "enter": [
              {
                "spawn": {
                  "kind": "raider",
                  "tag": "{{id}}_w1",
                  "n": "{{jaeger}}",
                  "ziel": "{{ziel}}",
                  "angles": [
                    0.2,
                    -0.6,
                    1.1
                  ]
                }
              },
              {
                "after": {
                  "sec": 3,
                  "do": [
                    {
                      "radio": {
                        "from": "{{npc}}",
                        "text": "@{{id}}.funk_start"
                      }
                    }
                  ]
                }
              }
            ],
            "timers": [
              {
                "at": 0.5,
                "oda": "@{{id}}.lage"
              },
              {
                "at": 60,
                "oda": "@{{id}}.tipp",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    {
                      "not": {
                        "v": "{{id}}_w2"
                      }
                    },
                    {
                      "any": [
                        {
                          "enemiesLeft": {
                            "max": 0
                          }
                        },
                        {
                          "elapsed": "{{verstaerkung_nach}}"
                        }
                      ]
                    }
                  ]
                },
                "do": [
                  {
                    "wendung": "{{id}}_verstaerkung",
                    "ankuendigung": {
                      "oda": "@{{id}}.ankuendigung",
                      "art": "vorher",
                      "vorlauf_s": 4
                    },
                    "wirkung": [
                      {
                        "set": {
                          "{{id}}_w2": true
                        }
                      },
                      {
                        "radio": {
                          "from": "{{npc}}",
                          "text": "@{{id}}.funk_verstaerkung"
                        }
                      },
                      {
                        "after": {
                          "sec": 4,
                          "do": [
                            {
                              "spawn": {
                                "kind": "{{verstaerkung}}",
                                "tag": "{{id}}_w2",
                                "ziel": "{{ziel}}"
                              }
                            },
                            {
                              "set": {
                                "{{id}}_w2_da": true
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "abwehr",
                "text": "@{{id}}.ziel",
                "done": false
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    {
                      "v": "{{id}}_w2_da"
                    },
                    {
                      "enemiesLeft": {
                        "max": 0
                      }
                    }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              {
                "do": "debug_clear_enemies"
              },
              {
                "set": {
                  "{{id}}_w2": true,
                  "{{id}}_w2_da": true
                }
              }
            ]
          }
        ],
        "texte": {
          "{{id}}.funk_start": "{{funk_start}}",
          "{{id}}.funk_verstaerkung": "{{funk_verstaerkung}}",
          "{{id}}.lage": "Feindkontakt! Taktik besetzen, Captain verteilt Schilde auf die bedrohte Seite.",
          "{{id}}.tipp": "Pilot: Breitseite zum Gegner. Taktik: Ziel mit T, Batterien 2/3. Schäden: E halten oder Bots.",
          "{{id}}.ankuendigung": "Ortung: Verstärkung im Anflug! Schilde hoch, Pilot – Breitseite bereithalten.",
          "{{id}}.ziel": "Angriff abwehren"
        }
      },
      "test": {
        "params": {
          "loc": "b7",
          "npc": "grauzahn"
        }
      }
    },
    {
      "id": "pylonen_pruefung",
      "name": "Pylonen mit Frontschild um ein Objekt",
      "schauplatz": "weltraum",
      "beschreibung": "Kustoden-Pylonen stehen um das Hauptobjekt des Orts, ihr Frontschild schluckt alles von vorn. Die Taktik scannt, wo der Schild ist, der Pilot fliegt die Flanke an. Nach dem ersten Abschuss (oder nach einer Weile) erwacht ein Wächter mit EMP. Passt zu Kustoden-Anlagen und Belagerungen. Nur an Orten mit Hauptobjekt.",
      "braucht": [
        "raumkampf"
      ],
      "dauer_min": [
        3,
        5
      ],
      "dauer_quelle": "schaetzung",
      "dauer_je_crew": { "1": [5, 7], "2": [4, 5], "3": [3, 5] },
      "ereignisse": [
        "enemyKilled",
        "enemyScanned"
      ],
      "params": {
        "loc": {
          "typ": "loc",
          "pflicht": true,
          "werte": [
            "relais",
            "b7",
            "kesh",
            "wrack"
          ],
          "beschreibung": "Ort mit Hauptobjekt (Relais, Boje, Mond, Wrack)"
        },
        "pylonen": {
          "typ": "zahl",
          "default": 3,
          "min": 2,
          "max": 4
        },
        "waechter_nach": {
          "typ": "zahl",
          "default": 30,
          "min": 15,
          "max": 90
        }
      },
      "vorlage": {
        "buehne": {
          "orte": [
            "{{loc}}"
          ]
        },
        "steps": [
          {
            "id": "{{id}}",
            "loc": "{{loc}}",
            "restartOnReturn": true,
            "enter": [
              {
                "spawn": {
                  "kind": "pylon",
                  "tag": "{{id}}_pylon",
                  "face": "out",
                  "n": "{{pylonen}}",
                  "atStation": [
                    { "dx": -300, "dy": -240 },
                    { "dx": 340, "dy": -40 },
                    { "dx": -230, "dy": 290 },
                    { "dx": 200, "dy": 260 }
                  ]
                }
              }
            ],
            "timers": [
              {
                "at": 1,
                "oda": "@{{id}}.lage"
              },
              {
                "at": 30,
                "if": {
                  "not": {
                    "event": "enemyScanned"
                  }
                },
                "oda": "@{{id}}.tipp",
                "garantie": "hinweis"
              }
            ],
            "rules": [
              {
                "if": {
                  "all": [
                    { "atLocation": "{{loc}}" },
                    { "not": { "v": "{{id}}_waechter" } },
                    {
                      "any": [
                        { "elapsed": "{{waechter_nach}}" },
                        { "killed": { "tag": "{{id}}_pylon", "min": 1 } }
                      ]
                    }
                  ]
                },
                "do": [
                  {
                    "wendung": "{{id}}_waechter",
                    "ankuendigung": {
                      "oda": "@{{id}}.waechter",
                      "art": "gleichzeitig",
                      "grund": "Der Wächter erscheint sichtbar und lädt seine EMP-Schüsse sichtbar."
                    },
                    "wirkung": [
                      { "set": { "{{id}}_waechter": true } },
                      {
                        "spawn": {
                          "kind": "sentinel",
                          "tag": "{{id}}_waechter",
                          "atStation": [ { "dx": 160, "dy": 120 } ]
                        }
                      }
                    ]
                  }
                ]
              }
            ],
            "objectives": [
              {
                "id": "pylonen",
                "text": "@{{id}}.ziel",
                "done": {
                  "all": [
                    { "elapsed": 0.5 },
                    { "enemiesLeft": { "tag": "{{id}}_pylon", "max": 0 } }
                  ]
                }
              }
            ],
            "next": [
              {
                "if": {
                  "all": [
                    { "v": "{{id}}_waechter" },
                    { "enemiesLeft": { "max": 0 } }
                  ]
                },
                "goto": "{{weiter}}"
              }
            ],
            "skip": [
              { "do": "debug_clear_enemies" },
              { "set": { "{{id}}_waechter": true } }
            ]
          }
        ],
        "texte": {
          "{{id}}.lage": "Pylonen mit Frontschild. Taktik: scannen und den Piloten an die Seite lotsen – Marker helfen!",
          "{{id}}.tipp": "Tipp: Pylon anvisieren, S halten – dann seht ihr, wo sein Schild ist. Von der Seite geht es schneller.",
          "{{id}}.waechter": "Ein Kustoden-Wächter erwacht! Seine EMP-Schüsse legen Systeme lahm – Schilde oben halten.",
          "{{id}}.ziel": "Pylonen ausschalten ({killed:{{id}}_pylon}/{{pylonen}}) – von der Seite!"
        }
      },
      "test": {
        "params": {
          "loc": "relais"
        }
      }
    }
  ],
  "quelle": "vault: Bausteine/Ziel-Moleküle.md; pylonen_pruefung aus m2 (Relais), S2 in den Kern übernommen"
}
