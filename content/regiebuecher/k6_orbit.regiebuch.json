  "ausgaenge": {
    "erfolg": {
      "beschreibung": "Fregatte zerstört, die Orbitalabwehr von Eisenwald ist gebrochen, der Legat lebt (auch wenn die Fulminata fiel).",
      "folgen": [
        {"do":"welt_fakt","key":"orbit_eisenwald","value":"befreit","quelle":"Orbitschlacht"},
