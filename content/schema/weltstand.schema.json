{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pantheon/weltstand/3",
  "title": "Weltstand (Pantheon, Version 3)",
  "description": "Speicherstand einer Kampagne: Welt + Schiff + NSC + Chronik (CONTRACT-S1 §5). Liegt auf dem Server (WORLD_DIR, Standard data/worlds/<id>.json), atomar geschrieben, vorherige Fassung als <id>.bak.json. Gespeichert wird angedockt und beim Abschluss einer Mission. Höchstens 5 Weltstände.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "erstellt", "gespeichert", "ort", "schiff", "welt", "missionen", "npc", "chronik"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "enum": [1, 2, 3], "description": "Formatversion 3 (B1–B3, geschrieben wird immer 3). 2 = S2-Stand, 1 = S1-Stand: bleiben gültig und werden beim Laden per server/weltstand.js MIGRATIONS[n] gehoben (v1 -> v2: leerer Block spielleiter; v2 -> v3: leere Blöcke welt.landepunkte, welt.wracks, crew, welt.sektoren aus den Orten)." },
    "crew": {
      "type": "object", "additionalProperties": false,
      "description": "B2 (CONTRACT-B2 §9, CONTRACT-B1 §8): Crew-weite Daten ohne Namen. Inhaber: waffen.js (waffen), squad.js über game.weltstand.rolleGesehen (rollen_gesehen).",
      "properties": {
        "waffen": { "type": "object", "description": "Hash der Browser-Kennung (12 Hex-Zeichen, SHA-1) -> gewählte Waffe (Waffenwahl am Transporter, E26). Nie Namen.",
          "propertyNames": { "pattern": "^[0-9a-f]{12}$" }, "additionalProperties": { "type": "string" } },
        "rollen_gesehen": { "type": "array", "items": { "type": "string" }, "description": "Gegnerrollen, die die Crew schon gesehen hat (Einführungsregel E24)" }
      }
    },
    "spielleiter": {
      "type": "object",
      "description": "S2 (CONTRACT-S2 §3.2): Zustand des Spielleiters. Bücher nur für angebotene/aktive Missionen, erledigte nur als Zusammenfassung.",
      "properties": {
        "plaene": { "type": "object", "description": "missionId -> { grobplan, anlass, origin, szenen: { sid: { quelle, antwort, key } }, buch }",
          "additionalProperties": { "type": "object" } },
        "archiv_gespielt": { "type": "array", "items": { "type": "string" } },
        "archiv_abgelehnt": { "type": "array", "items": { "type": "string" }, "description": "abgelehnte Archiv-Missionen: erst wieder anbieten, wenn alle anderen gespielt/abgelehnt sind" },
        "zusammenfassung": { "type": "array", "items": { "type": "object", "properties": {
          "id": { "type": "string" }, "titel": { "type": "string" }, "auftraggeber": { "type": ["string", "null"] }, "ausgang": { "type": ["string", "null"] },
          "boden": { "type": "boolean", "description": "B1: Mission hatte eine Bodenszene (Bodenquote)" },
          "lang": { "type": "boolean", "description": "B1: lange Mission (ab CONFIG.spielleiter.boden.langAbMin)" },
          "landepunkte": { "type": "array", "items": { "type": "string" }, "description": "B1: benutzte Landepunkte (lpId)" },
          "dauer_ziel_min": { "type": ["number", "null"], "minimum": 0 } } } },
        "naechste_id": { "type": "integer", "minimum": 0 }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{4,40}$" },
    "name": { "type": "string", "maxLength": 40, "description": "Anzeigename in der Lobby, z. B. 'Lerche · 07.10.'" },
    "erstellt": { "type": "string", "format": "date-time" },
    "gespeichert": { "type": "string", "format": "date-time" },
    "spielzeit_s": { "type": "number", "minimum": 0 },
    "tutorial": { "enum": ["laeuft", "erledigt", "uebersprungen", "gespielt"], "description": "'gespielt' = Altname für 'erledigt'" },

    "meta": {
      "type": "object", "additionalProperties": false,
      "description": "Nur zur Anzeige in der Lobby",
      "properties": {
        "spieler": { "type": "array", "maxItems": 3, "items": { "type": "string", "maxLength": 24 } },
        "server": { "type": "string", "description": "SERVER_VERSION beim Speichern" }
      }
    },

    "ort": {
      "type": "object", "additionalProperties": false, "required": ["angedockt"],
      "description": "Laden setzt das Schiff angedockt hierhin (letzter Andockort bzw. hafen).",
      "properties": { "angedockt": { "type": "string" } }
    },

    "schiff": {
      "type": "object", "additionalProperties": false, "required": ["name", "marken", "lager"],
      "properties": {
        "name": { "type": "string" },
        "marken": { "type": "integer", "minimum": 0 },
        "lager": { "type": "object", "description": "Gegenstand -> Anzahl (ersatzteil, flickblech, loeschgel, loeschgelCharges, medipack, bolzen, tafel …)", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "ausbauten": { "type": "array", "items": { "type": "string" }, "description": "gekaufte Upgrades (seitenturm, bolzenwerfer; schildpool entfällt seit PAN-01, bot2/schrauber3 ist das Modul Werkstatt)" },
        "stufe": { "type": "integer", "minimum": 0, "maximum": 3, "description": "PAN-01 B: Ausbaustufe der Lerche (0 Start: Waffen 8 4 6, Modulräume 1 2 · 1: + Waffen 7 9, Raum 3 · 2: + Waffen 2 5, Raum 4 · 3: + Waffen 1 3). Fehlt das Feld (Altstand), gilt Stufe 0. Öffnet Plätze, Räume und die Fahrt der Lifts ins Unterdeck." },
        "waffen": { "type": "object", "description": "PAN-01 C: Bestückung der neun Waffenplätze (Ziffernblock 1–9) mit Katalog-Ids (shared/schiffskatalog.js). Fehlt das Feld (Altstand), gilt die Startbestückung 8 Lanze · 4 und 6 Standardbatterie. Nur offene Plätze (Ausbaustufe) sind aktiv.", "additionalProperties": false,
          "properties": { "1": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "2": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "3": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "4": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "5": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "6": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "7": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "8": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] }, "9": { "enum": ["standardbatterie", "sturmbatterie", "streubatterie", "lanzenbatterie", "lanze", "standardkanone", "torpedowerfer", "abwehrturm"] } } },
        "module": { "type": "array", "description": "PAN-01 A: Bestückung der Modulräume (Bordmodule, je 1 Energie). Fehlt das Feld (Altstand), gilt die Start-Bestückung (Frachtraum, Krankenstation). Die Energieverteilung wird nicht gespeichert.", "maxItems": 4,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "raum"], "properties": { "id": { "enum": ["frachtraum", "krankenstation", "werkstatt"] }, "raum": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Modulraum-Nummer" }, "an": { "type": "boolean", "description": "Wunsch der Technik (Standard an)" } } } },
        "deko": { "type": "array", "items": { "type": "string" }, "description": "Deko im Besitz" },
        "dekoPlaetze": { "type": "object", "description": "Deko-Platz -> Deko-Kennung oder null", "additionalProperties": { "type": ["string", "null"] } },
        "quartiere": { "type": "object", "description": "Quartier -> Einrichtung (floor, wall, light)" },
        "systeme": { "type": "object", "description": "System -> ok|damaged|broken (offline wird ok, geflickt wird damaged)", "additionalProperties": { "enum": ["ok", "damaged", "broken"] } },
        "huelle": { "type": "number", "minimum": 0 },
        "support": { "type": "object", "description": "Abklingzeiten der Captain-Unterstützung", "additionalProperties": { "type": "number" } },
        "pins": { "type": "array", "description": "Pins des Planungstischs", "items": { "type": "object" } },
        "fracht": { "type": "array", "description": "EK3 Teil A, PAN-01 B: mitgeführte Ladung (Art je Bucht; höchstens 2 je Modul Frachtraum, also bis zu 8 bei vier Frachträumen)", "maxItems": 8, "items": { "oneOf": [ { "type": "string", "enum": ["sprengstoff", "fracht", "deuterium"] }, { "type": "object", "description": "SL0: Person im Frachtraum (p Kennung, n Name, b Bett)", "required": ["p"], "properties": { "p": { "type": "string" }, "n": { "type": "string" }, "b": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } ] } },
        "zonen": { "type": "object", "description": "SL6: erkundete Zonen und Zähler (Zonen.toSave; sim-sund fand: ohne dieses Feld lehnt jedes Speichern nach dem Gasfeld ab)", "properties": { "bekannt": { "type": "array", "items": { "type": "string" } }, "zaehler": { "type": "object", "additionalProperties": { "type": "number" } } }, "additionalProperties": false }
      }
    },

    "welt": {
      "type": "object", "additionalProperties": false, "required": ["orte"],
      "properties": {
        "orte": {
          "type": "object", "additionalProperties": false, "required": ["bekannt", "besucht"],
          "properties": {
            "bekannt": { "type": "array", "items": { "type": "string" } },
            "besucht": { "type": "array", "items": { "type": "string" } },
            "aufgedeckt": { "type": "array", "items": { "type": "string" }, "description": "per Weitscan aufgedeckte Funde" },
            "gefunden": { "type": "array", "items": { "type": "string" }, "description": "eingesammelte/gescannte Funde" }
          }
        },
        "verbindungen_offen": { "type": "array", "items": { "type": "string" }, "description": "Schlüssel aus LOCKED_LINKS, die offen sind" },
        "landepunkte": {
          "type": "object",
          "description": "B1 (CONTRACT-B1 §8): Landepunkt-ID -> gebaute Karte (Seed) und ihre Zustände. Inhaber server/sim/landepunkte.js (toSave/restore). Weicht bauversion ab, wird neu gebaut und Zustände über Anker-/Kanten-IDs übertragen.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "seed": { "type": "integer" },
              "bauversion": { "type": ["string", "null"] },
              "schablone": { "type": ["string", "null"] },
              "art": { "type": "string" },
              "bauweise": { "type": ["string", "null"] },
              "besitz": { "type": ["string", "null"] },
              "zustand": { "type": ["string", "null"] },
              "zustaende": { "type": "object", "description": "Anker-ID bzw. Kanten-ID -> Zustand", "additionalProperties": { "type": "string" } },
              "alarm": { "type": "boolean" },
              "besuche": { "type": "integer", "minimum": 0 },
              "letzte_mission": { "type": ["string", "null"] },
              "neu": { "type": "boolean" },
              "gesperrt": { "type": "boolean" }
            }
          }
        },
        "wracks": {
          "type": "array", "description": "B1 (§7/§8): treibende Wracks als Landepunkte. Inhaber server/sim/entern.js.",
          "items": { "type": "object", "required": ["lpId"], "properties": {
            "lpId": { "type": "string" }, "ort": { "type": ["string", "null"] }, "quelle": { "enum": ["entern", "daten"] } } }
        },
        "sektoren": {
          "type": "object", "description": "B3 (CONTRACT-B3 §5): Erkundungsstand der Sektorkarte. Inhaber explore.js/sprung.js. orte.* bleibt als Altfeld.",
          "properties": {
            "erkundet": { "type": "array", "items": { "type": "string" }, "description": "besuchte Hexe (SSZZ)" },
            "bojen": { "type": "array", "items": { "type": "string" }, "description": "bekannte Bojen (Kanten-IDs a-b)" },
            "temp": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "a": { "type": "string" }, "b": { "type": "string" }, "bis": { "type": "string" } } }, "description": "temporäre Sprungpunkte" },
            "offen": { "type": "array", "items": { "type": "string" }, "description": "geöffnete gesperrte Kanten" }
          }
        },
        "notrufe": {
          "type": "object", "description": "SL8 (CONCEPT-SL8): freigeschaltete Notrufe: Id -> Zustand (0 offen, 1 angenommen, 2 vor Ort, 3 erledigt, 4 abgelaufen, 5 abgelehnt), Restzeit in Spielsekunden, gestellte Fragen, Sonde hat gemessen. Inhaber server/sim/notrufe.js.",
          "additionalProperties": { "type": "object", "properties": { "z": { "type": "integer", "minimum": 0, "maximum": 5 }, "rest": { "type": "number", "minimum": 0 },
            "befragt": { "type": "array", "items": { "type": "integer" } }, "sonde": { "type": "boolean" },
            "v": { "type": "integer", "minimum": 0, "description": "Wiederkehr: Index der Variante (0 = Original)" }, "n": { "type": "integer", "minimum": 0, "description": "Wiederkehr: Zahl der bisherigen Wiederkehren" },
            "w": { "type": "number", "minimum": 0, "description": "Wiederkehr: Sekunden bis der Ruf erneut erscheint" } } }
        },
        "spur": {
          "type": "object", "description": "SL5 (CONCEPT-SL5): laufende Ionenspur. Inhaber server/sim/spur.js; Wegliste steht in content/spuren/<id>.json.",
          "properties": { "id": { "type": "string" }, "idx": { "type": "integer", "minimum": 0 }, "gelesen": { "type": "boolean" }, "fertig": { "type": "boolean" } }
        },
        "sektorplan": {
          "type": "object", "description": "SL4 (CONCEPT-SL4): Sektorplan des Captains. Inhaber server/sim/sektorplan.js. gesichtet: Hex -> { q: sonde|karte, alter (s) }; marken: Einträge im Szenen-Koordinatensystem; schiffe: Momentaufnahmen mit Alter (s).",
          "properties": {
            "gesichtet": { "type": "object", "additionalProperties": { "type": "object", "properties": { "q": { "enum": ["sonde", "karte"] }, "alter": { "type": "number", "minimum": 0 } } } },
            "marken": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "h": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "k": { "type": "string" } } } },
            "schiffe": { "type": "array", "items": { "type": "object", "properties": { "h": { "type": "string" }, "art": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "alter": { "type": "number", "minimum": 0 } } } },
            "seq": { "type": "integer", "minimum": 0 }
          }
        },
        "karten": { "type": "array", "items": { "type": "string" }, "description": "kartierte Außenkarten (platform, wreck, kesh)" },
        "flags": { "type": "object", "description": "Weltweite Flags (bribed, decision, technikerRescued …)", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "fakten": { "type": "object", "description": "Kanon aus Folgen, z. B. tafel_von_kesh: konkordat_archiv. Der Server schreibt den Wert direkt (Quelle in faktenQuelle); die Form { value, quelle } (wie content/npc.json) wird ebenfalls gelesen.",
          "additionalProperties": { "type": ["string", "number", "boolean", "null", "object"], "properties": { "value": { "type": ["string", "number", "boolean", "null"] }, "quelle": { "type": ["string", "null"] } } } },
        "faktenQuelle": { "type": "object", "description": "Fakt -> Quelle (Mission/Ausgang)", "additionalProperties": { "type": "string" } },
        "faeden": { "type": "array", "items": { "type": "string" }, "description": "S2: offene Erzählfäden (Fakt-Schlüssel aus welt_fakt { faden: true })" },
        "odaSeen": { "type": "array", "items": { "type": "string" }, "description": "schon gesagte ODA-Einmal-Texte" },
        "scans": { "type": "array", "items": { "type": "string" }, "description": "abgeschlossene Captain-Scans" },
        "wrack": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "salvage": { "type": "array", "items": { "type": "boolean" } },
            "loreRead": { "type": "boolean" },
            "hollow": { "type": "object", "additionalProperties": false, "properties": { "marked": { "type": "boolean" }, "open": { "type": "boolean" } } }
          }
        },
        "log": {
          "type": "array", "maxItems": 200, "description": "Logbuch (letzte CONFIG.weltstand.logKeep Einträge)",
          "items": { "type": "object", "required": ["text"],
            "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "loc": { "type": ["string", "null"] }, "t": { "type": "number" }, "mission": { "type": ["string", "null"] } } }
        }
      }
    },

    "missionen": {
      "type": "object",
      "description": "= mission.toSave(): { missionen: { id: Status }, aktiv, flags, buchFokus }. Laden startet eine aktive Mission beim gespeicherten Schritt (bzw. wiederaufnahme.ab) neu. Altform (Missions-ID -> Status direkt, wie weltstand.beispiel.json) wird weiter gelesen.",
      "properties": {
        "missionen": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "required": ["status"],
            "properties": {
              "status": { "enum": ["angeboten", "aktiv", "erledigt", "gescheitert"] },
              "schritt": { "type": ["string", "null"] },
              "v": { "type": "object" },
              "ereignisse": { "type": "array", "items": { "type": "string" } },
              "entscheidungen": { "type": "array", "items": { "type": "string" } },
              "erledigte_ziele": { "type": "array", "items": { "type": "object" } },
              "fund": { "type": "string", "description": "B1: gemerkter Fund der laufenden Mission (Aktion fund, Textbaustein {fund}); fehlt -> „die Beute“" },
              "ausgang": { "type": ["string", "null"] },
              "start_s": { "type": ["number", "null"] }, "ende_s": { "type": ["number", "null"] }
            }
          }
        },
        "aktiv": { "type": ["string", "null"] },
        "flags": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "buchFokus": { "type": ["string", "null"] }
      },
      "additionalProperties": {
        "type": "object", "required": ["status"],
        "properties": {
          "status": { "enum": ["angeboten", "aktiv", "erledigt", "gescheitert"] },
          "schritt": { "type": ["string", "null"] },
          "v": { "type": "object", "description": "Schrittvariablen (m.v)" },
          "ereignisse": { "type": "array", "items": { "type": "string" }, "description": "für den Neustart nötige Ereignisse (accepted …)" },
          "entscheidungen": { "type": "array", "items": { "type": "string" } },
          "erledigte_ziele": { "type": "array", "items": { "type": "object" } },
          "ausgang": { "type": ["string", "null"] },
          "start_s": { "type": ["number", "null"] }, "ende_s": { "type": ["number", "null"] }
        }
      }
    },

    "npc": {
      "type": "object",
      "description": "NSC als Datensätze (Nemesis-Prinzip). Kennung -> Datensatz. Startwerte aus content/npc.json.",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["name", "fraktion", "status", "haltung", "gedaechtnis"],
        "properties": {
          "name": { "type": "string" },
          "titel": { "type": "string", "description": "Anzeige im Funk, z. B. 'Hafenmeisterin'" },
          "fraktion": { "type": "string" },
          "rolle": { "type": "string" },
          "status": { "enum": ["lebt", "verwundet", "verletzt", "gefangen", "tot", "verschwunden", "vermisst", "unbekannt", "befoerdert", "uebergelaufen"] },
          "haltung": { "type": "integer", "minimum": -10, "maximum": 10, "description": "CONFIG.weltstand.attitudeMin … attitudeMax (Standard -3 Feind … 0 neutral … 3 Verbündeter)" },
          "ort": { "type": "string" },
          "gedaechtnis": {
            "type": "array", "maxItems": 50,
            "description": "Gemeinsame Ereignisse, älteste zuerst. Höchstens CONFIG.weltstand.npcMemoryMax (12): bei mehr fällt der älteste Eintrag mit dem kleinsten Gewicht heraus.",
            "items": { "type": "object", "additionalProperties": false, "required": ["text"],
              "properties": {
                "ereignis": { "type": "string" },
                "text": { "type": "string", "maxLength": 200 },
                "mission": { "type": "string" },
                "schritt": { "type": "string" },
                "haltung": { "type": "integer" },
                "gewicht": { "type": "number" },
                "spielzeit_s": { "type": "number" }
              } }
          }
        }
      }
    },

    "chronik": {
      "type": "array",
      "description": "Gespielte Missionen und Entscheidungen. Grundlage für 'Was bisher geschah'.",
      "items": { "type": "object", "additionalProperties": false, "required": ["text"],
        "properties": { "text": { "type": "string", "maxLength": 300 }, "mission": { "type": "string" }, "ausgang": { "type": "string" }, "spielzeit_s": { "type": "number" } } }
    }
  }
}
