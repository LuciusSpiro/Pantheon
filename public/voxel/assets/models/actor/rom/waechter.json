{
  "id": "actor/rom/waechter",
  "name": "Kastell-Automat (Rom): Stier-Konstrukt der Legion mit Scutum als Frontschild",
  "tier": "detail",
  "jitter": 0,
  "palette": "rom",
  "tags": ["actor", "rom", "gegner", "waechter", "ruine", "aussenteam"],
  "notes": "Vorderseite +z. Basis lerche/actor/warden (Palette rom, Flügel abgetragen, Hörnerkrone durch Galea mit Querkamm ersetzt) + rom/scutum. Parameter wie lerche/actor/warden (Drop-in): state 0 aktiv / 1 Treffer / 2 zerstört, front 0/1 = Frontschild (Scutum vor der Brust, Emitter an) bzw. Schild auf dem Rücken. Der Schildbogen ist ein FX von ACTORS am Socket shield_front.",
  "footprint": [1.25, 2.0],
  "params": {
    "state": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand (0 aktiv, 1 Treffer, 2 zerstört)" },
    "front": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Frontschild (0 auf dem Rücken, 1 vorn)" }
  },
  "let": { "dy": "state == 2 ? -5 : 0" },
  "variants": {
    "treffer": { "state": 1 },
    "zerstoert": { "state": 2 },
    "schild_aus": { "front": 0 }
  },
  "ops": [
    { "name": "Körper (Wächter-Basis)", "op": "use", "model": "lerche/actor/warden", "palette": "rom", "params": { "state": "state", "front": "front" }, "at": [0, 0, 0] },

    { "name": "Flügel abtragen links", "op": "box", "mode": "carve", "at": [6, "22 + dy", -13], "size": [3, 20, 21] },
    { "name": "Flügel abtragen rechts", "op": "box", "mode": "carve", "at": [-9, "22 + dy", -13], "size": [3, 20, 21] },
    { "name": "Hörnerkrone abtragen", "op": "box", "mode": "carve", "at": [-5, "29 + dy", 5], "size": [10, 6, 10] },
    { "name": "Bart abtragen", "op": "box", "mode": "carve", "at": [-3, "18 + dy", 12], "size": [6, 4, 3] },

    { "name": "Oberbau Rom", "op": "group", "at": [0, "dy", 0], "ops": [
      { "name": "Leib ruhiger (Panzerringe)", "op": "box", "mode": "paint", "at": [-5, 11, -11], "size": [10, 4, 18], "color": { "stripes": ["primary", { "shade": "primary", "f": 0.8 }], "axis": "z", "period": 3 } },
      { "name": "Leib ruhiger oben", "op": "box", "mode": "paint", "at": [-5, 16, -11], "size": [10, 3, 18], "color": { "stripes": ["primary", { "shade": "primary", "f": 0.8 }], "axis": "z", "period": 3 } },
      { "name": "Flankenpanzer Schienen", "op": "box", "mode": "paint", "at": [6, 12, -12], "size": [2, 10, 19], "color": "metal", "mirror": "x", "mirrorAt": 0 },
      { "name": "Flankenpanzer Goldkante", "op": "box", "mode": "paint", "at": [6, 21, -12], "size": [2, 1, 19], "color": "trim", "mirror": "x", "mirrorAt": 0 },
      { "name": "Schulterplatte", "op": "box", "at": [5, 19, 2], "size": [3, 3, 5], "color": "metal_light", "mirror": "x", "mirrorAt": 0 },
      { "name": "Gesichtsmaske", "op": "box", "mode": "paint", "at": [-3, 22, 12], "size": [6, 6, 1], "color": "metal_light" },
      { "name": "Augenschlitz", "op": "box", "mode": "paint", "at": [-2, 25, 12], "size": [4, 1, 1], "color": "dark", "jitter": false },
      { "name": "Augen aktiv", "op": "box", "if": "state == 0", "mode": "paint", "at": [1, 25, 12], "size": [1, 1, 1], "color": { "role": "glow", "emit": 1.2 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
      { "name": "Augen Treffer", "op": "box", "if": "state == 1", "mode": "paint", "at": [1, 25, 12], "size": [1, 1, 1], "color": { "role": "glow2", "emit": 1.8 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
      { "name": "Kinnschutz", "op": "box", "at": [-3, 20, 11], "size": [6, 2, 2], "color": "metal" },
      { "name": "Galea Kalotte", "op": "box", "at": [-4, 28, 7], "size": [8, 2, 7], "color": "metal_light" },
      { "name": "Galea Wangenklappen", "op": "box", "at": [3, 23, 9], "size": [1, 5, 3], "color": "metal_light", "mirror": "x", "mirrorAt": 0 },
      { "name": "Kammhalter", "op": "box", "if": "state != 2", "at": [-1, 30, 9], "size": [2, 1, 2], "color": "trim" },
      { "name": "Querkamm (crista transversa)", "op": "box", "if": "state != 2", "at": [-6, 31, 9], "size": [12, 3, 2], "color": "cloth" },
      { "name": "Kamm zerfetzt", "op": "box", "if": "state == 2", "at": [-3, 30, 9], "size": [5, 1, 2], "color": { "noise": ["cloth", "dark"], "cell": 1 } }
    ] },

    { "name": "Scutum vorn (Frontschild)", "op": "use", "if": "front && state != 2", "model": "rom/scutum", "params": { "emitter": 1 }, "at": [0, "4 + dy", 13] },
    { "name": "Scutum Halterung", "op": "box", "if": "front && state != 2", "at": [-2, "12 + dy", 10], "size": [4, 2, 2], "color": "metal_dark" },
    { "name": "Scutum auf dem Rücken", "op": "use", "if": "!front && state != 2", "model": "rom/scutum", "params": { "emitter": 0 }, "at": [0, "13 + dy", -11] },
    { "name": "Scutum zerstört (abgefallen)", "op": "use", "if": "state == 2", "model": "rom/scutum", "params": { "emitter": 0 }, "at": [0, 0, 13] },
    { "name": "Scutum Brandspur", "op": "box", "if": "state == 2", "mode": "paint", "at": [-6, 0, 11], "size": [12, 18, 6], "color": { "noise": ["dark", "primary", "primary"], "cell": 2 } }
  ],
  "sockets": {
    "label": [0, 2.3, 0],
    "shield_front": [0, 0.8, 1.0],
    "fx_spark": [0.35, 1.2, 0.4],
    "head_top": [0, 2.1, 0.6]
  },
  "anchor": [0, 0, 0]
}
