{
  "id": "away/kesh/cover_low",
  "name": "Kesh – Mauerrest (halbe Deckung, 0,75 m, helle Oberkante)",
  "tier": "architecture",
  "palette": "mond_kesh",
  "tags": ["away", "kesh", "deckung", "deckung_halb", "kachelbar"],
  "footprint": [1, 1],
  "jitter": 0.05,
  "params": {
    "damaged": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Angeschossen" }
  },
  "variants": {
    "angeschossen": { "damaged": 1 },
    "variante": { "seed": 3 }
  },
  "let": {
    "cx": "(seed % 2) * 3",
    "cz": "(floor(seed / 2) % 2) * 3"
  },
  "ops": [
    { "op": "box", "name": "Körper", "at": [0, 0, 0], "size": [4, 4, 4],
      "color": { "noise": ["stone", { "shade": "stone", "f": 0.9 }, { "shade": "stone", "f": 1.06 }], "weights": [3, 2, 1], "cell": 2 } },
    { "op": "box", "name": "Untere Lage dunkel", "at": [0, 0, 0], "size": [4, 2, 4], "mode": "paint", "color": "stone_dark" },
    { "op": "box", "name": "Helle Oberkante", "at": [0, 3, 0], "size": [4, 1, 4], "mode": "paint", "color": "cover_top", "jitter": false },
    { "op": "box", "name": "Oberkante Kantenschatten", "at": [0, 3, 0], "size": [4, 1, 4], "mode": "paint",
      "color": { "frame": "cover_top_dim", "fill": "cover_top", "axes": "xz" }, "jitter": false },
    { "op": "box", "name": "Bruchkante", "at": ["cx", 3, "cz"], "size": [1, 1, 1], "mode": "carve" },

    { "op": "box", "name": "Einschlag oben", "if": "damaged", "at": [1, 3, 0], "size": [2, 1, 2], "mode": "carve" },
    { "op": "box", "name": "Einschlag Kante", "if": "damaged", "at": [3, 2, 0], "size": [1, 2, 1], "mode": "carve" },
    { "op": "box", "name": "Einschlag Boden hell", "if": "damaged", "at": [1, 2, 0], "size": [2, 1, 2], "mode": "paint", "color": "cover_top_dim" },
    { "op": "box", "name": "Ruß", "if": "damaged", "at": [0, 1, 0], "size": [4, 2, 1], "mode": "paint",
      "color": { "noise": ["dark", "stone_dark", "stone"], "weights": [2, 2, 1] } }
  ],
  "anchor": [2, 1, 2]
}
