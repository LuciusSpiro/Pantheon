    { "op": "box", "name": "Glyphenplatte", "if": "glyph", "at": [1, 0, 1], "size": [2, 1, 2], "mode": "paint", "color": "stone_dark" },
    { "op": "box", "name": "Glyphenpunkt", "if": "glyph", "at": [1, 0, 1], "size": [1, 1, 1], "mode": "paint", "color": "neon_dim", "jitter": false },
