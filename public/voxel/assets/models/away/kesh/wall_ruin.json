{
  "id": "away/kesh/wall_ruin",
  "name": "Kesh – Ruinenwand des Kustoden-Archivs (Autotile, volle Deckung, dunkle Krone)",
  "tier": "architecture",
  "palette": "mond_kesh",
  "tags": ["away", "kesh", "wand", "kachelbar", "autotile", "deckung_voll"],
  "footprint": [1, 1],
  "jitter": 0,
  "params": {
    "conn": { "default": 10, "min": 0, "max": 15, "step": 1, "label": "Nachbarwände (N1 O2 S4 W8)" },
    "cut": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Geschnitten (1,25 m statt 3 m)" },
    "decay": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Verfallen (Krone ausgebrochen, Glyphen tot)" }
  },
  "variants": {
    "geschnitten": { "cut": 1 },
    "ecke": { "conn": 6 },
    "frei": { "conn": 0 },
    "verfallen": { "decay": 1, "seed": 1 },
    "verfallen_cut": { "decay": 1, "cut": 1, "seed": 2 },
    "nische": { "conn": 10, "seed": 1 }
  },
  "let": {
    "cn": "floor(conn) % 2",
    "ce": "floor(conn / 2) % 2",
    "cs": "floor(conn / 4) % 2",
    "cw": "floor(conn / 8) % 2",
    "H": "cut ? 6 : 13",
    "gy": "cut ? 3 : 8",
    "nx": "(seed % 2) * 2",
    "nd": "cut ? 1 : 3",
    "niche": "!cut && seed % 4 == 1",
    "tick": "seed % 3 == 0"
  },
  "ops": [
    { "op": "box", "name": "Mauerkörper (Quader)", "at": [0, 0, 0], "size": [4, "H", 4],
      "color": { "noise": ["stone", "stone", { "shade": "stone", "f": 0.88 }, { "shade": "stone", "f": 1.08 }], "weights": [4, 2, 2, 1], "cell": 2 } },
    { "op": "box", "name": "Sockel", "at": [0, 0, 0], "size": [4, 2, 4], "mode": "paint", "color": { "noise": ["stone_dark", { "shade": "stone_dark", "f": 0.9 }], "cell": 2 } },
    { "op": "box", "name": "Lagerfuge", "if": "!cut", "at": [0, 5, 0], "size": [4, 1, 4], "mode": "paint", "color": { "shade": "stone", "f": 0.78 } },

    { "op": "group", "name": "Schauseite (je Richtung, nur wenn frei)", "repeat": { "count": 4, "step": [0, 0, 0], "var": "f" }, "rot": "f * 90", "pivot": [2, 2],
      "let": {
        "fe": "f == 0 ? 1 - cs : f == 1 ? 1 - ce : f == 2 ? 1 - cn : 1 - cw"
      },
      "ops": [
        { "op": "box", "name": "Glyphenband", "if": "fe && !decay", "at": [1, "gy", 3], "size": [2, 1, 1], "mode": "paint", "color": "neon", "jitter": false },
        { "op": "box", "name": "Glyphenband tot", "if": "fe && decay", "at": [1, "gy", 3], "size": [2, 1, 1], "mode": "paint", "color": "glyph_dead" },
        { "op": "box", "name": "Glyphe Strich", "if": "fe && tick && !decay && !cut", "at": [2, "gy + 1", 3], "size": [1, 2, 1], "mode": "paint", "color": "neon", "jitter": false },
        { "op": "box", "name": "Nische", "if": "fe && niche", "at": [1, 2, 3], "size": [2, 3, 1], "mode": "carve" },
        { "op": "box", "name": "Nische Rückwand", "if": "fe && niche", "at": [1, 2, 2], "size": [2, 3, 1], "mode": "paint", "color": "stone_dark" },
        { "op": "box", "name": "Nische Glimmen", "if": "fe && niche && !decay", "at": [1, 2, 2], "size": [2, 1, 1], "mode": "paint", "color": "neon_dim", "jitter": false },
        { "op": "line", "name": "Riss", "if": "fe && decay", "from": [1, 2, 3], "to": [2, "H - 3", 3], "r": 0.5, "mode": "paint", "color": "dark" }
      ] },

    { "op": "box", "name": "Krone dunkel", "at": [0, "H - 1", 0], "size": [4, 1, 4], "mode": "paint", "color": "crown" },
    { "op": "box", "name": "Ausbruch", "if": "decay", "at": ["nx", "H - nd", 0], "size": [2, "nd", 4], "mode": "carve" },
    { "op": "box", "name": "Ausbruch Krone", "if": "decay", "at": ["nx", "H - nd - 1", 0], "size": [2, 1, 4], "mode": "paint", "color": "crown" },
    { "op": "box", "name": "Abgeplatzte Ecke", "if": "decay && !cut", "at": ["3 - nx", "H - 2", "(seed % 3 == 0) ? 0 : 3"], "size": [1, 1, 1], "mode": "carve" }
  ],
  "anchor": [2, 1, 2]
}
