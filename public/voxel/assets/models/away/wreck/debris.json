{
  "id": "away/wreck/debris",
  "name": "Wrack Zaunkönig – Trümmerhaufen (Bleche, Träger, Kistenreste; seed)",
  "tier": "detail",
  "palette": "wrack",
  "tags": ["away", "wreck", "truemmer", "deckung"],
  "footprint": [1, 1],
  "jitter": 0.02,
  "params": {},
  "variants": { "b": { "seed": 1 }, "c": { "seed": 2 }, "d": { "seed": 3 } },
  "let": {
    "ox": "round(sin(seed * 1.9 + 0.4) * 2)",
    "oz": "round(cos(seed * 2.3 + 0.9) * 2)",
    "crate": "seed % 2 == 0",
    "beam": "seed % 3 != 1"
  },
  "ops": [
    { "op": "box", "name": "Schuttsockel", "at": [-7, 0, -7], "size": [14, 2, 14], "color": { "noise": ["metal_dark", "soot", "rust_dark"], "weights": [3, 2, 1], "cell": 2 } },
    { "op": "wedge", "name": "Blech schräg", "at": ["-5 + ox", 2, -6], "size": [8, 7, 8], "slope": "+x", "color": { "noise": ["rust", "metal", { "shade": "rust", "f": 0.8 }], "weights": [3, 2, 1], "cell": 2 } },
    { "op": "wedge", "name": "Blech 2", "at": [0, 2, "oz"], "size": [7, 6, 6], "slope": "-z", "color": { "noise": ["primary", "metal_dark"], "weights": [2, 1], "cell": 2 } },
    { "op": "box", "name": "Kistenrest", "if": "crate", "at": ["2 - ox", 2, -6], "size": [5, 5, 5], "color": { "frame": "metal_dark", "fill": "secondary", "axes": "xy" } },
    { "op": "line", "name": "Träger", "if": "beam", "from": [-6, 2, "4 + oz"], "to": [5, 11, "-5 - oz"], "r": 0.9, "color": "metal_light" },
    { "op": "line", "name": "Kabel", "from": [-6, 2, 6], "to": [3, 8, 2], "r": 0.5, "color": "rubber" },
    { "op": "box", "name": "Glutfunke", "if": "seed % 4 == 1", "at": [-2, 2, 4], "size": [1, 1, 1], "color": "glow2", "jitter": false }
  ],
  "anchor": [0, 0, 0]
}
