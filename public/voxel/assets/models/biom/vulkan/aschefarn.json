{
 "id": "biom/vulkan/aschefarn",
 "name": "Aschefarn (VOX-02): Sichtschleier der Vulkanzone, 0,8 bis 1,0 m, ohne Kollision, sperrt die Sicht. Acht dünne, eckige Wedel (Stufen, steil aufsteigend, mit seitlichen Zackenfiedern) strahlen von oben sichtbar aus einem dunklen Herz, dazwischen Lücken; graustichiges Olivgrün (plant*), klar anders als Stein und Fels; keine Glut. seed ändert Höhen, Fiedern und Wedellängen, lässt Fiedern aus und verschiebt die Pflanze um bis zu 1 Voxel",
 "tier": "detail",
 "palette": "biom_vulkan",
 "jitter": 0,
 "tags": [
  "biom",
  "vulkan",
  "farn",
  "sichtschleier"
 ],
 "footprint": [
  1,
  1
 ],
 "budgetTris": 600,
 "let": {
  "sx": "round((hash(seed, 5) - 0.5) * 2)",
  "sz": "round((hash(seed, 6) - 0.5) * 2)"
 },
 "ops": [
  {
   "op": "group",
   "name": "Pflanze",
   "at": [
    "sx",
    0,
    "sz"
   ],
   "ops": [
    {
     "op": "box",
     "name": "Herz",
     "at": [
      -2,
      0,
      -2
     ],
     "size": [
      4,
      4,
      4
     ],
     "color": "plant_dark"
    },
    {
     "op": "box",
     "name": "Mittelspross",
     "at": [
      -1,
      4,
      -1
     ],
     "size": [
      2,
      "9 + floor(hash(seed, 1) * 3)",
      2
     ],
     "color": "plant"
    },
    {
     "op": "group",
     "name": "Wedel gerade",
     "repeat": {
      "count": 4,
      "step": [
       0,
       0,
       0
      ],
      "var": "k"
     },
     "rot": "k * 90",
     "if": "1",
     "let": {
      "a": "floor(hash(seed, k, 1) * 4)",
      "b": "floor(hash(seed, k, 2) * 3)",
      "c": "hash(seed, k, 5) > 0.4 ? 1 : 0",
      "d": "floor(hash(seed, k, 7) * 2)"
     },
     "ops": [
      {
       "op": "box",
       "name": "Wedel unten",
       "at": [
        2,
        4,
        0
       ],
       "size": [
        2,
        1,
        1
       ],
       "color": "plant_dark"
      },
      {
       "op": "box",
       "name": "Wedel Steg",
       "at": [
        3,
        4,
        0
       ],
       "size": [
        1,
        "4 + a",
        1
       ],
       "color": "plant"
      },
      {
       "op": "box",
       "name": "Wedel Spitze",
       "at": [
        4,
        "7 + a",
        0
       ],
       "size": [
        "2 + d",
        1,
        1
       ],
       "color": "plant_light"
      },
      {
       "op": "box",
       "name": "Fieder links",
       "at": [
        3,
        "6 + b",
        1
       ],
       "size": [
        1,
        1,
        3
       ],
       "color": "plant",
       "if": "c == 1 || a > 2"
      },
      {
       "op": "box",
       "name": "Fieder rechts",
       "at": [
        3,
        "5 + b",
        -3
       ],
       "size": [
        1,
        1,
        2
       ],
       "color": "plant_dark",
       "if": "b > 0 && d == 0 || a == 3"
      }
     ]
    },
    {
     "op": "group",
     "name": "Wedel schräg",
     "repeat": {
      "count": 4,
      "step": [
       0,
       0,
       0
      ],
      "var": "k"
     },
     "rot": "k * 90",
     "if": "1",
     "let": {
      "a": "floor(hash(seed, k, 1) * 4)",
      "b": "floor(hash(seed, k, 2) * 3)",
      "c": "hash(seed, k, 5) > 0.4 ? 1 : 0",
      "d": "floor(hash(seed, k, 7) * 2)"
     },
     "ops": [
      {
       "op": "box",
       "name": "Schräg Steg",
       "at": [
        3,
        4,
        3
       ],
       "size": [
        1,
        "4 + b",
        1
       ],
       "color": "plant"
      },
      {
       "op": "box",
       "name": "Schräg Spitze",
       "at": [
        4,
        "7 + b",
        4
       ],
       "size": [
        2,
        1,
        2
       ],
       "color": "plant_light"
      }
     ]
    }
   ]
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}
