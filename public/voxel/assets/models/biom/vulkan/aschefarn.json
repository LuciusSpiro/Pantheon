{
 "id": "biom/vulkan/aschefarn",
 "name": "Aschefarn (VOX-02): Sichtschleier der Vulkanzone, 0,8 bis 1,0 m, ohne Kollision, sperrt die Sicht. Dünne, eckige Wedel aus 1-Voxel-Balken strahlen von oben sichtbar aus einem dunklen Herz (vier über die Achsen, bis zu vier kürzere über die Ecken), in der Mitte ein aufrechter Spross, dazwischen Lücken. Jeder Wedel ist einstufig oder zweistufig seitlich versetzt, hat eine eigene Höhe und Neigung (Versatz zur Seite), Fiedern werden nach oben kürzer; graustichiges Olivgrün (plant*), klar anders als Stein und Fels; keine Glut. seed ändert Höhen, Stufen, Versatz, Fiedern und Wedellängen, lässt Wedel aus und verschiebt die Pflanze um bis zu 1 Voxel",
 "tier": "detail",
 "palette": "biom_vulkan",
 "jitter": 0,
 "tags": [
  "biom",
  "vulkan",
  "farn",
  "sichtschleier"
 ],
 "footprint": [
  1,
  1
 ],
 "budgetTris": 600,
 "let": {
  "sx": "round((hash(seed, 5) - 0.5) * 2)",
  "sz": "round((hash(seed, 6) - 0.5) * 2)",
  "H0": "8 + floor(hash(seed, 1) * 3)",
  "typ": "floor(seed) % 3",
  "p": "floor(hash(seed, 77) * 2)"
 },
 "ops": [
  {
   "op": "group",
   "name": "Pflanze",
   "at": [
    "sx",
    0,
    "sz"
   ],
   "ops": [
    {
     "op": "box",
     "name": "Herz",
     "at": [
      -2,
      0,
      -2
     ],
     "size": [
      4,
      4,
      4
     ],
     "color": "plant_dark"
    },
    {
     "op": "box",
     "name": "Mittelspross",
     "at": [
      0,
      4,
      0
     ],
     "size": [
      1,
      "H0",
      1
     ],
     "color": "plant"
    },
    {
     "op": "box",
     "name": "Mittelspross Krone",
     "at": [
      0,
      "4 + H0",
      -1
     ],
     "size": [
      1,
      1,
      3
     ],
     "color": "plant_light"
    },
    {
     "op": "group",
     "name": "Wedel gerade",
     "repeat": {
      "count": 4,
      "step": [
       0,
       0,
       0
      ],
      "var": "k"
     },
     "rot": "k * 90",
     "if": "1",
     "let": {
      "t": "typ == 1 ? 0 : typ == 2 ? floor(hash(seed, k, 1) * 3) : 2",
      "L1": "1 + floor(hash(seed, k, 2) * 2)",
      "h1": "(typ == 1 ? 6 : 3) + floor(hash(seed, k, 3) * 3)",
      "dz": "floor(hash(seed, k, 4) * 3) - 1",
      "h2": "2 + floor(hash(seed, k, 5) * 2)",
      "d": "floor(hash(seed, k, 7) * 2)",
      "yT": "4 + h1 - 1",
      "wl": "2 + floor(hash(seed, k, 8) * 2)"
     },
     "ops": [
      {
       "op": "box",
       "name": "Fuß",
       "at": [
        2,
        4,
        0
       ],
       "size": [
        "L1 + 1",
        1,
        1
       ],
       "color": "plant_dark"
      },
      {
       "op": "box",
       "name": "Riser",
       "at": [
        "2 + L1",
        4,
        0
       ],
       "size": [
        1,
        "h1",
        1
       ],
       "color": "plant"
      },
      {
       "op": "box",
       "name": "Fieder unten",
       "at": [
        "2 + L1",
        "yT - 2",
        1
       ],
       "size": [
        1,
        1,
        "wl"
       ],
       "color": "plant",
       "if": "hash(seed, k, 6) > 0.35"
      },
      {
       "op": "box",
       "name": "Fieder oben",
       "at": [
        "2 + L1",
        "yT",
        -2
       ],
       "size": [
        1,
        1,
        2
       ],
       "color": "plant_dark",
       "if": "t != 1 && hash(seed, k, 10) > 0.4"
      },
      {
       "op": "box",
       "name": "Spitze einstufig",
       "at": [
        "3 + L1",
        "yT",
        0
       ],
       "size": [
        "1 + d",
        1,
        1
       ],
       "color": "plant_light",
       "if": "t != 2"
      },
      {
       "op": "box",
       "name": "Stufe Quer",
       "at": [
        "2 + L1",
        "yT",
        "min(0, dz)"
       ],
       "size": [
        2,
        1,
        "abs(dz) + 1"
       ],
       "color": "plant",
       "if": "t == 2"
      },
      {
       "op": "box",
       "name": "Riser zwei",
       "at": [
        "3 + L1",
        "yT",
        "dz"
       ],
       "size": [
        1,
        "h2",
        1
       ],
       "color": "plant",
       "if": "t == 2"
      },
      {
       "op": "box",
       "name": "Spitze zweistufig",
       "at": [
        "3 + L1",
        "yT + h2 - 1",
        "dz"
       ],
       "size": [
        2,
        1,
        1
       ],
       "color": "plant_light",
       "if": "t == 2"
      }
     ]
    },
    {
     "op": "group",
     "name": "Wedel Ecke",
     "repeat": {
      "count": 4,
      "step": [
       0,
       0,
       0
      ],
      "var": "k"
     },
     "rot": "k * 90",
     "if": "typ == 1 || k % 2 == p || typ == 2 && hash(seed, k, 19) > 0.3",
     "let": {
      "b": "floor(hash(seed, k, 12) * 3)"
     },
     "ops": [
      {
       "op": "box",
       "name": "Ecke Steg",
       "at": [
        3,
        4,
        3
       ],
       "size": [
        1,
        "3 + b",
        1
       ],
       "color": "plant"
      },
      {
       "op": "box",
       "name": "Ecke Spitze",
       "at": [
        4,
        "6 + b",
        4
       ],
       "size": [
        1,
        1,
        1
       ],
       "color": "plant_light"
      }
     ]
    }
   ]
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}
