{
 "id": "biom/wiese/farn",
 "name": "Wiesenwald-Farn (VOX-02): niedriger Sichtschleier (0,8 bis 1,0 m), ohne Kollision, sperrt die Sicht. Dünne Wedel aus 1-Voxel-Balken mit Fiedern strahlen sternförmig um ein kleines dunkles Herz: bis zu vier Wedel über die Achsen (steil aufsteigend, oben überhängend, Fiedern quer, Spitze heller), dazwischen bis zu vier kürzere Wedel über die Diagonalen, in der Mitte ein aufrechter Austrieb mit Haken (er bestimmt die Höhe). seed wählt die Gestalt (seed % 3: 0 Vase, steil und schmal; 1 Spreizer, niedrig und weit mit allen Wedeln; 2 gemischt mit Lücken) sowie Höhe, Länge, Fiederbreite und Auslassung der Wedel",
 "tier": "detail",
 "palette": "biom_wiesenwald",
 "jitter": 0,
 "tags": [
  "biom",
  "wiese",
  "farn",
  "sichtschleier"
 ],
 "footprint": [
  1,
  1
 ],
 "budgetTris": 600,
 "ops": [
  {
   "op": "box",
   "name": "Herz",
   "at": [
    -1,
    0,
    -1
   ],
   "size": [
    3,
    3,
    3
   ],
   "color": "plant_dark"
  },
  {
   "op": "box",
   "name": "Austrieb",
   "at": [
    0,
    3,
    0
   ],
   "size": [
    1,
    "H0 - 3",
    1
   ],
   "color": "plant"
  },
  {
   "op": "box",
   "name": "Austrieb Haken",
   "at": [
    1,
    "H0 - 1",
    0
   ],
   "size": [
    2,
    1,
    1
   ],
   "color": "plant_light"
  },
  {
   "op": "group",
   "name": "Wedel Achse",
   "repeat": {
    "count": 4,
    "step": [
     0,
     0,
     0
    ],
    "var": "k"
   },
   "rot": "k * 90",
   "if": "1",
   "let": {
    "ya": "(typ == 0 ? 8 : typ == 1 ? 5 : 5) + floor(hash(seed, k, 1) * (typ == 0 ? 3 : typ == 1 ? 3 : 4))",
    "R": "(typ == 0 ? 4 : typ == 1 ? 6 : 4) + floor(hash(seed, k, 2) * (typ == 2 ? 3 : 2))",
    "w1": "typ == 1 ? 2 : floor(hash(seed, k, 3) * 2)"
   },
   "ops": [
    {
     "op": "box",
     "name": "Wedel Stiel",
     "at": [
      2,
      2,
      0
     ],
     "size": [
      1,
      "ya - 4",
      1
     ],
     "color": "plant"
    },
    {
     "op": "box",
     "name": "Wedel Bogen",
     "at": [
      2,
      "ya - 2",
      0
     ],
     "size": [
      "R - 2",
      1,
      1
     ],
     "color": "plant"
    },
    {
     "op": "box",
     "name": "Wedel Spitze",
     "at": [
      "R",
      "ya - 3",
      0
     ],
     "size": [
      1,
      2,
      1
     ],
     "color": "plant_light"
    },
    {
     "op": "box",
     "name": "Fieder 1",
     "at": [
      3,
      "ya - 2",
      "-w1"
     ],
     "size": [
      1,
      1,
      "2 * w1 + 1"
     ],
     "color": "plant"
    },
    {
     "op": "box",
     "name": "Fieder 2",
     "at": [
      5,
      "ya - 3",
      -1
     ],
     "size": [
      1,
      1,
      3
     ],
     "color": "plant_dark",
     "if": "typ != 0 && R >= 5"
    }
   ]
  },
  {
   "op": "group",
   "name": "Wedel Diagonale",
   "repeat": {
    "count": 4,
    "step": [
     0,
     0,
     0
    ],
    "var": "k"
   },
   "rot": "k * 90",
   "if": "typ != 1 && k % 2 == p",
   "let": {
    "yd": "(typ == 0 ? 6 : 5) + floor(hash(seed, k, 11) * 3)",
    "n": "typ == 1 ? 3 : 2 + floor(hash(seed, k, 12) * 2)"
   },
   "ops": [
    {
     "op": "box",
     "name": "Diag Stiel",
     "at": [
      1,
      3,
      1
     ],
     "size": [
      1,
      "yd - 3",
      1
     ],
     "color": "plant_dark"
    },
    {
     "op": "group",
     "name": "Diag Schritte",
     "repeat": {
      "count": 4,
      "step": [
       0,
       0,
       0
      ],
      "var": "t"
     },
     "if": "t < n",
     "let": {},
     "ops": [
      {
       "op": "box",
       "name": "Diag Balken",
       "at": [
        "1 + t",
        "yd",
        "1 + t"
       ],
       "size": [
        2,
        1,
        1
       ],
       "color": "plant"
      }
     ]
    },
    {
     "op": "box",
     "name": "Diag Spitze",
     "at": [
      "n + 1",
      "yd - 1",
      "n + 1"
     ],
     "size": [
      1,
      2,
      1
     ],
     "color": "plant_light"
    }
   ]
  }
 ],
 "anchor": [
  0,
  0,
  0
 ],
 "let": {
  "p": "floor(hash(seed, 77) * 2)",
  "H0": "13 + floor(hash(seed, 1) * 4)",
  "typ": "floor(seed) % 3"
 }
}
