{
 "id": "biom/wiese/strauch",
 "name": "Wiesenwald-Strauch (VOX-02): rund aus 25-cm-Blöcken (wie die Bäume), ohne Kollision, sperrt die Sicht (Sichtschleier). seed wählt die Gestalt: 0 Kuppel (1,25 m), 1 hoch und schmal (1,5 m), 2 zwei Hügel; seed 3, 4, … wiederholt die Gestalt mit anderem Versatz",
 "tier": "detail",
 "palette": "biom_wiesenwald",
 "jitter": 0,
 "tags": [
  "biom",
  "wiese",
  "strauch",
  "sichtschleier"
 ],
 "footprint": [
  1,
  1
 ],
 "budgetTris": 800,
 "variants": {
  "kuppel": {
   "seed": 0
  },
  "schmal": {
   "seed": 1
  },
  "huegel": {
   "seed": 2
  }
 },
 "let": {
  "typ": "floor(seed) % 3",
  "ox": "(hash(seed, 2) - 0.5) * 4",
  "oz": "(hash(seed, 3) - 0.5) * 4",
  "a": "hash(seed, 4) * 6.283",
  "sp": "typ == 1 ? 3 : 4",
  "o": "typ == 1 ? -6 : -8",
  "l1x": "typ == 0 ? ox * 0.5 : (typ == 1 ? ox * 0.5 : (-3.5))",
  "l1y": "typ == 0 ? 9 : (typ == 1 ? 11 : (7))",
  "l1z": "typ == 0 ? oz * 0.5 : (typ == 1 ? oz * 0.5 : (-2.5 + oz * 0.5))",
  "l1rx": "typ == 0 ? 8.3 : (typ == 1 ? 6.8 : (5.5))",
  "l1ry": "typ == 0 ? 10 : (typ == 1 ? 13 : (12))",
  "l1rz": "typ == 0 ? 8.3 : (typ == 1 ? 6.8 : (5.5))",
  "l2x": "typ == 0 ? cos(a) * 3.5 : (typ == 1 ? 0 : (3.5))",
  "l2y": "typ == 0 ? 10 : (typ == 1 ? -90 : (7))",
  "l2z": "typ == 0 ? sin(a) * 3.5 : (typ == 1 ? 0 : (3 + oz * 0.5))",
  "l2rx": "typ == 0 ? 5 : (typ == 1 ? 0.1 : (5.5))",
  "l2ry": "typ == 0 ? 8 : (typ == 1 ? 0.1 : (13))",
  "l2rz": "typ == 0 ? 5 : (typ == 1 ? 0.1 : (5.5))",
  "l3x": "0",
  "l3y": "-90",
  "l3z": "0",
  "l3rx": "0.1",
  "l3ry": "0.1",
  "l3rz": "0.1"
 },
 "ops": [
  {
   "op": "group",
   "name": "Blockgitter X",
   "repeat": {
    "count": "sp",
    "step": [
     4,
     0,
     0
    ],
    "var": "i"
   },
   "ops": [
    {
     "op": "group",
     "name": "Blockgitter Z",
     "repeat": {
      "count": "sp",
      "step": [
       0,
       0,
       4
      ],
      "var": "j"
     },
     "ops": [
      {
       "op": "group",
       "name": "Blockgitter Y",
       "repeat": {
        "count": 6,
        "step": [
         0,
         4,
         0
        ],
        "var": "k"
       },
       "let": {
        "X": "o + 2 + i * 4",
        "Y": "2 + k * 4",
        "Z": "o + 2 + j * 4",
        "d1": "((X - l1x) / l1rx) * ((X - l1x) / l1rx) + ((Y - l1y) / l1ry) * ((Y - l1y) / l1ry) + ((Z - l1z) / l1rz) * ((Z - l1z) / l1rz)",
        "d2": "((X - l2x) / l2rx) * ((X - l2x) / l2rx) + ((Y - l2y) / l2ry) * ((Y - l2y) / l2ry) + ((Z - l2z) / l2rz) * ((Z - l2z) / l2rz)",
        "d3": "((X - l3x) / l3rx) * ((X - l3x) / l3rx) + ((Y - l3y) / l3ry) * ((Y - l3y) / l3ry) + ((Z - l3z) / l3rz) * ((Z - l3z) / l3rz)"
       },
       "ops": [
        {
         "op": "box",
         "name": "Block (Vereinigung der Lappen)",
         "if": "min(d1, min(d2, d3)) <= 1",
         "at": [
          "o",
          0,
          "o"
         ],
         "size": [
          4,
          4,
          4
         ],
         "color": {
          "noise": [
           "plant",
           "plant_dark",
           "plant_light"
          ],
          "weights": [
           3,
           "k == 0 ? 3 : 0.6",
           "k >= 3 ? 1.6 : 0.2"
          ],
          "cell": 1000,
          "seed": "i * 13 + j * 7 + k * 31"
         }
        }
       ]
      }
     ]
    }
   ]
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}
