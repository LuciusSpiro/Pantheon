{
  "id": "fig/basis/kopf",
  "name": "Basis-Kopf (Mensch, 8er-Kopf): Hals, festes Gesicht, Frisur",
  "tier": "detail",
  "palette": "base",
  "tags": ["figur","basis","kopf"],
  "notes": "CHA-02 A2: 8er-Kopf aus Richtung A (FIG-01), wie cha/koerper/standard/head. Schädel 8×7×8 (x -4..3, y 26..32, z -4..3), Hals 4×4 bei y 25, festes Gesicht bei z = 3 (Augen 1×2, Mund, Wangen). Haut über skin/skin_shadow, Augen fest. Frisur 0 kahl, 1 kurz (Haarkappe), 2 Zopf (z -5), 3 lang (Vorhang hinten); Bart färbt y 26..27 (Mund wandert auf y 27).",
  "params": {"hair":{"default":1,"min":0,"max":3,"step":1,"label":"Frisur (0 kahl, 1 kurz, 2 Zopf, 3 lang)"},"beard":{"default":0,"min":0,"max":1,"step":1,"label":"Bart"}},
  "ops": [
    {"name": "Hals", "op": "box", "at": [-2,25,-2], "size": [4,1,4], "color": "skin_shadow", "jitter": false},
    {"name": "Schädel", "op": "box", "at": [-4,26,-4], "size": [8,7,8], "color": "skin", "jitter": false},
    {"name": "Kinnkanten", "op": "box", "at": [3,26,3], "size": [1,1,1], "mode": "carve", "mirror": "x", "mirrorAt": 0},
    {"name": "Augen", "op": "box", "at": [1,28,3], "size": [1,2,1], "color": "#1A120E", "mode": "paint", "jitter": false, "mirror": "x", "mirrorAt": 0},
    {"name": "Mund", "op": "box", "at": [-1,26,3], "size": [2,1,1], "color": {"shade": "skin", "f": 0.86}, "mode": "paint", "jitter": false},
    {"name": "Wangen", "op": "box", "at": [2,27,3], "size": [1,1,1], "color": {"shade": "skin", "f": 0.93}, "mode": "paint", "jitter": false, "mirror": "x", "mirrorAt": 0},
    {"name": "Haarkranz", "op": "box", "at": [-4,31,-4], "size": [8,1,7], "color": "hair", "if": "hair >= 1"},
    {"name": "Haar oben", "op": "box", "at": [-4,32,-4], "size": [8,1,8], "color": {"shade": "hair", "f": 1.12}, "if": "hair >= 1"},
    {"name": "Scheitel", "op": "box", "at": [0,32,-4], "size": [1,1,8], "color": {"shade": "hair", "f": 0.78}, "if": "hair >= 1", "mode": "paint"},
    {"name": "Haar hinten", "op": "box", "at": [-4,27,-4], "size": [8,4,1], "color": "hair", "if": "hair >= 1"},
    {"name": "Haar Seiten", "op": "box", "at": [3,28,-3], "size": [1,3,3], "color": "hair", "if": "hair >= 1", "mirror": "x", "mirrorAt": 0},
    {"name": "Strähne", "op": "box", "at": [-4,30,3], "size": [2,1,1], "color": "hair", "if": "hair >= 1"},
    {"name": "Zopf", "op": "box", "at": [-1,23,-5], "size": [2,7,1], "color": {"stripes": ["hair",{"shade": "hair", "f": 0.78}], "axis": "y", "period": 2}, "if": "hair == 2"},
    {"name": "Zopf-Band", "op": "box", "at": [-1,29,-5], "size": [2,1,1], "color": "primary", "if": "hair == 2"},
    {"name": "Langes Haar hinten", "op": "box", "at": [-4,22,-4], "size": [8,9,1], "color": "hair", "if": "hair == 3"},
    {"name": "Bart", "op": "box", "at": [-4,26,-1], "size": [8,2,5], "color": "hair", "if": "beard", "mode": "paint"},
    {"name": "Bart Mund frei", "op": "box", "at": [-1,27,3], "size": [2,1,1], "color": {"shade": "skin", "f": 0.86}, "if": "beard"}
  ],
  "variants": {"kahl": {"hair": 0}, "zopf": {"hair": 2}, "lang": {"hair": 3}, "bart": {"beard": 1}},
  "anchor": [0,0,0]
}
