{
  "id": "fig/basis/kopf",
  "name": "Basis-Kopf (Mensch): Hals, Gesicht, Frisur",
  "tier": "detail",
  "palette": "base",
  "tags": ["figur", "basis", "kopf"],
  "notes": "Schädel 4×5×5 (x -2..1, y 26..30, z -2..2), Gesicht bei z = 2. Bewusst schmal (keine Chibi-Köpfe).",
  "params": {
    "hair": { "default": 1, "min": 0, "max": 3, "step": 1, "label": "Frisur (0 kahl, 1 kurz, 2 Zopf, 3 lang)" },
    "beard": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Bart" }
  },
  "ops": [
    { "name": "Hals", "op": "box", "at": [-1, 25, -1], "size": [2, 1, 2], "color": "skin_shadow" },
    { "name": "Schädel", "op": "box", "at": [-2, 26, -2], "size": [4, 5, 5], "color": "skin" },
    { "name": "Kiefer-Ecken", "op": "box", "at": [1, 26, 2], "size": [1, 1, 1], "mode": "carve", "mirror": "x", "mirrorAt": 0 },
    { "name": "Kinn-Schatten", "op": "box", "at": [-1, 26, 2], "size": [2, 1, 1], "color": { "shade": "skin", "f": 0.9 } },
    { "name": "Nase", "op": "box", "at": [-1, 27, 3], "size": [2, 1, 1], "color": { "shade": "skin", "f": 0.95 } },
    { "name": "Augen", "op": "box", "at": [1, 28, 2], "size": [1, 1, 1], "color": "black", "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "name": "Brauen", "op": "box", "at": [1, 29, 2], "size": [1, 1, 1], "color": { "shade": "hair", "f": 1.15 }, "mirror": "x", "mirrorAt": 0 },
    { "name": "Ohren", "op": "box", "at": [2, 27, 0], "size": [1, 2, 1], "color": "skin_shadow", "mirror": "x", "mirrorAt": 0 },

    { "name": "Haar oben", "if": "hair >= 1", "op": "box", "at": [-2, 31, -2], "size": [4, 1, 4], "color": { "shade": "hair", "f": 1.08 } },
    { "name": "Haar Stirn", "if": "hair >= 1", "op": "box", "at": [-2, 30, 1], "size": [4, 1, 2], "color": "hair" },
    { "name": "Haar Krone", "if": "hair >= 1", "op": "box", "at": [-2, 30, -2], "size": [4, 1, 3], "color": "hair" },
    { "name": "Haar hinten", "if": "hair >= 1", "op": "box", "at": [-2, 27, -3], "size": [4, 4, 1], "color": "hair" },
    { "name": "Haar Seiten", "if": "hair >= 1", "op": "box", "at": [2, 28, -2], "size": [1, 3, 2], "color": "hair", "mirror": "x", "mirrorAt": 0 },
    { "name": "Zopf", "if": "hair == 2", "op": "box", "at": [-1, 23, -4], "size": [2, 7, 1], "color": { "stripes": ["hair", { "shade": "hair", "f": 0.78 }], "axis": "y", "period": 2 } },
    { "name": "Zopf-Band", "if": "hair == 2", "op": "box", "at": [-1, 29, -4], "size": [2, 1, 1], "color": "primary" },
    { "name": "Langes Haar hinten", "if": "hair == 3", "op": "box", "at": [-2, 24, -3], "size": [4, 7, 1], "color": "hair" },
    { "name": "Langes Haar Seiten", "if": "hair == 3", "op": "box", "at": [2, 25, -2], "size": [1, 6, 2], "color": "hair", "mirror": "x", "mirrorAt": 0 },
    { "name": "Bart", "if": "beard", "op": "box", "at": [-2, 26, 1], "size": [4, 2, 3], "color": "hair", "mode": "paint" },
    { "name": "Bart Nase frei", "if": "beard", "op": "box", "at": [-1, 27, 3], "size": [2, 1, 1], "color": { "shade": "skin", "f": 0.95 } }
  ],
  "variants": { "kahl": { "hair": 0 }, "zopf": { "hair": 2 }, "lang": { "hair": 3 }, "bart": { "beard": 1 } },
  "anchor": [0, 0, 0]
}
