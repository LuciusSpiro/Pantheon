{
  "id": "fig/rostmeute/kopf",
  "name": "Plünderer-Kopf: Schädelhelm (Schütze), Kapuze mit Halbmaske (Flanker), Helm mit Funk-Headset (Funker)",
  "tier": "detail",
  "palette": "rostmeute",
  "tags": ["figur", "rostmeute", "kopf", "helm", "gegner"],
  "notes": "role 0 Schütze / 1 Flanker / 2 Funker. Bandenzeichen: knochenweiße Maske mit roten Augen. Von oben: rostiger Helm bzw. Kapuze (Crew: weiße Helme).",
  "params": {
    "role": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Rolle (0 Schütze, 1 Flanker, 2 Funker)" }
  },
  "ops": [
    { "name": "Kopf", "op": "use", "model": "fig/basis/kopf", "params": { "hair": 0 } },

    { "name": "Helm", "op": "group", "if": "role != 1", "ops": [
      { "name": "Halsschutz", "op": "box", "at": [-2, 25, -2], "size": [4, 1, 4], "color": "metal_dark" },
      { "name": "Helmschale", "op": "box", "at": [-3, 26, -3], "size": [6, 5, 6], "mode": "under", "color": { "noise": ["primary", { "shade": "primary", "f": 0.78 }, "metal"], "weights": [4, 2, 1], "cell": 2 } },
      { "name": "Kalotte", "op": "box", "at": [-2, 31, -2], "size": [4, 1, 4], "color": { "shade": "primary", "f": 0.88 } },
      { "name": "Flickblech", "op": "box", "at": [2, 27, -3], "size": [1, 3, 3], "color": "secondary", "mode": "paint" },
      { "name": "Flickniete", "op": "box", "at": [2, 29, -1], "size": [1, 1, 1], "color": "dark", "mode": "paint" },
      { "name": "Schädelmaske", "op": "box", "at": [-3, 26, 3], "size": [6, 4, 1], "color": "trim" },
      { "name": "Zähne", "op": "box", "at": [-2, 26, 3], "size": [4, 1, 1], "color": { "stripes": ["trim", "dark"], "axis": "x", "period": 1 }, "jitter": false },
      { "name": "Nasenloch", "op": "box", "at": [-1, 27, 3], "size": [2, 1, 1], "color": "dark" },
      { "name": "Augenhöhlen", "op": "box", "at": [-3, 28, 3], "size": [6, 1, 1], "color": "dark" },
      { "name": "Rote Augen", "op": "box", "at": [1, 28, 3], "size": [1, 1, 1], "color": { "role": "glow", "emit": 2.0 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
      { "name": "Stirnwulst", "op": "box", "at": [-3, 29, 3], "size": [6, 1, 1], "color": { "shade": "trim", "f": 0.85 } }
    ] },

    { "name": "Knochenkamm (Schütze)", "op": "box", "if": "role == 0", "repeat": { "count": 3, "step": [0, 0, 2] }, "at": [-1, 32, -3], "size": [2, "i == 1 ? 3 : 2", 1], "color": "trim" },
    { "name": "Kammfuß (Schütze)", "op": "box", "if": "role == 0", "at": [-1, 32, -2], "size": [2, 1, 3], "color": "metal_dark" },

    { "name": "Headset (Funker)", "op": "group", "if": "role == 2", "ops": [
      { "name": "Hörmuschel", "op": "box", "at": [3, 27, -2], "size": [1, 3, 3], "color": "metal_dark" },
      { "name": "Hörmuschel Gegenseite", "op": "box", "at": [-4, 27, -1], "size": [1, 2, 2], "color": "metal_dark" },
      { "name": "Bügel", "op": "box", "at": [-3, 32, -1], "size": [6, 1, 1], "color": "metal" },
      { "name": "Mikrofonarm", "op": "line", "from": [3.5, 27.5, 0.5], "to": [1.5, 26.5, 4.5], "r": 0.5, "color": "metal_light" },
      { "name": "Mikrofon", "op": "box", "at": [0, 26, 4], "size": [2, 1, 1], "color": { "role": "glow2", "emit": 1.2 }, "jitter": false },
      { "name": "Kopfantenne", "op": "line", "from": [3.5, 30.5, -1.5], "to": [3.5, 34.5, -2.5], "r": 0.5, "color": "metal_light" }
    ] },

    { "name": "Kapuze (Flanker)", "op": "group", "if": "role == 1", "ops": [
      { "name": "Kapuze", "op": "box", "at": [-3, 26, -3], "size": [6, 6, 6], "mode": "under", "color": { "noise": ["leather", { "shade": "leather", "f": 0.8 }], "weights": [3, 1], "cell": 2 } },
      { "name": "Kapuzenspitze 1", "op": "box", "at": [-1, 29, -4], "size": [2, 3, 1], "color": { "shade": "leather", "f": 0.85 } },
      { "name": "Kapuzenspitze 2", "op": "box", "at": [-1, 28, -5], "size": [2, 2, 1], "color": { "shade": "leather", "f": 0.75 } },
      { "name": "Kapuzensaum Seiten", "op": "box", "at": [2, 25, 3], "size": [1, 6, 1], "color": { "shade": "leather", "f": 0.7 }, "mirror": "x", "mirrorAt": 0 },
      { "name": "Kapuzensaum oben", "op": "box", "at": [-3, 31, 3], "size": [6, 1, 1], "color": { "shade": "leather", "f": 0.7 } },
      { "name": "Halbmaske", "op": "box", "at": [-2, 26, 3], "size": [4, 2, 1], "color": "trim" },
      { "name": "Maskenzähne", "op": "box", "at": [-2, 26, 3], "size": [4, 1, 1], "color": { "stripes": ["trim", "dark"], "axis": "x", "period": 1 }, "jitter": false },
      { "name": "Brillenband", "op": "box", "at": [-2, 28, 3], "size": [4, 1, 1], "color": "dark" },
      { "name": "Brillengläser", "op": "box", "at": [1, 28, 3], "size": [1, 1, 1], "color": { "role": "glow", "emit": 2.0 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
      { "name": "Halstuch", "op": "box", "at": [-3, 24, -2], "size": [6, 2, 5], "color": "primary" }
    ] }
  ],
  "variants": { "flanker": { "role": 1 }, "funker": { "role": 2 } },
  "anchor": [0, 0, 0]
}
