{
  "id": "fig/rostmeute/rumpf",
  "name": "Plünderer-Rumpf: Flickpanzer (Schütze), Lederweste mit Halstuch (Flanker), Polsterweste mit Funkgerät und Antenne (Funker)",
  "tier": "detail",
  "palette": "rostmeute",
  "tags": ["figur", "rostmeute", "rumpf", "gegner"],
  "notes": "Funkgerät und Antenne sind fest am Rumpf (Rolle 2), der Rig-Anbaupunkt back bleibt frei. Antennenspitze 2,19 m über dem Boden.",
  "params": {
    "role": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Rolle (0 Schütze, 1 Flanker, 2 Funker)" }
  },
  "ops": [
    { "name": "Unterkleidung", "op": "use", "model": "fig/basis/rumpf" },

    { "name": "Flickpanzer (Schütze)", "op": "group", "if": "role == 0", "ops": [
      { "name": "Brustpanzer", "op": "box", "at": [-4, 19, -3], "size": [8, 5, 6], "color": { "noise": ["primary", { "shade": "primary", "f": 0.8 }], "weights": [3, 1], "cell": 2 } },
      { "name": "Flickblech Brust", "op": "box", "at": [0, 20, 2], "size": [3, 3, 1], "color": "secondary", "mode": "paint" },
      { "name": "Nieten", "op": "box", "at": [0, 22, 2], "size": [1, 1, 1], "color": "dark", "mode": "paint", "repeat": { "count": 2, "step": [2, -2, 0] } },
      { "name": "Warnstreifen", "op": "box", "at": [-4, 19, -3], "size": [8, 1, 6], "color": { "stripes": ["warning", "dark"], "axis": "x", "period": 1 }, "mode": "paint", "jitter": false },
      { "name": "Bandenzeichen Rücken", "op": "box", "at": [-3, 20, -3], "size": [1, 3, 1], "color": "trim", "mode": "paint", "repeat": { "count": 3, "step": [2, 0, 0] } },
      { "name": "Munitionstasche", "op": "box", "at": [-2, 17, -4], "size": [4, 3, 1], "color": "leather" }
    ] },

    { "name": "Lederweste (Flanker)", "op": "group", "if": "role == 1", "ops": [
      { "name": "Weste", "op": "box", "at": [-4, 18, -3], "size": [8, 6, 6], "color": { "noise": ["leather", { "shade": "leather", "f": 0.82 }], "weights": [3, 1], "cell": 2 } },
      { "name": "Weste offen", "op": "box", "at": [-1, 18, 2], "size": [2, 6, 1], "color": "cloth", "mode": "paint" },
      { "name": "Flicken Rücken", "op": "box", "at": [0, 20, -3], "size": [3, 2, 1], "color": "secondary", "mode": "paint" },
      { "name": "Halstuch Zipfel", "op": "box", "at": [-1, 20, -4], "size": [2, 4, 1], "color": "primary" },
      { "name": "Halstuch Ende", "op": "box", "at": [0, 18, -4], "size": [1, 2, 1], "color": { "shade": "primary", "f": 0.85 } }
    ] },

    { "name": "Funkerweste (Funker)", "op": "group", "if": "role == 2", "ops": [
      { "name": "Polsterweste", "op": "box", "at": [-4, 18, -3], "size": [8, 6, 6], "color": { "stripes": ["metal_light", { "shade": "metal_light", "f": 0.85 }], "axis": "y", "period": 2 } },
      { "name": "Tragegurte", "op": "box", "at": [1, 17, 2], "size": [1, 7, 1], "color": "leather", "mode": "paint", "mirror": "x", "mirrorAt": 0 },
      { "name": "Funkgerät", "op": "box", "at": [-3, 17, -6], "size": [6, 7, 3], "color": { "frame": "metal_dark", "fill": "secondary", "axes": "xy", "width": 1 } },
      { "name": "Funkgerät Rost", "op": "box", "at": [-3, 17, -6], "size": [3, 2, 1], "color": "primary", "mode": "paint" },
      { "name": "Skala", "op": "box", "at": [0, 21, -7], "size": [2, 1, 1], "color": { "role": "glow2", "emit": 1.2 }, "jitter": false },
      { "name": "Drehknöpfe", "op": "box", "at": [-2, 22, -7], "size": [1, 1, 1], "color": "trim", "repeat": { "count": 2, "step": [0, -2, 0] } },
      { "name": "Antenne", "op": "line", "from": [2.5, 23.5, -5.5], "to": [3.5, 33.5, -6.5], "r": 0.5, "color": "metal_light" },
      { "name": "Antennenspitze", "op": "box", "at": [3, 34, -7], "size": [1, 1, 1], "color": { "role": "glow", "emit": 2.2 }, "jitter": false },
      { "name": "Peitschenantenne", "op": "line", "from": [-2.5, 23.5, -5.5], "to": [-3.5, 30.5, -5.5], "r": 0.5, "color": "metal" },
      { "name": "Kabel", "op": "line", "from": [-3.5, 19.5, -4.5], "to": [-4.5, 22.5, 0.5], "r": 0.5, "color": "dark" }
    ] },

    { "name": "Patronengurt", "op": "line", "from": [3.5, 24.5, 3.5], "to": [-3.5, 17.5, 3.5], "r": 0.5, "color": "leather" },
    { "name": "Patronen", "op": "box", "at": [1, 22, 3], "size": [1, 1, 1], "color": "metal_light", "mode": "paint", "repeat": { "count": 3, "step": [-2, -2, 0] } }
  ],
  "variants": { "flanker": { "role": 1 }, "funker": { "role": 2 } },
  "anchor": [0, 0, 0]
}
