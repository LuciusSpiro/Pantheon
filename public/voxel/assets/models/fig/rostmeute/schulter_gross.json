{
  "id": "fig/rostmeute/schulter_gross",
  "name": "Plünderer-Oberarm links mit großem Schulterstück (Bandenseite)",
  "tier": "detail",
  "palette": "rostmeute",
  "tags": ["figur", "rostmeute", "arm", "ruestung", "gegner"],
  "notes": "Asymmetrie ist Absicht: links ein großes Rost-/Knochenstück, rechts (schulter_flick) ein kleines Flickblech. Von oben das deutlichste Merkmal gegen die Crew.",
  "params": {
    "role": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Rolle (0 Schütze, 1 Flanker, 2 Funker)" }
  },
  "ops": [
    { "name": "Ärmel", "op": "use", "model": "fig/basis/oberarm" },

    { "name": "Schulterstück groß (Schütze)", "op": "group", "if": "role == 0", "ops": [
      { "name": "Schale", "op": "box", "at": [4, 21, -3], "size": [5, 3, 7], "color": { "noise": ["primary", { "shade": "primary", "f": 0.78 }], "weights": [3, 1], "cell": 2 } },
      { "name": "Knochenplatte", "op": "box", "at": [4, 24, -3], "size": [4, 1, 7], "color": "trim" },
      { "name": "Kante rund", "op": "box", "at": [8, 23, -3], "size": [1, 1, 1], "mode": "carve", "mirror": "z", "mirrorAt": 0.5 },
      { "name": "Stacheln", "op": "box", "at": [6, 25, -2], "size": [1, 2, 1], "color": { "shade": "trim", "f": 0.9 }, "repeat": { "count": 3, "step": [0, 0, 2] } },
      { "name": "Warnrand", "op": "box", "at": [4, 21, -3], "size": [5, 1, 7], "color": { "stripes": ["warning", "dark"], "axis": "z", "period": 1 }, "mode": "paint", "jitter": false }
    ] },
    { "name": "Schulterpolster (Flanker)", "op": "group", "if": "role == 1", "ops": [
      { "name": "Polster", "op": "box", "at": [4, 22, -2], "size": [4, 2, 5], "color": "leather" },
      { "name": "Knochenscheibe", "op": "box", "at": [5, 24, -1], "size": [2, 1, 3], "color": "trim" },
      { "name": "Riemen", "op": "box", "at": [4, 20, -1], "size": [3, 1, 3], "color": "dark" }
    ] },
    { "name": "Schulterstück mittel (Funker)", "op": "group", "if": "role == 2", "ops": [
      { "name": "Schale", "op": "box", "at": [4, 21, -2], "size": [5, 3, 5], "color": "primary" },
      { "name": "Knochenplatte", "op": "box", "at": [4, 24, -2], "size": [4, 1, 5], "color": "trim" },
      { "name": "Flicken", "op": "box", "at": [8, 21, -1], "size": [1, 2, 2], "color": "secondary", "mode": "paint" }
    ] },
    { "name": "Armbinde", "op": "box", "at": [4, 18, -1], "size": [3, 1, 3], "color": "primary" }
  ],
  "variants": { "flanker": { "role": 1 }, "funker": { "role": 2 } },
  "anchor": [0, 0, 0]
}
