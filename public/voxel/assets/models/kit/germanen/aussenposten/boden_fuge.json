{
  "id": "kit/germanen/aussenposten/boden_fuge",
  "name": "Außenposten Stabbau – boden_fuge: Innenboden helles Eisen, kalte Plattenfuge; Glut nur als seltene Linie (Nordrand, jede vierte Kachel)",
  "tier": "architecture",
  "palette": "nord",
  "tags": [
    "germanen",
    "aussenposten",
    "slot",
    "stabbau",
    "ort01"
  ],
  "notes": "ORT-01 K2 (Gruppe 2b), Integration: Glutraster (\"Lava-Waffel\") entfernt. paint am N- und W-Rand → 1-m-Raster; Glut nur an Kacheln mit seed == 0 (seed = Muster-Hash 0..3), emit 0,45, #FF7A1A.",
  "jitter": 0,
  "params": {
    "w": {
      "default": 4,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Breite (Voxel)"
    },
    "h": {
      "default": 1,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Höhe (Voxel)"
    },
    "d": {
      "default": 4,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tiefe (Voxel)"
    },
    "zustand": {
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 1,
      "label": "0 intakt · 1 verfallen · 2 umkämpft"
    },
    "belag": {
      "default": 0,
      "min": 0,
      "max": 3,
      "step": 1,
      "label": "Belag"
    },
    "art": {
      "default": "aussenposten",
      "options": [
        "aussenposten",
        "station",
        "ruine",
        "schiff"
      ],
      "label": "Kartenart"
    }
  },
  "anchor": [
    0,
    0,
    0
  ],
  "let": {
    "dk": "1 - zustand * 0.06",
    "em": "zustand < 2 ? 0.45 : 0"
  },
  "ops": [
    {
      "name": "Platte (für sich allein, im Gerüst nur Anstrich)",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "metal_light",
        "f": "0.72 * dk"
      },
      "if": "belag == 2"
    },
    {
      "name": "Platte Hof",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "metal_light",
        "f": "0.8 * dk"
      },
      "if": "belag != 2"
    },
    {
      "name": "Glutfuge N",
      "op": "box",
      "at": [
        0,
        "h - 1",
        0
      ],
      "size": [
        "w",
        1,
        1
      ],
      "mode": "paint",
      "color": "#FF7A1A",
      "emit": "em",
      "if": "belag == 2 && zustand < 2 && floor(seed) == 0"
    },
    {
      "name": "Fuge kalt N",
      "op": "box",
      "at": [
        0,
        "h - 1",
        0
      ],
      "size": [
        "w",
        1,
        1
      ],
      "mode": "paint",
      "color": {
        "shade": "metal_dark",
        "f": "dk"
      },
      "if": "belag != 2 || zustand == 2 || floor(seed) != 0"
    },
    {
      "name": "Fuge kalt W",
      "op": "box",
      "at": [
        0,
        "h - 1",
        1
      ],
      "size": [
        1,
        1,
        "d - 1"
      ],
      "mode": "paint",
      "color": {
        "shade": "metal_dark",
        "f": "dk"
      }
    }
  ]
}
