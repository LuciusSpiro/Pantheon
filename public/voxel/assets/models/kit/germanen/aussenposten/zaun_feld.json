{
  "id": "kit/germanen/aussenposten/zaun_feld",
  "name": "Außenposten – zaun_feld: Palisadenstämme mit heller, bereifter Spitzenkrone",
  "tier": "architecture",
  "palette": "nord",
  "tags": ["germanen", "aussenposten", "slot"],
  "jitter": 0,
  "params": {
    "w": {"default": 2, "min": 1, "max": 16, "step": 1, "label": "Breite (Voxel)"},
    "h": {"default": 9, "min": 1, "max": 16, "step": 1, "label": "Höhe (Voxel)"},
    "d": {"default": 1, "min": 1, "max": 4, "step": 1, "label": "Tiefe (Voxel)"},
    "zustand": {"default": 0, "min": 0, "max": 2, "step": 1, "label": "0 intakt · 1 verfallen · 2 umkämpft"}
  },
  "ops": [
    {"name": "Stämme", "op": "box", "at": [0, 0, 0], "size": ["w", "h", "d"], "color": {"stripes": [{"shade": "wood", "f": "1 - zustand * 0.12"}, {"shade": "wood", "f": "0.8 - zustand * 0.1"}], "axis": "x", "period": 1}},
    {"name": "Krone hell (geschält)", "op": "box", "at": [0, "h - 2", 0], "size": ["w", 2, "d"], "mode": "paint", "color": {"shade": "wood", "f": "1.45 - zustand * 0.1"}},
    {"name": "Spitzen (jeder zweite Stamm kürzer)", "op": "box", "repeat": {"count": "w", "step": [1, 0, 0], "var": "i"}, "if": "(i + floor(hash(seed, 7) * 2)) % 2 == 0", "at": [0, "h - 1", 0], "size": [1, 1, "d"], "mode": "carve"},
    {"name": "Spitzen bereift", "op": "box", "at": [0, "h - 1", 0], "size": ["w", 1, "d"], "mode": "paint", "color": "frost"},
    {"name": "Seilbund unten", "op": "box", "at": [0, 2, 0], "size": ["w", 1, "d"], "mode": "paint", "color": "leather"},
    {"name": "Seilbund oben", "op": "box", "if": "h > 6", "at": [0, "h - 4", 0], "size": ["w", 1, "d"], "mode": "paint", "color": "leather"},
    {"name": "Frostwehe am Fuß", "op": "box", "at": [0, 0, 0], "size": ["w", 1, "d"], "mode": "paint", "color": "frost_dark"},
    {"name": "Ruß (umkämpft)", "op": "box", "if": "zustand == 2", "at": [0, 1, 0], "size": ["w", "h - 4", "d"], "mode": "paint", "color": {"noise": [{"shade": "wood", "f": 0.75}, "dark", "wood_dark"], "weights": [2, 1, 2], "seed": "seed"}}
  ],
  "anchor": [0, 0, 0]
}
