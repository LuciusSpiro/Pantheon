    "h",
    "d"
   ],
   "color": {
    "shade": "metal_light",
    "f": "0.9 * dk"
   }
  },
  {
   "name": "Flügelfuge",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    0,
    0
   ],
   "size": [
    2,
    "h",
    "d"
   ],
   "color": {
    "shade": "metal_dark",
    "f": "dk"
   },
