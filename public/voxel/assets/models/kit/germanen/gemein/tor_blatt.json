{
 "id": "kit/germanen/gemein/tor_blatt",
 "name": "Germanen gemein – tor_blatt (blatt): Großes Bohlentor: zwei Flügel, drei Eisenbänder, Z-Streben",
 "tier": "architecture",
 "palette": "nord",
 "tags": [
  "germanen",
  "gemein",
  "slot"
 ],
 "notes": "ART-GK-BAU, gemeinsamer Steckplatz (Fallback für alle Kartenarten ohne eigenes Teil). Füllt seinen Kasten in der Kantenschicht voll (Naht); Zustand dunkelt ab (dk), umkämpft Ruß.",
 "jitter": 0,
 "params": {
  "w": {
   "default": 8,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Breite (Voxel)"
  },
  "h": {
   "default": 9,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Höhe (Voxel)"
  },
  "d": {
   "default": 2,
   "min": 1,
   "max": 4,
   "step": 1,
   "label": "Tiefe (Voxel)"
  },
  "zustand": {
   "default": 0,
   "min": 0,
   "max": 2,
   "step": 1,
   "label": "0 intakt · 1 verfallen · 2 umkämpft"
  },
  "state": {
   "default": 0,
   "min": 0,
   "max": 3,
   "step": 1,
   "label": "0 zu"
  }
 },
 "let": {
  "dk": "1 - zustand * 0.1"
 },
 "variants": {},
 "ops": [
  {
   "name": "Bohlen",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "stripes": [
     {
      "shade": "wood",
      "f": "0.92 * dk"
     },
     {
      "shade": "wood",
      "f": "0.8 * dk"
     }
    ],
    "axis": "x",
    "period": 1
   }
  },
  {
   "name": "Z-Strebe links",
   "op": "line",
   "mode": "paint",
   "from": [
    1,
    1,
    "d - 1"
   ],
   "to": [
    "floor(w / 2) - 2",
    "h - 2",
    "d - 1"
   ],
   "r": 0.5,
   "color": {
    "shade": "wood_dark",
    "f": "dk"
   },
   "if": "w >= 8 && h >= 6"
  },
  {
   "name": "Z-Strebe rechts",
   "op": "line",
   "mode": "paint",
   "from": [
    "w - 2",
    1,
    "d - 1"
   ],
   "to": [
    "floor(w / 2) + 1",
    "h - 2",
    "d - 1"
   ],
   "r": 0.5,
   "color": {
    "shade": "wood_dark",
    "f": "dk"
   },
   "if": "w >= 8 && h >= 6"
  },
  {
   "name": "Flügelfuge",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    0,
    0
   ],
   "size": [
    2,
    "h",
    "d"
   ],
   "color": {
    "shade": "wood_dark",
    "f": "0.75 * dk"
   },
   "mode": "paint"
  },
  {
   "name": "Eisenband",
   "op": "box",
   "at": [
    0,
    "1 + i * floor((h - 2) / 2)",
    0
   ],
   "size": [
    "w",
    1,
    "d"
   ],
   "color": {
    "shade": "metal_dark",
    "f": "dk"
   },
   "mode": "paint",
   "if": "h >= 4",
   "repeat": {
    "count": 3,
    "step": [
     0,
     0,
     0
    ],
    "var": "i"
   }
  },
  {
   "name": "Ruß (umkämpft)",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "noise": [
     {
      "shade": "wood",
      "f": 0.7
     },
     "dark",
     {
      "shade": "wood",
      "f": 0.85
     }
    ],
    "weights": [
     3,
     1,
     2
    ],
    "seed": "seed"
   },
   "mode": "paint",
   "if": "zustand == 2"
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}
