{
 "id": "kit/germanen/gemein/truemmer_haufen",
 "name": "Germanen gemein – truemmer_haufen: Granitbrocken, Bohlen und ein zerbrochener Schild (≤ 0,75 m)",
 "tier": "architecture",
 "palette": "nord",
 "tags": [
  "germanen",
  "gemein",
  "slot"
 ],
 "notes": "ART-GK-BAU, gemeinsamer Steckplatz (Fallback für alle Kartenarten ohne eigenes Teil). Füllt seinen Kasten in der Kantenschicht voll (Naht); Zustand dunkelt ab (dk), umkämpft Ruß.",
 "jitter": 0,
 "params": {
  "w": {
   "default": 4,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Breite (Voxel)"
  },
  "h": {
   "default": 3,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Höhe (Voxel)"
  },
  "d": {
   "default": 4,
   "min": 1,
   "max": 4,
   "step": 1,
   "label": "Tiefe (Voxel)"
  },
  "zustand": {
   "default": 0,
   "min": 0,
   "max": 2,
   "step": 1,
   "label": "0 intakt · 1 verfallen · 2 umkämpft"
  }
 },
 "let": {
  "dk": "1 - zustand * 0.1"
 },
 "variants": {
  "a": {
   "seed": 1
  },
  "b": {
   "seed": 2
  }
 },
 "ops": [
  {
   "name": "Bett",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    1,
    "d"
   ],
   "color": {
    "checker": [
     {
      "shade": "stone_dark",
      "f": "dk"
     },
     {
      "shade": "stone",
      "f": "0.85 * dk"
     }
    ],
    "period": 2
   }
  },
  {
   "name": "Mitte",
   "op": "box",
   "at": [
    "floor(hash(seed, 1) * 2)",
    1,
    "floor(hash(seed, 2) * 2)"
   ],
   "size": [
    "max(1, w - 1)",
    1,
    "max(1, d - 2)"
   ],
   "color": {
    "shade": "stone",
    "f": "dk"
   },
   "if": "h >= 2"
  },
  {
   "name": "Spitze",
   "op": "box",
   "at": [
    "1 + floor(hash(seed, 3) * 2)",
    2,
    1
   ],
   "size": [
    1,
    1,
    2
   ],
   "color": {
    "shade": "stone_dark",
    "f": "dk"
   },
   "if": "h >= 3"
  },
  {
   "name": "Bohle",
   "op": "line",
   "from": [
    0,
    1,
    "d - 1"
   ],
   "to": [
    "w - 1",
    "min(h - 1, 2)",
    "d - 1"
   ],
   "r": 0.5,
   "color": {
    "shade": "wood",
    "f": "0.9 * dk"
   },
   "if": "h >= 2 && w >= 3"
  },
  {
   "name": "Schildrest",
   "op": "box",
   "at": [
    "floor(hash(seed, 6) * max(1, w - 1))",
    1,
    "floor(hash(seed, 7) * max(1, d - 1))"
   ],
   "size": [
    1,
    1,
    1
   ],
   "color": {
    "shade": "cloth",
    "f": "0.85 * dk"
   },
   "mode": "paint",
   "if": "h >= 2"
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}
