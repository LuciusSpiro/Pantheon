    "w - 1",
    1,
    "floor(hash(seed, 4) * d)"
   ],
   "r": 0.5,
   "color": {
    "shade": "metal_light",
    "f": "0.9 * dk"
   },
   "if": "h >= 2 && hash(seed, 5) < 0.7"
  },
  {
   "name": "Glutrest",
   "op": "box",
   "at": [
    "floor(hash(seed, 6) * w)",
    0,
    "floor(hash(seed, 7) * d)"
   ],
   "size": [
    1,
    1,
    1
   ],
   "color": {
    "role": "ember",
    "emit": 0.5
   },
