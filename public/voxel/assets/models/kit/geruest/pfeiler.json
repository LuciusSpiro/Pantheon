{
  "id": "kit/geruest/pfeiler",
  "name": "Bausatz-Gerüst – Pfeiler (3 m, Schaft 50 cm, volle Deckung)",
  "tier": "architecture",
  "palette": "base",
  "tags": ["kit","geruest","pfeiler"],
  "footprint": [1,1],
  "jitter": 0,
  "slots": ["pfeiler_fuss","pfeiler_schaft","pfeiler_kopf"],
  "params": {
    "conn": {"default":10,"min":0,"max":15,"step":1,"label":"Nachbarn gleicher Klasse (N1 O2 S4 W8)"},
    "cut": {"default":0,"min":0,"max":1,"step":1,"label":"Geschnitten (1,25 m)"},
    "zustand": {"default":0,"min":0,"max":2,"step":1,"label":"0 intakt · 1 verfallen · 2 umkämpft"},
    "art": {"default":"station","options":["aussenposten","station","ruine","schiff"],"label":"Kartenart"},
    "bauweise": {"default":"neutral","options":["neutral","test","germanen","rom","vorlaeufer","konkordat"],"label":"Bauweise (füllt die Steckplätze)"}
  },
  "variants": {
    "frei": {"conn":0},
    "ende": {"conn":2},
    "ecke": {"conn":6},
    "t": {"conn":7},
    "kreuz": {"conn":15},
    "geschnitten": {"cut":1},
    "verfallen": {"zustand":1,"seed":1},
    "umkaempft": {"zustand":2,"seed":2},
    "probe": {"bauweise":"test"},
    "probe_ecke": {"bauweise":"test","conn":6,"art":"aussenposten"},
    "probe_station": {"bauweise":"test","art":"station"},
    "probe_ruine_verfallen": {"bauweise":"test","art":"ruine","zustand":2,"seed":3}
  },
  "let": {
    "cn": "floor(conn) % 2",
    "ce": "floor(conn / 2) % 2",
    "cs": "floor(conn / 4) % 2",
    "cw": "floor(conn / 8) % 2",
    "H": "cut ? 5 : 12"
  },
  "ops": [
    {"name":"Steckplatz pfeiler_fuss","op":"use","model":"kit/{bauweise}/{art}/pfeiler_fuss","fallback":["kit/{bauweise}/gemein/pfeiler_fuss","kit/geruest/slot/pfeiler_fuss"],"at":[0,0,0],"params":{"cut":"cut","zustand":"zustand","art":"{art}","seed":"seed","conn":"conn","w":4,"h":1,"d":4}},
    {"name":"Steckplatz pfeiler_schaft","op":"use","model":"kit/{bauweise}/{art}/pfeiler_schaft","fallback":["kit/{bauweise}/gemein/pfeiler_schaft","kit/geruest/slot/pfeiler_schaft"],"at":[1,1,1],"params":{"cut":"cut","zustand":"zustand","art":"{art}","seed":"seed","conn":"conn","w":2,"h":"H - 2","d":2}},
    {"op":"group","name":"Verbindung je Anschluss (Pfeilerreihe wird Mauer)","repeat":{"count":4,"step":[0,0,0],"var":"f"},"rot":"f * 90","pivot":[2,2],"let":{"fc":"f == 0 ? cs : f == 1 ? ce : f == 2 ? cn : cw"},"ops":[{"name":"Steckplatz pfeiler_schaft","op":"use","model":"kit/{bauweise}/{art}/pfeiler_schaft","fallback":["kit/{bauweise}/gemein/pfeiler_schaft","kit/geruest/slot/pfeiler_schaft"],"at":[1,1,3],"params":{"cut":"cut","zustand":"zustand","art":"{art}","seed":"seed * 4 + f","conn":"conn","w":2,"h":"H - 2","d":1},"if":"fc"}]},
    {"name":"Steckplatz pfeiler_kopf","op":"use","model":"kit/{bauweise}/{art}/pfeiler_kopf","fallback":["kit/{bauweise}/gemein/pfeiler_kopf","kit/geruest/slot/pfeiler_kopf"],"at":[0,"H - 1",0],"params":{"cut":"cut","zustand":"zustand","art":"{art}","seed":"seed","conn":"conn","w":4,"h":1,"d":4}},
    {"name":"Verfall (schont Anschlussnähte und Unterkante)","op":"erode","if":"zustand > 0","density":"zustand == 1 ? 0.2 : 0.35","depth":"zustand","at":["cw",0,"cn"],"size":["4 - cw - ce","H","4 - cn - cs"]}
  ],
  "anchor": [2,0,2]
}
