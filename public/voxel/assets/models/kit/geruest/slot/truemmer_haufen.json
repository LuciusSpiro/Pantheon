{
  "id": "kit/geruest/slot/truemmer_haufen",
  "name": "Gerüst-Steckplatz truemmer_haufen (neutral): Trümmerhaufen (Stufen, per seed)",
  "tier": "architecture",
  "palette": "base",
  "tags": ["geruest","slot"],
  "jitter": 0,
  "params": {
    "w": {"default":4,"min":1,"max":16,"step":1,"label":"Breite (Voxel)"},
    "h": {"default":4,"min":1,"max":16,"step":1,"label":"Höhe (Voxel)"},
    "d": {"default":1,"min":1,"max":4,"step":1,"label":"Tiefe (Voxel)"},
    "zustand": {"default":0,"min":0,"max":2,"step":1,"label":"0 intakt · 1 verfallen · 2 umkämpft"}
  },
  "ops": [
    {"name":"Füllung","op":"box","at":[0,0,0],"size":["w",1,"d"],"color":{"shade":"rock","f":"1 * (1 - zustand * 0.1)"}},
    {"name":"Mitte","op":"box","at":["floor(hash(seed, 1) * 2)",1,"floor(hash(seed, 2) * 2)"],"size":["max(1, w - 1)",1,"max(1, d - 1)"],"color":{"shade":"rock_dark","f":"1 * (1 - zustand * 0.1)"}},
    {"name":"Spitze","op":"box","if":"h >= 3","at":["1 + floor(hash(seed, 3) * 2)",2,1],"size":[1,1,2],"color":{"shade":"rock","f":"1 * (1 - zustand * 0.1)"}}
  ],
  "anchor": [0,0,0]
}
