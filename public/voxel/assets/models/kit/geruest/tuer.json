    {"name":"Steckplatz tuer_rahmen","op":"use","model":"kit/{bauweise}/{art}/tuer_rahmen","fallback":["kit/{bauweise}/gemein/tuer_rahmen","kit/geruest/slot/tuer_rahmen"],"at":[0,10,0],"params":{"cut":"cut","zustand":"zustand","art":"{art}","seed":"seed","w":"W","h":3,"d":4,"teil":1,"state":"state"},"if":"!cut"},
    {"name":"Steckplatz tuer_blatt","op":"use","model":"kit/{bauweise}/{art}/tuer_blatt","fallback":["kit/{bauweise}/gemein/tuer_blatt","kit/geruest/slot/tuer_blatt"],"at":[0,1,1],"params":{"cut":"cut","zustand":"zustand","art":"{art}","seed":"seed","w":"W","h":"cut ? 5 : 9","d":2,"state":"state"},"if":"zu"},
    {"name":"Verfall am Sturz","op":"erode","if":"zustand > 0 && !cut","density":"zustand == 1 ? 0.2 : 0.35","depth":"zustand","at":[1,10,0],"size":["W - 2",3,4]}
  ],
  "anchor": [4,1,2]
