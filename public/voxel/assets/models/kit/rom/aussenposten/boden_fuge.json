{
  "id": "kit/rom/aussenposten/boden_fuge",
  "name": "Rom Außenposten boden_fuge: Travertinfugen nur an den Grenzen von 2x2-Kachelblöcken, kein Amber im Boden",
  "tier": "architecture",
  "palette": "rom",
  "tags": [
    "rom",
    "aussenposten",
    "slot",
    "ort01"
  ],
  "jitter": 0,
  "params": {
    "w": {
      "default": 4,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Breite (Voxel)"
    },
    "h": {
      "default": 1,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Höhe (Voxel)"
    },
    "d": {
      "default": 4,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tiefe (Voxel)"
    },
    "zustand": {
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 1,
      "label": "0 intakt · 1 verfallen · 2 umkämpft"
    },
    "belag": {
      "default": 0,
      "min": 0,
      "max": 3,
      "step": 1,
      "label": "0 Hof · 1 Landefeld · 2 Gebäude und Weg (Gunmetal) · 3 Plateau"
    },
    "art": {
      "default": "aussenposten",
      "options": [
        "aussenposten",
        "station",
        "ruine",
        "schiff"
      ],
      "label": "Kartenart"
    },
    "par": {
      "default": -1,
      "min": -1,
      "max": 3,
      "step": 1,
      "label": "Kachellage im 2x2-Block: x mod 2 + 2 * (y mod 2), -1 = unbekannt"
    }
  },
  "ops": [
    {
      "name": "Grund Hof",
      "op": "box",
      "if": "belag == 0",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "stone",
        "f": "0.95 * (1 - zustand * 0.06)"
      },
      "jitter": false
    },
    {
      "name": "Grund Landefeld",
      "op": "box",
      "if": "belag == 1",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "secondary",
        "f": "0.9 * (1 - zustand * 0.06)"
      },
      "jitter": false
    },
    {
      "name": "Grund Innen",
      "op": "box",
      "if": "belag == 2",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "metal_dark",
        "f": "1.3 * (1 - zustand * 0.06)"
      },
      "jitter": false
    },
    {
      "name": "Grund Plateau",
      "op": "box",
      "if": "belag == 3",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "stone_light",
        "f": "0.9 * (1 - zustand * 0.06)"
      },
      "jitter": false
    },
    {
      "name": "Fuge Landefeld N",
      "op": "box",
      "mode": "paint",
      "if": "py == 0 && (belag == 1 || belag == 3)",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        1
      ],
      "color": {
        "shade": "stone_dark",
        "f": "0.9 * (1 - zustand * 0.06)"
      },
      "jitter": false
    },
    {
      "name": "Fuge Landefeld W",
      "op": "box",
      "mode": "paint",
      "if": "px == 0 && (belag == 1 || belag == 3)",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        1,
        "h",
        "d"
      ],
      "color": {
        "shade": "stone_dark",
        "f": "0.9 * (1 - zustand * 0.06)"
      },
      "jitter": false
    },
    {
      "name": "Fuge Innen W",
      "op": "box",
      "mode": "paint",
      "if": "px == 0 && (belag == 2)",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        1,
        "h",
        "d"
      ],
      "color": {
        "shade": "stone",
        "f": "0.92 * (1 - zustand * 0.06)"
      },
      "jitter": false
    },
    {
      "name": "Fuge Innen N",
      "op": "box",
      "mode": "paint",
      "if": "py == 0 && (belag == 2)",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        1
      ],
      "color": {
        "shade": "stone",
        "f": "0.92 * (1 - zustand * 0.06)"
      },
      "jitter": false
    }
  ],
  "anchor": [
    0,
    0,
    0
  ],
  "let": {
    "px": "par < 0 ? 0 : floor(par) % 2",
    "py": "par < 0 ? 0 : floor(par / 2) % 2"
  }
}
