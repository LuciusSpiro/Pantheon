{
  "id": "kit/rom/aussenposten/wand_krone",
  "name": "Rom Außenposten wand_krone: Travertinkrone mit Amber-Rinne als Ein-Voxel-Linie entlang der Wandrichtung",
  "tier": "architecture",
  "palette": "rom",
  "tags": [
    "rom",
    "aussenposten",
    "slot",
    "ort01"
  ],
  "jitter": 0,
  "params": {
    "w": {
      "default": 4,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Breite (Voxel)"
    },
    "h": {
      "default": 1,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Höhe (Voxel)"
    },
    "d": {
      "default": 4,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tiefe (Voxel)"
    },
    "zustand": {
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 1,
      "label": "0 intakt · 1 verfallen · 2 umkämpft"
    },
    "conn": {
      "default": 10,
      "min": 0,
      "max": 15,
      "step": 1,
      "label": "Nachbarn (N1 O2 S4 W8)"
    }
  },
  "let": {
    "cn": "floor(conn) % 2",
    "ce": "floor(conn / 2) % 2",
    "cs": "floor(conn / 4) % 2",
    "cw": "floor(conn / 8) % 2"
  },
  "ops": [
    {
      "name": "Krone",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "stone_light",
        "f": "0.98 * (1 - zustand * 0.06)"
      }
    },
    {
      "name": "Rinne-Einfassung x (beidseitig)",
      "op": "box",
      "mode": "paint",
      "if": "(ce || cw || conn == 0) && d >= 3",
      "at": [0, 0, 0],
      "size": ["w", 1, 1],
      "color": { "shade": "stone_dark", "f": 0.8 },
      "jitter": false
    },
    {
      "name": "Rinne-Einfassung x (Reihe 2)",
      "op": "box",
      "mode": "paint",
      "if": "(ce || cw || conn == 0) && d >= 3",
      "at": [0, 0, 2],
      "size": ["w", 1, 1],
      "color": { "shade": "stone_dark", "f": 0.8 },
      "jitter": false
    },
    {
      "name": "Rinne-Einfassung z (Spalte 0)",
      "op": "box",
      "mode": "paint",
      "if": "(cn || cs) && w >= 3",
      "at": [0, 0, 0],
      "size": [1, 1, "d"],
      "color": { "shade": "stone_dark", "f": 0.8 },
      "jitter": false
    },
    {
      "name": "Rinne-Einfassung z (Spalte 2)",
      "op": "box",
      "mode": "paint",
      "if": "(cn || cs) && w >= 3",
      "at": [2, 0, 0],
      "size": [1, 1, "d"],
      "color": { "shade": "stone_dark", "f": 0.8 },
      "jitter": false
    },
    {
      "name": "Rinne Mitte",
      "op": "box",
      "mode": "paint",
      "at": [
        1,
        0,
        1
      ],
      "size": [
        1,
        1,
        1
      ],
      "color": {
        "role": "glow2",
        "emit": 1.1
      },
      "jitter": false
    },
    {
      "name": "Rinne N",
      "op": "box",
      "mode": "paint",
      "if": "floor(conn) % 2",
      "at": [
        1,
        0,
        0
      ],
      "size": [
        1,
        1,
        1
      ],
      "color": {
        "role": "glow2",
        "emit": 1.1
      },
      "jitter": false
    },
    {
      "name": "Rinne O",
      "op": "box",
      "mode": "paint",
      "if": "floor(conn / 2) % 2",
      "at": [
        2,
        0,
        1
      ],
      "size": [
        2,
        1,
        1
      ],
      "color": {
        "role": "glow2",
        "emit": 1.1
      },
      "jitter": false
    },
    {
      "name": "Rinne S",
      "op": "box",
      "mode": "paint",
      "if": "floor(conn / 4) % 2",
      "at": [
        1,
        0,
        2
      ],
      "size": [
        1,
        1,
        2
      ],
      "color": {
        "role": "glow2",
        "emit": 1.1
      },
      "jitter": false
    },
    {
      "name": "Rinne W",
      "op": "box",
      "mode": "paint",
      "if": "floor(conn / 8) % 2",
      "at": [
        0,
        0,
        1
      ],
      "size": [
        1,
        1,
        1
      ],
      "color": {
        "role": "glow2",
        "emit": 1.1
      },
      "jitter": false
    }
  ],
  "anchor": [
    0,
    0,
    0
  ]
}
