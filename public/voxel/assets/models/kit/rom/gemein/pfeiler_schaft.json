{
  "id": "kit/rom/gemein/pfeiler_schaft",
  "name": "Rom-Steckplatz pfeiler_schaft: Säulenschaft mit Lichtkanal und Goldring",
  "tier": "architecture",
  "palette": "rom",
  "tags": ["rom","slot","gemein"],
  "jitter": 0,
  "params": {
    "w": {"default":2,"min":1,"max":16,"step":1,"label":"Breite (Voxel)"},
    "h": {"default":10,"min":1,"max":16,"step":1,"label":"Höhe (Voxel)"},
    "d": {"default":2,"min":1,"max":4,"step":1,"label":"Tiefe (Voxel)"},
    "zustand": {"default":0,"min":0,"max":2,"step":1,"label":"0 intakt · 1 verfallen · 2 umkämpft"},
    "conn": {"default":0,"min":0,"max":15,"step":1}
  },
  "ops": [
    {"name":"Schaft","op":"box","at":[0,0,0],"size":["w","h","d"],"color":{"shade":"stone","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Manschette","op":"box","at":[0,0,0],"size":["w",1,"d"],"color":{"shade":"metal","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Goldring","op":"box","if":"h > 4","at":[0,"h - 2",0],"size":["w",1,"d"],"color":{"shade":"trim","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Lichtkanal","op":"box","if":"h > 4","at":[0,2,"d - 1"],"size":[1,"h - 4",1],"color":{"role":"glow","emit":"zustand == 0 ? 1.0 : 0.3"},"jitter":false}
  ],
  "anchor": [0,0,0]
}
