{
  "id": "kit/rom/gemein/truemmer_haufen",
  "name": "Rom-Steckplatz truemmer_haufen: Trümmer aus Travertin und Keramikpaneelen",
  "tier": "architecture",
  "palette": "rom",
  "tags": ["rom","slot","gemein"],
  "jitter": 0,
  "params": {
    "w": {"default":4,"min":1,"max":16,"step":1,"label":"Breite (Voxel)"},
    "h": {"default":3,"min":1,"max":16,"step":1,"label":"Höhe (Voxel)"},
    "d": {"default":4,"min":1,"max":4,"step":1,"label":"Tiefe (Voxel)"},
    "zustand": {"default":0,"min":0,"max":2,"step":1,"label":"0 intakt · 1 verfallen · 2 umkämpft"}
  },
  "ops": [
    {"name":"Haufen","op":"box","at":[0,0,0],"size":["w","max(1, h - 1)","d"],"color":{"noise":[{"shade":"stone","f":"1 * (1 - zustand * 0.08)"},{"shade":"stone_dark","f":"1 * (1 - zustand * 0.08)"},{"shade":"secondary","f":"0.9 * (1 - zustand * 0.08)"}],"weights":[3,2,1],"cell":1}},
    {"name":"Brocken","op":"box","repeat":{"count":3,"step":[0,0,0],"var":"i"},"if":"h > 1","at":["floor(hash(seed, i, 1) * max(1, w - 1))","max(1, h - 1)","floor(hash(seed, i, 2) * max(1, d - 1))"],"size":[1,1,1],"color":{"noise":[{"shade":"stone_light","f":"1 * (1 - zustand * 0.08)"},{"shade":"primary","f":"0.7 * (1 - zustand * 0.08)"}],"weights":[3,1],"cell":1}},
    {"name":"Moos","op":"box","mode":"paint","if":"zustand > 0","at":[0,0,0],"size":["w","h","d"],"color":{"noise":[{"shade":"plant_dark","f":0.75},"stone_dark","stone"],"weights":[1,3,3],"cell":1}}
  ],
  "anchor": [0,0,0]
