{
  "id": "kit/rom/gemein/wand_fuellung",
  "name": "Rom-Steckplatz wand_fuellung: Panzerband rot, Energiefuge, Keramikpaneele",
  "tier": "architecture",
  "palette": "rom",
  "tags": ["rom","slot","gemein"],
  "jitter": 0,
  "let": {"pb":"h >= 6 ? 2 : 1"},
  "params": {
    "w": {"default":4,"min":1,"max":16,"step":1,"label":"Breite (Voxel)"},
    "h": {"default":9,"min":1,"max":16,"step":1,"label":"Höhe (Voxel)"},
    "d": {"default":1,"min":1,"max":4,"step":1,"label":"Tiefe (Voxel)"},
    "zustand": {"default":0,"min":0,"max":2,"step":1,"label":"0 intakt · 1 verfallen · 2 umkämpft"}
  },
  "ops": [
    {"name":"Panzerband rot","op":"box","at":[0,0,0],"size":["w","pb","d"],"color":{"shade":"primary","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Energiefuge","op":"box","at":[0,"pb",0],"size":["w",1,"d"],"color":{"role":"glow","emit":"zustand == 0 ? 1.1 : 0.4"},"jitter":false},
    {"name":"Keramikpaneele","op":"box","if":"h > pb + 1","at":[0,"pb + 1",0],"size":["w","h - pb - 1","d"],"color":{"shade":"secondary","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Paneelfuge","op":"box","if":"h > pb + 5","at":[0,"pb + 4",0],"size":["w",1,"d"],"color":{"shade":"secondary","f":"0.75 * (1 - zustand * 0.08)"}},
    {"name":"Moos","op":"box","mode":"paint","if":"zustand > 0","at":[0,0,0],"size":["w","pb","d"],"color":{"noise":[{"shade":"plant_dark","f":0.75},"stone_dark","stone"],"weights":[1,3,3],"cell":1}}
  ],
  "anchor": [0,0,0]
}
