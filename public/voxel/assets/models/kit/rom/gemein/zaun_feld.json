{
  "id": "kit/rom/gemein/zaun_feld",
  "name": "Rom-Steckplatz zaun_feld: Paneelfeld: Panzerband unten, Keramik oben, Goldkante",
  "tier": "architecture",
  "palette": "rom",
  "tags": ["rom","slot","gemein"],
  "jitter": 0,
  "params": {
    "w": {"default":2,"min":1,"max":16,"step":1,"label":"Breite (Voxel)"},
    "h": {"default":9,"min":1,"max":16,"step":1,"label":"Höhe (Voxel)"},
    "d": {"default":1,"min":1,"max":4,"step":1,"label":"Tiefe (Voxel)"},
    "zustand": {"default":0,"min":0,"max":2,"step":1,"label":"0 intakt · 1 verfallen · 2 umkämpft"},
    "conn": {"default":10,"min":0,"max":15,"step":1}
  },
  "ops": [
    {"name":"Panzerband","op":"box","at":[0,0,0],"size":["w","min(2, h)","d"],"color":{"shade":"primary","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Keramik","op":"box","if":"h > 3","at":[0,2,0],"size":["w","h - 3","d"],"color":{"shade":"secondary","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Goldkante","op":"box","if":"h > 2","at":[0,"h - 1",0],"size":["w",1,"d"],"color":{"shade":"trim","f":"0.85 * (1 - zustand * 0.08)"}},
    {"name":"Moos","op":"box","mode":"paint","if":"zustand > 0","at":[0,0,0],"size":["w",1,"d"],"color":{"noise":[{"shade":"plant_dark","f":0.75},"stone_dark","stone"],"weights":[2,3,3],"cell":1}}
  ],
  "anchor": [0,0,0]
}
