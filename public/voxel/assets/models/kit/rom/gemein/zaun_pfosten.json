{
  "id": "kit/rom/gemein/zaun_pfosten",
  "name": "Rom-Steckplatz zaun_pfosten: Gunmetal-Pfosten mit Goldkappe und Emitter",
  "tier": "architecture",
  "palette": "rom",
  "tags": ["rom","slot","gemein"],
  "jitter": 0,
  "params": {
    "w": {"default":2,"min":1,"max":16,"step":1,"label":"Breite (Voxel)"},
    "h": {"default":10,"min":1,"max":16,"step":1,"label":"Höhe (Voxel)"},
    "d": {"default":2,"min":1,"max":4,"step":1,"label":"Tiefe (Voxel)"},
    "zustand": {"default":0,"min":0,"max":2,"step":1,"label":"0 intakt · 1 verfallen · 2 umkämpft"},
    "conn": {"default":10,"min":0,"max":15,"step":1}
  },
  "ops": [
    {"name":"Pfosten","op":"box","at":[0,0,0],"size":["w","h","d"],"color":{"frame":{"shade":"metal_light","f":"1 * (1 - zustand * 0.08)"},"fill":{"shade":"metal","f":"1 * (1 - zustand * 0.08)"},"axes":"x"}},
    {"name":"Fuß","op":"box","at":[0,0,0],"size":["w",1,"d"],"color":{"shade":"stone_dark","f":"1 * (1 - zustand * 0.08)"}},
    {"name":"Kappe gold","op":"box","at":[0,"h - 1",0],"size":["w",1,"d"],"color":{"shade":"trim","f":"0.9 * (1 - zustand * 0.08)"}},
    {"name":"Emitter","op":"box","if":"h > 4","at":[0,"h - 2",0],"size":["w",1,"d"],"color":{"role":"glow","emit":"zustand == 0 ? 1.0 : 0"},"jitter":false}
  ],
  "anchor": [0,0,0]
}
