{
  "id": "kit/rom/station/boden_fuge",
  "name": "Rom-Station boden_fuge: warme Travertinfuge nur an den Grenzen von 2x2-Kachelblöcken (Gold bei der Schmuckplatte)",
  "tier": "architecture",
  "palette": "rom",
  "tags": [
    "rom",
    "slot",
    "station",
    "ort01"
  ],
  "jitter": 0,
  "params": {
    "w": {
      "default": 4,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Breite (Voxel)"
    },
    "h": {
      "default": 1,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Höhe (Voxel)"
    },
    "d": {
      "default": 4,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tiefe (Voxel)"
    },
    "zustand": {
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 1,
      "label": "0 intakt · 1 verfallen · 2 umkämpft"
    },
    "belag": {
      "default": 0,
      "min": 0,
      "max": 3,
      "step": 1,
      "label": "0 Gunmetal-Marmor · 1 Gitterrost · 2 Amber-Rinnenplatte (nur Gänge/Rinnenzonen) · 3 Schmuckplatte"
    },
    "par": {
      "default": -1,
      "min": -1,
      "max": 3,
      "step": 1,
      "label": "Kachellage im 2x2-Block: x mod 2 + 2 * (y mod 2), -1 = unbekannt"
    }
  },
  "ops": [
    {
      "name": "Fuge Nord",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        1
      ],
      "color": {
        "shade": "stone",
        "f": "0.6 * (1 - zustand * 0.08)"
      },
      "if": "py == 0 && belag != 3"
    },
    {
      "name": "Fuge West",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        1,
        "h",
        "d"
      ],
      "color": {
        "shade": "stone",
        "f": "0.6 * (1 - zustand * 0.08)"
      },
      "if": "px == 0 && belag != 3"
    },
    {
      "name": "Fuge Gold Nord",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        1
      ],
      "color": {
        "shade": "trim",
        "f": "0.85 * (1 - zustand * 0.08)"
      },
      "if": "py == 0 && belag == 3"
    },
    {
      "name": "Fuge Gold West",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        1,
        "h",
        "d"
      ],
      "color": {
        "shade": "trim",
        "f": "0.85 * (1 - zustand * 0.08)"
      },
      "if": "px == 0 && belag == 3"
    }
  ],
  "anchor": [
    0,
    0,
    0
  ],
  "let": {
    "px": "par < 0 ? 0 : floor(par) % 2",
    "py": "par < 0 ? 0 : floor(par / 2) % 2"
  }
}
