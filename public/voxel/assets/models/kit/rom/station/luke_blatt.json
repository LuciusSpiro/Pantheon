{
 "id": "kit/rom/station/luke_blatt",
 "name": "Rom-Station luke_blatt: Gunmetal-Deckel mit Amber-Mitte (zu) bzw. aufgestellte Klappe mit Goldrahmen (offen)",
 "tier": "architecture",
 "palette": "rom",
 "tags": [
  "rom",
  "slot",
  "station",
  "ort01"
 ],
 "jitter": 0,
 "params": {
  "w": {
   "default": 2,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Breite (Voxel)"
  },
  "h": {
   "default": 1,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Höhe (Voxel)"
  },
  "d": {
   "default": 2,
   "min": 1,
   "max": 4,
   "step": 1,
   "label": "Tiefe (Voxel)"
  },
  "zustand": {
   "default": 0,
   "min": 0,
   "max": 2,
   "step": 1,
   "label": "0 intakt · 1 verfallen · 2 umkämpft"
  },
  "conn": {
   "default": 10,
   "min": 0,
   "max": 15,
   "step": 1
  },
  "state": {
   "default": 0,
   "min": 0,
   "max": 1,
   "step": 1,
   "label": "0 zu · 1 offen"
  }
 },
 "ops": [
  {
   "name": "Deckel",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "frame": {
     "shade": "trim",
     "f": "0.9 * (1 - zustand * 0.08)"
    },
    "fill": {
     "shade": "metal",
     "f": "0.9 * (1 - zustand * 0.08)"
    },
    "axes": "xz",
    "width": 1
   },
   "if": "state == 0 && d >= 2"
  },
  {
   "name": "Deckel Sensor",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    1,
    "h",
    1
   ],
   "color": {
    "shade": "#FFA21A",
    "f": 1,
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "jitter": false,
   "if": "state == 0 && d >= 2 && zustand < 2"
  },
  {
   "name": "Klappe",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "frame": {
     "shade": "trim",
     "f": "0.9 * (1 - zustand * 0.08)"
    },
    "fill": {
     "shade": "metal_dark",
     "f": "1 * (1 - zustand * 0.08)"
    },
    "axes": "xy",
    "width": 1
   },
   "if": "state == 1 || d < 2"
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}