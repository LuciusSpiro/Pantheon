   "default": 8,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Breite (Voxel)"
  },
  "h": {
   "default": 9,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Höhe (Voxel)"
  },
  "d": {
   "default": 2,
   "min": 1,
   "max": 4,
   "step": 1,
   "label": "Tiefe (Voxel)"
  },
  "zustand": {
   "default": 0,
   "min": 0,
   "max": 2,
   "step": 1,
   "label": "0 intakt · 1 verfallen · 2 umkämpft"
