   "default": 0,
   "min": 0,
   "max": 3,
   "step": 1
  }
 },
 "ops": [
  {
   "name": "Schott",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "frame": {
     "shade": "trim",
     "f": "0.9 * (1 - zustand * 0.08)"
    },
    "fill": {
     "shade": "metal_dark",
     "f": "1 * (1 - zustand * 0.08)"
    },
    "axes": "xy",
    "width": 1
   }
  },
  {
   "name": "Rotband",
   "op": "box",
   "at": [
    1,
    1,
    "d - 1"
   ],
   "size": [
    "w - 2",
    1,
    1
   ],
   "color": {
    "shade": "primary",
    "f": "1 * (1 - zustand * 0.08)"
   }
  },
  {
   "name": "Rotband oben",
   "op": "box",
   "at": [
    1,
    "h - 2",
    "d - 1"
   ],
   "size": [
    "w - 2",
    1,
    1
   ],
   "color": {
    "shade": "primary",
    "f": "1 * (1 - zustand * 0.08)"
   },
   "if": "h > 5"
  },
  {
   "name": "Mittelnaht",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    1,
    "d - 1"
   ],
   "size": [
    2,
    "h - 2",
    1
   ],
   "color": {
    "shade": "metal_light",
    "f": "0.55 * (1 - zustand * 0.08)"
   }
  },
  {
   "name": "Naht Amber",
   "op": "box",
   "at": [
    "floor(w / 2)",
    2,
    "d - 1"
   ],
   "size": [
    1,
    "h - 4",
    1
   ],
   "color": {
    "shade": "#FFA21A",
    "f": 1,
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "jitter": false,
   "if": "state == 0 && zustand < 2 && h > 4"
  },
  {
   "name": "Riegel",
   "op": "box",
   "at": [
    0,
    "floor(h / 2)",
    "d - 1"
   ],
   "size": [
    "w",
    1,
    1
   ],
   "color": {
    "shade": "primary",
    "f": "0.9 * (1 - zustand * 0.08)"
   },
   "if": "state == 3"
  },
  {
   "name": "Siegel",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    "floor(h / 2)",
    "d - 1"
   ],
   "size": [
    2,
    1,
    1
   ],
   "color": {
    "shade": "#FFA21A",
    "f": 1,
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "jitter": false,
   "if": "state == 3"
  },
  {
   "name": "Ruß",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "noise": [
     {
      "shade": "metal_dark",
      "f": 1.4
     },
     {
      "shade": "secondary",
      "f": 0.97
     }
    ],
    "weights": [
     1,
     6
    ],
    "cell": 2,
    "seed": "seed"
   },
   "mode": "paint",
   "if": "zustand == 2"
  }
 ],
 "anchor": [
  0,
