{
 "id": "kit/rom/station/tuer_blatt",
 "name": "Rom-Station tuer_blatt: Gunmetal-Flügel mit Goldrahmen und rotem Paneel; zu: Amber-Naht; verschlossen: roter Riegel und Amber-Siegel",
 "tier": "architecture",
 "palette": "rom",
 "tags": [
  "rom",
  "slot",
  "station",
  "ort01"
 ],
 "jitter": 0,
 "params": {
  "w": {
   "default": 8,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Breite (Voxel)"
  },
  "h": {
   "default": 9,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Höhe (Voxel)"
  },
  "d": {
   "default": 2,
   "min": 1,
   "max": 4,
   "step": 1,
   "label": "Tiefe (Voxel)"
  },
  "zustand": {
   "default": 0,
   "min": 0,
   "max": 2,
   "step": 1,
   "label": "0 intakt · 1 verfallen · 2 umkämpft"
  },
  "state": {
   "default": 1,
   "min": 0,
   "max": 3,
   "step": 1
  }
 },
 "ops": [
  {
   "name": "Flügel",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "frame": {
     "shade": "trim",
     "f": "0.9 * (1 - zustand * 0.08)"
    },
    "fill": {
     "shade": "metal_dark",
     "f": "1 * (1 - zustand * 0.08)"
    },
    "axes": "xy",
    "width": 1
   }
  },
  {
   "name": "Paneel rot",
   "op": "box",
   "at": [
    1,
    1,
    "d - 1"
   ],
   "size": [
    "w - 2",
    2,
    1
   ],
   "color": {
    "shade": "primary",
    "f": "1 * (1 - zustand * 0.08)"
   },
   "if": "h > 5"
  },
  {
   "name": "Naht",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    1,
    "d - 1"
   ],
   "size": [
    2,
    "h - 2",
    1
   ],
   "color": {
    "shade": "#FFA21A",
    "f": 1,
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "jitter": false,
   "if": "state == 1 && zustand < 2"
  },
  {
   "name": "Naht dunkel",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    1,
    "d - 1"
   ],
   "size": [
    2,
    "h - 2",
    1
   ],
   "color": {
    "shade": "metal_light",
    "f": "0.7 * (1 - zustand * 0.08)"
   },
   "if": "state != 1 || zustand == 2"
  },
  {
   "name": "Riegel",
   "op": "box",
   "at": [
    0,
    "floor(h / 2)",
    "d - 1"
   ],
   "size": [
    "w",
    1,
    1
   ],
   "color": {
    "shade": "primary",
    "f": "0.9 * (1 - zustand * 0.08)"
   },
   "if": "state == 2"
  },
  {
   "name": "Siegel",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    "floor(h / 2)",
    "d - 1"
   ],
   "size": [
    2,
    1,
    1
   ],
   "color": {
    "shade": "#FFA21A",
    "f": 1,
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "jitter": false,
   "if": "state == 2"
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}