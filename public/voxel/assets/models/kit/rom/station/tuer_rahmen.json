{
 "id": "kit/rom/station/tuer_rahmen",
 "name": "Rom-Station tuer_rahmen: Schwelle mit Amber-Sensorlinie; Sturz mit Goldkämpfer, Rotband, Schlussstein und Amberrinne oben",
 "tier": "architecture",
 "palette": "rom",
 "tags": [
  "rom",
  "slot",
  "station",
  "ort01"
 ],
 "jitter": 0,
 "params": {
  "w": {
   "default": 8,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Breite (Voxel)"
  },
  "h": {
   "default": 3,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Höhe (Voxel)"
  },
  "d": {
   "default": 4,
   "min": 1,
   "max": 4,
   "step": 1,
   "label": "Tiefe (Voxel)"
  },
  "zustand": {
   "default": 0,
   "min": 0,
   "max": 2,
   "step": 1,
   "label": "0 intakt · 1 verfallen · 2 umkämpft"
  },
  "teil": {
   "default": 1,
   "min": 0,
   "max": 1,
   "step": 1,
   "label": "0 Schwelle · 1 Sturz"
  },
  "state": {
   "default": 0,
   "min": 0,
   "max": 3,
   "step": 1
  }
 },
 "ops": [
  {
   "name": "Schwelle",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "frame": {
     "shade": "trim",
     "f": "1 * (1 - zustand * 0.08)"
    },
    "fill": {
     "shade": "metal_dark",
     "f": "1.1 * (1 - zustand * 0.08)"
    },
    "axes": "x",
    "width": 1
   },
   "if": "teil == 0"
  },
  {
   "name": "Schwelle Sensor",
   "op": "box",
   "at": [
    2,
    0,
    1
   ],
   "size": [
    "w - 4",
    "h",
    2
   ],
   "color": {
    "shade": "#FFA21A",
    "f": 1,
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "jitter": false,
   "if": "teil == 0 && state != 3"
  },
  {
   "name": "Sturz",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "shade": "secondary",
    "f": "1 * (1 - zustand * 0.08)"
   },
   "if": "teil == 1"
  },
  {
   "name": "Kämpfer",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    1,
    "d"
   ],
   "color": {
    "shade": "trim",
    "f": "1 * (1 - zustand * 0.08)"
   },
   "if": "teil == 1"
  },
  {
   "name": "Rotband",
   "op": "box",
   "at": [
    0,
    1,
    0
   ],
   "size": [
    "w",
    1,
    "d"
   ],
   "color": {
    "shade": "primary",
    "f": "1 * (1 - zustand * 0.08)"
   },
   "if": "teil == 1 && h >= 3"
  },
  {
   "name": "Schlussstein",
   "op": "box",
   "at": [
    "floor(w / 2) - 1",
    0,
    0
   ],
   "size": [
    2,
    "h - 1",
    "d"
   ],
   "color": {
    "shade": "trim",
    "f": "1 * (1 - zustand * 0.08)"
   },
   "if": "teil == 1 && h >= 3"
  },
  {
   "name": "Sturz Rand",
   "op": "box",
   "at": [
    0,
    "h - 1",
    0
   ],
   "size": [
    "w",
    1,
    "d"
   ],
   "color": {
    "shade": "stone_light",
    "f": "1.05 * (1 - zustand * 0.08)"
   },
   "if": "teil == 1 && h >= 3"
  },
  {
   "name": "Sturz Rinne",
   "op": "box",
   "at": [
    0,
    "h - 1",
    1
   ],
   "size": [
    "w",
    1,
    2
   ],
   "color": {
    "shade": "#FFA21A",
    "f": 1,
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "jitter": false,
   "if": "teil == 1 && h >= 3"
  }
 ],
 "anchor": [
  0,
  0,
  0
 ]
}