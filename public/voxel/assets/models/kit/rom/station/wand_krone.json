{
 "id": "kit/rom/station/wand_krone",
 "name": "Rom-Station wand_krone: Marmorkrone, Amberrinne als EINE 1-Voxel-Linie je Wandachse (Leitfaden: Stücke vor Wand)",
 "tier": "architecture",
 "palette": "rom",
 "tags": [
  "rom",
  "slot",
  "station",
  "ort01"
 ],
 "jitter": 0,
 "params": {
  "w": {
   "default": 4,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Breite (Voxel)"
  },
  "h": {
   "default": 1,
   "min": 1,
   "max": 16,
   "step": 1,
   "label": "Höhe (Voxel)"
  },
  "d": {
   "default": 4,
   "min": 1,
   "max": 4,
   "step": 1,
   "label": "Tiefe (Voxel)"
  },
  "zustand": {
   "default": 0,
   "min": 0,
   "max": 2,
   "step": 1,
   "label": "0 intakt · 1 verfallen · 2 umkämpft"
  },
  "conn": {
   "default": 10,
   "min": 0,
   "max": 15,
   "step": 1
  }
 },
 "let": {
  "cn": "floor(conn) % 2",
  "ce": "floor(conn / 2) % 2",
  "cs": "floor(conn / 4) % 2",
  "cw": "floor(conn / 8) % 2",
  "gx": "ce && cw",
  "gz": "cn && cs",
  "lauf_x": "gx || (conn == 0) || (!gz && (ce || cw) && !(cn || cs))",
  "lauf_z": "!gx && (gz || (!(ce || cw) && (cn || cs)))",
  "ecke": "!gx && !gz && (ce || cw) && (cn || cs)"
 },
 "ops": [
  {
   "name": "Krone",
   "op": "box",
   "at": [
    0,
    0,
    0
   ],
   "size": [
    "w",
    "h",
    "d"
   ],
   "color": {
    "shade": "stone_light",
    "f": "1.05 * (1 - zustand * 0.08)"
   }
  },
  {
   "name": "Rinne entlang x",
   "op": "box",
   "at": [
    0,
    "h - 1",
    1
   ],
   "size": [
    "w",
    1,
    1
   ],
   "color": {
    "role": "glow2",
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "mode": "paint",
   "jitter": false,
   "if": "lauf_x"
  },
  {
   "name": "Rinne entlang z",
   "op": "box",
   "at": [
    1,
    "h - 1",
    0
   ],
   "size": [
    1,
    1,
    "d"
   ],
   "color": {
    "role": "glow2",
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "mode": "paint",
   "jitter": false,
   "if": "lauf_z"
  },
  {
   "name": "Rinne Ecke Mitte",
   "op": "box",
   "at": [
    1,
    "h - 1",
    1
   ],
   "size": [
    1,
    1,
    1
   ],
   "color": {
    "role": "glow2",
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "mode": "paint",
   "jitter": false,
   "if": "ecke"
  },
  {
   "name": "Rinne Ecke N",
   "op": "box",
   "at": [
    1,
    "h - 1",
    0
   ],
   "size": [
    1,
    1,
    1
   ],
   "color": {
    "role": "glow2",
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "mode": "paint",
   "jitter": false,
   "if": "ecke && cn"
  },
  {
   "name": "Rinne Ecke S",
   "op": "box",
   "at": [
    1,
    "h - 1",
    2
   ],
   "size": [
    1,
    1,
    2
   ],
   "color": {
    "role": "glow2",
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "mode": "paint",
   "jitter": false,
   "if": "ecke && cs"
  },
  {
   "name": "Rinne Ecke W",
   "op": "box",
   "at": [
    0,
    "h - 1",
    1
   ],
   "size": [
    1,
    1,
    1
   ],
   "color": {
    "role": "glow2",
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "mode": "paint",
   "jitter": false,
   "if": "ecke && cw"
  },
  {
   "name": "Rinne Ecke O",
   "op": "box",
   "at": [
    2,
    "h - 1",
    1
   ],
   "size": [
    2,
    1,
    1
   ],
   "color": {
    "role": "glow2",
    "emit": "zustand == 2 ? 0.25 : 0.6"
   },
   "mode": "paint",
   "jitter": false,
   "if": "ecke && ce"
  }

 ],
 "anchor": [
  0,
  0,
  0
 ]
}
