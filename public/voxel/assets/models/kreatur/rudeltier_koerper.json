{
 "id": "kreatur/rudeltier_koerper",
 "name": "Rudeltier Helmhyaene, Koerper (MON-02, Richtung D): Teilmodell mit der Rolle \"fell\"; die Fellfarbe waehlt kreatur/rudeltier",
 "tier": "detail",
 "palette": "kreatur",
 "jitter": 0,
 "tags": [
  "kreatur",
  "rudeltier",
  "teil"
 ],
