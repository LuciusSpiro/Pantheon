   "at": [
    -1,
    "round(7.5 + t * (2 + duck) + 2.2 + t * 0.6) - 1",
    "i - 8"
   ],
   "size": [
    2,
    "max(1, 13 + duck - (round(7.5 + t * (2 + duck) + 2.2 + t * 0.6) - 1))",
    1
   ],
   "color": "fell",
   "repeat": {
    "count": 10,
    "step": [
     0,
     0,
     0
    ],
    "var": "i"
   },
   "let": {
    "t": "max(0, (i - 3) / 7.5)"
   }
  },
  {
   "op": "box",
   "name": "Maehne zwischen den Marken",
   "at": [
    -1,
    "13 + duck - 1",
    "i - 8"
   ],
   "size": [
    2,
    1,
    1
   ],
   "color": "maehne",
   "repeat": {
    "count": 10,
    "step": [
     0,
     0,
     0
    ],
    "var": "i"
   },
   "if": "i % 4 >= 2"
  },
  {
   "op": "box",
   "name": "Platz der Marken frei",
   "at": [
    -1,
    "13 + duck",
