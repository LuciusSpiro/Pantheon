   },
   "ops": [
    {
     "op": "box",
     "name": "oberes Glied",
     "at": [
      -3,
      "h - floor(h / 2)",
      2
     ],
     "size": [
      2,
      "floor(h / 2)",
      2
     ],
     "color": "fell"
    },
    {
     "op": "box",
     "name": "unteres Glied",
     "at": [
      -3,
      0,
      "2 + dz"
     ],
     "size": [
      2,
      "h - floor(h / 2) + 1",
      2
     ],
     "color": "fell"
    },
    {
     "op": "box",
     "name": "Kralle",
     "at": [
      -3,
      0,
      "2 + dz"
     ],
     "size": [
      2,
