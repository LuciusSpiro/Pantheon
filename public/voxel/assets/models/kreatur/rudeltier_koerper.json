   },
   "at": [
    0,
    "7.5 + t * (2 + duck)",
    "3 + t * 7.5 - 8"
   ],
   "r": [
    "2.6 + t * 0.8",
    "2.2 + t * 0.6",
    2.4
   ],
   "color": "fell"
  },
  {
   "op": "ellipsoid",
   "name": "Knochenkragen (heller Block)",
   "at": [
    0,
    "cy",
    3
