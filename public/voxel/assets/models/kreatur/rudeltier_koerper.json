  1,
  1
 ],
 "budgetTris": 2300,
 "params": {
  "pose": {
   "default": 0,
   "min": 0,
   "max": 3,
   "step": 1,
   "label": "Pose: 0 steh, 1 aufladen, 2 pause, 3 rammen"
  },
  "beinphase": {
   "default": 0,
   "min": 0,
   "max": 1,
   "step": 1,
   "label": "Beinphase (zwei Phasen im Wechsel)"
  }
 },
 "let": {
  "duck": "pose == 1 ? -1 : (pose == 2 ? -2 : (pose == 3 ? -1 : 0))",
  "kopf": "pose == 1 ? -2 : (pose == 2 ? -4 : (pose == 3 ? -2 : 0))",
  "hf": "8 + duck",
  "cy": "10 + duck",
  "h0": "9 + duck + kopf",
  "kamm": "13 + duck"
 },
 "ops": [
