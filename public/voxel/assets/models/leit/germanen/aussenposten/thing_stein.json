        {"op": "box", "name": "Ornament", "at": [2, 8, 3], "size": [1, 1, 1], "mode": "paint", "color": "metal_light", "jitter": false},
        {"op": "box", "name": "Ornament", "at": [1, 9, 3], "size": [1, 1, 1], "mode": "paint", "color": "metal_light", "jitter": false},
