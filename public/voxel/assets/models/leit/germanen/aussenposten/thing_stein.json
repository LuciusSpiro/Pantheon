      {"op": "cyl", "name": "Schale", "at": [-11, 7, 5], "r": 2.6, "h": 2, "color": "metal_dark", "jitter": false},
      {"op": "cyl", "name": "Feuer", "if": "feuer", "at": [-11, 8, 5], "r": 1.8, "h": 3, "color": {"role": "ember", "emit": 1.2}, "jitter": false},
      {"op": "box", "name": "Flammenspitze", "if": "feuer", "at": [-12, 11, 4], "size": [2, 2, 2], "color": {"role": "ember", "emit": 1.2}, "jitter": false},
      {"op": "cyl", "name": "Asche", "if": "!feuer", "at": [-11, 8, 5], "r": 1.8, "h": 1, "color": "ember_dark"}
    ] },
    {"op": "group", "name": "Speer mit Wimpel (genommen)", "if": "state == 1", "ops": [
      {"op": "box", "name": "Speerschaft", "at": [-6, 1, 5], "size": [1, 34, 1], "color": "wood_dark"},
      {"op": "box", "name": "Speerspitze", "at": [-6, 35, 5], "size": [1, 3, 1], "color": "metal_light"},
      {"op": "box", "name": "Wimpel", "at": [-5, 28, 5], "size": [7, 5, 1], "color": "cloth"},
      {"op": "box", "name": "Wimpel Saum", "at": [-5, 28, 5], "size": [7, 1, 1], "mode": "paint", "color": {"shade": "cloth", "f": 0.7}}
    ] }
