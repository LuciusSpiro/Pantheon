        {"op": "box", "name": "Ornament", "at": [-2, 8, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [-3, 9, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [-1, 9, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [-2, 10, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [0, 9, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [2, 8, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [1, 9, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [3, 9, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false},
        {"op": "box", "name": "Ornament", "at": [2, 10, 3], "size": [1, 1, 1], "mode": "paint", "color": {"role": "rune", "emit": 1.0}, "jitter": false}
      ] }
    ] },
    {"op": "group", "name": "Feuerschalen links und rechts", "mirror": "x", "mirrorAt": 0, "ops": [
