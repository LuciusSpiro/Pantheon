{
  "id": "leit/germanen/station/hochsitz_halle",
  "name": "Leitstück Station Germanen: Hochsitz der Halle (Stufenpodest, Eisenthron mit Fell, Baldachin, Hochsitzpfeiler, Feuerschalen)",
  "tier": "detail",
