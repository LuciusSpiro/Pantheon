    {"name": "Sockel Rand", "op": "box", "at": [-24, 1, -16], "size": [48, 1, 32], "mode": "paint", "color": {"frame": "metal_light", "fill": {"checker": ["stone_dark", {"shade": "stone_dark", "f": 0.85}], "period": 4}, "axes": "xz", "width": 1}, "jitter": false},
    {"name": "Sockel Leitlicht x", "op": "box", "at": [-23, 1, -15], "size": [46, 1, 30], "mode": "paint", "color": {"frame": {"role": "leit", "emit": 1.1}, "fill": {"checker": ["stone_dark", {"shade": "stone_dark", "f": 0.85}], "period": 4}, "axes": "z", "width": 1}, "jitter": false},
    {"name": "Sockel Leitlicht z", "op": "box", "at": [-23, 1, -14], "size": [46, 1, 28], "mode": "paint", "color": {"frame": {"role": "leit", "emit": 1.1}, "fill": {"checker": ["stone_dark", {"shade": "stone_dark", "f": 0.85}], "period": 4}, "axes": "x", "width": 1}, "jitter": false},
    {"name": "Herdblock", "op": "box", "at": [-21, 2, -12], "size": [24, 9, 20], "color": {"frame": "metal_dark", "fill": "stone_dark", "axes": "xy", "width": 1}, "jitter": false},
