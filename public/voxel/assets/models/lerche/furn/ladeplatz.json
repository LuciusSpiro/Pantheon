    "sprengkiste": { "darstellung": "sprengkiste" },
    "kiste_med": { "darstellung": "kiste_med" },
    "bett": { "darstellung": "bett" }
  },
  "ops": [
    { "op": "use", "name": "Darstellung nach Schlüssel", "model": "lerche/furn/ladeplatz_{darstellung}",
      "fallback": ["lerche/furn/ladeplatz_kiste"],
