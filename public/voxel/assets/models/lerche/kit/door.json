{
  "id": "lerche/kit/door",
  "name": "Lerche – Tür (Schott im Rundbogen / Doppeltür Holz-Bronze), Durchgang entlang z",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "kit", "tuer", "kachelbar"],
  "footprint": [1, 1],
  "jitter": 0,
  "params": {
    "open": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Offen" },
    "style": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "0 Schott im Rundbogen (System) · 1 Doppeltür Holz/Bronze (Privat)" },
    "locked": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Verriegelt (rote Sperre)" },
    "cut": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Geschnitten (1,25 m wie die Wand daneben)" }
  },
  "variants": {
    "offen": { "open": 1 },
    "verriegelt": { "locked": 1 },
    "privat": { "style": 1 },
    "privat_offen": { "style": 1, "open": 1 },
    "geschnitten": { "cut": 1 },
    "geschnitten_offen": { "cut": 1, "open": 1 },
    "geschnitten_privat_verriegelt": { "cut": 1, "style": 1, "locked": 1 }
  },
  "let": {
    "jh": "cut ? 16 : 36",
    "lh": "cut ? 16 : 36",
    "lampY": "cut ? 8 : 20",
    "barY": "cut ? 8 : 16"
  },
  "ops": [
    { "op": "box", "name": "Laibung System (Bronze, 12,5 cm – lichte Weite 0,75 m)", "if": "style == 0", "mirror": "x", "mirrorAt": 8, "at": [0, 0, 0], "size": [2, "jh", 16], "color": "metal" },
    { "op": "box", "name": "Laibung Privat (Marmor)", "if": "style == 1", "mirror": "x", "mirrorAt": 8, "at": [0, 0, 0], "size": [2, "jh", 16], "color": "secondary" },
    { "op": "box", "name": "Laibung Sockel", "mirror": "x", "mirrorAt": 8, "at": [0, 0, 0], "size": [2, 4, 16], "mode": "paint", "color": "metal_dark" },
    { "op": "box", "name": "Laibung Kante vorn/hinten", "if": "style == 0", "mirror": "xz", "mirrorAt": 8, "at": [0, 4, 12], "size": [2, "jh - 4", 4], "mode": "paint", "color": "metal_light" },

    { "op": "box", "name": "Sturz System", "if": "!cut && style == 0", "at": [0, 36, 0], "size": [16, 12, 16], "color": "metal" },
    { "op": "box", "name": "Sturz Privat", "if": "!cut && style == 1", "at": [0, 36, 0], "size": [16, 12, 16], "color": "stone" },
    { "op": "box", "name": "Bogenzwickel", "if": "!cut", "mirror": "x", "mirrorAt": 8, "at": [2, 32, 0], "size": [2, 4, 16], "color": "secondary" },
    { "op": "box", "name": "Archivolte Scheitel", "if": "!cut", "at": [2, 36, 0], "size": [12, 4, 16], "mode": "paint", "color": "secondary" },
    { "op": "box", "name": "Schlussstein", "if": "!cut", "mirror": "z", "mirrorAt": 8, "at": [6, 40, 12], "size": [4, 4, 4], "mode": "paint", "color": "trim" },
    { "op": "box", "name": "Kappe dunkel", "if": "!cut", "at": [0, 44, 0], "size": [16, 4, 16], "mode": "paint", "color": "metal_dark" },
    { "op": "box", "name": "Kappe Goldlinie", "if": "!cut", "mirror": "z", "mirrorAt": 8, "at": [0, 44, 12], "size": [16, 4, 4], "mode": "paint", "color": "trim" },

    { "op": "box", "name": "Pfostenkappe dunkel", "if": "cut", "mirror": "x", "mirrorAt": 8, "at": [0, 16, 0], "size": [2, 4, 16], "color": "metal_dark" },
    { "op": "box", "name": "Pfostenkappe Gold (Schlussstein-Ersatz)", "if": "cut", "mirror": "xz", "mirrorAt": 8, "at": [0, 16, 12], "size": [2, 4, 4], "mode": "paint", "color": "trim" },

    { "op": "group", "name": "Schott geschlossen", "if": "!open && style == 0", "ops": [
      { "op": "box", "name": "Schottblatt", "at": [2, 0, 6], "size": [12, "lh", 4], "color": { "frame": "metal_light", "fill": { "shade": "metal_light", "f": 0.8 }, "axes": "y" } },
      { "op": "box", "name": "Rotmarke", "if": "!locked", "at": [2, "barY", 6], "size": [12, 3, 4], "mode": "paint", "color": "primary" }
    ] },
    { "op": "group", "name": "Doppeltür geschlossen", "if": "!open && style == 1", "ops": [
      { "op": "box", "name": "Türblätter Holz", "at": [2, 0, 6], "size": [12, "lh", 4], "color": { "stripes": ["wood", { "shade": "wood", "f": 0.82 }], "axis": "x", "period": 3 } },
      { "op": "box", "name": "Bronzebänder", "repeat": { "count": "cut ? 1 : 2", "step": [0, 16, 0], "var": "b" }, "at": [2, "cut ? 12 : 8", 6], "size": [12, 2, 4], "mode": "paint", "color": "metal_light" },
      { "op": "box", "name": "Ringgriffe", "if": "!locked", "at": [6, "barY", 6], "size": [4, 2, 4], "mode": "paint", "color": "trim" }
    ] },
    { "op": "box", "name": "Sperrriegel (verriegelt)", "if": "locked && !open", "at": [2, "barY", 6], "size": [12, 3, 4], "mode": "paint", "color": { "role": "warning", "emit": 1.5 }, "jitter": false },

    { "op": "box", "name": "Blattkante System (in der Laibung)", "if": "open && style == 0", "mirror": "x", "mirrorAt": 8, "at": [0, 4, 6], "size": [2, "jh - 4", 4], "mode": "paint", "color": { "shade": "metal_light", "f": 1.15 } },
    { "op": "box", "name": "Blattkante Privat (in der Laibung)", "if": "open && style == 1", "mirror": "x", "mirrorAt": 8, "at": [0, 4, 6], "size": [2, "jh - 4", 4], "mode": "paint", "color": "wood" },

    { "op": "box", "name": "Statuslicht frei (kühl)", "if": "!locked && style == 0", "mirror": "xz", "mirrorAt": 8, "at": [0, "lampY", 14], "size": [2, 2, 2], "mode": "paint", "color": { "role": "glow", "emit": 1.0 }, "jitter": false },
    { "op": "box", "name": "Statuslicht frei (warm)", "if": "!locked && style == 1", "mirror": "xz", "mirrorAt": 8, "at": [0, "lampY", 14], "size": [2, 2, 2], "mode": "paint", "color": { "role": "glow2", "emit": 0.9 }, "jitter": false },
    { "op": "box", "name": "Statuslicht verriegelt", "if": "locked", "mirror": "xz", "mirrorAt": 8, "at": [0, "lampY", 14], "size": [2, 2, 2], "mode": "paint", "color": { "role": "warning", "emit": 1.5 }, "jitter": false }
  ],
  "anchor": [8, 0, 8]
}
