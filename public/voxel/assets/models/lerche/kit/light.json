{
  "id": "lerche/kit/light",
  "name": "Lerche – Wandleuchte „Lucerna“ (normal / Alarm / Notstrom)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "kit", "licht", "wandleuchte"],
  "footprint": [0.375, 0.5],
  "params": {
    "mode": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "0 normal · 1 Alarm · 2 Notstrom" },
    "style": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "0 Bronze kühl (System) · 1 warm (Privat)" }
  },
  "variants": {
    "alarm": { "mode": 1 },
    "notstrom": { "mode": 2 },
    "warm": { "style": 1 },
    "warm_alarm": { "style": 1, "mode": 1 }
  },
  "ops": [
    { "op": "box", "name": "Wandplatte System", "if": "style == 0", "at": [-2, 0, 0], "size": [4, 12, 1], "color": { "frame": "metal_light", "fill": "metal", "axes": "xy" } },
    { "op": "box", "name": "Wandplatte Privat", "if": "style == 1", "at": [-2, 0, 0], "size": [4, 12, 1], "color": { "frame": "trim", "fill": { "shade": "trim", "f": 0.62 }, "axes": "xy" } },
    { "op": "box", "name": "Plattenspitze", "at": [-1, 12, 0], "size": [2, 1, 1], "color": "trim" },
    { "op": "box", "name": "Ausleger", "at": [-1, 10, 1], "size": [2, 1, 4], "color": "metal_dark" },
    { "op": "box", "name": "Ausleger-Stütze", "at": [-1, 8, 1], "size": [2, 2, 1], "color": "metal_dark" },

    { "op": "cyl", "name": "Schale System", "if": "style == 0", "at": [0, 3, 5], "r": 1.4, "r2": 2.8, "h": 2, "color": "metal" },
    { "op": "cyl", "name": "Schale Privat", "if": "style == 1", "at": [0, 3, 5], "r": 1.4, "r2": 2.8, "h": 2, "color": { "shade": "trim", "f": 0.8 } },
    { "op": "box", "name": "Schalenknauf", "at": [-1, 2, 4], "size": [2, 1, 2], "color": "trim" },
    { "op": "cyl", "name": "Schalenrand", "at": [0, 5, 5], "r": 3, "h": 1, "color": "trim" },

    { "op": "cyl", "name": "Licht kühl", "if": "mode == 0 && style == 0", "at": [0, 6, 5], "r": 2, "h": 3, "color": { "role": "glow", "emit": 0.85 }, "jitter": false },
    { "op": "cyl", "name": "Licht warm", "if": "mode == 0 && style == 1", "at": [0, 6, 5], "r": 2, "h": 3, "color": { "role": "glow2", "emit": 0.85 }, "jitter": false },
    { "op": "cyl", "name": "Licht Alarm", "if": "mode == 1", "at": [0, 6, 5], "r": 2, "h": 3, "color": { "role": "warning", "emit": 1.4 }, "jitter": false },
    { "op": "cyl", "name": "Licht Notstrom (gedimmt)", "if": "mode == 2", "at": [0, 6, 5], "r": 2, "h": 3, "color": { "shade": { "role": "glow2", "emit": 0.45 }, "f": 0.7 }, "jitter": false },

    { "op": "box", "name": "Käfigstreben", "mirror": "xz", "mirrorAt": { "x": 0, "z": 5 }, "at": [-2, 6, 3], "size": [1, 3, 1], "color": "metal_dark" },
    { "op": "cyl", "name": "Haube", "at": [0, 9, 5], "r": 2.6, "r2": 1.2, "h": 2, "color": "trim" },
    { "op": "box", "name": "Alarm-Raute auf der Platte", "if": "mode == 1", "at": [-1, 4, 1], "size": [2, 2, 1], "color": { "role": "warning", "emit": 1.2 }, "jitter": false }
  ],
  "anchor": [0, 0, 0]
}
