{
  "id": "lerche/kit/wall",
  "name": "Lerche – Wandkachel (Autotile, Systemdeck/Privatdeck/Brücke/Quartier)",
  "tier": "architecture",
  "palette": "lerche_rom",
  "tags": ["lerche", "kit", "wand", "kachelbar", "autotile"],
  "footprint": [1, 1],
  "jitter": 0,
  "params": {
    "conn": { "default": 10, "min": 0, "max": 15, "step": 1, "label": "Nachbarwände (N1 O2 S4 W8)" },
    "cut": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Geschnitten (1,25 m mit Kappe)" },
    "style": { "default": 0, "min": 0, "max": 4, "step": 1, "label": "0 System (wie Privat, Band schwarz) · 1 Privat · 2 Brücke · 3 Quartier Holz/Paneel · 4 Quartier Tapete" },
    "variant": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Variante (Stil 3: Holz/Paneel, Stil 4: grün/creme)" }
  },
  "variants": {
    "geschnitten": { "cut": 1 },
    "ecke": { "conn": 6 },
    "ende": { "conn": 2, "cut": 1 },
    "frei": { "conn": 0 },
    "kreuz": { "conn": 15, "cut": 1 },
    "privat": { "style": 1, "seed": 1 },
    "privat_cut": { "style": 1, "cut": 1, "seed": 2 },
    "bruecke": { "style": 2 },
    "holz": { "style": 3 },
    "paneel": { "style": 3, "variant": 1 },
    "tapete_gruen": { "style": 4 },
    "tapete_creme": { "style": 4, "variant": 1 }
  },
  "let": {
    "cn": "floor(conn) % 2",
    "ce": "floor(conn / 2) % 2",
    "cs": "floor(conn / 4) % 2",
    "cw": "floor(conn / 8) % 2",
    "H": "cut ? 5 : 12",
    "fh": "cut ? 3 : 8",
    "gy": "H - 1",
    "pil": "seed % 3 == 0 ? 1 : 0",
    "motif": "floor(seed / 3) % 4",
    "s0": "style == 0",
    "pv": "style <= 1",
    "s1": "style == 1",
    "s2": "style == 2",
    "s3h": "style == 3 && variant == 0",
    "s3p": "style == 3 && variant == 1",
    "s4g": "style == 4 && variant == 0",
    "s4c": "style == 4 && variant == 1"
  },
  "ops": [
    { "op": "box", "name": "Körper System/Privat (Stuck)", "if": "pv", "at": [0, 0, 0], "size": [4, "H", 4], "color": "stone" },
    { "op": "box", "name": "Körper Brücke (Marmor)", "if": "s2", "at": [0, 0, 0], "size": [4, "H", 4], "color": "secondary" },
    { "op": "box", "name": "Körper Quartier Holz", "if": "s3h", "at": [0, 0, 0], "size": [4, "H", 4], "color": "wood_dark" },
    { "op": "box", "name": "Körper Quartier Paneel", "if": "s3p", "at": [0, 0, 0], "size": [4, "H", 4], "color": "wood" },
    { "op": "box", "name": "Körper Tapete", "if": "style == 4", "at": [0, 0, 0], "size": [4, "H", 4], "color": "stone_light" },

    { "op": "box", "name": "Kappe dunkel (Grundriss)", "at": [0, "H-1", 0], "size": [4, 1, 4], "color": "metal_dark", "mode": "paint" },

    { "op": "group", "name": "Schauseite (je Richtung, nur wenn frei)", "repeat": { "count": 4, "step": [0, 0, 0], "var": "f" }, "rot": "f * 90", "pivot": [2, 2],
      "let": {
        "fe": "f == 0 ? 1 - cs : f == 1 ? 1 - ce : f == 2 ? 1 - cn : 1 - cw",
        "le": "f == 0 ? 1 - cw : f == 1 ? 1 - cs : f == 2 ? 1 - ce : 1 - cn",
        "re": "f == 0 ? 1 - ce : f == 1 ? 1 - cn : f == 2 ? 1 - cw : 1 - cs",
        "u0": "le",
        "uw": "4 - le - re",
        "pp": "pil && uw >= 3"
      },
      "ops": [
        { "op": "box", "name": "Feld vertieft", "if": "fe", "at": ["u0", 1, 3], "size": ["uw", "fh", 1], "mode": "carve" },

        { "op": "box", "name": "Feld System Sockelzone (schwarz statt rot)", "if": "fe && s0", "at": ["u0", 1, 2], "size": ["uw", 2, 1], "mode": "paint", "color": "dark" },
        { "op": "box", "name": "Feld Privat Sockelzone (pompejanisch rot)", "if": "fe && s1", "at": ["u0", 1, 2], "size": ["uw", 2, 1], "mode": "paint", "color": { "shade": "primary", "f": 0.85 } },
        { "op": "box", "name": "Feld Freskogrund (System/Privat)", "if": "fe && pv", "at": ["u0", 3, 2], "size": ["uw", "fh - 2", 1], "mode": "paint", "color": "stone_light" },
        { "op": "box", "name": "Feld Brücke (Marmor)", "if": "fe && s2", "at": ["u0", 1, 2], "size": ["uw", "fh", 1], "mode": "paint", "color": "stone_light" },
        { "op": "box", "name": "Feld Brücke Goldlinie", "if": "fe && s2 && !cut", "at": ["u0", 2, 2], "size": ["uw", 1, 1], "mode": "paint", "color": "trim" },
        { "op": "box", "name": "Feld Holz", "if": "fe && s3h", "at": ["u0", 1, 2], "size": ["uw", "fh", 1], "mode": "paint", "color": { "stripes": ["wood", { "shade": "wood", "f": 0.88 }], "axis": "x", "period": 2 } },
        { "op": "box", "name": "Feld Paneel", "if": "fe && s3p", "at": ["u0", 1, 2], "size": ["uw", "fh", 1], "mode": "paint", "color": "stone_light" },
        { "op": "box", "name": "Feld Paneel Fuß", "if": "fe && s3p", "at": ["u0", 1, 2], "size": ["uw", 1, 1], "mode": "paint", "color": "wood" },
        { "op": "box", "name": "Tapete grün", "if": "fe && s4g", "at": ["u0", 1, 2], "size": ["uw", "fh", 1], "mode": "paint", "color": { "stripes": ["plant_dark", { "shade": "plant_dark", "f": 0.8 }], "axis": "x", "period": 1 } },
        { "op": "box", "name": "Tapete creme", "if": "fe && s4c", "at": ["u0", 1, 2], "size": ["uw", "fh", 1], "mode": "paint", "color": { "stripes": ["stone_light", "paving"], "axis": "x", "period": 1 } },
        { "op": "box", "name": "Tapete Fußleiste", "if": "fe && style == 4", "at": ["u0", 1, 2], "size": ["uw", 1, 1], "mode": "paint", "color": "wood_dark" },

        { "op": "group", "name": "Fresko-Motiv (System/Privat, per seed)", "if": "fe && pv && !cut && !pp", "ops": [
          { "op": "box", "name": "Girlande", "if": "motif == 1", "at": [1, 6, 2], "size": [2, 1, 1], "mode": "paint", "color": "plant" },
          { "op": "box", "name": "Girlande Blüte", "if": "motif == 1", "at": [1, 5, 2], "size": [1, 1, 1], "mode": "paint", "color": "flower2" },
          { "op": "box", "name": "Vogel", "if": "motif == 2", "at": [1, 6, 2], "size": [2, 1, 1], "mode": "paint", "color": "cloth2" },
          { "op": "box", "name": "Vogel Kopf", "if": "motif == 2", "at": [2, 7, 2], "size": [1, 1, 1], "mode": "paint", "color": "cloth2" },
          { "op": "box", "name": "Vase", "if": "motif == 3", "at": [1, 4, 2], "size": [2, 1, 1], "mode": "paint", "color": "primary" },
          { "op": "box", "name": "Vase Pflanze", "if": "motif == 3", "at": [1, 5, 2], "size": [2, 2, 1], "mode": "paint", "color": "plant_dark" },
          { "op": "box", "name": "Vase Blüte", "if": "motif == 3", "at": [2, 7, 2], "size": [1, 1, 1], "mode": "paint", "color": "flower" }
        ] },

        { "op": "box", "name": "Pilaster System/Privat", "if": "fe && pp && pv", "at": [1, 1, 3], "size": [2, "fh", 1], "color": "secondary" },
        { "op": "box", "name": "Pilaster Brücke", "if": "fe && pp && s2", "at": [1, 1, 3], "size": [1, "fh", 1], "color": "secondary" },
        { "op": "box", "name": "Lichtfuge Brücke", "if": "fe && pp && s2", "at": [2, 2, 2], "size": [1, "cut ? 1 : 5", 1], "mode": "paint", "color": { "role": "glow", "emit": 0.5 } },
        { "op": "box", "name": "Lisene Quartier", "if": "fe && pp && style >= 3", "at": [1, 1, 3], "size": [1, "fh", 1], "color": "wood_dark" },
        { "op": "box", "name": "Pilaster-Kapitell gold", "if": "fe && pp && style <= 2", "at": [1, "fh", 3], "size": ["pv ? 2 : 1", 1, 1], "mode": "paint", "color": "trim" },

        { "op": "box", "name": "Sockel Brücke", "if": "fe && s2", "at": [0, 0, 3], "size": [4, 1, 1], "mode": "paint", "color": "stone_dark" },
        { "op": "box", "name": "Sockel System/Privat", "if": "fe && pv", "at": [0, 0, 3], "size": [4, 1, 1], "mode": "paint", "color": "stone_dark" },
        { "op": "box", "name": "Sockel Quartier", "if": "fe && style >= 3", "at": [0, 0, 3], "size": [4, 1, 1], "mode": "paint", "color": "wood_dark" },

        { "op": "box", "name": "Fries System (Gold/Schwarz statt Gold/Purpur)", "if": "fe && !cut && s0", "at": [0, 9, 3], "size": [4, 1, 1], "mode": "paint", "color": { "stripes": ["trim", "dark"], "axis": "x", "period": 1 } },
        { "op": "box", "name": "Fries Privat (Gold/Purpur)", "if": "fe && !cut && s1", "at": [0, 9, 3], "size": [4, 1, 1], "mode": "paint", "color": { "stripes": ["trim", "cloth2"], "axis": "x", "period": 1 } },
        { "op": "box", "name": "Fries Brücke", "if": "fe && !cut && s2", "at": [0, 9, 3], "size": [4, 1, 1], "mode": "paint", "color": "trim" },
        { "op": "box", "name": "Fries Quartier", "if": "fe && !cut && style >= 3", "at": [0, 9, 3], "size": [4, 1, 1], "mode": "paint", "color": "wood_dark" },

        { "op": "box", "name": "Goldlinie an der Kappe (Messing)", "if": "fe", "at": [0, "gy", 3], "size": [4, 1, 1], "mode": "paint", "color": { "shade": "trim", "f": 0.72 } }
      ] }
  ],
  "anchor": [2, 0, 2]
}
