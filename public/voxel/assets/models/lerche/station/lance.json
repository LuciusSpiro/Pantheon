{
  "id": "lerche/station/lance",
  "name": "Lanzen-Ladekammer – liegende Spule mit Rammsporn zum Bug (Lerche, ART-B)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "station", "system", "lanze", "rostrum"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 5, "step": 1, "label": "Zustand (0 ok, 1 besch., 2 zerst., 3 geflickt, 4 Eskalation, 5 EMP)" },
    "charge": { "default": 0, "min": 0, "max": 3, "step": 1, "label": "Ladung (0–3)" }
  },
  "let": { "lit": "state != 2 && state != 5", "c": "(state != 2 && state != 5) ? charge : 0" },
  "variants": {
    "beschaedigt": { "state": 1 }, "zerstoert": { "state": 2 }, "geflickt": { "state": 3 }, "eskalation": { "state": 4 }, "emp": { "state": 5 },
    "laedt": { "charge": 2 }, "voll": { "charge": 3 }
  },
  "ops": [
    { "op": "use", "name": "Sockel eckig", "model": "lerche/station/parts_b/plinth", "params": { "w": 16, "d": 14, "round": 0, "soot": "state == 2", "ember": "state == 4" }, "at": [0, 0, 0] },

    { "op": "group", "name": "Lagerböcke", "repeat": { "count": 2, "step": [7, 0, 0], "var": "k" }, "at": [-5, 0, 0], "ops": [
      { "op": "box", "name": "Bock Marmor", "at": [-1, 3, -4], "size": [3, 4, 7], "color": "secondary" },
      { "op": "box", "name": "Bock Goldkante", "at": [-1, 6, -4], "size": [3, 1, 7], "color": "trim" }
    ] },

    { "op": "cyl", "name": "Spulenkern", "axis": "x", "at": [-8, 10, -0.5], "r": 2.6, "h": 13, "color": "metal_dark" },
    { "op": "cyl", "name": "Ladeglut Drittel 1", "if": "c >= 1", "axis": "x", "at": [-8, 10, -0.5], "r": 2.8, "h": 4, "color": { "role": "glow", "emit": 1.6 }, "jitter": false },
    { "op": "cyl", "name": "Ladeglut Drittel 2", "if": "c >= 2", "axis": "x", "at": [-4, 10, -0.5], "r": 2.8, "h": 4, "color": { "role": "glow", "emit": 2.0 }, "jitter": false },
    { "op": "cyl", "name": "Ladeglut Drittel 3", "if": "c >= 3", "axis": "x", "at": [0, 10, -0.5], "r": 2.8, "h": 5, "color": { "role": "#E8F6FF", "emit": 2.8 }, "jitter": false },
    { "op": "cyl", "name": "Ruhelicht Kern", "if": "lit && c == 0", "axis": "x", "at": [-8, 10, -0.5], "r": 2.8, "h": 13, "color": { "role": "glow", "emit": 0.5 }, "jitter": false },
    { "op": "cyl", "name": "Wicklungen", "axis": "x", "at": [-8, 10, -0.5], "r": 3.6, "h": 1, "color": "trim", "repeat": { "count": 7, "step": [2, 0, 0] } },
    { "op": "cyl", "name": "Endplatte hinten", "axis": "x", "at": [-8, 10, -0.5], "r": 4, "h": 1, "color": { "frame": "primary", "fill": "metal", "axes": "yz", "width": 1 } },

    { "op": "group", "name": "Rammsporn (Rostrum)", "ops": [
      { "op": "box", "name": "Sporn Hals", "at": [5, 7, -3], "size": [1, 7, 5], "color": "metal_light" },
      { "op": "wedge", "name": "Sporn Keil", "at": [6, 6, -3], "size": [2, 9, 5], "slope": "+x", "color": "metal_light" },
      { "op": "box", "name": "Sporn Klinge oben", "at": [5, 13, -3], "size": [3, 1, 5], "color": "trim" },
      { "op": "box", "name": "Sporn Klinge Mitte", "at": [5, 10, -3], "size": [3, 1, 5], "color": "trim" },
      { "op": "box", "name": "Sporn Klinge unten", "at": [5, 7, -3], "size": [3, 1, 5], "color": "trim" },
      { "op": "box", "name": "Mündungsauge", "if": "c >= 3", "at": [7, 9, -1], "size": [1, 3, 1], "color": { "role": "#FFFFFF", "emit": 3 }, "jitter": false }
    ] },

    { "op": "box", "name": "Ladepult", "at": [-4, 3, 3], "size": [6, 6, 3], "color": { "frame": "trim", "fill": "stone", "axes": "xy", "width": 1 } },
    { "op": "box", "name": "Pultplatte", "at": [-5, 9, 3], "size": [8, 1, 4], "color": "metal_light" },
    { "op": "box", "name": "Ladeanzeige", "repeat": { "count": 3, "step": [2, 0, 0], "var": "i" }, "if": "c > i", "at": [-4, 10, 5], "size": [1, 1, 1], "color": { "role": "glow", "emit": 2 }, "jitter": false },
    { "op": "box", "name": "Ladeanzeige leer", "repeat": { "count": 3, "step": [2, 0, 0], "var": "i" }, "if": "c <= i", "at": [-4, 10, 5], "size": [1, 1, 1], "color": "dark", "jitter": false },
    { "op": "use", "name": "Wartungspaneel", "model": "lerche/station/parts_b/panel", "params": { "open": "state == 1 || state == 4", "w": 4, "h": 4, "kd": 1 }, "at": [-1, 4, 6] },
    { "op": "cyl", "name": "Beschädigt: Wicklung abgerutscht", "if": "state == 1 || state == 4", "axis": "x", "at": [-2, 6, -0.5], "r": 3.6, "h": 1, "arc": [0, 200], "color": "trim" },
    { "op": "cyl", "name": "Beschädigt: Lücke", "if": "state == 1 || state == 4", "axis": "x", "at": [-2, 10, -0.5], "r": 3.7, "h": 1, "hollow": 1, "mode": "carve" },

    { "op": "box", "name": "Zerstört: Spule gebrochen", "if": "state == 2", "at": [-3, 7, -5], "size": [3, 8, 9], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Sporn abgeknickt", "if": "state == 2", "at": [5, 10, -4], "size": [3, 5, 7], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Klinge am Boden", "if": "state == 2", "at": [4, 3, 3], "size": [3, 1, 3], "color": "trim" },
    { "op": "box", "name": "Zerstört: Ruß", "if": "state == 2", "at": [-8, 6, -8], "size": [16, 14, 11], "mode": "paint", "color": { "noise": ["black", "metal_dark", "metal_light", "stone_dark"], "weights": [1, 2, 3, 1], "cell": 2 }, "jitter": false },

    { "op": "use", "name": "Flickband", "if": "state == 3", "model": "lerche/station/parts_b/patch", "params": { "w": 10, "h": 7 }, "at": [-1, 3, 5] },
    { "op": "box", "name": "Flickband Spule", "if": "state == 3", "at": [-3, 6, -5], "size": [2, 9, 9], "mode": "paint", "color": { "stripes": ["metal_light", "secondary"], "axis": "y", "period": 1 } },

    { "op": "line", "name": "EMP-Bogen Wicklungen", "if": "state == 5", "from": [-7, 14, 0], "to": [-4, 12, 2], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false },
    { "op": "line", "name": "EMP-Bogen Wicklungen 2", "if": "state == 5", "from": [-4, 12, 2], "to": [-1, 14, 1], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false },
    { "op": "line", "name": "EMP-Bogen Sporn", "if": "state == 5", "from": [-1, 14, 1], "to": [5, 12, 2], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false },

    { "op": "use", "name": "Statuskrone", "model": "lerche/station/parts_b/crown", "params": { "state": "state", "r": 2.5 }, "at": [-4, 13, -0.5] }
  ],
  "anchor": [0, 0, 0]
}
