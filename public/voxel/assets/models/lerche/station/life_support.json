{
  "id": "lerche/station/life_support",
  "name": "Lebenserhaltung – Algenkessel mit Glaszylinder und Rohren (Lerche, ART-B)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "station", "system", "lebenserhaltung"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 5, "step": 1, "label": "Zustand (0 ok, 1 besch., 2 zerst., 3 geflickt, 4 Eskalation, 5 EMP)" }
  },
  "let": { "lit": "state != 2 && state != 5" },
  "variants": {
    "beschaedigt": { "state": 1 }, "zerstoert": { "state": 2 }, "geflickt": { "state": 3 }, "eskalation": { "state": 4 }, "emp": { "state": 5 }
  },
  "ops": [
    { "op": "use", "name": "Sockel eckig", "model": "lerche/station/parts_b/plinth", "params": { "w": 14, "d": 14, "round": 0, "soot": "state == 2", "ember": "state == 4" }, "at": [0, 0, 0] },

    { "op": "cyl", "name": "Kesselfuß", "at": [0, 3, 0], "r": 4.5, "h": 1, "color": "metal_dark" },
    { "op": "cyl", "name": "Kessel Bronze", "at": [0, 4, 0], "r": 5.6, "h": 6, "color": "metal_light" },
    { "op": "cyl", "name": "Kessel Rotband", "at": [0, 6, 0], "r": 5.7, "h": 2, "hollow": 1, "mode": "paint", "color": "primary" },
    { "op": "cyl", "name": "Kessel Goldrand", "at": [0, 9, 0], "r": 5.9, "h": 1, "color": "trim" },
    { "op": "cyl", "name": "Kessel Deckel", "at": [0, 10, 0], "r": 5, "h": 1, "color": "metal" },

    { "op": "cyl", "name": "Algenzylinder", "if": "state != 2", "at": [0, 11, 0], "r": 3.6, "h": 14, "color": { "noise": ["plant", "plant_dark", "plant_light", "#6FA04A"], "weights": [3, 2, 2, 1], "cell": 1 }, "jitter": false },
    { "op": "cyl", "name": "Algen dämmern (EMP)", "if": "state == 5", "at": [0, 11, 0], "r": 3.6, "h": 14, "mode": "paint", "color": { "noise": ["plant_dark", "#2F4A26"], "weights": [2, 1], "cell": 1 }, "jitter": false },
    { "op": "box", "name": "Gasblasen", "if": "lit", "at": [-1, 13, 3], "size": [1, 1, 1], "color": { "role": "glow", "emit": 1.6 }, "jitter": false, "repeat": { "count": 4, "step": [1, 3, 0], "var": "i" } },
    { "op": "box", "name": "Gasblasen links", "if": "lit", "at": [-3, 15, 1], "size": [1, 1, 1], "color": { "role": "glow", "emit": 1.6 }, "jitter": false, "repeat": { "count": 3, "step": [0, 3, 0] } },
    { "op": "box", "name": "Glasstrebe vorn/hinten", "if": "state != 2", "at": [-0.5, 11, -4], "size": [1, 14, 8], "mode": "paint", "color": "metal_light" },
    { "op": "box", "name": "Glasstrebe seitlich", "if": "state != 2", "at": [-4, 11, -0.5], "size": [8, 14, 1], "mode": "paint", "color": "metal_light" },
    { "op": "cyl", "name": "Glasring", "at": [0, 17, 0], "r": 3.9, "h": 1, "hollow": 0.9, "color": "trim" },
    { "op": "cyl", "name": "Deckelring", "at": [0, 25, 0], "r": 4.2, "h": 1, "color": "trim" },
    { "op": "ellipsoid", "name": "Kuppeldeckel", "at": [0, 26, 0], "r": [3.2, 1.8, 3.2], "half": "+y", "color": "metal_light" },

    { "op": "line", "name": "Steigrohr", "from": [6, 5, 0], "to": [6, 21, 0], "r": 0.9, "color": "metal", "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "Steigrohr Bogen", "from": [6, 21, 0], "to": [4, 23, 0], "r": 0.9, "color": "metal", "mirror": "x", "mirrorAt": 0 },
    { "op": "box", "name": "Rohrmuffe", "at": [5, 14, -1], "size": [2, 1, 2], "color": "trim", "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "Rücklauf zur Wand", "from": [-2, 6, -5], "to": [-2, 6, -6.6], "r": 1, "color": "metal_dark", "mirror": "x", "mirrorAt": 0 },
    { "op": "cyl", "name": "Handrad", "axis": "z", "at": [-4.5, 8, 5], "r": 1.8, "h": 1, "hollow": 0.7, "color": "primary" },
    { "op": "use", "name": "Wartungspaneel", "model": "lerche/station/parts_b/panel", "params": { "open": "state == 1 || state == 4", "w": 4, "h": 4, "kd": 2 }, "at": [1, 4, 5] },
    { "op": "line", "name": "Beschädigt: Sprung im Glas", "if": "state == 1 || state == 4", "from": [-2, 23, 3], "to": [1, 15, 3.5], "r": 0.6, "mode": "paint", "color": "black", "jitter": false },

    { "op": "cyl", "name": "Zerstört: Glasstumpf", "if": "state == 2", "at": [0, 11, 0], "r": 3.6, "h": 4, "hollow": 1, "color": { "noise": ["glass", "plant_dark", "soil_dark"], "weights": [2, 1, 1] }, "jitter": false },
    { "op": "box", "name": "Zerstört: Glasstumpf Zacke", "if": "state == 2", "at": [-3, 15, -2], "size": [2, 4, 3], "color": "glass", "jitter": false },
    { "op": "box", "name": "Zerstört: Lache ausgelaufen", "if": "state == 2", "at": [-7, 3, 2], "size": [9, 1, 5], "color": { "noise": ["plant_dark", "soil_dark", "#2F4A26"], "weights": [2, 1, 1] }, "jitter": false },
    { "op": "box", "name": "Zerstört: Deckel hängt", "if": "state == 2", "at": [-1, 18, -8], "size": [8, 10, 5], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Rohr abgerissen", "if": "state == 2", "at": [4, 12, -2], "size": [4, 12, 4], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Ruß", "if": "state == 2", "at": [-8, 9, -8], "size": [16, 20, 16], "mode": "paint", "color": { "noise": ["black", "metal_dark", "metal_light", "stone_dark"], "weights": [1, 2, 3, 1], "cell": 2 }, "jitter": false },

    { "op": "use", "name": "Flickband", "if": "state == 3", "model": "lerche/station/parts_b/patch", "params": { "w": 8, "h": 9 }, "at": [0, 13, 3] },

    { "op": "line", "name": "EMP-Bogen Rohr-Glas", "if": "state == 5", "from": [6, 19, 0], "to": [3, 17, 2], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "EMP-Bogen Glas", "if": "state == 5", "from": [3, 17, 2], "to": [1, 21, 3], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },

    { "op": "use", "name": "Statuskrone", "if": "state != 2", "model": "lerche/station/parts_b/crown", "params": { "state": "state", "r": 2.6 }, "at": [0, 27, 0] },
    { "op": "use", "name": "Statuskrone (zerstört, tiefer)", "if": "state == 2", "model": "lerche/station/parts_b/crown", "params": { "state": 2, "r": 3 }, "at": [0, 15, 0] }
  ],
  "anchor": [0, 0, 0]
}
