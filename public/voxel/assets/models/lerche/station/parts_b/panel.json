{
  "id": "lerche/station/parts_b/panel",
  "name": "Wartungspaneel (zu / offen, ART-B)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "station", "teil", "paneel"],
  "footprint": [0.4, 0.15],
  "params": {
    "open": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Paneel offen" },
    "w": { "default": 5, "min": 3, "max": 10, "step": 1, "label": "Breite (Voxel)" },
    "h": { "default": 6, "min": 3, "max": 12, "step": 1, "label": "Höhe (Voxel)" },
    "kd": { "default": 3, "min": 1, "max": 6, "step": 1, "label": "Klappentiefe offen (Voxel)" }
  },
  "let": { "x0": "-floor(w/2)" },
  "ops": [
    { "op": "box", "name": "Paneel zu", "if": "!open", "at": ["x0", 0, 0], "size": ["w", "h", 1], "color": { "frame": "trim", "fill": "primary", "axes": "xy", "width": 1 } },
    { "op": "box", "name": "Griffleiste", "if": "!open", "at": [-1, "floor(h/2)", 1], "size": [2, 1, 1], "color": "metal_light" },
    { "op": "box", "name": "Öffnung Rahmen", "if": "open", "at": ["x0", 0, 0], "size": ["w", "h", 1], "color": "metal_dark" },
    { "op": "box", "name": "Öffnung dunkel", "if": "open", "at": ["x0+1", 1, 0], "size": ["w-2", "h-2", 1], "color": "black", "jitter": false },
    { "op": "line", "name": "Kabel hängt heraus 1", "if": "open", "from": ["x0+1", "h-2", 1], "to": ["x0+2", 1, 1], "r": 0.5, "color": "glow2" },
    { "op": "line", "name": "Kabel hängt heraus 2", "if": "open", "from": ["x0+w-2", "h-2", 1], "to": ["x0+w-3", 0, 1], "r": 0.5, "color": "metal_light" },
    { "op": "box", "name": "Klappe aufgeschwenkt", "if": "open", "at": ["x0+w", 0, 1], "size": [1, "h", "min(kd, w-1)"], "color": { "frame": "trim", "fill": "primary", "axes": "yz", "width": 1 } }
  ],
  "anchor": [0, 0, 0]
}
