{
  "id": "lerche/station/reactor",
  "name": "Reaktor – Tholos mit Glühkern (Lerche, ART-B)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "station", "system", "reaktor", "tholos"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 5, "step": 1, "label": "Zustand (0 ok, 1 besch., 2 zerst., 3 geflickt, 4 Eskalation, 5 EMP)" },
    "power": { "default": 0, "min": 0, "max": 3, "step": 1, "label": "Leistung (0 online, 1 überladen, 2 offline, 3 Notstart)" }
  },
  "let": {
    "dead": "state == 2 || power == 2",
    "cold": "state == 5 && power != 1"
  },
  "variants": {
    "beschaedigt": { "state": 1 },
    "zerstoert": { "state": 2 },
    "geflickt": { "state": 3 },
    "eskalation": { "state": 4 },
    "emp": { "state": 5 },
    "ueberladen": { "power": 1 },
    "offline": { "power": 2 },
    "notstart": { "power": 3 }
  },
  "ops": [
    { "op": "use", "name": "Sockel rund", "model": "lerche/station/parts_b/plinth", "params": { "w": 15, "d": 15, "round": 1, "soot": "state == 2", "ember": "state == 4" }, "at": [0, 0, 0] },
    { "op": "cyl", "name": "Stufe Marmor", "at": [0, 3, 0], "r": 6.6, "h": 1, "color": "secondary" },
    { "op": "cyl", "name": "Stylobat", "at": [0, 4, 0], "r": 6.1, "h": 1, "color": "stone_light" },

    { "op": "cyl", "name": "Kern Fassung unten", "at": [0, 5, 0], "r": 2.8, "h": 1, "color": "trim" },
    { "op": "cyl", "name": "Glühkern online", "if": "!dead && !cold && (power == 0)", "at": [0, 6, 0], "r": 2, "h": 12, "color": { "role": "glow", "emit": 2.2 }, "jitter": false },
    { "op": "cyl", "name": "Glühkern überladen (grell)", "if": "!dead && power == 1", "at": [0, 6, 0], "r": 2, "h": 12, "color": { "role": "#F4FBFF", "emit": 3.6 }, "jitter": false },
    { "op": "cyl", "name": "Glühkern Notstart (Amber)", "if": "!dead && !cold && power == 3", "at": [0, 6, 0], "r": 2, "h": 12, "color": { "role": "glow2", "emit": 2.0 }, "jitter": false },
    { "op": "cyl", "name": "Glühkern EMP (kalt, schwach)", "if": "!dead && cold", "at": [0, 6, 0], "r": 2, "h": 12, "color": { "role": "#3C5566", "emit": 0.5 }, "jitter": false },
    { "op": "cyl", "name": "Kern dunkel", "if": "dead", "at": [0, 6, 0], "r": 2, "h": 12, "color": "glass", "jitter": false },
    { "op": "cyl", "name": "Kernringe Bronze", "at": [0, 8, 0], "r": 2.6, "h": 1, "color": "metal_dark", "repeat": { "count": 3, "step": [0, 4, 0] } },
    { "op": "ellipsoid", "name": "Flamme oben", "if": "!dead", "at": [0, 18, 0], "r": [2, 2.4, 2], "half": "+y", "color": { "role": "glow", "emit": 2.6 }, "jitter": false },
    { "op": "ellipsoid", "name": "Flamme überladen", "if": "!dead && power == 1", "at": [0, 18, 0], "r": [2, 3.4, 2], "half": "+y", "color": { "role": "#FFFFFF", "emit": 4 }, "jitter": false },
    { "op": "ellipsoid", "name": "Flamme Notstart", "if": "!dead && power == 3", "at": [0, 18, 0], "r": [2, 2.4, 2], "half": "+y", "color": { "role": "glow2", "emit": 2.4 }, "jitter": false },

    { "op": "group", "name": "Säulen seitlich", "mirror": "x", "mirrorAt": 0, "ops": [
      { "op": "group", "name": "Säule 0°", "at": [5, 0, 0], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 5, -1], "size": [3, 1, 3], "color": "trim" },
        { "op": "cyl", "name": "Schaft", "at": [0.5, 6, 0.5], "r": 1.1, "h": 11, "color": "secondary" },
        { "op": "box", "name": "Kapitell", "at": [-1, 17, -1], "size": [3, 1, 3], "color": "trim" } ] },
      { "op": "group", "name": "Säule 45°", "at": [3.5, 0, 3.5], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 5, -1], "size": [3, 1, 3], "color": "trim" },
        { "op": "cyl", "name": "Schaft", "at": [0.5, 6, 0.5], "r": 1.1, "h": 11, "color": "secondary" },
        { "op": "box", "name": "Kapitell", "at": [-1, 17, -1], "size": [3, 1, 3], "color": "trim" } ] },
      { "op": "group", "name": "Säule 135°", "at": [3.5, 0, -4.5], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 5, -1], "size": [3, 1, 3], "color": "trim" },
        { "op": "cyl", "name": "Schaft", "at": [0.5, 6, 0.5], "r": 1.1, "h": 11, "color": "secondary" },
        { "op": "box", "name": "Kapitell", "at": [-1, 17, -1], "size": [3, 1, 3], "color": "trim" } ] }
    ] },
    { "op": "group", "name": "Säule hinten", "at": [-0.5, 0, -6], "ops": [
      { "op": "box", "name": "Basis", "at": [-1, 5, -1], "size": [3, 1, 3], "color": "trim" },
      { "op": "cyl", "name": "Schaft", "at": [0.5, 6, 0.5], "r": 1.1, "h": 11, "color": "secondary" },
      { "op": "box", "name": "Kapitell", "at": [-1, 17, -1], "size": [3, 1, 3], "color": "trim" } ] },

    { "op": "cyl", "name": "Gebälk", "at": [0, 18, 0], "r": 6.8, "h": 2, "hollow": 2, "color": "stone" },
    { "op": "cyl", "name": "Gebälk Goldband", "at": [0, 19, 0], "r": 6.9, "h": 1, "hollow": 1, "color": "trim" },
    { "op": "ellipsoid", "name": "Kuppel Bronze", "at": [0, 20, 0], "r": [6.6, 6, 6.6], "half": "+y", "color": "metal_light" },
    { "op": "box", "name": "Kuppelrippen", "at": [-0.5, 20, -7], "size": [1, 7, 14], "mode": "paint", "color": "trim" },
    { "op": "box", "name": "Kuppelrippen quer", "at": [-7, 20, -0.5], "size": [14, 7, 1], "mode": "paint", "color": "trim" },
    { "op": "cyl", "name": "Kuppelfuß Rot", "at": [0, 20, 0], "r": 6.7, "h": 1, "hollow": 1.2, "mode": "paint", "color": "primary" },
    { "op": "cyl", "name": "Oculus", "at": [0, 18, 0], "r": 2.1, "h": 12, "mode": "carve" },

    { "op": "box", "name": "Bedienaltar", "at": [-2, 3, 3], "size": [4, 7, 2], "color": { "frame": "trim", "fill": "stone", "axes": "xy", "width": 1 } },
    { "op": "box", "name": "Altarplatte", "at": [-3, 10, 3], "size": [6, 1, 3], "color": "metal_light" },
    { "op": "box", "name": "Anzeige", "if": "!dead", "at": [-1, 11, 4], "size": [2, 1, 1], "color": { "role": "glow", "emit": 1.4 }, "jitter": false },
    { "op": "use", "name": "Wartungspaneel", "model": "lerche/station/parts_b/panel", "params": { "open": "state == 1 || state == 4", "w": 4, "h": 5, "kd": 2 }, "at": [0, 4, 5] },

    { "op": "line", "name": "Riss leuchtet Kuppel", "if": "power == 1 && !dead", "from": [0, 26, 0], "to": [6, 21, 2], "r": 1.1, "mode": "paint", "color": { "role": "#FFFFFF", "emit": 3.4 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "Riss leuchtet Kuppel hinten", "if": "power == 1 && !dead", "from": [0, 26, 0], "to": [-2, 21, -6], "r": 1.1, "mode": "paint", "color": { "role": "#FFFFFF", "emit": 3.4 }, "jitter": false },
    { "op": "cyl", "name": "Gebälk glüht (überladen)", "if": "power == 1 && !dead", "at": [0, 18, 0], "r": 6.9, "h": 3, "hollow": 1.5, "mode": "paint", "color": { "noise": [{ "role": "#FFFFFF", "emit": 3 }, "stone", { "role": "#FFF4D6", "emit": 2.4 }], "weights": [2, 2, 1], "cell": 1 }, "jitter": false },
    { "op": "line", "name": "Riss leuchtet Stufe", "if": "power == 1 && !dead", "from": [-6, 4, 2], "to": [6, 4, -2], "r": 0.7, "mode": "paint", "color": { "role": "#FFF4D6", "emit": 3 }, "jitter": false },

    { "op": "box", "name": "Zerstört: Säule gebrochen", "if": "state == 2", "at": [2, 10, 2], "size": [6, 8, 6], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Kuppel eingebrochen", "if": "state == 2", "at": [0, 18, 0], "size": [8, 10, 8], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Trümmer", "if": "state == 2", "at": [4, 3, 4], "size": [3, 2, 2], "color": "metal_light" },
    { "op": "box", "name": "Zerstört: Ruß Kuppel", "if": "state == 2", "at": [-8, 17, -8], "size": [16, 12, 16], "mode": "paint", "color": { "noise": ["black", "metal_dark", "metal", "stone_dark"], "weights": [2, 2, 2, 1], "cell": 2 }, "jitter": false },

    { "op": "use", "name": "Flickband", "if": "state == 3", "model": "lerche/station/parts_b/patch", "params": { "w": 8, "h": 7 }, "at": [0, 3, 5] },

    { "op": "line", "name": "EMP-Bogen 1", "if": "state == 5", "from": [5, 15, 0], "to": [3, 12, 2], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.6 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "EMP-Bogen 2", "if": "state == 5", "from": [3, 12, 2], "to": [2, 15, 1], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.6 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "EMP-Bogen 3", "if": "state == 5", "from": [4, 9, 4], "to": [6, 6, 1], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.6 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },

    { "op": "cyl", "name": "Laterne Fuß", "at": [0, 25, 0], "r": 2.4, "h": 1, "color": "metal_dark" },
    { "op": "cyl", "name": "Laterne online", "if": "!dead && !cold && power == 0", "at": [0, 26, 0], "r": 1.8, "h": 2, "color": { "role": "glow", "emit": 2.2 }, "jitter": false },
    { "op": "cyl", "name": "Laterne überladen", "if": "!dead && power == 1", "at": [0, 26, 0], "r": 1.8, "h": 3, "color": { "role": "#FFFFFF", "emit": 3.6 }, "jitter": false },
    { "op": "cyl", "name": "Laterne Notstart", "if": "!dead && !cold && power == 3", "at": [0, 26, 0], "r": 1.8, "h": 2, "color": { "role": "glow2", "emit": 2.2 }, "jitter": false },
    { "op": "cyl", "name": "Laterne EMP", "if": "!dead && cold", "at": [0, 26, 0], "r": 1.8, "h": 2, "color": { "role": "#3C5566", "emit": 0.5 }, "jitter": false },
    { "op": "cyl", "name": "Laterne dunkel", "if": "dead", "at": [0, 26, 0], "r": 1.8, "h": 2, "color": "glass", "jitter": false },
    { "op": "use", "name": "Statuskrone", "model": "lerche/station/parts_b/crown", "params": { "state": "state", "r": 3.6 }, "at": [0, 25, 0] }
  ],
  "anchor": [0, 0, 0]
}
