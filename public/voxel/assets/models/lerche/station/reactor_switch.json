{
  "id": "lerche/station/reactor_switch",
  "name": "Reaktorschalter – Hebel an Marmorsäule (Lerche, ART-B)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "station", "schalter", "reaktor"],
  "footprint": [0.6, 0.75],
  "params": {
    "pos": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Hebel (0 ruht, 1 gehalten, 2 umgelegt)" }
  },
  "variants": { "gehalten": { "pos": 1 }, "umgelegt": { "pos": 2 } },
  "ops": [
    { "op": "use", "name": "Sockel", "model": "lerche/station/parts_b/plinth", "params": { "w": 9, "d": 10, "round": 0 }, "at": [0, 0, -1] },
    { "op": "box", "name": "Säulenfuß", "at": [-3, 3, -5], "size": [6, 1, 5], "color": "trim" },
    { "op": "box", "name": "Säulenschaft Marmor", "at": [-2, 4, -4], "size": [4, 20, 3], "color": { "stripes": ["secondary", "stone"], "axis": "x", "period": 1 } },
    { "op": "box", "name": "Kapitell", "at": [-3, 24, -5], "size": [6, 2, 5], "color": { "frame": "trim", "fill": "stone", "axes": "xz", "width": 1 } },
    { "op": "box", "name": "Lichtkanal", "at": [-0.5, 6, -1], "size": [1, 16, 1], "mode": "paint", "color": { "role": "glow", "emit": 1.2 }, "jitter": false },

    { "op": "box", "name": "Schaltkasten Bronze", "at": [-3, 9, -1], "size": [6, 7, 2], "color": { "frame": "trim", "fill": "metal", "axes": "xy", "width": 1 } },
    { "op": "box", "name": "Hebelschlitz", "at": [-0.5, 10, 1], "size": [1, 5, 1], "color": "black", "jitter": false },
    { "op": "box", "name": "Drehpunkt", "at": [-1, 12, 1], "size": [2, 1, 1], "color": "trim" },

    { "op": "line", "name": "Hebel ruht (oben)", "if": "pos == 0", "from": [0, 12.5, 2], "to": [0, 18, 4], "r": 0.6, "color": "metal_light" },
    { "op": "box", "name": "Griff ruht", "if": "pos == 0", "at": [-1, 18, 3], "size": [2, 2, 2], "color": "primary" },
    { "op": "line", "name": "Hebel gehalten (waagrecht)", "if": "pos == 1", "from": [0, 12.5, 2], "to": [0, 13, 6], "r": 0.6, "color": "metal_light" },
    { "op": "box", "name": "Griff gehalten", "if": "pos == 1", "at": [-1, 12, 5], "size": [2, 2, 2], "color": { "role": "glow2", "emit": 1.8 }, "jitter": false },
    { "op": "line", "name": "Hebel umgelegt (unten)", "if": "pos == 2", "from": [0, 12.5, 2], "to": [0, 7, 4], "r": 0.6, "color": "metal_light" },
    { "op": "box", "name": "Griff umgelegt", "if": "pos == 2", "at": [-1, 6, 3], "size": [2, 2, 2], "color": "primary" },

    { "op": "box", "name": "Anzeige ruht", "if": "pos == 0", "at": [-1, 17, -1], "size": [2, 2, 1], "color": "glass", "jitter": false },
    { "op": "box", "name": "Anzeige gehalten (Amber)", "if": "pos == 1", "at": [-1, 17, -1], "size": [2, 2, 1], "color": { "role": "glow2", "emit": 2.2 }, "jitter": false },
    { "op": "box", "name": "Anzeige umgelegt", "if": "pos == 2", "at": [-1, 17, -1], "size": [2, 2, 1], "color": { "role": "glow", "emit": 2.2 }, "jitter": false },
    { "op": "box", "name": "Kapitell-Leuchte gehalten", "if": "pos == 1", "at": [-2, 26, -4], "size": [4, 1, 3], "color": { "role": "glow2", "emit": 2 }, "jitter": false },
    { "op": "box", "name": "Kapitell-Leuchte umgelegt", "if": "pos == 2", "at": [-2, 26, -4], "size": [4, 1, 3], "color": { "role": "glow", "emit": 2 }, "jitter": false },
    { "op": "box", "name": "Kapitell-Deckel ruht", "if": "pos == 0", "at": [-2, 26, -4], "size": [4, 1, 3], "color": "metal_dark" }
  ],
  "anchor": [0, 0, 0]
}
