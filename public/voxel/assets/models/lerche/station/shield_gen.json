{
  "id": "lerche/station/shield_gen",
  "name": "Schildgenerator – Säulenkranz mit schwebendem Ring (Lerche, ART-B)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "station", "system", "schild"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 5, "step": 1, "label": "Zustand (0 ok, 1 besch., 2 zerst., 3 geflickt, 4 Eskalation, 5 EMP)" }
  },
  "let": { "lit": "state != 2 && state != 5", "ringUp": "state != 2", "tilt": "state == 1 || state == 4" },
  "variants": {
    "beschaedigt": { "state": 1 }, "zerstoert": { "state": 2 }, "geflickt": { "state": 3 }, "eskalation": { "state": 4 }, "emp": { "state": 5 }
  },
  "ops": [
    { "op": "use", "name": "Sockel eckig", "model": "lerche/station/parts_b/plinth", "params": { "w": 14, "d": 14, "round": 0, "soot": "state == 2", "ember": "state == 4" }, "at": [0, 0, 0] },
    { "op": "cyl", "name": "Ringscheibe Marmor", "at": [0, 3, 0], "r": 6.2, "h": 1, "color": "secondary" },
    { "op": "cyl", "name": "Ringscheibe Fuge", "at": [0, 3, 0], "r": 4.2, "h": 1, "hollow": 1, "mode": "paint", "color": "trim", "jitter": false },

    { "op": "box", "name": "Mittelblock", "at": [-2, 4, -2], "size": [4, 5, 4], "color": { "frame": "trim", "fill": "metal", "axes": "xy", "width": 1 } },
    { "op": "cyl", "name": "Mast", "at": [0, 9, 0], "r": 1, "h": 15, "color": "metal_dark" },
    { "op": "ellipsoid", "name": "Feldkugel", "if": "lit", "at": [0, 13, 0], "r": 2.2, "color": { "role": "glow", "emit": 2 }, "jitter": false },
    { "op": "ellipsoid", "name": "Feldkugel dunkel", "if": "!lit", "at": [0, 13, 0], "r": 2.2, "color": "glass", "jitter": false },
    { "op": "cyl", "name": "Kugelfassung", "at": [0, 12, 0], "r": 2.6, "h": 1, "hollow": 0.8, "color": "trim" },
    { "op": "use", "name": "Wartungspaneel", "model": "lerche/station/parts_b/panel", "params": { "open": "state == 1 || state == 4", "w": 4, "h": 4, "kd": 3 }, "at": [0, 4, 2] },

    { "op": "group", "name": "Säulenkranz", "mirror": "x", "mirrorAt": 0, "ops": [
      { "op": "group", "name": "Säule 0°", "at": [5.5, 0, 0], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 4, -1], "size": [2, 1, 2], "color": "trim" },
        { "op": "cyl", "name": "Schaft", "at": [0, 5, 0], "r": 0.8, "h": 14, "color": { "stripes": ["secondary", "stone"], "axis": "y", "period": 4 } },
        { "op": "box", "name": "Kapitell", "at": [-1, 19, -1], "size": [2, 1, 2], "color": "trim" },
        { "op": "box", "name": "Feldspitze", "if": "lit", "at": [-1, 20, -1], "size": [2, 1, 2], "color": { "role": "glow", "emit": 1.8 }, "jitter": false } ] },
      { "op": "group", "name": "Säule 60°", "at": [3, 0, 4.5], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 4, -1], "size": [2, 1, 2], "color": "trim" },
        { "op": "cyl", "name": "Schaft", "at": [0, 5, 0], "r": 0.8, "h": 14, "color": { "stripes": ["secondary", "stone"], "axis": "y", "period": 4 } },
        { "op": "box", "name": "Kapitell", "at": [-1, 19, -1], "size": [2, 1, 2], "color": "trim" },
        { "op": "box", "name": "Feldspitze", "if": "lit", "at": [-1, 20, -1], "size": [2, 1, 2], "color": { "role": "glow", "emit": 1.8 }, "jitter": false } ] },
      { "op": "group", "name": "Säule 300°", "at": [3, 0, -4.5], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 4, -1], "size": [2, 1, 2], "color": "trim" },
        { "op": "cyl", "name": "Schaft", "at": [0, 5, 0], "r": 0.8, "h": 14, "color": { "stripes": ["secondary", "stone"], "axis": "y", "period": 4 } },
        { "op": "box", "name": "Kapitell", "at": [-1, 19, -1], "size": [2, 1, 2], "color": "trim" },
        { "op": "box", "name": "Feldspitze", "if": "lit", "at": [-1, 20, -1], "size": [2, 1, 2], "color": { "role": "glow", "emit": 1.8 }, "jitter": false } ] }
    ] },

    { "op": "cyl", "name": "Schwebender Ring Bronze", "if": "ringUp && !tilt", "at": [0, 22, 0], "r": 7, "h": 2, "hollow": 1.6, "color": "metal_light" },
    { "op": "cyl", "name": "Ring Feldband innen", "if": "lit && !tilt", "at": [0, 23, 0], "r": 5.7, "h": 1, "hollow": 0.6, "color": { "role": "glow", "emit": 2 }, "jitter": false },
    { "op": "cyl", "name": "Ring Feldband innen aus", "if": "!lit && ringUp && !tilt", "at": [0, 23, 0], "r": 5.7, "h": 1, "hollow": 0.6, "color": "metal_dark" },
    { "op": "cyl", "name": "Ring schief hinten (beschädigt)", "if": "tilt", "at": [0, 22, 0], "r": 7, "h": 2, "hollow": 1.6, "arc": [180, 360], "color": "metal_light" },
    { "op": "cyl", "name": "Ring schief Mitte (beschädigt)", "if": "tilt", "at": [0, 20, 0], "r": 7, "h": 2, "hollow": 1.6, "arc": [0, 50], "color": "metal_light" },
    { "op": "cyl", "name": "Ring schief Mitte 2 (beschädigt)", "if": "tilt", "at": [0, 20, 0], "r": 7, "h": 2, "hollow": 1.6, "arc": [130, 180], "color": "metal_light" },
    { "op": "cyl", "name": "Ring abgesackt vorn (beschädigt)", "if": "tilt", "at": [0, 18, 0], "r": 7, "h": 2, "hollow": 1.6, "arc": [50, 130], "color": "metal_light" },
    { "op": "cyl", "name": "Ring Feldband flackert (beschädigt)", "if": "tilt", "at": [0, 23, 0], "r": 5.7, "h": 1, "hollow": 0.6, "arc": [200, 340], "color": { "role": "glow", "emit": 1.6 }, "jitter": false },
    { "op": "cyl", "name": "Ring Rotband", "if": "ringUp", "at": [0, 18, 0], "r": 7, "h": 6, "hollow": 0.7, "mode": "paint", "color": { "stripes": ["primary", "metal_light"], "axis": "y", "period": 1 } },
    { "op": "box", "name": "Flickklammern auf Ring (geflickt)", "if": "state == 3", "at": [-2, 24, 4], "size": [4, 1, 3], "color": { "stripes": ["metal_light", "secondary"], "axis": "x", "period": 1 }, "mirror": "z", "mirrorAt": 0 },
    { "op": "box", "name": "Flickklammern seitlich (geflickt)", "if": "state == 3", "at": [4, 24, -2], "size": [3, 1, 4], "color": { "stripes": ["metal_light", "secondary"], "axis": "z", "period": 1 } },
    { "op": "box", "name": "Ring Goldnieten", "if": "ringUp", "at": [-0.5, 24, -7], "size": [1, 1, 14], "mode": "paint", "color": "trim" },

    { "op": "box", "name": "Zerstört: Säule gebrochen", "if": "state == 2", "at": [1, 11, 2], "size": [5, 10, 5], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Mast abgeknickt", "if": "state == 2", "at": [-2, 18, -2], "size": [4, 10, 4], "mode": "carve" },
    { "op": "cyl", "name": "Zerstört: Ring abgestürzt", "if": "state == 2", "at": [0, 4, 0], "r": 7, "h": 1, "hollow": 1.4, "arc": [150, 330], "color": "metal_light" },
    { "op": "box", "name": "Zerstört: Ringstück schräg", "if": "state == 2", "at": [3, 4, 3], "size": [3, 3, 2], "color": "metal_dark" },
    { "op": "box", "name": "Zerstört: Ruß", "if": "state == 2", "at": [-8, 3, -8], "size": [16, 20, 16], "mode": "paint", "color": { "noise": ["black", "metal_dark", "secondary", "stone_dark"], "weights": [2, 2, 2, 1], "cell": 2 }, "jitter": false },

    { "op": "use", "name": "Flickband", "if": "state == 3", "model": "lerche/station/parts_b/patch", "params": { "w": 8, "h": 8 }, "at": [0, 8, 3] },

    { "op": "line", "name": "EMP-Bogen Säule-Ring", "if": "state == 5", "from": [5, 20, 0], "to": [6, 22, 2], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "EMP-Bogen Ring-Mast", "if": "state == 5", "from": [4, 22, -3], "to": [1, 19, -1], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "EMP-Bogen Kugel", "if": "state == 5", "from": [-2, 15, 1], "to": [2, 11, 2], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false },

    { "op": "use", "name": "Statuskrone", "if": "state != 2", "model": "lerche/station/parts_b/crown", "params": { "state": "state", "r": 2.5 }, "at": [0, 24, 0] },
    { "op": "use", "name": "Statuskrone (zerstört, tiefer)", "if": "state == 2", "model": "lerche/station/parts_b/crown", "params": { "state": 2, "r": 2.5 }, "at": [0, 18, 0] }
  ],
  "anchor": [0, 0, 0]
}
