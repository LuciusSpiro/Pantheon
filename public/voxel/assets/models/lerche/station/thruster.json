{
  "id": "lerche/station/thruster",
  "name": "Steuerdüse – Düsengehäuse mit Adlerschwinge als Kühlrippen (Lerche, ART-B)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "station", "system", "duese", "adler"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 5, "step": 1, "label": "Zustand (0 ok, 1 besch., 2 zerst., 3 geflickt, 4 Eskalation, 5 EMP)" },
    "side": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Seite (0 Backbord: Schwinge nach −x, 1 Steuerbord: gespiegelt)" }
  },
  "let": { "lit": "state != 2 && state != 5", "w": "side ? 1 : -1", "bx": "side ? -2.5 : 2.5", "bx0": "side ? -3 : 2" },
  "variants": {
    "beschaedigt": { "state": 1 }, "zerstoert": { "state": 2 }, "geflickt": { "state": 3 }, "eskalation": { "state": 4 }, "emp": { "state": 5 },
    "steuerbord": { "side": 1 }
  },
  "ops": [
    { "op": "use", "name": "Sockel eckig", "model": "lerche/station/parts_b/plinth", "params": { "w": 16, "d": 14, "round": 0, "soot": "state == 2", "ember": "state == 4" }, "at": [0, 0, 0] },

    { "op": "box", "name": "Gehäusebett", "at": ["bx0-3", 3, -6], "size": [7, 3, 10], "color": "metal_dark" },
    { "op": "cyl", "name": "Düsengehäuse", "axis": "z", "at": ["bx", 9.5, -7], "r": 4, "h": 10, "color": "metal_light" },
    { "op": "cyl", "name": "Düsenglocke hinten", "axis": "z", "at": ["bx", 9.5, -7], "r": 4.6, "r2": 4, "h": 2, "color": "metal" },
    { "op": "cyl", "name": "Gehäuseringe", "axis": "z", "at": ["bx", 9.5, -4], "r": 4.4, "h": 1, "color": "trim", "repeat": { "count": 2, "step": [0, 0, 4] } },
    { "op": "box", "name": "Rotband Gehäuse", "at": ["bx0-4", 13, -2], "size": [9, 1, 1], "mode": "paint", "color": "primary" },
    { "op": "cyl", "name": "Frontdeckel", "axis": "z", "at": ["bx", 9.5, 3], "r": 3.4, "h": 1, "color": { "frame": "trim", "fill": "secondary", "axes": "xy", "width": 1 } },
    { "op": "cyl", "name": "Druckanzeige", "if": "lit", "axis": "z", "at": ["bx", 9.5, 4], "r": 1.2, "h": 1, "color": { "role": "glow", "emit": 1.8 }, "jitter": false },
    { "op": "cyl", "name": "Druckanzeige aus", "if": "!lit", "axis": "z", "at": ["bx", 9.5, 4], "r": 1.2, "h": 1, "color": "glass", "jitter": false },

    { "op": "group", "name": "Adlerkopf", "at": ["bx", 13, 1], "ops": [
      { "op": "ellipsoid", "name": "Kopf", "at": [0, 1.5, 0], "r": [1.8, 1.6, 2], "color": "trim" },
      { "op": "box", "name": "Schnabel", "at": [-1, 0, 2], "size": [2, 2, 2], "color": "metal_light" },
      { "op": "box", "name": "Schnabelspitze", "at": [-0.5, 0, 4], "size": [1, 1, 1], "color": "metal_light" },
      { "op": "box", "name": "Auge", "if": "lit", "at": [-2, 2, 1], "size": [4, 1, 1], "color": { "role": "glow", "emit": 1.6 }, "jitter": false }
    ] },

    { "op": "box", "name": "Schwinge Ansatz", "at": ["side ? 0 : -3", 6, -6], "size": [3, 6, 9], "color": "metal" },
    { "op": "box", "name": "Feder (Kühlrippe)", "repeat": { "count": 4, "step": [0, 0, 0], "var": "i" },
      "at": ["side ? floor(1.6+1.6*i) : -floor(1.6+1.6*i)-1", 5, "-6+i"], "size": [1, "11+3*i", "8-i"],
      "color": { "stripes": ["metal_light", "secondary"], "axis": "y", "period": 3 } },
    { "op": "box", "name": "Federspitze Gold", "repeat": { "count": 4, "step": [0, 0, 0], "var": "i" },
      "at": ["side ? floor(1.6+1.6*i) : -floor(1.6+1.6*i)-1", "13+3*i", "-6+i"], "size": [1, 3, "8-i"], "mode": "paint", "color": "trim" },
    { "op": "box", "name": "Federkiel Rot", "repeat": { "count": 4, "step": [0, 0, 0], "var": "i" },
      "at": ["side ? floor(1.6+1.6*i) : -floor(1.6+1.6*i)-1", 5, "1"], "size": [1, "8+3*i", 1], "mode": "paint", "color": "primary" },
    { "op": "box", "name": "Kühlglut zwischen den Federn", "if": "lit", "at": ["side ? 2 : -8", 5, -3], "size": [6, 1, 2], "color": { "role": "glow", "emit": 1.5 }, "jitter": false },

    { "op": "use", "name": "Wartungspaneel", "model": "lerche/station/parts_b/panel", "params": { "open": "state == 1 || state == 4", "w": 4, "h": 3, "kd": 2 }, "at": ["bx0", 3, 4] },
    { "op": "box", "name": "Beschädigt: Feder geknickt", "if": "state == 1 || state == 4", "at": ["side ? 6 : -8", 17, -6], "size": [2, 6, 8], "mode": "carve" },
    { "op": "box", "name": "Beschädigt: Federspitze lose", "if": "state == 1 || state == 4", "at": ["side ? 5 : -7", 15, -3], "size": [2, 2, 1], "color": "trim" },

    { "op": "box", "name": "Zerstört: Federn abgerissen", "if": "state == 2", "at": ["side ? 3 : -8", 9, -8], "size": [5, 20, 16], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Gehäuse aufgerissen", "if": "state == 2", "at": ["side ? -6 : 1", 9, -4], "size": [5, 6, 6], "mode": "carve" },
    { "op": "box", "name": "Zerstört: Feder am Boden", "if": "state == 2", "at": ["side ? 2 : -7", 3, 2], "size": [5, 1, 2], "color": "metal_light" },
    { "op": "box", "name": "Zerstört: Ruß", "if": "state == 2", "at": [-8, 6, -8], "size": [16, 22, 16], "mode": "paint", "color": { "noise": ["black", "metal_dark", "metal_light", "stone_dark"], "weights": [1, 2, 3, 1], "cell": 2 }, "jitter": false },

    { "op": "use", "name": "Flickband", "if": "state == 3", "model": "lerche/station/parts_b/patch", "params": { "w": 8, "h": 7 }, "at": ["bx", 6, 4] },

    { "op": "line", "name": "EMP-Bogen Federn", "if": "state == 5", "from": ["w*2", 16, -2], "to": ["w*4", 19, -1], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false },
    { "op": "line", "name": "EMP-Bogen Federn 2", "if": "state == 5", "from": ["w*4", 19, -1], "to": ["w*6", 21, -3], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false },
    { "op": "line", "name": "EMP-Bogen Gehäuse", "if": "state == 5", "from": ["bx-2", 14, 0], "to": ["bx+2", 12, 2], "r": 0.5, "color": { "role": "#A9D6E5", "emit": 2.4 }, "jitter": false },

    { "op": "use", "name": "Statuskrone", "model": "lerche/station/parts_b/crown", "params": { "state": "state", "r": 2.5 }, "at": ["bx", 14, -4] }
  ],
  "anchor": [0, 0, 0]
}
