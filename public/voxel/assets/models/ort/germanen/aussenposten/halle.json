  "let": { "em": "licht ? 0.6 : 0" },
  "ops": [
    { "op": "box", "name": "Fundament", "at": [-17, 0, -11], "size": [34, 1, 22], "color": "stone_dark" },
    { "op": "box", "name": "Umgang", "at": [-16, 1, -10], "size": [32, 5, 20], "color": { "stripes": ["metal_light", "metal"], "axis": "x", "period": 1 } },
