    { "op": "box", "name": "Pfosten", "at": ["-16 + i*6", 1, 10], "size": [1, 5, 1], "color": "metal_dark", "repeat": { "count": 6, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Pfosten Nieten", "at": ["-16 + i*6", 4, 11], "size": [1, 1, 1], "color": "copper", "repeat": { "count": 6, "var": "i", "step": [0, 0, 0] } },
    { "op": "wedge", "name": "Umgangdach", "at": [-17, 6, -11], "size": [34, 3, 22], "gable": "z", "color": { "stripes": ["metal", "metal_light"], "axis": "y", "period": 1 } },
    { "op": "box", "name": "Traufe Kupfer", "at": [-17, 6, 10], "size": [34, 1, 1], "color": "copper_dark", "mirror": "z", "mirrorAt": 0 },
