{
  "id": "ort/germanen/aussenposten/halle",
  "name": "Stabhalle (Germanen): Kommando- und Funkhalle in Stabbauweise aus Eisenplanken, gestaffelte Steildächer, Turmnadel als Antenne, Glutfuge am First",
  "tier": "architecture",
  "palette": "nord",
  "jitter": 0,
  "tags": ["bau", "germanen", "aussenposten", "kommando", "ort01"],
  "footprint": [8, 5],
  "params": {
    "licht": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Glut und Runen an" }
