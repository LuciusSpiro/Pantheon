    { "op": "wedge", "name": "Hauptdach", "at": [-14, 12, -8], "size": [28, 12, 16], "gable": "z", "color": { "stripes": ["metal", "metal_light"], "axis": "y", "period": 1 } },
    { "op": "box", "name": "First Kupfer", "at": [-14, 23, -1], "size": [28, 1, 2], "color": "copper_dark" },
    { "op": "box", "name": "Glutfuge First", "at": [-12, 24, -1], "size": [24, 1, 1], "color": { "role": "ember", "emit": "em" } },
    { "op": "box", "name": "Tor", "at": [-3, 1, 10], "size": [6, 5, 1], "color": "dark" },
    { "op": "box", "name": "Torpfosten", "at": [-4, 1, 11], "size": [1, 6, 1], "color": "metal_dark", "mirror": "x", "mirrorAt": 0 },
    { "op": "box", "name": "Torsturz", "at": [-4, 6, 11], "size": [8, 1, 1], "color": "copper_dark" },
    { "op": "box", "name": "Tor Glutlinie", "at": [-3, 1, 11], "size": [6, 1, 1], "color": { "role": "ember", "emit": "em" } },
    { "op": "box", "name": "Turm", "at": [-2, 22, -2], "size": [4, 5, 4], "color": { "stripes": ["metal_light", "metal"], "axis": "x", "period": 1 } },
    { "op": "box", "name": "Turm Glut", "at": [-2, 24, -2], "size": [4, 1, 4], "color": { "role": "ember", "emit": "em" }, "mode": "paint" },
    { "op": "wedge", "name": "Turmdach", "at": [-2, 27, -2], "size": [4, 3, 4], "gable": "x", "color": "metal" },
    { "op": "box", "name": "Turmnadel", "at": [-1, 30, -1], "size": [2, 4, 2], "color": "copper_dark" },
    { "op": "box", "name": "Nadel Rune", "at": [-1, 34, -1], "size": [2, 1, 2], "color": { "role": "rune", "emit": "em" } },
    { "op": "line", "name": "Giebelbretter", "from": [-14, 20, -4], "to": [-14, 27, 3], "r": 0.5, "color": "copper_dark", "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "Giebelbretter 2", "from": [-14, 20, 4], "to": [-14, 27, -3], "r": 0.5, "color": "copper_dark", "mirror": "x", "mirrorAt": 0 },
    { "op": "box", "name": "Giebelspitzen", "at": [-15, 27, 3], "size": [1, 1, 1], "color": { "role": "rune", "emit": "em" }, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } }
  ],
  "anchor": [0, 0, 0]
}
