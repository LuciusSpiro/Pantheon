    { "op": "box", "name": "Tor", "at": [-2, 1, 6], "size": [4, 4, 1], "color": "dark" },
    { "op": "box", "name": "Torpfosten", "at": [-3, 1, 7], "size": [1, 5, 1], "color": "metal_dark", "mirror": "x", "mirrorAt": 0 },
    { "op": "box", "name": "Torsturz", "at": [-3, 5, 7], "size": [6, 1, 1], "color": "copper_dark" },
    { "op": "box", "name": "Tor Glutlinie", "at": [-2, 1, 7], "size": [4, 1, 1], "color": { "role": "ember", "emit": "em" } },
    { "op": "box", "name": "Fenster", "at": [-9, 2, 6], "size": [3, 2, 1], "color": "glass", "mirror": "x", "mirrorAt": 0 },
    { "op": "box", "name": "Fenster Glut", "at": [-9, 1, 7], "size": [3, 1, 1], "color": { "role": "ember", "emit": "em" }, "mirror": "x", "mirrorAt": 0 },
