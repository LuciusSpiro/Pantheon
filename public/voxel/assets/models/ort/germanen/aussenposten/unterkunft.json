    { "op": "wedge", "name": "Hauptdach", "at": [-9, 9, -6], "size": [18, 7, 12], "gable": "z", "color": { "stripes": ["metal", "metal_light"], "axis": "y", "period": 1 } },
    { "op": "box", "name": "First Kupfer", "at": [-9, 15, -1], "size": [18, 1, 2], "color": "copper_dark" },
