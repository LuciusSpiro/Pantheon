    { "op": "box", "name": "Pfosten", "at": ["-11 + i*7", 1, 7], "size": [1, 4, 1], "color": "metal_dark", "repeat": { "count": 4, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Pfosten Nieten", "at": ["-11 + i*7", 3, 7], "size": [1, 1, 1], "color": "copper", "repeat": { "count": 4, "var": "i", "step": [0, 0, 0] } },
    { "op": "wedge", "name": "Umgangdach", "at": [-12, 5, -8], "size": [24, 3, 16], "gable": "z", "color": { "stripes": ["metal", "metal_light"], "axis": "y", "period": 1 } },
    { "op": "box", "name": "Traufe Kupfer", "at": [-12, 5, 7], "size": [24, 1, 1], "color": "copper_dark", "mirror": "z", "mirrorAt": 0 },
