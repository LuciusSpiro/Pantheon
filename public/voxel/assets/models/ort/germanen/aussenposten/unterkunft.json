    { "op": "box", "name": "Schornstein Kupfer", "at": [4, 17, -4], "size": [2, 1, 2], "color": "copper" },
    { "op": "box", "name": "Schornstein Glut", "at": [4, 18, -4], "size": [2, 1, 2], "color": { "role": "ember", "emit": "em" } },
    { "op": "line", "name": "Giebelbretter", "from": [-9, 10, -3], "to": [-9, 15, 3], "r": 0.5, "color": "copper_dark", "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "Giebelbretter 2", "from": [-9, 10, 3], "to": [-9, 15, -3], "r": 0.5, "color": "copper_dark", "mirror": "x", "mirrorAt": 0 },
    { "op": "box", "name": "Giebelspitzen", "at": [-10, 15, 3], "size": [1, 1, 1], "color": { "role": "rune", "emit": "em" }, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } }
  ],
  "anchor": [0, 0, 0]
