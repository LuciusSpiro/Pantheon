{
  "id": "ort/germanen/gemein/schildantenne",
  "name": "Schildantenne (Germanen): Rundschild aus Eisenplanken als Parabolspiegel, Kupferrand, Schildbuckel mit Speisehorn, Sendering glüht; Gegenstück zum Clipeus",
  "tier": "detail",
  "palette": "nord",
  "jitter": 0,
  "tags": ["prop", "germanen", "funk", "antenne", "kommando", "aussenposten", "station", "ort01"],
