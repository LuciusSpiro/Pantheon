      { "op": "box", "name": "Rune", "at": [-8, "16 + i*4", -8], "size": [2, 2, 1], "color": { "role": "rune", "emit": "em > 0 ? 1 : 0" }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Rune 2", "at": [-1, "18 + i*4", -8], "size": [2, 1, 1], "color": { "role": "rune", "emit": "em > 0 ? 1 : 0" }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Rune 3", "at": [6, "15 + i*5", -8], "size": [2, 2, 1], "color": { "role": "rune", "emit": "em > 0 ? 1 : 0" }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Rohrbogen", "at": [-8, 30, -9], "size": [16, 2, 2], "color": "metal_dark" },
      { "op": "box", "name": "Rohrbogen zum Abzug", "at": [-1, 30, -7], "size": [2, 2, 5], "color": "metal_dark" }
    ] }
  ],
  "anchor": [0, 0, 0]
}
