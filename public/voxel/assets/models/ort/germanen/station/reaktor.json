  "ops": [
    { "op": "box", "name": "Herdplatte", "at": [-16, 0, -16], "size": [32, 2, 32], "color": { "noise": ["stone_dark", "stone"], "weights": [2, 1], "cell": 4 } },
    { "op": "use", "name": "Ofen vorn", "model": "ort/germanen/gemein/klinker", "params": { "w": 22, "h": 12, "d": 1, "lage": 4, "glut": "em * 0.7" }, "at": [0, 2, 9] },
    { "op": "use", "name": "Ofen hinten", "model": "ort/germanen/gemein/klinker", "params": { "w": 22, "h": 12, "d": 1, "lage": 4, "glut": "em * 0.7" }, "at": [0, 2, -9], "rot": 180 },
    { "op": "use", "name": "Ofen links", "model": "ort/germanen/gemein/klinker", "params": { "w": 20, "h": 12, "d": 1, "lage": 4, "glut": "em * 0.7" }, "at": [-10, 2, 0], "rot": 270 },
    { "op": "use", "name": "Ofen rechts", "model": "ort/germanen/gemein/klinker", "params": { "w": 20, "h": 12, "d": 1, "lage": 4, "glut": "em * 0.7" }, "at": [10, 2, 0], "rot": 90 },
    { "op": "box", "name": "Ofenkern", "at": [-10, 2, -9], "size": [20, 12, 18], "color": "metal_dark", "mode": "under" },
    { "op": "box", "name": "Eckbänder", "at": [-11, 2, 9], "size": [2, 12, 3], "color": "metal_dark", "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } },
    { "op": "cyl", "name": "Schacht", "at": [0, 14, 0], "r": 9, "r2": 5.5, "h": 12, "color": { "noise": ["metal", "metal_dark"], "weights": [2, 1], "cell": 3 } },
    { "op": "cyl", "name": "Reif 1", "at": [0, 15, 0], "r": 9.2, "h": 1, "color": "copper_dark" },
    { "op": "cyl", "name": "Reif 2", "at": [0, 20, 0], "r": 7.6, "h": 1, "color": "copper_dark" },
    { "op": "cyl", "name": "Haube", "at": [0, 26, 0], "r": 6.5, "h": 2, "color": "metal_dark" },
    { "op": "cyl", "name": "Abzug", "at": [0, 28, 0], "r": 2.5, "h": 4, "color": "metal" },
    { "op": "cyl", "name": "Abzug Glut", "at": [0, 31, 0], "r": 1.5, "h": 1, "color": { "role": "ember", "emit": "em" } },
    { "op": "box", "name": "Glutmaul", "at": [-5, 3, 10], "size": [10, 7, 2], "color": { "role": "ember", "emit": "em * 1.2" } },
    { "op": "box", "name": "Rost", "at": [-5, 3, 12], "size": [1, 7, 1], "color": "dark", "repeat": { "count": 5, "step": [2, 0, 0] } },
    { "op": "box", "name": "Maulsturz", "at": [-7, 10, 11], "size": [14, 2, 2], "color": "metal_dark" },
    { "op": "group", "name": "Blasebälge", "mirror": "x", "mirrorAt": 0, "ops": [
      { "op": "box", "name": "Balg Boden", "at": [11, 2, -6], "size": [5, 1, 12], "color": "metal_dark" },
      { "op": "wedge", "name": "Balg Leder", "at": [11, 3, -6], "size": [5, 5, 12], "slope": "+x", "color": { "stripes": ["leather", { "shade": "leather", "f": 0.7 }], "axis": "z", "period": 2 } },
      { "op": "box", "name": "Balg Platte", "at": [11, 7, -6], "size": [3, 1, 12], "color": "metal" },
      { "op": "box", "name": "Balg Kolben", "at": [12, 8, -1], "size": [2, 6, 2], "color": "metal_light" },
      { "op": "box", "name": "Balg Düse", "at": [9, 5, -1], "size": [2, 2, 2], "color": "copper" }
    ] },
    { "op": "group", "name": "Runenrohre", "ops": [
