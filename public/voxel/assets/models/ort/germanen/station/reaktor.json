{
  "id": "ort/germanen/station/reaktor",
  "name": "Esse-Reaktor (Germanen, Richtung Esse): geklinkerter Schmelzofen als Reaktor, Glutmaul mit Rost, Blasebalg-Kühlpumpen, Runenrohre",
  "tier": "detail",
  "palette": "nord",
  "jitter": 0,
  "tags": ["prop", "germanen", "reaktor", "hauptstueck", "ort01"],
