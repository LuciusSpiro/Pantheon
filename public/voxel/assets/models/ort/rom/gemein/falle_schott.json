    { "op": "cyl", "name": "Goldring verrußt", "at": [0, 0, 0], "r": 7.5, "h": 1, "color": { "noise": ["trim", "metal_dark"], "weights": [1, 3], "cell": 1 }, "if": "state == 3" },
    { "op": "cyl", "name": "Marmor", "at": [0, 0, 0], "r": 6.5, "h": 1, "color": "stone_light", "if": "state < 2" },
    { "op": "cyl", "name": "Marmor matt", "at": [0, 0, 0], "r": 6.5, "h": 1, "color": "stone_dark", "if": "state == 2" },
    { "op": "cyl", "name": "Marmor verkohlt", "at": [0, 0, 0], "r": 6.5, "h": 1, "color": { "noise": ["metal_dark", "dark", "black"], "weights": [4, 3, 1], "cell": 1 }, "if": "state == 3" },

    { "op": "cyl", "name": "Fuge außen", "at": [0, 0, 0], "r": 3.2, "h": 1, "color": "stone_dark", "mode": "paint", "if": "state == 0" },
    { "op": "cyl", "name": "Fuge innen", "at": [0, 0, 0], "r": 2.4, "h": 1, "color": "stone_light", "mode": "paint", "if": "state == 0" },

    { "op": "cyl", "name": "Rahmen Scheibe", "at": [0, 1, 0], "r": 4.6, "h": 1, "color": "falle_dunkel", "if": "state == 1" },
    { "op": "cyl", "name": "Rahmen frei", "at": [0, 1, 0], "r": 3.4, "h": 1, "mode": "carve", "if": "state == 1" },
