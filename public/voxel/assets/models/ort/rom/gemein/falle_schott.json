    { "op": "cyl", "name": "Auge erhaben", "at": [0, 1, 0], "r": 2.6, "h": 1, "color": { "role": "falle", "emit": 1.1 }, "if": "state == 1" },
    { "op": "cyl", "name": "Auge Kern", "at": [0, 1, 0], "r": 1.3, "h": 1, "color": { "role": "falle_kern", "emit": 1.2 }, "if": "state == 1" },

    { "op": "cyl", "name": "Loch", "at": [0, 0, 0], "r": 3.4, "h": 1, "color": "black", "mode": "paint", "if": "state >= 2" },
    { "op": "cyl", "name": "Deckel", "at": [3.3, 1, 3.3], "r": 2.3, "h": 1, "color": "stone_light", "if": "state == 2" },
    { "op": "cyl", "name": "Deckel Siegel", "at": [3.3, 1, 3.3], "r": 1.1, "h": 1, "color": "trim", "mode": "paint", "if": "state == 2" },

    { "op": "cyl", "name": "Linsenring Bruch A", "at": [0, 1, 0], "r": 4.6, "h": 1, "hollow": 1.2, "arc": [10, 110], "color": "black", "if": "state == 3" },
    { "op": "cyl", "name": "Linsenring Bruch B", "at": [0, 1, 0], "r": 4.6, "h": 1, "hollow": 1.2, "arc": [150, 205], "color": "black", "if": "state == 3" },
    { "op": "cyl", "name": "Linsenring Bruch C", "at": [0, 1, 0], "r": 4.6, "h": 1, "hollow": 1.2, "arc": [250, 320], "color": "black", "if": "state == 3" },
    { "op": "line", "name": "Riss 1", "from": [3.5, 0, 3], "to": [6, 0, 5], "r": 0.6, "color": "black", "mode": "paint", "if": "state == 3" },
    { "op": "line", "name": "Riss 2", "from": [-3.5, 0, 2], "to": [-6, 0, 3.5], "r": 0.6, "color": "black", "mode": "paint", "if": "state == 3" },
    { "op": "line", "name": "Riss 3", "from": [-1, 0, -3.5], "to": [-2, 0, -6], "r": 0.6, "color": "black", "mode": "paint", "if": "state == 3" },
    { "op": "line", "name": "Riss 4", "from": [3, 0, -3], "to": [5, 0, -5], "r": 0.6, "color": "black", "mode": "paint", "if": "state == 3" },
    { "op": "erode", "name": "Umriss gebrochen", "density": 0.3, "depth": 2, "salt": 3, "if": "state == 3" }
