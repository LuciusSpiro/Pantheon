{
 "id": "ort/rom/gemein/terminal",
 "name": "Kommandopult unter Bogen als Anker terminal (Rom): Bestand ort/rom/station/terminal; lädt = Amber-Ladeleiste halb, geladen = Leiste voll und Schirm weiß, gesperrt = Sperrband",
 "tier": "detail",
 "palette": "rom",
 "jitter": 0,
 "tags": [
  "prop",
  "anker",
  "ort01",
  "rom",
  "terminal"
 ],
 "footprint": [
  1,
  1
 ],
 "params": {
  "state": {
   "default": 0,
   "min": 0,
   "max": 3,
   "step": 1,
   "label": "Terminal (0 bereit, 1 lädt, 2 geladen, 3 gesperrt)"
  }
 },
 "variants": {
  "laedt": {
   "state": 1
  },
  "geladen": {
   "state": 2
  },
  "gesperrt": {
   "state": 3
  }
 },
 "ops": [
  {
   "op": "use",
   "name": "Pult",
   "model": "ort/rom/station/terminal",
   "params": {
    "state": "state == 3 ? 2 : 0",
    "holo": "state == 0 || state == 3"
   },
   "at": [
    0,
    0,
    0
   ]
  },
  {
   "op": "box",
   "name": "Ladeleiste lit",
   "at": [
    -6,
    16,
    -1
   ],
   "size": [
    1,
    1,
    3
   ],
   "color": {
    "role": "glow2",
    "emit": 0.9
   },
   "if": "i < n && state != 0 && state != 3",
   "jitter": false,
   "repeat": {
    "count": 6,
    "var": "i",
    "step": [
     2,
     0,
     0
    ]
   }
  },
  {
   "op": "box",
   "name": "Ladeleiste leer",
   "at": [
    -6,
    16,
    -1
   ],
   "size": [
    1,
    1,
    3
   ],
   "color": "stone_light",
   "if": "i >= n && state != 0 && state != 3",
   "repeat": {
    "count": 6,
    "var": "i",
    "step": [
     2,
     0,
     0
    ]
   }
  },
  {
   "op": "box",
   "name": "Schirm geladen",
   "at": [
    -4,
    14,
    -5
   ],
   "size": [
    8,
    9,
    1
   ],
   "color": {
    "role": "glow",
    "emit": 0.6
   },
   "if": "state == 2",
   "jitter": false
  },
  {
   "op": "box",
   "name": "Schirm Ladebalken",
   "at": [
    -4,
    14,
    -5
   ],
   "size": [
    4,
    1,
    1
   ],
   "color": {
    "role": "glow2",
    "emit": 0.9
   },
   "if": "state == 1",
   "jitter": false
  }
 ],
 "anchor": [
  0,
  0,
  0
 ],
 "let": {
  "n": "state == 1 ? 3 : 6"
 }
}
