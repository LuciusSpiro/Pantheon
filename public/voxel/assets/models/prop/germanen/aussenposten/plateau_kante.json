{
  "id": "prop/germanen/aussenposten/plateau_kante",
  "name": "Plateaukante mit Brüstung (Außenposten, Aussicht)",
  "tier": "detail",
  "palette": "nord",
  "tags": ["prop", "germanen", "aussenposten", "aussicht", "kante", "autotile"],
  "footprint": [1, 1],
  "params": {
    "conn": {"default": 10, "min": 0, "max": 15, "step": 1, "label": "Nachbar-Kanten (N1 O2 S4 W8)"}
  },
  "let": {"n": "floor(conn / 1) % 2", "o": "floor(conn / 2) % 2", "s": "floor(conn / 4) % 2", "w": "floor(conn / 8) % 2"},
  "variants": {"gerade_nz": {"conn": 5}, "ecke": {"conn": 6}, "t": {"conn": 14}, "kreuz": {"conn": 15}, "einzeln": {"conn": 0}, "ende": {"conn": 2}},
  "ops": [
    {"op": "box", "name": "Felsblock", "at": [-8, 0, -8], "size": [16, 7, 16], "color": "rock_dark", "jitter": false},
    {"op": "box", "name": "Felsdecke", "at": [-8, 7, -8], "size": [16, 1, 16], "color": "rock", "jitter": false},
    {"op": "box", "name": "Frost Decke", "at": [-8, 7, -8], "size": [16, 1, 16], "mode": "paint", "color": {"noise": ["rock", "frost", "rock"], "weights": [2, 1, 1], "cell": 3, "seed": "seed"}},
    {"op": "box", "name": "Schichtfuge", "at": [-8, 3, -8], "size": [16, 1, 16], "mode": "paint", "color": "stone_dark", "jitter": false},
    {"op": "box", "name": "Brocken", "if": "hash(seed, 1) < 0.5", "at": [-7, 8, -7], "size": [3, 2, 3], "color": "rock"},
    {"op": "box", "name": "Brocken 2", "if": "hash(seed, 2) < 0.4", "at": [4, 8, 5], "size": [3, 1, 2], "color": "rock_dark"},

    {"op": "box", "name": "Mittelpfosten", "at": [-1, 8, -1], "size": [2, 6, 2], "color": "wood_dark"},
    {"op": "box", "name": "Pfostenkappe", "at": [-1, 14, -1], "size": [2, 1, 2], "color": "frost"},
    {"op": "box", "name": "Riegel N", "if": "n", "at": [-1, 11, -8], "size": [2, 2, 7], "color": "wood", "jitter": false},
    {"op": "box", "name": "Riegel S", "if": "s", "at": [-1, 11, 1], "size": [2, 2, 7], "color": "wood", "jitter": false},
    {"op": "box", "name": "Riegel O", "if": "o", "at": [1, 11, -1], "size": [7, 2, 2], "color": "wood", "jitter": false},
    {"op": "box", "name": "Riegel W", "if": "w", "at": [-8, 11, -1], "size": [7, 2, 2], "color": "wood", "jitter": false},
    {"op": "box", "name": "Stütze N", "if": "n", "at": [-1, 8, -6], "size": [2, 3, 1], "color": "wood_dark"},
    {"op": "box", "name": "Stütze S", "if": "s", "at": [-1, 8, 5], "size": [2, 3, 1], "color": "wood_dark"},
    {"op": "box", "name": "Stütze O", "if": "o", "at": [5, 8, -1], "size": [1, 3, 2], "color": "wood_dark"},
    {"op": "box", "name": "Stütze W", "if": "w", "at": [-6, 8, -1], "size": [1, 3, 2], "color": "wood_dark"},
    {"op": "box", "name": "Eisennägel", "at": [-1, 12, -1], "size": [2, 1, 2], "color": "metal_dark"}
  ],
  "anchor": [0, 0, 0]
}
