{
  "id": "prop/germanen/aussenposten/runenmast",
  "name": "Runenmast (Außenposten, Sprengpunkt)",
  "tier": "detail",
  "palette": "nord",
  "tags": ["prop", "germanen", "aussenposten", "sprengpunkt", "funkmast"],
  "footprint": [1, 1],
  "params": {
    "state": {"default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand (0 intakt, 1 scharf, 2 zerstoert)"}
  },
  "let": {"heil": "state < 2", "runen": "state < 2 ? 0.9 : 0"},
  "variants": {"scharf": {"state": 1}, "zerstoert": {"state": 2}},
  "ops": [
    {"op": "box", "name": "Fundament Stein", "at": [-6, 0, -6], "size": [12, 2, 12], "color": "stone_dark", "jitter": false},
    {"op": "box", "name": "Fundament Kante", "at": [-6, 2, -6], "size": [12, 1, 12], "color": "stone", "jitter": false},
    {"op": "box", "name": "Frostflecken", "at": [-5, 2, -5], "size": [3, 1, 2], "mode": "paint", "color": "frost", "jitter": false, "mirror": "xz", "mirrorAt": {"x": 0, "z": 0}},
    {"op": "box", "name": "Fußschwelle x", "at": [-7, 0, -1], "size": [14, 3, 2], "color": "wood_dark"},
    {"op": "box", "name": "Fußschwelle z", "at": [-1, 0, -7], "size": [2, 3, 14], "color": "wood_dark"},
    {"op": "box", "name": "Schwellennägel", "at": [-7, 3, -1], "size": [1, 1, 2], "color": "metal_dark", "mirror": "x", "mirrorAt": 0},
    {"op": "box", "name": "Mast Holz", "if": "heil", "at": [-2, 3, -2], "size": [4, 28, 4], "color": {"stripes": ["wood_dark", "wood"], "axis": "x", "period": 2}, "jitter": false},
    {"op": "box", "name": "Mast Stumpf", "if": "!heil", "at": [-2, 3, -2], "size": [4, 9, 4], "color": {"noise": ["wood_dark", "dark"], "weights": [2, 1]}},
    {"op": "box", "name": "Splitter", "if": "!heil", "at": [-2, 12, -1], "size": [1, 3, 1], "color": "wood"},
    {"op": "box", "name": "Splitter 2", "if": "!heil", "at": [1, 12, 0], "size": [1, 2, 1], "color": "wood"},
    {"op": "box", "name": "Eisenmanschette unten", "at": [-3, 3, -3], "size": [6, 2, 6], "color": "metal_dark"},
    {"op": "box", "name": "Eisenband", "if": "heil", "at": [-3, 26, -3], "size": [6, 1, 6], "color": "metal_dark"},
    {"op": "box", "name": "Runenhülse", "if": "heil", "at": [-3, 9, -3], "size": [6, 15, 6], "color": "metal", "jitter": false},
    {"op": "box", "name": "Hülsenrand oben", "if": "heil", "at": [-3, 23, -3], "size": [6, 1, 6], "color": "metal_light"},
    {"op": "box", "name": "Hülsenrand unten", "if": "heil", "at": [-3, 9, -3], "size": [6, 1, 6], "color": "metal_light"},
    {"op": "group", "name": "Ringornament je Seite (zwei Leuchtringe, keine Zeichen)", "if": "heil", "repeat": {"count": 4, "step": [0, 0, 0], "var": "i"}, "rot": "i*90", "pivot": [0, 0], "ops": [
      {"op": "box", "name": "Ring 1 unten", "at": [-2, 12, 2], "size": [4, 1, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
      {"op": "box", "name": "Ring 1 oben", "at": [-2, 15, 2], "size": [4, 1, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
      {"op": "box", "name": "Ring 1 Seiten", "at": [-2, 13, 2], "size": [1, 2, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
      {"op": "box", "name": "Ring 1 Seiten", "at": [1, 13, 2], "size": [1, 2, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
      {"op": "box", "name": "Ring 2 unten", "at": [-2, 18, 2], "size": [4, 1, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
      {"op": "box", "name": "Ring 2 oben", "at": [-2, 21, 2], "size": [4, 1, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
      {"op": "box", "name": "Ring 2 Seiten", "at": [-2, 19, 2], "size": [1, 2, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
      {"op": "box", "name": "Ring 2 Seiten", "at": [1, 19, 2], "size": [1, 2, 1], "color": {"role": "rune", "emit": "runen"}, "jitter": false}
    ] },
    {"op": "cyl", "name": "Krone Ring", "if": "heil", "at": [0, 29, 0], "r": 4.6, "h": 1, "hollow": 1, "color": "metal_dark"},
    {"op": "box", "name": "Kronenstreben x", "if": "heil", "at": [-4, 29, 0], "size": [8, 1, 1], "color": "metal"},
    {"op": "box", "name": "Kronenstreben z", "if": "heil", "at": [0, 29, -4], "size": [1, 1, 8], "color": "metal"},
    {"op": "box", "name": "Zinken", "if": "heil", "at": [-4, 30, -1], "size": [1, 3, 1], "color": "metal_light", "mirror": "x", "mirrorAt": 0.5},
    {"op": "box", "name": "Zinken z", "if": "heil", "at": [0, 30, -4], "size": [1, 3, 1], "color": "metal_light", "mirror": "z", "mirrorAt": 0.5},
    {"op": "box", "name": "Mastspitze", "if": "heil", "at": [-1, 31, -1], "size": [2, 3, 2], "color": "metal_dark"},
    {"op": "box", "name": "Spitzenlicht", "if": "heil", "at": [-1, 34, -1], "size": [2, 1, 2], "color": {"role": "rune", "emit": "runen"}, "jitter": false},
    {"op": "line", "name": "Abspannseil NO", "if": "heil", "from": [1, 27, 1], "to": [6.5, 3, 6.5], "r": 0.5, "color": "metal_dark"},
    {"op": "line", "name": "Abspannseil SW", "if": "heil", "from": [-1, 27, -1], "to": [-6.5, 3, -6.5], "r": 0.5, "color": "metal_dark"},
    {"op": "box", "name": "Seilpflöcke", "at": [-7, 2, -7], "size": [2, 2, 2], "color": "metal_dark", "mirror": "xz", "mirrorAt": {"x": 0, "z": 0}},
    {"op": "group", "name": "Ladung (scharf)", "if": "state == 1", "ops": [
      {"op": "box", "name": "Ladungspaket", "at": [-4, 4, 2], "size": [8, 6, 2], "color": "metal_dark", "jitter": false},
      {"op": "cyl", "name": "Sprengrollen", "at": [-2.5, 4, 5], "r": 1.2, "h": 6, "color": "leather", "repeat": {"count": 3, "step": [2.5, 0, 0]}, "jitter": false},
      {"op": "box", "name": "Gurt", "at": [-4, 8, 2], "size": [8, 1, 5], "color": "metal_light", "jitter": false},
      {"op": "box", "name": "Zünder", "at": [-1, 10, 3], "size": [3, 2, 3], "color": "trim"},
      {"op": "box", "name": "Zünderkappe", "at": [0, 12, 4], "size": [1, 1, 1], "color": "metal_light"},
      {"op": "line", "name": "Zündkabel", "from": [3, 5, 5], "to": [6, 0, 7], "r": 0.5, "color": "dark"}
    ] },
    {"op": "group", "name": "Trümmer (zerstört)", "if": "state == 2", "ops": [
      {"op": "line", "name": "Mast umgestürzt", "from": [-1, 3, -2], "to": [5, 3, 7], "r": 2, "color": "wood_dark"},
      {"op": "box", "name": "Hülse geplatzt", "at": [-6, 3, 2], "size": [4, 2, 4], "color": "metal_dark"},
      {"op": "box", "name": "Kronenrest", "at": [-6, 3, -6], "size": [5, 1, 1], "color": "metal"},
      {"op": "box", "name": "Ruß", "at": [-7, 0, -7], "size": [14, 3, 14], "mode": "paint", "color": {"noise": ["dark", "black", "stone_dark"], "weights": [2, 1, 2]}},
      {"op": "erode", "name": "Fundament gesprengt", "density": 0.45, "depth": 2, "at": [-7, 0, -7], "size": [14, 3, 14]}
    ] }
  ],
  "anchor": [0, 0, 0]
}
