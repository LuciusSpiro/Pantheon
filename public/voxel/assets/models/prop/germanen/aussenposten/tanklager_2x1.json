      {"op": "box", "name": "Blech hoch", "at": [7, 6, -6], "size": [1, 6, 5], "color": "metal"},
      {"op": "erode", "name": "Riss", "density": 0.5, "depth": 2, "at": [-15, 6, -7], "size": [24, 8, 14]},
      {"op": "box", "name": "Ruß", "at": [-16, 0, -8], "size": [32, 16, 16], "mode": "paint", "color": {"noise": ["dark", "black", "wood_dark"], "weights": [2, 1, 2]}}
    ] }
