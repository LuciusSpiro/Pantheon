{
  "id": "prop/germanen/aussenposten/tanklager_2x1",
  "name": "Tanklager 2×1 (Außenposten, Sprengpunkt)",
  "tier": "detail",
  "palette": "nord",
  "tags": ["prop", "germanen", "aussenposten", "sprengpunkt", "tank"],
  "footprint": [2, 1],
