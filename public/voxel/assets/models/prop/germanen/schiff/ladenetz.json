{
  "id": "prop/germanen/schiff/ladenetz",
  "name": "Ladenetz über Kisten und Säcken (Germanen, Schiff)",
  "notes": "Deko im Laderaum. Netz als Seilraster (Paint-Streifen über alle Flächen), vier Haken mit Spannseilen. seed variiert die Ladung.",
  "tier": "detail",
  "palette": "nord",
  "tags": ["germanen", "schiff", "prop", "deko", "ladung"],
  "footprint": [1, 1],
  "let": { "h1": "6 + floor(hash(seed, 1) * 3)", "h2": "4 + floor(hash(seed, 2) * 3)", "fass": "hash(seed, 3) < 0.5" },
  "variants": { "anders": { "seed": 3 }, "dritte": { "seed": 7 } },
  "ops": [
    { "op": "box", "name": "Kiste groß", "at": [-7, 0, -6], "size": [8, "h1", 8], "color": { "frame": "metal", "fill": { "stripes": ["wood", "wood", "wood_dark"], "axis": "y", "period": 1 }, "axes": "xy" } },
    { "op": "box", "name": "Kiste klein", "at": [1, 0, -5], "size": [6, "h2", 6], "color": { "frame": "metal_dark", "fill": "wood_dark", "axes": "xz" } },
    { "op": "box", "name": "Kiste oben", "at": [-5, "h1", -4], "size": [5, 4, 5], "color": { "frame": "metal", "fill": "wood", "axes": "xy" } },
    { "op": "cyl", "name": "Fass", "if": "fass", "at": [4, 0, 4], "r": 2.8, "h": 8, "color": { "stripes": ["wood", "wood", "metal_dark"], "axis": "y", "period": 2 } },
    { "op": "ellipsoid", "name": "Sack 1", "at": [-3, 2, 3], "r": [3, 2.5, 2.5], "color": { "noise": ["cloth2", { "shade": "cloth2", "f": 0.85 }], "weights": [2, 1] } },
    { "op": "ellipsoid", "name": "Sack 2", "if": "!fass", "at": [4, 2, 3], "r": [2.5, 2.2, 3], "color": { "noise": ["leather", { "shade": "leather", "f": 0.85 }], "weights": [2, 1] } },
    { "op": "box", "name": "Netz längs", "at": [-8, 1, -8], "size": [1, 16, 16], "mode": "paint", "color": { "shade": "leather", "f": 1.35 }, "jitter": false, "repeat": { "count": 6, "step": [3, 0, 0] } },
    { "op": "box", "name": "Netz quer", "at": [-8, 1, -7], "size": [16, 16, 1], "mode": "paint", "color": { "shade": "leather", "f": 1.35 }, "jitter": false, "repeat": { "count": 5, "step": [0, 0, 3] } },
    { "op": "group", "name": "Haken", "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 }, "ops": [
      { "op": "box", "name": "Bodenring", "at": [-8, 0, -8], "size": [2, 1, 2], "color": "metal_light" },
      { "op": "line", "name": "Spannseil", "from": [-7, 1, -7], "to": [-4, 6, -4], "r": 0.5, "color": { "shade": "leather", "f": 1.35 } }
    ] }
  ],
  "sockets": { "label": [0, 1.0, 0] },
  "anchor": [0, 0, 0]
}
