{
  "id": "prop/germanen/station/andockring_2x1",
  "name": "Station Germanen: Andockring 2x1 (Druckkragen mit rundem Schott, Seitenklammern, Kolben)",
  "tier": "detail",
  "palette": "nord",
  "tags": ["prop", "germanen", "station", "schleuse", "andockring"],
  "notes": "ART-STATION. 2 x 1 m, 2,06 m. Rücken (-z) an der Außenhülle, Vorderseite +z in die Station. Dicker Ring mit heller Vorderkante, rundes Druckschott aus Klinkerringen mit zwei waagrechten Riegelbalken (bewusst KEIN Kreuz, keine Speichen: kein Sonnenrad/Keltenkreuz-Anklang). Klammern nur links und rechts. Runen als gepunkteter Leiterbahn-Kreis auf der Ringfront (emit 0,6). state 1 offen: Schott eingefahren, Tunnel dunkel.",
  "footprint": [2, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "Schott (0 zu, 1 offen)" },
    "zustand": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand (0 intakt, 1 verfallen, 2 umkämpft)" }
  },
  "variants": { "offen": { "state": 1 }, "verfallen": { "zustand": 1 }, "umkaempft": { "zustand": 2 } },
  "ops": [
