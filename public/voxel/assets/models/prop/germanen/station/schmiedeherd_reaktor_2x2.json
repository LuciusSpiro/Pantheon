{
  "id": "prop/germanen/station/schmiedeherd_reaktor_2x2",
  "name": "Station Germanen: Schmiedeherd-Reaktor 2x2 (Sprengpunkt: Glutkern im Eisenkäfig auf Stufensockel)",
  "tier": "detail",
  "palette": "nord",
  "tags": ["prop", "germanen", "station", "reaktor", "sprengpunkt", "light"],
  "notes": "ART-STATION, Anker sprengpunkt (CONTRACT-B1 §3.3): state 0 intakt / 1 scharf / 2 zerstoert. Runder Stufensockel aus Schmiedeeisen mit Leiterbahn-Runenband (checker, emit 0,6), Glutbecken mit Schmelzkern (ember, Feuerschein, emit <= 1,5) in einem Käfig aus vier Eisenpfeilern, oben Ring mit offenem Auge (Kern von oben sichtbar) und kurzer Esse. Vorn eine helle Ladeplatte: dort sitzt im Zustand scharf das Ladungspaket (Zünder mit weißem Licht, keine Telegraf- oder Zustandsfarbe). zerstoert: Kern erloschen, Käfig gebrochen, Ruß, Trümmer. Hörner (Knochen) an den vorderen Pfeilern als Hornfels-Anklang.",
  "footprint": [2, 2],
  "params": {
    "state": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Sprengpunkt (0 intakt, 1 scharf, 2 zerstoert)" },
    "zustand": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand (0 intakt, 1 verfallen, 2 umkämpft)" }
  },
  "let": { "live": "state < 2" },
  "variants": { "scharf": { "state": 1 }, "zerstoert": { "state": 2 }, "verfallen": { "zustand": 1 }, "umkaempft": { "zustand": 2 } },
  "ops": [
    { "name": "Sockel Stufe 1", "op": "cyl", "at": [0, 0, 0], "r": 15.5, "h": 3, "color": "metal_dark", "jitter": false },
    { "name": "Sockel Stufe 1 Lichtkante", "op": "cyl", "at": [0, 2, 0], "r": 15.5, "h": 1, "hollow": 1, "mode": "paint", "color": "metal_light", "jitter": false },
    { "name": "Sockel Stufe 2", "op": "cyl", "at": [0, 3, 0], "r": 13.5, "h": 5, "color": "primary", "jitter": false },
    { "name": "Klinkerkante", "op": "cyl", "at": [0, 5, 0], "r": 13.5, "h": 1, "hollow": 1, "mode": "paint", "color": { "shade": "primary", "f": 0.72 }, "jitter": false },
    { "name": "Runenband (gepunktete Leiterbahn)", "op": "cyl", "at": [0, 6, 0], "r": 13.5, "h": 1, "hollow": 1, "mode": "paint", "color": { "checker": ["metal_dark", { "shade": "glow", "f": 0.75, "emit": 0.6 }], "period": 1 }, "jitter": false },
    { "name": "Glutbecken Rand", "op": "cyl", "at": [0, 8, 0], "r": 10.5, "h": 3, "hollow": 2, "color": "metal_dark", "jitter": false },
    { "name": "Glutbecken Boden", "op": "cyl", "at": [0, 8, 0], "r": 8.5, "h": 2, "color": "metal_dark", "jitter": false },
    { "name": "Glutbett", "if": "live", "op": "cyl", "at": [0, 10, 0], "r": 8.5, "h": 1, "color": { "noise": [{ "shade": "ember", "f": 0.9, "emit": 1.0 }, { "shade": "ember", "f": 0.65, "emit": 0.8 }, "metal_dark"], "weights": [2, 2, 1], "cell": 2 }, "jitter": false },
    { "name": "Schmelzkern", "if": "live", "op": "ellipsoid", "at": [0, 15, 0], "r": [4.5, 6, 4.5], "color": { "shade": "ember", "f": 0.92, "emit": 1.1 }, "jitter": false },
    { "name": "Kern Fassung", "op": "cyl", "at": [0, 10, 0], "r": 5.5, "h": 1, "hollow": 1, "color": "metal_light", "jitter": false },

    { "name": "Käfigpfeiler", "op": "box", "at": [-10, 8, -10], "size": [3, 21, 3], "color": "metal_dark", "jitter": false, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } },
    { "name": "Pfeiler Lichtkante", "op": "box", "at": [-8, 8, -8], "size": [1, 21, 1], "color": "metal_light", "jitter": false, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } },
    { "name": "Pfeiler Bänder", "op": "box", "at": [-10, 14, -10], "size": [3, 1, 3], "repeat": { "count": 2, "step": [0, 7, 0] }, "color": "metal", "mode": "paint", "jitter": false, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } },
    { "name": "Kopfring", "op": "cyl", "at": [0, 29, 0], "r": 12, "h": 3, "hollow": 4, "color": "primary", "jitter": false },
    { "name": "Kopfring Lichtkante", "op": "cyl", "at": [0, 31, 0], "r": 12, "h": 1, "hollow": 1, "mode": "paint", "color": "metal_light", "jitter": false },
    {"name": "Hörner vorn Ansatz", "op": "box", "at": [-11, 29, 8], "size": [2, 2, 2], "color": "trim", "mirror": "x", "mirrorAt": 0},
    {"name": "Hörner vorn Bogen", "op": "box", "at": [-12, 31, 8], "size": [2, 1, 2], "color": "trim", "mirror": "x", "mirrorAt": 0},
    {"name": "Hörner vorn Spitze", "op": "box", "at": [-12, 32, 8], "size": [1, 2, 1], "color": {"shade": "trim", "f": 0.75}, "mirror": "x", "mirrorAt": 0},

    { "name": "Kühlrohr", "op": "line", "from": [-7, 3, -13], "to": [-7, 27, -11], "r": 1.5, "color": "metal", "mirror": "x", "mirrorAt": 0 },
    { "name": "Kühlrohr Schellen", "op": "box", "at": [-9, 9, -14], "size": [4, 1, 4], "repeat": { "count": 2, "step": [0, 8, 0] }, "color": "metal_light", "mirror": "x", "mirrorAt": 0 },

    { "name": "Ladeplatte", "op": "box", "at": [-4, 3, 13], "size": [8, 8, 2], "color": { "frame": "metal_light", "fill": "metal_dark", "axes": "xy", "width": 1 }, "jitter": false },
    { "name": "Ladeplatte Bolzen", "op": "box", "at": [-3, 9, 15], "size": [1, 1, 1], "color": "trim", "mirror": "x", "mirrorAt": 0 },

    { "name": "Ladung Körper", "if": "state == 1", "op": "box", "at": [-3, 4, 14], "size": [6, 6, 2], "color": "metal_dark" },
    { "name": "Ladung Riemen", "if": "state == 1", "op": "box", "at": [-4, 5, 14], "size": [8, 1, 2], "repeat": { "count": 2, "step": [0, 3, 0] }, "color": "leather" },
    { "name": "Ladung Zünder", "if": "state == 1", "op": "box", "at": [-1, 10, 14], "size": [2, 2, 2], "color": "metal_light" },
    { "name": "Zünder Licht (weiß)", "if": "state == 1", "op": "box", "at": [0, 12, 14], "size": [1, 1, 1], "color": { "role": "white", "emit": 1.2 }, "jitter": false },
    { "name": "Zünder Draht", "if": "state == 1", "op": "line", "from": [1, 11, 15], "to": [5, 7, 15], "r": 0.5, "color": "rubber" },

    { "name": "Zerstört: Kern erloschen", "if": "state == 2", "op": "cyl", "at": [0, 10, 0], "r": 8.5, "h": 1, "color": { "noise": ["black", "metal_dark", { "shade": "ember", "f": 0.55, "emit": 0.5 }], "weights": [3, 3, 1], "cell": 2 }, "jitter": false },
    { "name": "Zerstört: Kernschlacke", "if": "state == 2", "op": "ellipsoid", "at": [1, 11, -1], "r": [4, 2.5, 3.5], "color": { "noise": ["black", "metal_dark"], "weights": [1, 1], "cell": 2 } },
    { "name": "Zerstört: Pfeiler gebrochen", "if": "state == 2", "op": "box", "at": [6, 16, 6], "size": [8, 16, 8], "mode": "carve" },
    { "name": "Zerstört: Ring gesprengt", "if": "state == 2", "op": "box", "at": [-2, 28, 2], "size": [14, 8, 12], "mode": "carve" },
    { "name": "Zerstört: Trümmer Ring", "if": "state == 2", "op": "box", "at": [9, 3, 6], "size": [5, 2, 6], "color": "primary" },
    { "name": "Zerstört: Trümmer Pfeiler", "if": "state == 2", "op": "line", "from": [4, 9, 12], "to": [12, 4, 8], "r": 1.3, "color": "metal_dark" },
    { "name": "Zerstört: Ladeplatte aufgerissen", "if": "state == 2", "op": "box", "at": [-2, 5, 13], "size": [4, 4, 3], "mode": "carve" },
    { "name": "Zerstört: Bruch", "if": "state == 2", "op": "erode", "density": 0.3, "depth": 2, "at": [-16, 12, -16], "size": [32, 24, 32], "salt": 3 },
    { "name": "Zerstört: Ruß", "if": "state == 2", "op": "cyl", "at": [0, 8, 0], "r": 15, "h": 28, "mode": "paint", "color": { "noise": ["black", "metal_dark", "primary"], "weights": [2, 2, 1], "cell": 2 }, "jitter": false },

    { "name": "Verfall", "op": "erode", "if": "zustand > 0 && state < 2", "density": "zustand * 0.05", "depth": 1, "at": [-16, 20, -16], "size": [32, 16, 32] },
    { "name": "Ruß (umkämpft)", "if": "zustand == 2 && state < 2", "op": "line", "from": [-14, 4, 6], "to": [-6, 30, 12], "r": 2, "mode": "paint", "color": { "noise": ["black", "metal_dark"], "weights": [1, 1], "cell": 1 }, "jitter": false }
  ],
  "anchor": [0, 0, 0]
