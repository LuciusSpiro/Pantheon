{
  "id": "prop/germanen/station/wandmonitor",
  "name": "Station Germanen: Wandmonitor (Eisenrahmen mit Klinkerlippen, Kabelkanal zum Boden, Hörner)",
  "tier": "detail",
  "palette": "nord",
  "tags": ["prop", "germanen", "station", "monitor", "wandnah"],
  "notes": "ART-STATION. 1 x 0,25 m, Rücken an die Wand (-z), Pivot am Boden vor der Wand. Schirm 1,1-1,9 m hoch, Kabelkanal trägt ihn bis zum Boden (keine Sonderregel für Wandmontage nötig). Inhalt: Leiterbahn-Ornament und vier Pegelbalken (seed), Frostblau gedämpft, emit <= 0,9. on 0 = dunkel.",
  "footprint": [1, 0.25],
  "params": {
    "on": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Schirm an" },
    "zustand": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand (0 intakt, 1 verfallen, 2 umkämpft)" }
  },
  "let": { "lit": "on && zustand < 2" },
  "variants": { "aus": { "on": 0 }, "verfallen": { "zustand": 1 }, "umkaempft": { "zustand": 2 } },
  "ops": [
    { "name": "Kabelkanal", "op": "box", "at": [-1, 0, -2], "size": [2, 18, 2], "color": "metal_dark", "jitter": false },
    { "name": "Kanal Schellen", "op": "box", "at": [-1, 4, 0], "size": [2, 1, 1], "repeat": { "count": 3, "step": [0, 5, 0] }, "color": "metal_light" },
    { "name": "Kanalfuß", "op": "box", "at": [-2, 0, -2], "size": [4, 1, 3], "color": "metal_dark", "jitter": false },
    { "name": "Gehäuse", "op": "box", "at": [-8, 18, -2], "size": [16, 12, 2], "color": "metal_dark", "jitter": false },
    { "name": "Schirm", "op": "box", "at": [-6, 20, 0], "size": [12, 8, 1], "color": "glass", "jitter": false },
    { "name": "Rahmen seitlich", "op": "box", "at": [-8, 19, 0], "size": [2, 10, 1], "color": "primary", "jitter": false, "mirror": "x", "mirrorAt": 0 },
    { "name": "Klinkerlippe oben", "op": "box", "at": [-8, 29, -2], "size": [16, 1, 4], "color": "metal_light", "jitter": false },
    { "name": "Klinkerlippe unten", "op": "box", "at": [-8, 18, -2], "size": [16, 1, 4], "color": { "shade": "primary", "f": 1.15 }, "jitter": false },
    { "name": "Nieten", "op": "box", "at": [-7, 20, 1], "size": [1, 1, 1], "repeat": { "count": 2, "step": [0, 7, 0] }, "color": "metal_light", "mirror": "x", "mirrorAt": 0 },
    { "name": "Leiterbahn oben (gepunktet)", "if": "lit", "op": "box", "at": [-5, 26, 0], "size": [1, 1, 1], "repeat": { "count": 6, "step": [2, 0, 0] }, "color": { "shade": "glow", "f": 0.75, "emit": 0.7 }, "mode": "paint", "jitter": false },
    { "name": "Leiterbahn Zug", "if": "lit", "op": "box", "at": [-5, 24, 0], "size": [5, 1, 1], "color": { "shade": "glow", "f": 0.8, "emit": 0.8 }, "mode": "paint", "jitter": false },
    { "name": "Leiterbahn Knoten", "if": "lit", "op": "box", "at": [-1, 22, 0], "size": [1, 2, 1], "color": { "shade": "glow", "f": 0.8, "emit": 0.8 }, "mode": "paint", "jitter": false },
    { "name": "Pegelbalken", "if": "lit", "op": "box", "at": [1, 21, 0], "size": [1, "1 + floor(hash(seed, i) * 4)", 1], "repeat": { "count": 4, "step": [1, 0, 0], "var": "i" }, "color": { "shade": "glow", "f": 0.9, "emit": 0.9 }, "mode": "paint", "jitter": false },
    {"name": "Hörner Ansatz", "op": "box", "at": [-8, 30, -2], "size": [2, 2, 2], "color": "trim", "mirror": "x", "mirrorAt": 0},
    {"name": "Hörner Spitze", "op": "box", "at": [-8, 32, -1], "size": [1, 2, 1], "color": {"shade": "trim", "f": 0.75}, "mirror": "x", "mirrorAt": 0},

    { "name": "Verfall", "op": "erode", "if": "zustand > 0", "density": "zustand * 0.08", "depth": 1, "at": [-8, 18, -2], "size": [16, 16, 4] },
    { "name": "Schirm gesprungen", "if": "zustand == 2", "op": "line", "from": [-6, 27, 0], "to": [2, 20, 0], "r": 0.5, "mode": "carve" },
    { "name": "Ruß", "if": "zustand == 2", "op": "line", "from": [-8, 22, 1], "to": [0, 31, 1], "r": 1.5, "mode": "paint", "color": { "noise": ["black", "metal_dark"], "weights": [1, 1], "cell": 1 }, "jitter": false }
  ],
  "anchor": [0, 0, 0]
}
