    ] },
    { "name": "Verschlossen", "op": "group", "if": "state == 2", "ops": [
      { "name": "Querriegel", "op": "box", "at": [-19,17,2], "size": [38,3,2], "color": {"frame": "trim", "fill": "primary", "axes": "x"} },
      { "name": "Riegelkloben", "op": "box", "at": [-19,15,1], "size": [3,7,3], "color": "metal", "mirror": "x", "mirrorAt": 0 },
