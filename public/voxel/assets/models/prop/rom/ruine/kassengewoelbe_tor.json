      { "name": "Stabreste unten", "op": "box", "repeat": {"count": 8, "step": [4,0,0], "var": "i"}, "if": "hash(seed, i, 1) < 0.75", "at": [-14,1,-1], "size": [2, "2 + floor(hash(seed, i, 2) * 10)",2], "color": "metal_dark" },
      { "name": "Stabreste oben", "op": "box", "repeat": {"count": 8, "step": [4,0,0], "var": "i"}, "if": "hash(seed, i, 3) < 0.6", "at": [-14, "26 + floor(hash(seed, i, 4) * 6)",-1], "size": [2,10,2], "color": "metal_dark" },
      { "name": "Gitterstück am Boden", "op": "box", "at": [-10,1,3], "size": [14,2,7], "color": {"stripes": ["metal_dark", "dark"], "axis": "x", "period": 2} },
      { "name": "Verbogener Stab", "op": "line", "from": [6,1,2], "to": [12,6,9], "r": 0.7, "color": "metal" },
      { "name": "Trümmer", "op": "box", "repeat": {"count": 5, "step": [0,0,0], "var": "i"}, "at": ["floor(hash(seed, i, 5) * 30) - 16",1, "floor(hash(seed, i, 6) * 8) - 4"], "size": [3,2,3], "color": {"noise": ["stone", "stone_dark"], "cell": 1} }
    ] },
    { "name": "Verfall", "op": "erode", "if": "state != 3", "density": 0.15, "depth": 1, "salt": 3, "at": [-21,2,-7], "size": [42,42,14] },
    { "name": "Moos", "op": "box", "mode": "paint", "at": [-21,0,-7], "size": [42,5,14], "color": {"noise": [{"shade": "plant_dark", "f": 0.75}, "stone_dark", "stone", "stone"], "weights": [1,3,3,3], "cell": 1} },
    { "name": "Moos Gesims", "op": "box", "mode": "paint", "at": [-21,43,-7], "size": [42,1,14], "color": {"noise": [{"shade": "plant_dark", "f": 0.75}, "stone_light", "stone_light"], "weights": [1,3,2], "cell": 2} }
  ],
