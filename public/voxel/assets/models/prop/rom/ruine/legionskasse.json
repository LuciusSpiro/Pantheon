    { "name": "Moos", "op": "box", "mode": "paint", "at": [-8, 0, -7], "size": [16, 2, 14], "color": { "noise": [{ "shade": "plant_dark", "f": 0.75 }, "stone_dark", "stone"], "weights": [1, 3, 3], "cell": 1 } }
