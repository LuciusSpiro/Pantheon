{
  "id": "prop/rom/ruine/schutt",
  "name": "Schutthaufen (Kastellruine, seed-variiert)",
  "tier": "detail",
  "palette": "rom",
  "tags": ["prop", "rom", "ruine", "deko", "schutt"],
  "notes": "Deko (keine Kollision). Form über seed: Lage und Größe der Blöcke, Paneelbruch, Moos. gross 0/1 = flacher Streuhaufen / hoher Haufen.",
  "footprint": [1, 1],
  "params": {
    "gross": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Hoher Haufen" }
  },
  "let": { "hh": "gross ? 4 : 2" },
  "variants": { "b": { "seed": 7 }, "c": { "seed": 13, "gross": 0 }, "flach": { "gross": 0 } },
  "ops": [
    { "name": "Haufen", "op": "ellipsoid", "at": [0, 0, 0], "r": [6.5, "hh", 6], "half": "+y", "color": { "noise": ["stone", "stone_dark", "paving_dark", "stone_light"], "weights": [3, 2, 1, 1], "cell": 1 } },
    { "name": "Travertinblöcke", "op": "box", "repeat": { "count": "gross ? 6 : 4", "step": [0, 0, 0], "var": "i" },
      "at": ["floor(hash(seed, i, 1) * 10) - 6", "floor(hash(seed, i, 2) * hh)", "floor(hash(seed, i, 3) * 10) - 6"],
      "size": ["2 + floor(hash(seed, i, 4) * 3)", "2 + floor(hash(seed, i, 5) * 2)", "2 + floor(hash(seed, i, 6) * 3)"],
      "color": { "noise": ["stone", "stone_light"], "weights": [2, 1], "cell": 2 } },
    { "name": "Keramikpaneel gebrochen", "op": "box", "if": "hash(seed, 9) < 0.7",
      "at": ["floor(hash(seed, 10) * 6) - 5", "hh - 1", "floor(hash(seed, 11) * 6) - 4"], "size": [5, 1, 3],
      "color": { "stripes": ["secondary", "secondary", "primary"], "axis": "x", "period": 1 } },
    { "name": "Panzerband Rest", "op": "box", "if": "hash(seed, 12) < 0.5",
      "at": ["floor(hash(seed, 13) * 4) - 1", 0, "floor(hash(seed, 14) * 6) - 6"], "size": [4, 2, 1], "color": { "shade": "primary", "f": 0.8 } },
    { "name": "Armierung", "op": "line", "from": ["floor(hash(seed, 15) * 6) - 5", "hh - 1", -3], "to": ["floor(hash(seed, 16) * 6) - 1", "hh + 2", 3], "r": 0.5, "color": "metal_dark" },
    { "name": "Bruch", "op": "erode", "density": 0.3, "depth": 1, "salt": 1 },
    { "name": "Moos", "op": "box", "mode": "paint", "at": [-8, 1, -8], "size": [16, 6, 16], "color": { "noise": [{ "shade": "plant_dark", "f": 0.75 }, "stone", "stone_dark", "stone", "stone_light"], "weights": [1, 4, 3, 4, 2], "cell": 1 } }
  ],
  "sockets": {},
  "anchor": [0, 0, 0]
}
