{
  "id": "prop/rom/schiff/reaktor_schiff",
  "name": "Schiffsreaktor: Tholos mit Glühkern, schlank (Rom, Sprengpunkt)",
  "notes": "Anker sprengpunkt. Schlanke Eigenfassung im Stil von lerche/station/reactor (Tholos, sechs Säulen, Bronzekuppel mit Oculus), jitter 0, unter 2 500 Dreiecken. state 0 intakt (kaltblauer Kern), 1 scharf (Sprengpaket am Altar, Ladungen an den Säulen, rote Blinklichter, Kern Amber), 2 zerstört (Kuppel eingebrochen, Säule gebrochen, Ruß, Glutnest).",
  "tier": "detail",
  "palette": "lerche_rom",
  "jitter": 0,
  "tags": ["rom", "schiff", "prop", "sprengpunkt", "reaktor"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand 0 intakt / 1 scharf / 2 zerstört" }
  },
  "let": { "tot": "state == 2", "arm": "state == 1" },
  "variants": { "scharf": { "state": 1 }, "zerstoert": { "state": 2 } },
  "ops": [
    { "op": "box", "name": "Sockel", "at": [-8, 0, -8], "size": [16, 2, 16], "color": "metal_dark" },
    { "op": "cyl", "name": "Stufe Marmor", "at": [0, 2, 0], "r": 7, "h": 2, "color": "secondary" },

    { "op": "cyl", "name": "Kern blau", "if": "state == 0", "at": [0, 4, 0], "r": 2.2, "h": 10, "color": { "role": "glow", "emit": 2.2 }, "jitter": false },
    { "op": "cyl", "name": "Kern amber (scharf)", "if": "arm", "at": [0, 4, 0], "r": 2.2, "h": 10, "color": { "role": "glow2", "emit": 2.6 }, "jitter": false },
    { "op": "cyl", "name": "Kern dunkel", "if": "tot", "at": [0, 4, 0], "r": 2.2, "h": 10, "color": "glass", "jitter": false },
    { "op": "cyl", "name": "Kernring Bronze", "at": [0, 8, 0], "r": 2.8, "h": 1, "color": "metal_dark", "repeat": { "count": 1, "step": [0, 4, 0] } },

    { "op": "group", "name": "Vier Säulen", "mirror": "x", "mirrorAt": 0, "ops": [
      { "op": "group", "name": "Säule vorn", "at": [4.5, 0, 4], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 4, -1], "size": [3, 1, 3], "color": "trim" },
        { "op": "box", "name": "Schaft", "at": [0, 5, 0], "size": [2, 9, 2], "color": "secondary" },
        { "op": "box", "name": "Kapitell", "at": [-1, 14, -1], "size": [3, 1, 3], "color": "trim" } ] },
      { "op": "group", "name": "Säule hinten", "at": [4.5, 0, -5], "ops": [
        { "op": "box", "name": "Basis", "at": [-1, 4, -1], "size": [3, 1, 3], "color": "trim" },
        { "op": "box", "name": "Schaft", "at": [0, 5, 0], "size": [2, 9, 2], "color": "secondary" },
        { "op": "box", "name": "Kapitell", "at": [-1, 14, -1], "size": [3, 1, 3], "color": "trim" } ] }
    ] },

    { "op": "cyl", "name": "Gebälk", "at": [0, 15, 0], "r": 7, "h": 2, "color": "stone" },
    { "op": "cyl", "name": "Gebälk Goldband", "at": [0, 16, 0], "r": 7.1, "h": 1, "hollow": 1, "color": "trim" },
    { "op": "ellipsoid", "name": "Kuppel Bronze", "at": [0, 17, 0], "r": [6.6, 4.5, 6.6], "half": "+y", "color": "metal_light" },
    { "op": "cyl", "name": "Kuppelfuß Rot", "at": [0, 17, 0], "r": 6.8, "h": 1, "hollow": 1.2, "mode": "paint", "color": "primary" },
    { "op": "cyl", "name": "Oculus", "at": [0, 16, 0], "r": 2.2, "h": 7, "mode": "carve" },
    { "op": "cyl", "name": "Laterne Fuß", "at": [0, 21, 0], "r": 2.4, "h": 1, "color": "metal_dark" },
    { "op": "cyl", "name": "Laterne blau", "if": "state == 0", "at": [0, 22, 0], "r": 1.8, "h": 2, "color": { "role": "glow", "emit": 2.2 }, "jitter": false },
    { "op": "cyl", "name": "Laterne amber (scharf)", "if": "arm", "at": [0, 22, 0], "r": 1.8, "h": 2, "color": { "role": "glow2", "emit": 2.4 }, "jitter": false },
    { "op": "cyl", "name": "Laterne dunkel", "if": "tot", "at": [0, 22, 0], "r": 1.8, "h": 2, "color": "glass", "jitter": false },
    { "op": "cyl", "name": "Laternenkappe", "at": [0, 24, 0], "r": 2.2, "h": 1, "color": "trim" },

    { "op": "box", "name": "Bedienaltar", "at": [-2, 2, 5], "size": [4, 6, 2], "color": { "frame": "trim", "fill": "stone", "axes": "xy", "width": 1 } },
    { "op": "box", "name": "Altarplatte", "at": [-3, 8, 4], "size": [6, 1, 3], "color": "metal_light" },
    { "op": "box", "name": "Anzeige", "if": "!tot", "at": [-1, 9, 5], "size": [2, 1, 1], "color": { "role": "glow", "emit": 1.4 }, "jitter": false },

    { "op": "group", "name": "Ladung (scharf)", "if": "arm", "ops": [
      { "op": "box", "name": "Sprengpaket", "at": [-3, 9, 4], "size": [6, 5, 2], "color": { "frame": "metal_dark", "fill": "warning", "axes": "xy", "width": 1 } },
      { "op": "box", "name": "Zünder", "at": [-1, 14, 4], "size": [2, 1, 2], "color": "metal_light" },
      { "op": "box", "name": "Blinklicht Paket", "at": [-1, 15, 5], "size": [2, 1, 1], "color": { "role": "alarm", "emit": 1.6 }, "jitter": false },
      { "op": "box", "name": "Säulenladung", "at": [4, 8, 5], "size": [3, 3, 2], "color": { "frame": "metal_dark", "fill": "warning", "axes": "xy", "width": 1 }, "mirror": "x", "mirrorAt": 0 },
      { "op": "line", "name": "Zündschnur", "from": [3, 10, 5], "to": [1, 11, 5], "r": 0.5, "color": "black", "mirror": "x", "mirrorAt": 0 },
      { "op": "box", "name": "Blinklicht oben", "at": [-1, 25, -1], "size": [2, 1, 2], "color": { "role": "alarm", "emit": 1.8 }, "jitter": false }
    ] },

    { "op": "group", "name": "Zerstört", "if": "tot", "ops": [
      { "op": "box", "name": "Säule gebrochen", "at": [3, 8, 3], "size": [6, 7, 6], "mode": "carve" },
      { "op": "box", "name": "Kuppel eingebrochen", "at": [0, 15, 0], "size": [8, 9, 8], "mode": "carve" },
      { "op": "box", "name": "Trümmer", "at": [4, 3, 4], "size": [3, 2, 2], "color": "metal_light" },
      { "op": "line", "name": "Blech aufgebogen", "from": [4, 15, 3], "to": [6, 19, 4], "r": 0.6, "color": "metal_light" },
      { "op": "box", "name": "Ruß", "at": [-8, 10, -8], "size": [16, 14, 16], "mode": "paint", "color": { "noise": ["metal", "metal_dark"], "weights": [2, 1], "cell": 4 }, "jitter": false },
      { "op": "box", "name": "Glutnest", "at": [-1, 5, -1], "size": [2, 2, 2], "color": { "role": "ember", "emit": 0.8 }, "jitter": false }
    ] }
  ],
  "sockets": { "use": [0, 0, 0.6], "charge": [0, 0.6, 0.35], "fx_explode": [0, 0.8, 0], "fx_smoke": [0, 1.6, 0], "fx_spark": [0.25, 0.8, 0.3], "light": [0, 0.9, 0], "label": [0, 1.9, 0] },
  "anchor": [0, 0, 0]
}
