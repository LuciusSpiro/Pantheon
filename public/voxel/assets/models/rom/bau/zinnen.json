{
  "id": "rom/bau/zinnen",
  "name": "Zinnenkranz mit Emitter-Finnen (Rom, Baustein)",
  "tier": "architecture",
  "palette": "rom",
  "tags": ["architektur", "rom", "baustein", "zinnen", "wehrgang"],
  "footprint": [4, 0.5],
  "params": {
    "len": { "default": 16, "min": 4, "max": 64, "step": 4, "label": "Länge (Voxel, Vielfache von 4 = nahtlos)" },
    "lights": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Emitter-Spitzen leuchten" }
  },
  "ops": [
    { "op": "box", "name": "Brüstungsband", "at": [0, 0, 0], "size": ["len", 1, 2], "color": "primary" },
    { "op": "box", "name": "Goldkante Brüstung außen", "at": [0, 0, 1], "size": ["len", 1, 1], "color": { "stripes": ["primary", "primary", "primary", "trim"], "axis": "x", "period": 1 } },
    { "op": "box", "name": "Zinne (Finne)", "repeat": { "count": "floor(len/4)", "step": [4, 0, 0] }, "at": [1, 1, 0], "size": [2, 2, 2], "color": "secondary" },
    { "op": "box", "name": "Finnenkopf", "repeat": { "count": "floor(len/4)", "step": [4, 0, 0] }, "at": [1, 3, 0], "size": [2, 1, 2], "color": "metal" },
    { "op": "box", "name": "Emitter-Spitze", "if": "lights", "repeat": { "count": "floor(len/4)", "step": [4, 0, 0] }, "at": [1, 3, 1], "size": [1, 1, 1], "color": { "role": "glow", "emit": 1.2 }, "jitter": false },
    { "op": "box", "name": "Finnen-Fuge", "repeat": { "count": "floor(len/4)", "step": [4, 0, 0] }, "at": [2, 1, 1], "size": [1, 2, 1], "color": { "shade": "secondary", "f": 0.82 } }
  ],
  "anchor": [0, 0, 0]
}
