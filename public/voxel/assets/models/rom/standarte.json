{
  "id": "rom/standarte",
  "name": "Aquila-Standarte als Feldgenerator (Rom)",
  "tier": "detail",
  "palette": "rom",
  "tags": ["prop", "rom", "standarte", "aquila", "feldgenerator", "wahrzeichen"],
  "footprint": [0.9, 0.9],
  "params": {
    "field": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Feldgenerator aktiv" },
    "pole": { "default": 36, "min": 20, "max": 48, "step": 1, "label": "Stangenlänge (Voxel)" }
  },
  "let": { "top": "6 + pole" },
  "variants": {
    "inaktiv": { "field": 0 },
    "kurz": { "pole": 26 }
  },
  "ops": [
    { "op": "use", "name": "Fuß", "model": "rom/standartenfuss", "at": [0, 0, 0], "params": { "glow": "field" } },
    { "op": "box", "name": "Stange", "at": [-1, 6, -1], "size": [2, "pole", 2], "color": "metal_dark" },
    { "op": "box", "name": "Stangenringe", "repeat": { "count": 3, "step": [0, 8, 0], "var": "k" }, "at": [-1, 9, -1], "size": [2, 1, 2], "color": "trim" },
    { "op": "group", "name": "Phalerae", "at": [0, "top-22", 0], "ops": [
      { "op": "box", "name": "Phalerae Träger", "at": [-1, -1, 1], "size": [2, 15, 1], "color": "metal" },
      { "op": "cyl", "name": "Phalera", "repeat": { "count": 3, "step": [0, 5, 0], "var": "k" }, "axis": "z", "at": [0, 2, 2], "r": 2.9, "h": 1, "color": "trim" },
      { "op": "cyl", "name": "Phalera Rand", "repeat": { "count": 3, "step": [0, 5, 0], "var": "k" }, "axis": "z", "at": [0, 2, 2], "r": 2.9, "h": 1, "hollow": 0.9, "color": { "shade": "trim", "f": 0.8 }, "mode": "paint" },
      { "op": "box", "name": "Phalera Buckel", "repeat": { "count": 3, "step": [0, 5, 0], "var": "k" }, "at": [-1, 1, 3], "size": [2, 2, 1], "color": { "shade": "trim", "f": 1.12 } },
      { "op": "box", "name": "Phalera Kern", "if": "field", "at": [-1, 6, 3], "size": [2, 2, 1], "color": { "role": "glow", "emit": 0.9 }, "jitter": false }
    ] },
    { "op": "group", "name": "Feldring", "at": [0, "top-6", 0], "ops": [
      { "op": "box", "name": "Speichen", "at": [-5, 0, -1], "size": [10, 1, 2], "color": "metal" },
      { "op": "box", "name": "Speichen quer", "at": [-1, 0, -5], "size": [2, 1, 10], "color": "metal" },
      { "op": "cyl", "name": "Ring", "at": [0, 0, 0], "r": 5.6, "hollow": 1.2, "h": 1, "color": "trim" },
      { "op": "cyl", "name": "Ring Leuchtkante", "if": "field", "at": [0, 1, 0], "r": 5.2, "hollow": 0.8, "h": 1, "color": { "role": "glow", "emit": 0.8 }, "jitter": false },
      { "op": "cyl", "name": "Ring Leuchtkante aus", "if": "!field", "at": [0, 1, 0], "r": 5.2, "hollow": 0.8, "h": 1, "color": "metal_light" }
    ] },
    { "op": "group", "name": "Aquila", "at": [0, "top", 0], "ops": [
      { "op": "box", "name": "Querbalken", "at": [-3, 0, -2], "size": [6, 1, 4], "color": "metal" },
      { "op": "line", "name": "Blitzbündel", "from": [-5.5, 0.5, 2.5], "to": [5.5, 0.5, 2.5], "r": 0.5, "color": "trim" },
      { "op": "box", "name": "Blitz Zacken", "at": [-6, -1, 2], "size": [1, 1, 1], "color": "trim", "mirror": "x", "mirrorAt": 0 },
      { "op": "box", "name": "Fänge", "at": [-2, 1, 0], "size": [1, 1, 2], "color": { "shade": "trim", "f": 0.75 }, "mirror": "x", "mirrorAt": 0 },
      { "op": "ellipsoid", "name": "Körper", "at": [0, 4.5, 0.5], "r": [1.8, 3.2, 2], "color": "trim" },
      { "op": "box", "name": "Schwanz", "at": [-1, 1, -2], "size": [2, 3, 1], "color": { "shade": "trim", "f": 0.85 } },
      { "op": "ellipsoid", "name": "Kopf", "at": [0, 8.5, 1.5], "r": [1.3, 1.4, 1.6], "color": "trim" },
      { "op": "box", "name": "Schnabel", "at": [-1, 8, 3], "size": [2, 1, 1], "color": { "shade": "trim", "f": 0.7 } },
      { "op": "box", "name": "Augen", "at": [-2, 9, 2], "size": [1, 1, 1], "color": "black", "jitter": false, "mirror": "x", "mirrorAt": 0 },
      { "op": "group", "name": "Flügel", "mirror": "x", "mirrorAt": 0, "ops": [
        { "op": "box", "name": "Schwingenreihe", "repeat": { "count": 10, "step": [0, 1, 0], "var": "k" }, "let": { "xo": "-min(10, 5 + k)", "xi": "k >= 5 ? -4 - (k - 5) : -1" }, "at": ["xo", "4", 0], "size": ["xi - xo", 1, 1], "color": { "stripes": ["trim", { "shade": "trim", "f": 0.82 }], "axis": "x", "period": 1 } },
        { "op": "box", "name": "Schwingen Rückseite", "repeat": { "count": 6, "step": [0, 1, 0], "var": "k" }, "let": { "xo": "-min(9, 4 + k)" }, "at": ["xo", "4", -1], "size": ["-1 - xo", 1, 1], "color": { "shade": "trim", "f": 0.7 } },
        { "op": "box", "name": "Federspitze außen", "at": [-10, 14, 0], "size": [1, 2, 1], "color": { "shade": "trim", "f": 1.1 } },
        { "op": "box", "name": "Federspitze innen", "at": [-8, 14, 0], "size": [1, 1, 1], "color": "trim" },
        { "op": "box", "name": "Schwungfedern unten", "repeat": { "count": 2, "step": [-2, 0, 0], "var": "k" }, "at": [-3, 3, 0], "size": [1, 1, 1], "color": { "shade": "trim", "f": 0.82 } },
        { "op": "line", "name": "Vorderkante", "from": [-1.5, 7.5, 0.5], "to": [-9.5, 12.5, 0.5], "r": 0.6, "color": { "shade": "trim", "f": 1.12 } }
      ] }
    ] }
  ],
  "anchor": [0, 0, 0]
}
